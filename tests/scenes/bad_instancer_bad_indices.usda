#usda 1.0
# Robustness: a PointInstancer whose protoIndices outnumber its positions (tools/bench_robust.py). Indices naming missing
# prototypes are left out: they crash USD itself, under Karma as well (K-86).
(
    defaultPrim = "world"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "world"
{
    def Camera "camera"
    {
        float focalLength = 30
        float horizontalAperture = 36
        float verticalAperture = 27
        float2 clippingRange = (0.1, 1000)
        matrix4d xformOp:transform = ( (1,0,0,0), (0,0.966,-0.259,0), (0,0.259,0.966,0), (0, 3.5, 10, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }
    def DistantLight "sun"
    {
        float inputs:intensity = 2
        bool inputs:normalize = 1
        float3 xformOp:rotateXYZ = (-50, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def PointInstancer "pi"
    {
        rel prototypes = [</world/pi/proto>]
        int[] protoIndices = [0, 0, 0]
        point3f[] positions = [(0, 0, 0), (1, 0, 0)]
        def Sphere "proto"
        {
            double radius = 0.3
        }
    }
}
