#usda 1.0
(
    doc = """Generated from Composed Stage of root layer 
"""
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
)

def HoudiniLayerInfo "HoudiniLayerInfo" (
    customData = {
        int HoudiniCreatorNode = 1006
        int[] HoudiniEditorNodes = [1006]
        string HoudiniSaveControl = "Placeholder"
    }
)
{
}

def Scope "world"
{
    def Scope "Materials"
    {
        def Material "cyclesmat" (
            customData = {
                int[] HoudiniPrimEditorNodes = [1007]
            }
        )
        {
            token outputs:cycles:surface.connect = </world/Materials/cyclesmat/surface.outputs:BSDF>

            def Shader "surface" (
                apiSchemas = ["NodeGraphNodeAPI"]
                customData = {
                    bool HoudiniHasAutoPreviewShader = 1
                }
            )
            {
                uniform token info:id = "cycles_principled_bsdf"
                color3f inputs:base_color.connect = </world/Materials/cyclesmat/probe.outputs:value>
                token outputs:BSDF
                uniform float2 ui:nodegraph:node:pos = (-0.2883, 0.0376)
            }

            def Shader "probe" (
                apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "cycles_vector_curves"
                int inputs:curves = 2 (
                    customData = {
                        string rampbasisattr = "inputs:curves_basis"
                        bool rampbasisisarray = 0
                        string rampcountattr = "inputs:curves"
                        string rampposattr = "inputs:curves_keys"
                        string rampvalueattr = "inputs:curves_values"
                    }
                )
                token inputs:curves_basis = "linear" (
                    customData = {
                        string rampbasisattr = "inputs:curves_basis"
                        bool rampbasisisarray = 0
                        string rampcountattr = "inputs:curves"
                        string rampposattr = "inputs:curves_keys"
                        string rampvalueattr = "inputs:curves_values"
                    }
                )
                float[] inputs:curves_keys = [0, 1] (
                    customData = {
                        string rampbasisattr = "inputs:curves_basis"
                        bool rampbasisisarray = 0
                        string rampcountattr = "inputs:curves"
                        string rampposattr = "inputs:curves_keys"
                        string rampvalueattr = "inputs:curves_values"
                    }
                )
                color3f[] inputs:curves_values = [(0, 0, 0), (1, 1, 1)] (
                    customData = {
                        string rampbasisattr = "inputs:curves_basis"
                        bool rampbasisisarray = 0
                        string rampcountattr = "inputs:curves"
                        string rampposattr = "inputs:curves_keys"
                        string rampvalueattr = "inputs:curves_values"
                    }
                )
                vector3f outputs:value
                uniform float2 ui:nodegraph:node:pos = (0, 0)
            }
        }
    }
}

