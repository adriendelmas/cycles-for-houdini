#usda 1.0
(
    doc = """Generated from Composed Stage of root layer 
"""
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
)

def HoudiniLayerInfo "HoudiniLayerInfo" (
    customData = {
        int HoudiniCreatorNode = 190
        int[] HoudiniEditorNodes = [190]
        string HoudiniSaveControl = "Placeholder"
    }
)
{
}

def Scope "world"
{
    def Scope "Materials"
    {
        def Material "cyclesmat" (
            customData = {
                int[] HoudiniPrimEditorNodes = [191]
            }
        )
        {
            token outputs:cycles:surface.connect = </world/Materials/cyclesmat/surface.outputs:BSDF>

            def Shader "surface" (
                apiSchemas = ["NodeGraphNodeAPI"]
                customData = {
                    bool HoudiniHasAutoPreviewShader = 1
                }
            )
            {
                uniform token info:id = "cycles_principled_bsdf"
                color3f inputs:base_color.connect = </world/Materials/cyclesmat/probe.outputs:value>
                token outputs:BSDF
                uniform float2 ui:nodegraph:node:pos = (-0.2883, 0.0376)
            }

            def Shader "probe" (
                apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "cycles_float_curve"
                int inputs:curve = 2 (
                    customData = {
                        string rampbasisattr = "inputs:curve_basis"
                        bool rampbasisisarray = 0
                        string rampcountattr = "inputs:curve"
                        string rampposattr = "inputs:curve_keys"
                        string rampvalueattr = "inputs:curve_values"
                    }
                )
                token inputs:curve_basis = "linear" (
                    customData = {
                        string rampbasisattr = "inputs:curve_basis"
                        bool rampbasisisarray = 0
                        string rampcountattr = "inputs:curve"
                        string rampposattr = "inputs:curve_keys"
                        string rampvalueattr = "inputs:curve_values"
                    }
                )
                float[] inputs:curve_keys = [0, 1] (
                    customData = {
                        string rampbasisattr = "inputs:curve_basis"
                        bool rampbasisisarray = 0
                        string rampcountattr = "inputs:curve"
                        string rampposattr = "inputs:curve_keys"
                        string rampvalueattr = "inputs:curve_values"
                    }
                )
                float[] inputs:curve_values = [0, 1] (
                    customData = {
                        string rampbasisattr = "inputs:curve_basis"
                        bool rampbasisisarray = 0
                        string rampcountattr = "inputs:curve"
                        string rampposattr = "inputs:curve_keys"
                        string rampvalueattr = "inputs:curve_values"
                    }
                )
                float outputs:value
                uniform float2 ui:nodegraph:node:pos = (0, 0)
            }
        }
    }
}

