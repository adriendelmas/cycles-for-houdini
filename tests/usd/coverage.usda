    def RectLight "key"
    {
        float inputs:width = 6
        float inputs:height = 6
        float inputs:intensity = 12
        matrix4d xformOp:transform = ( (1,0,0,0), (0,0.5,-0.866,0), (0,0.866,0.5,0), (-4, 7, 6, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def DomeLight "sky"
    {
        float inputs:intensity = 0.35
        color3f inputs:color = (0.35, 0.45, 0.6)
    }
}

def RenderSettings "rendersettings"
{
    rel camera = </world/camera>
    uniform int2 resolution = (720, 360)
    rel products = </Render/product>
}

def Scope "Render"
{
    def RenderProduct "product"
    {
        rel camera = </world/camera>
        uniform token productType = "raster"
        token productName = "phase4b.exr"
        rel orderedVars = [</Render/Vars/color>]
    }

    def Scope "Vars"
    {
        def RenderVar "color" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color4f"
            token driver:parameters:aov:husk:format = "color4f"
            string driver:parameters:aov:husk:name = "C"
            uniform string sourceName = "color"
            uniform token sourceType = "raw"
        }
    }
}
