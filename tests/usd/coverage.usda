        }
        def Shader "n65"
        {
            uniform token info:id = "ND_dielectric_bsdf"
            token outputs:out
        }
        def Shader "n66"
        {
            uniform token info:id = "ND_oren_nayar_diffuse_bsdf"
            token outputs:out
        }
        def Shader "n67"
        {
            uniform token info:id = "ND_burley_diffuse_bsdf"
            token outputs:out
        }
        def Shader "n68"
