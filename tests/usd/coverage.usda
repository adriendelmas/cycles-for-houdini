        }
        def Material "mxGlass"
        {
            token outputs:mtlx:surface.connect = </world/Materials/mxGlass/s.outputs:surface>
            def Shader "s"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.35, 0.8, 0.95)
                float inputs:metalness = 0
                float inputs:transmission = 1
                float inputs:specular_roughness = 0.04
                float inputs:specular_IOR = 1.45
                token outputs:surface
            }
        }

        def Material "mxEmit"
        {
            token outputs:mtlx:surface.connect = </world/Materials/mxEmit/s.outputs:surface>
            def Shader "s"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.05, 0.05, 0.05)
                float inputs:specular_roughness = 0.5
                float inputs:emission = 2.5
                color3f inputs:emission_color = (1.0, 0.4, 0.12)
                token outputs:surface
