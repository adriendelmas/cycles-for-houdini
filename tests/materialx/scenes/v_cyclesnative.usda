            customData = {
                int[] HoudiniPrimEditorNodes = [16]
            }
        )
        uniform bool houdini:inviewermenu = 1 (
            customData = {
                int[] HoudiniPrimEditorNodes = [16]
            }
        )
        token projection = "perspective" (
            customData = {
                int[] HoudiniPrimEditorNodes = [16]
            }
        )
        double shutter:close = 0.25 (
            customData = {
                int[] HoudiniPrimEditorNodes = [16]
            }
        )
        double shutter:open = -0.25 (
            customData = {
                int[] HoudiniPrimEditorNodes = [16]
            }
        )
        float verticalAperture = 0.11787187 (
            customData = {
                int[] HoudiniPrimEditorNodes = [16]
            }
        )
        float verticalApertureOffset = 0 (
            customData = {
                int[] HoudiniPrimEditorNodes = [16]
            }
        )
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 4)
        float3 xformOp:translate:pivot = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:translate:pivot", "xformOp:rotateXYZ", "xformOp:scale", "!invert!xformOp:translate:pivot"] (
            customData = {
                int[] HoudiniPrimEditorNodes = [16]
            }
