            customData = {
                int[] HoudiniPrimEditorNodes = [16]
            }
        )
        float horizontalApertureOffset = 0 (
            customData = {
                int[] HoudiniPrimEditorNodes = [16]
            }
        )
        asset houdini:backgroundimage = @@ (
            customData = {
                int[] HoudiniPrimEditorNodes = [16]
            }
        )
