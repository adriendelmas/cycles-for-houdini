#usda 1.0
(
    doc = """Generated from Composed Stage of root layer 
"""
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
)

def HoudiniLayerInfo "HoudiniLayerInfo" (
    customData = {
        int HoudiniCreatorNode = 820
        int[] HoudiniEditorNodes = [820]
        string HoudiniSaveControl = "Placeholder"
    }
)
{
}

def Scope "world"
{
    def Scope "Materials"
    {
        def Material "cyclesmat" (
            customData = {
                int[] HoudiniPrimEditorNodes = [821]
            }
        )
        {
            token outputs:cycles:volume.connect = </world/Materials/cyclesmat/probe.outputs:volume>

            def Shader "probe" (
                apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "cycles_volume_coefficients"
                token outputs:volume
                uniform float2 ui:nodegraph:node:pos = (0, 0)
            }
        }
    }
}

