diff --git a/src/hydra/session.cpp b/src/hydra/session.cpp
index ae1ede13..50248a1b 100644
--- a/src/hydra/session.cpp
+++ b/src/hydra/session.cpp
@@ -24,6 +24,23 @@ const std::unordered_map<TfToken, PassType, TfToken::HashFunctor> kAovToPass = {
     {HdAovTokens->normal, PASS_NORMAL},
     {HdAovTokens->primId, PASS_OBJECT_ID},
     {HdAovTokens->instanceId, PASS_AOV_VALUE},
+
+    /* Houdini AOV naming conventions.
+     *
+     * Houdini's husk passes the `driver:parameters:aov:husk:name` attribute of a
+     * UsdRenderVar through as the Hydra AOV name, rather than a standard
+     * HdAovTokens value. A RenderVar authored with the usual Houdini names
+     * therefore arrives here unmapped, and the resulting binding is dropped -
+     * which leaves the render pass with no bindings at all, so it reports itself
+     * converged immediately and husk writes out an empty (black) frame.
+     *
+     * Accept the Houdini spellings as aliases so that render settings authored
+     * normally in Solaris work without modification. */
+    {TfToken("C"), PASS_COMBINED},
+    {TfToken("Cf"), PASS_COMBINED},
+    {TfToken("N"), PASS_NORMAL},
+    {TfToken("P"), PASS_POSITION},
+    {TfToken("Pz"), PASS_DEPTH},
 };
 
 }  // namespace
