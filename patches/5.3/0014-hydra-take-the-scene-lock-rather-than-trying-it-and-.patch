         "drawmodesupport" : false,
@@ -9,5 +9,17 @@
         "depthstyle" : "linear",
         "husk.default_output" : "cycles.exr",
         "husk.fast-exit" : 1
+    },
+
+    "HdCyclesPluginGPU" : {
+        "valid" : true,
+        "menulabel" : "Cycles GPU",
+        "menupriority" : 44,
+        "defaultpurposes" : [ "render" ],
+        "drawmodesupport" : false,
+        "needsdepth" : false,
+        "depthstyle" : "linear",
+        "husk.default_output" : "cycles.exr",
+        "husk.fast-exit" : 1
     }
 }
diff --git a/src/hydra/resources/plugInfo.json b/src/hydra/resources/plugInfo.json
index 7c2a7d94..f5862216 100644
--- a/src/hydra/resources/plugInfo.json
+++ b/src/hydra/resources/plugInfo.json
@@ -7,7 +7,14 @@
                         "bases": [
