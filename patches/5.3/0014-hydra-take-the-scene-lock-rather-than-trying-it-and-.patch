diff --git a/src/kernel/device/cuda/CMakeLists.txt b/src/kernel/device/cuda/CMakeLists.txt
index ac63c2cc..12d0d6d7 100644
--- a/src/kernel/device/cuda/CMakeLists.txt
+++ b/src/kernel/device/cuda/CMakeLists.txt
@@ -155,7 +155,16 @@ if(WITH_CYCLES_CUDA_BINARIES)
       DEPENDS ${cuda_file})
 
     unset(_cuda_nvcc_args)
-    delayed_install("${CMAKE_CURRENT_BINARY_DIR}" "${cuda_file_compressed}" ${CYCLES_INSTALL_PATH}/lib)
+    # The delegate roots Cycles at the Houdini tree, so its precompiled GPU
+    # kernels have to be installed inside that tree rather than beside it -
+    # otherwise they are simply never found at runtime and rendering silently
+    # falls back to compiling them on the fly, which needs a host compiler.
+    if(HOUDINI_FOUND)
+      set(_cycles_kernel_install_path ${CYCLES_INSTALL_PATH}/houdini/lib)
+    else()
+      set(_cycles_kernel_install_path ${CYCLES_INSTALL_PATH}/lib)
+    endif()
+    delayed_install("${CMAKE_CURRENT_BINARY_DIR}" "${cuda_file_compressed}" ${_cycles_kernel_install_path})
     list(APPEND cuda_cubins ${cuda_file_compressed})
     set(cuda_cubins "${cuda_cubins}" PARENT_SCOPE)
   endfunction()
