diff --git a/src/hydra/resources/cycles_aovs.py b/src/hydra/resources/cycles_aovs.py
new file mode 100644
index 00000000..d3ae4a96
--- /dev/null
+++ b/src/hydra/resources/cycles_aovs.py
@@ -0,0 +1,150 @@
+"""The Cycles AOVs LOP: Blender's View Layer passes as render vars.
+
+Each checked pass becomes a UsdRenderVar under the vars location, named and
+written to the image under Blender's own name (DiffDir, GlossInd, IndexOB...),
+sourcing the Cycles pass of that name, which the delegate resolves
+(hydra/session.cpp). The vars are appended to the render products: the ones
+the node names, or those of the stage's render settings.
+
+The node body is `import cycles_aovs; cycles_aovs.run(hou.pwd())`; the
+parameters live on the digital asset around it (tools/build_aovs_hda.py).
+"""
+
+import hou
+from pxr import Sdf, Tf, UsdRender
+
+# (parameter, EXR name, Cycles pass, data type, format)
+DATA = [
+    ("z", "Depth", "depth", "float", "float"),
+    ("mist", "Mist", "mist", "float", "float"),
+    ("position", "Position", "position", "point3f", "point3f"),
+    ("normal", "Normal", "normal", "normal3f", "normal3f"),
+    ("vector", "Vector", "motion", "float4", "float4"),
+    ("uv", "UV", "uv", "float3", "float3"),
+    ("roughness", "Roughness", "roughness", "float", "float"),
+    ("objectindex", "IndexOB", "object_id", "float", "float"),
+    ("materialindex", "IndexMA", "material_id", "float", "float"),
+    ("samplecount", "Debug Sample Count", "sample_count", "float", "float"),
+]
+DENOISING = [
+    ("Denoising Albedo", "denoising_albedo", "color3f", "color3h"),
+    ("Denoising Normal", "denoising_normal", "normal3f", "normal3f"),
+]
+LIGHT = [
+    ("diffusedirect", "DiffDir", "diffuse_direct"),
+    ("diffuseindirect", "DiffInd", "diffuse_indirect"),
+    ("diffusecolor", "DiffCol", "diffuse_color"),
+    ("glossydirect", "GlossDir", "glossy_direct"),
+    ("glossyindirect", "GlossInd", "glossy_indirect"),
+    ("glossycolor", "GlossCol", "glossy_color"),
+    ("transmissiondirect", "TransDir", "transmission_direct"),
+    ("transmissionindirect", "TransInd", "transmission_indirect"),
+    ("transmissioncolor", "TransCol", "transmission_color"),
+    ("volumedirect", "VolumeDir", "volume_direct"),
+    ("volumeindirect", "VolumeInd", "volume_indirect"),
+    ("emission", "Emit", "emission"),
+    ("environment", "Env", "background"),
+    ("ao", "AO", "ao"),
+    ("shadowcatcher", "Shadow Catcher", "shadow_catcher"),
+]
+CRYPTOMATTE = [
+    ("cryptoobject", "CryptoObject"),
+    ("cryptomaterial", "CryptoMaterial"),
+    ("cryptoasset", "CryptoAsset"),
+]
+
+
+def _prim_name(name):
+    return Tf.MakeValidIdentifier(name.replace(" ", ""))
+
+
+def _define_var(stage, location, aov_name, source_name, data_type, aov_format):
+    path = Sdf.Path(location).AppendChild(_prim_name(aov_name))
+    var = UsdRender.Var.Define(stage, path)
+    var.CreateSourceNameAttr(source_name)
+    var.CreateSourceTypeAttr(UsdRender.Tokens.raw)
+    var.CreateDataTypeAttr(data_type)
+    prim = var.GetPrim()
+    prim.CreateAttribute("driver:parameters:aov:name", Sdf.ValueTypeNames.String).Set(aov_name)
+    prim.CreateAttribute("driver:parameters:aov:format", Sdf.ValueTypeNames.Token).Set(aov_format)
+    return path
+
+
+def requested(node):
+    """(EXR name, source, data type, format) for every pass the node asks for."""
+    out = []
+    for parm, name, source, data_type, aov_format in DATA:
+        if node.evalParm(parm):
+            out.append((name, source, data_type, aov_format))
+    if node.evalParm("denoisingdata"):
+        out.extend(DENOISING)
+    for parm, name, source in LIGHT:
+        if node.evalParm(parm):
+            out.append((name, source, "color3f", "color3h"))
+
+    # Two ranks per layer: Levels 6 is three layers, as in Blender.
+    layers = max(1, (node.evalParm("cryptolevels") + 1) // 2)
+    for parm, prefix in CRYPTOMATTE:
+        if node.evalParm(parm):
+            for i in range(layers):
+                name = "%s%02d" % (prefix, i)
+                out.append((name, name, "color4f", "color4f"))
+
+    for i in range(1, node.evalParm("lightgroups") + 1):
+        group = node.evalParm("lightgroup%d" % i).strip()
+        if group:
+            out.append(("Combined_" + group, "lightgroup:" + group, "color3f", "color3h"))
+
+    for i in range(1, node.evalParm("shaderaovs") + 1):
+        name = node.evalParm("shaderaov%d" % i).strip()
+        if not name:
+            continue
+        if node.parm("shaderaovtype%d" % i).evalAsString() == "value":
+            out.append((name, name, "float", "float"))
+        else:
+            out.append((name, name, "color3f", "color3h"))
+    return out
+
+
+def _target_products(stage, node):
+    paths = node.evalParm("products").split()
+    if paths:
+        return [Sdf.Path(p) for p in paths]
+    settings_path = stage.GetMetadata("renderSettingsPrimPath")
+    settings = UsdRender.Settings(stage.GetPrimAtPath(settings_path)) if settings_path else None
+    if not settings:
+        for prim in stage.Traverse():
+            if prim.IsA(UsdRender.Settings):
+                settings = UsdRender.Settings(prim)
+                break
+    if not settings:
+        return []
+    return settings.GetProductsRel().GetForwardedTargets()
+
+
+def run(node):
+    """Author the render vars on the stage of `node`, a Python LOP inside the
+    asset, from the asset's parameters."""
+    asset = node.parent()
+    stage = node.editableStage()
+    aovs = requested(asset)
+    if not aovs:
+        return
+
+    products = _target_products(stage, asset)
+    if not products:
+        raise hou.NodeError(
+            "No render product to add the AOVs to: name one in Render Products, or put a "
+            "Render Settings with a product above this node.")
+    # Next to the product by default: /Render may be deactivated (Karma's settings, set aside
+    # for Cycles), and nothing can be defined under an inactive prim.
+    location = asset.evalParm("location") or str(products[0].GetParentPath().AppendChild("Vars"))
+    var_paths = [_define_var(stage, location, *aov) for aov in aovs]
+
+    for path in products:
+        product = UsdRender.Product(stage.GetPrimAtPath(path))
+        if not product:
+            raise hou.NodeError("%s is not a render product." % path)
+        rel = product.GetOrderedVarsRel()
+        targets = list(rel.GetTargets())
+        rel.SetTargets(targets + [p for p in var_paths if p not in targets])
