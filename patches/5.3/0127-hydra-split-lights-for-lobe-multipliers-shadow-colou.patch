+namespace {
+
+/* Every socket of `from` onto `to`. Node::set_value would do, but it takes an
+ * array over from its source: the light it copied lost its shader. */
+void CopySockets(Node *to, const Node &from)
+{
+  for (const SocketType &socket : from.type->inputs) {
+    switch (socket.type) {
+      case SocketType::BOOLEAN_ARRAY: {
+        array<bool> value = from.get_bool_array(socket);
+        to->set(socket, value);
+        break;
+      }
+      case SocketType::INT_ARRAY: {
+        array<int> value = from.get_int_array(socket);
+        to->set(socket, value);
+        break;
+      }
+      case SocketType::FLOAT_ARRAY: {
+        array<float> value = from.get_float_array(socket);
+        to->set(socket, value);
+        break;
+      }
+      case SocketType::POINT2_ARRAY: {
+        array<float2> value = from.get_float2_array(socket);
+        to->set(socket, value);
+        break;
+      }
+      case SocketType::COLOR_ARRAY:
+      case SocketType::VECTOR_ARRAY:
+      case SocketType::POINT_ARRAY:
+      case SocketType::NORMAL_ARRAY: {
+        array<packed_float3> value = from.get_float3_array(socket);
+        to->set(socket, value);
+        break;
+      }
+      case SocketType::STRING_ARRAY: {
+        array<ustring> value = from.get_string_array(socket);
+        to->set(socket, value);
+        break;
+      }
+      case SocketType::TRANSFORM_ARRAY: {
+        array<Transform> value = from.get_transform_array(socket);
+        to->set(socket, value);
+        break;
+      }
+      case SocketType::NODE_ARRAY: {
+        array<Node *> value = from.get_node_array(socket);
+        to->set(socket, value);
+        break;
+      }
+      default:
+        to->set_value(socket, from, socket);
+        break;
+    }
+  }
+}
+
+}  // namespace
+
+Light *HdCyclesLight::CreateLight(Scene *scene) const
+{
+  if (_lightType == HdPrimTypeTokens->domeLight) {
+    return scene->create_node<BackgroundLight>();
+  }
+  if (_lightType == HdPrimTypeTokens->distantLight) {
+    return scene->create_node<SunLight>();
+  }
+  if (_lightType == HdPrimTypeTokens->diskLight) {
+    AreaLight *const light = scene->create_node<AreaLight>();
+    light->set_ellipse(true);
+    return light;
+  }
+  if (_lightType == HdPrimTypeTokens->rectLight ||
+      _lightType == HdPrimTypeTokens->cylinderLight)
+  {
+    AreaLight *const light = scene->create_node<AreaLight>();
+    light->set_ellipse(false);
+    return light;
+  }
+  /* A sphere light: we can't know in advance if this is spot light or point
+   * light, so we set to derived class SpotLight and change the type later. */
+  return scene->create_node<SpotLight>();
+}
+
+/* Cycles scales a light as a whole, but can keep a lobe from seeing it and a
+ * light from casting shadows. So a light whose diffuse and specular
+ * multipliers differ, or that has a shadow colour, becomes several: one per
+ * lobe group at that lobe's multiplier, and for a shadow colour c each of
+ * those twice - with shadows at 1 - c, without at c, so lit areas get the
+ * whole light and shadowed ones c of it. The camera, when it sees the light,
+ * sees one copy at full strength. The primary light is the first part; twins
+ * copy every socket of it and of its object. A dome is the scene's
+ * background, of which Cycles has one: it keeps the 0-or-1 lobe switch. */
+void HdCyclesLight::SyncSplit(Scene *scene, HdRenderParam *renderParam)
+{
+  struct Part {
+    uint visibility;
+    float3 factor;
+    bool shadow;
+    /* Whether BSDF rays can hit it (MIS); else light sampling alone reaches it. */
+    bool mis;
+  };
+  const uint diffuseLobes = PATH_RAY_VISIBILITY_DIFFUSE | PATH_RAY_VISIBILITY_VOLUME_SCATTER;
+  const uint specularLobes = PATH_RAY_VISIBILITY_GLOSSY | PATH_RAY_VISIBILITY_TRANSMIT;
+  const uint lobes = diffuseLobes | specularLobes;
+  const uint other = _baseVisibility & ~(lobes | PATH_RAY_VISIBILITY_CAMERA);
+  const bool dome = _lightType == HdPrimTypeTokens->domeLight;
+
+  std::vector<std::pair<uint, float>> lobeGroups;
+  if (_diffuse == _specular) {
+    lobeGroups.emplace_back(lobes, _diffuse);
+  }
+  else {
+    lobeGroups.emplace_back(diffuseLobes, _diffuse);
+    lobeGroups.emplace_back(specularLobes, _specular);
+  }
+  const bool shadowColored = _castShadow && !is_zero(_shadowColor) && !dome;
+
+  std::vector<Part> parts;
+  for (const auto &[visibility, multiplier] : lobeGroups) {
+    if (multiplier == 0.0f) {
+      continue;
+    }
+    if (shadowColored) {
+      parts.push_back({visibility, multiplier * (one_float3() - _shadowColor), true, false});
+      parts.push_back({visibility, multiplier * _shadowColor, false, false});
+    }
+    else {
+      parts.push_back({visibility, make_float3(multiplier), _castShadow, false});
+    }
+  }
+
+  if (dome) {
+    /* One background: the lobes it reaches, at full strength. */
+    uint visibility = _baseVisibility & ~lobes;
+    for (const Part &part : parts) {
+      visibility |= _baseVisibility & part.visibility;
+    }
+    for (const float value : {_diffuse, _specular}) {
+      if (value != 0.0f && value != 1.0f) {
+        LOG_WARNING << "Light " << GetId().GetString() << ": multiplier " << value
+                    << " on a dome is rendered as 1; Cycles can only turn a lobe off there.";
+      }
+    }
+    parts = {{visibility, one_float3(), _castShadow, true}};
+  }
+  else {
+    /* BSDF rays stop at the first light they hit, whatever lobes it serves,
+     * so of parts lying on top of each other one alone can be hit: the first
+     * with shadows. A part without shadows cannot be at all - a BSDF ray
+     * meeting an occluder on its way would take its share of the MIS weight
+     * along: it is why shadow:enable = 0 left shadows half dark. */
+    bool hittable = false;
+    for (Part &part : parts) {
+      part.visibility = (part.visibility & _baseVisibility) | other;
+      part.mis = part.shadow && !hittable;
+      hittable |= part.mis;
+    }
+    const bool camera = (_baseVisibility & PATH_RAY_VISIBILITY_CAMERA) != 0;
+    if (parts.size() == 1 && parts[0].factor == one_float3() && parts[0].mis) {
+      parts[0].visibility |= camera ? PATH_RAY_VISIBILITY_CAMERA : 0u;
+    }
+    else if (camera || parts.empty()) {
+      /* Seen by the camera at full strength, or reaching nothing at all. */
+      parts.push_back(
+          {camera ? uint(PATH_RAY_VISIBILITY_CAMERA) : 0u, one_float3(), false, false});
+    }
+  }
+
+  DeleteTwins(scene, renderParam, parts.size() - 1);
+  while (_twins.size() < parts.size() - 1) {
+    Object *const object = scene->create_node<Object>();
+    Light *const light = CreateLight(scene);
+    object->name = _object->name;
+    light->name = _light->name;
+    _twins.emplace_back(object, light);
+  }
+
+  _light->set_strength(_strength * parts[0].factor);
+  _light->set_cast_shadow(parts[0].shadow);
+  _light->set_use_mis(parts[0].mis);
+  _object->set_visibility(parts[0].visibility);
+
+  auto *const session = static_cast<HdCyclesSession *>(renderParam);
+  for (size_t i = 0; i < _twins.size(); ++i) {
+    auto [object, light] = _twins[i];
+    CopySockets(light, *_light);
+    CopySockets(object, *_object);
+    object->set_geometry(light);
+    object->set_random_id(hash_uint2(hash_string(_light->name.c_str()), uint(i + 1)));
+    light->set_strength(_strength * parts[i + 1].factor);
+    light->set_cast_shadow(parts[i + 1].shadow);
+    light->set_use_mis(parts[i + 1].mis);
+    object->set_visibility(parts[i + 1].visibility);
+    session->SetLightLinks(object, _lightLink, _shadowLink);
+    if (light->is_modified()) {
+      light->tag_update(scene);
+    }
+    object->tag_update(scene);
+  }
+}
+
+void HdCyclesLight::DeleteTwins(Scene *scene, HdRenderParam *renderParam, const size_t keep)
+{
+  auto *const session = static_cast<HdCyclesSession *>(renderParam);
+  while (_twins.size() > keep) {
+    auto [object, light] = _twins.back();
+    _twins.pop_back();
+    session->ForgetObject(object);
+    if (!session->keep_nodes) {
+      scene->delete_node(object);
+      scene->delete_node(light);
+    }
+  }
+}
+
 HDCYCLES_NAMESPACE_CLOSE_SCOPE
