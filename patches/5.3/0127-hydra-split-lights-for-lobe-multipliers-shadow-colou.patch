+  float _diffuse = 1.0f;
+  float _specular = 1.0f;
+  CCL_NS::float3 _shadowColor = CCL_NS::make_float3(0.0f, 0.0f, 0.0f);
+  bool _castShadow = true;
+  PXR_NS::TfToken _lightLink;
+  PXR_NS::TfToken _shadowLink;
 };
 
