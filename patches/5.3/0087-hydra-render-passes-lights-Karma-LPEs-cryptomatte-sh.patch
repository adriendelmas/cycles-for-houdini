@@ -42,8 +51,181 @@ const std::unordered_map<TfToken, PassType, TfToken::HashFunctor> kAovToPass = {
     {TfToken("N"), PASS_NORMAL},
     {TfToken("P"), PASS_POSITION},
     {TfToken("Pz"), PASS_DEPTH},
+
+    /* Karma's and Mantra's names for the light path components, so a Karma
+     * render settings node's extra render vars land on their Cycles pass.
+     * Cycles' own names (`diffuse_direct`, `ao`, `mist`...) work as they are. */
+    {TfToken("Ce"), PASS_EMISSION},
+    {TfToken("albedo"), PASS_DENOISING_ALBEDO},
+    {TfToken("direct_volume"), PASS_VOLUME_DIRECT},
+    {TfToken("indirect_volume"), PASS_VOLUME_INDIRECT},
+    {TfToken("direct_emission"), PASS_EMISSION},
+    {TfToken("occlusion"), PASS_AO},
+    {TfToken("motionvector"), PASS_MOTION},
+};
+
+/* A Cycles light pass and the colour pass that turns it into what Karma
+ * writes. Cycles stores light already multiplied by the surface colour and
+ * divides it back out when the pass is read - Blender's "Diffuse Light" -
+ * while Karma's components, and its light path expressions, keep the
+ * colour: a diffuse sphere read 0.94 where Karma reads 0.75. Karma names are
+ * multiplied back; Cycles' own names keep Cycles' convention. */
+struct LightPass {
+  PassType type;
+  PassType color;
+};
+
+const std::unordered_map<std::string, LightPass> kKarmaComponents = {
+    {"direct_diffuse", {PASS_DIFFUSE_DIRECT, PASS_DIFFUSE_COLOR}},
+    {"indirect_diffuse", {PASS_DIFFUSE_INDIRECT, PASS_DIFFUSE_COLOR}},
+    {"direct_reflect", {PASS_GLOSSY_DIRECT, PASS_GLOSSY_COLOR}},
+    {"indirect_reflect", {PASS_GLOSSY_INDIRECT, PASS_GLOSSY_COLOR}},
+    {"direct_glossy", {PASS_GLOSSY_DIRECT, PASS_GLOSSY_COLOR}},
+    {"indirect_glossy", {PASS_GLOSSY_INDIRECT, PASS_GLOSSY_COLOR}},
+    {"direct_refract", {PASS_TRANSMISSION_DIRECT, PASS_TRANSMISSION_COLOR}},
+    {"indirect_refract", {PASS_TRANSMISSION_INDIRECT, PASS_TRANSMISSION_COLOR}},
 };
 
+/* Karma's raw render var sources. */
+const std::unordered_map<std::string, PassType> kRawSourceToPass = {
+    {"ray:hitPz", PASS_DEPTH},
+    {"ray:hitP", PASS_POSITION},
+    {"ray:hitN", PASS_NORMAL},
+    {"ray:hitNg", PASS_NORMAL},
+    {"ray:hituv", PASS_UV},
+};
+
+/* The light path expressions Karma's render settings write for its light
+ * components, and the Cycles pass that holds the same light. Cycles has no
+ * LPE engine: anything else is reported and left black. */
+const std::unordered_map<std::string, LightPass> kLpeToPass = {
+    {"C.*[LO]", {PASS_COMBINED, PASS_NONE}},
+    {"C.*L", {PASS_COMBINED, PASS_NONE}},
+    {"C<RD>.*L", {PASS_DIFFUSE, PASS_DIFFUSE_COLOR}},
+    {"C<RD>L", {PASS_DIFFUSE_DIRECT, PASS_DIFFUSE_COLOR}},
+    {"C<RD>.+L", {PASS_DIFFUSE_INDIRECT, PASS_DIFFUSE_COLOR}},
+    {"C<RG>.*L", {PASS_GLOSSY, PASS_GLOSSY_COLOR}},
+    {"C<RG>L", {PASS_GLOSSY_DIRECT, PASS_GLOSSY_COLOR}},
+    {"C<RG>.+L", {PASS_GLOSSY_INDIRECT, PASS_GLOSSY_COLOR}},
+    {"C<T.>.*L", {PASS_TRANSMISSION, PASS_TRANSMISSION_COLOR}},
+    {"C<TD>.*L", {PASS_TRANSMISSION, PASS_TRANSMISSION_COLOR}},
+    {"C<TG>.*L", {PASS_TRANSMISSION, PASS_TRANSMISSION_COLOR}},
+    {"C<TS>.*L", {PASS_TRANSMISSION, PASS_TRANSMISSION_COLOR}},
+    {"C<T.>L", {PASS_TRANSMISSION_DIRECT, PASS_TRANSMISSION_COLOR}},
+    {"C<T.>.+L", {PASS_TRANSMISSION_INDIRECT, PASS_TRANSMISSION_COLOR}},
+    {"CV.*L", {PASS_VOLUME, PASS_NONE}},
+    {"CVL", {PASS_VOLUME_DIRECT, PASS_NONE}},
+    {"CV.+L", {PASS_VOLUME_INDIRECT, PASS_NONE}},
+    {"CO", {PASS_EMISSION, PASS_NONE}},
+    {"C[LO]", {PASS_EMISSION, PASS_NONE}},
+};
+
+std::string SettingString(const HdAovSettingsMap &settings, const char *key)
+{
+  const auto it = settings.find(TfToken(key));
+  if (it == settings.end()) {
+    return {};
+  }
+  if (it->second.IsHolding<std::string>()) {
+    return it->second.UncheckedGet<std::string>();
+  }
+  if (it->second.IsHolding<TfToken>()) {
+    return it->second.UncheckedGet<TfToken>().GetString();
+  }
+  return {};
+}
+
+PassType CyclesPassNamed(const std::string &name)
+{
+  const auto alias = kAovToPass.find(TfToken(name));
+  if (alias != kAovToPass.end()) {
+    return alias->second;
+  }
+  const NodeEnum *types = Pass::get_type_enum();
+  if (types->exists(ustring(name))) {
+    return PassType((*types)[ustring(name)]);
+  }
+  return PASS_NONE;
+}
+
+/* Which Cycles pass a render var asks for, and under which name: the
+ * AOV's own name first (`C`, `N`, `diffuse_direct`), then what the var
+ * sources - a raw Cycles or Karma name, one of Karma's light path
+ * expressions, the `st` primvar. Anything else is a shader AOV named after
+ * its source, which `aov_output` nodes of that name write. */
+PassType ResolvePass(const HdRenderPassAovBinding &binding,
+                     std::string &passName,
+                     PassType &colorType)
+{
+  const std::string &name = binding.aovName.GetString();
+  passName = name;
+  colorType = PASS_NONE;
+  if (const PassType type = CyclesPassNamed(name)) {
+    return type;
+  }
+  const auto karma = kKarmaComponents.find(name);
+  if (karma != kKarmaComponents.end()) {
+    colorType = karma->second.color;
+    return karma->second.type;
+  }
+
+  const std::string sourceType = SettingString(binding.aovSettings, "sourceType");
+  const std::string sourceName = SettingString(binding.aovSettings, "sourceName");
+  if (sourceType == "lpe") {
+    const auto it = kLpeToPass.find(sourceName);
+    if (it != kLpeToPass.end()) {
+      colorType = it->second.color;
+      return it->second.type;
+    }
+    LOG_WARNING << "Render var '" << name << "': Cycles has no light path expressions and no "
+                << "pass matching '" << sourceName << "'; it stays black.";
+    return PASS_AOV_COLOR;
+  }
+  if (sourceType == "primvar") {
+    if (sourceName == "st" || sourceName == "uv") {
+      return PASS_UV;
+    }
+  }
+  if (!sourceName.empty()) {
+    const auto raw = kRawSourceToPass.find(sourceName);
+    if (raw != kRawSourceToPass.end()) {
+      return raw->second;
+    }
+    if (const PassType type = CyclesPassNamed(sourceName)) {
+      return type;
+    }
+  }
+
+  const bool value = binding.renderBuffer &&
+                     HdGetComponentCount(binding.renderBuffer->GetFormat()) == 1;
+  if (!sourceName.empty()) {
+    passName = sourceName;
+  }
+  LOG_INFO << "Render var '" << name << "' is not a Cycles pass; rendering it as the shader "
+           << (value ? "value" : "colour") << " AOV '" << passName << "'.";
+  return value ? PASS_AOV_VALUE : PASS_AOV_COLOR;
+}
+
+/* Cryptomatte layers are float4 passes named `Crypto<Kind><NN>`, two ranks
+ * each. Returns the kind and the layer index, or CRYPT_NONE. */
+CryptomatteType CryptomatteLayer(const std::string &name, int &index)
+{
+  static const std::pair<const char *, CryptomatteType> kinds[] = {
+      {"CryptoObject", CRYPT_OBJECT},
+      {"CryptoMaterial", CRYPT_MATERIAL},
+      {"CryptoAsset", CRYPT_ASSET}};
+  for (const auto &[prefix, kind] : kinds) {
+    const size_t len = strlen(prefix);
+    if (name.size() == len + 2 && name.compare(0, len, prefix) == 0 && isdigit(name[len]) &&
+        isdigit(name[len + 1]))
+    {
+      index = (name[len] - '0') * 10 + (name[len + 1] - '0');
+      return kind;
+    }
+  }
+  return CRYPT_NONE;
+}
+
