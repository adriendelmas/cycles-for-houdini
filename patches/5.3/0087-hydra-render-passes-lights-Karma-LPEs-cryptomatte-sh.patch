+void HdCyclesOutputDriver::MultiplyByColor(const Tile &tile,
+                                           const TfToken &aovName,
+                                           const size_t channels,
+                                           float *pixels) const
+{
+  const std::string *colorPass = _renderParam->ColorPassName(aovName);
+  if (!colorPass || channels < 3) {
+    return;
+  }
+  const size_t count = size_t(tile.size.x) * size_t(tile.size.y);
+  std::vector<float> color(count * 3);
+  if (!tile.get_pass_pixels(*colorPass, 3, color.data())) {
+    return;
+  }
+  for (size_t i = 0; i < count; ++i) {
+    for (size_t c = 0; c < 3; ++c) {
+      pixels[i * channels + c] *= color[i * 3 + c];
+    }
+  }
+}
