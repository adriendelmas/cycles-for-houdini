+  /* The kernel writes every layer of every enabled kind, objects first, then
+   * materials, then assets: create them all, in that order, whichever the
+   * render vars asked for. */
+  for (const auto &[kind, prefix] : {std::make_pair(CRYPT_OBJECT, "CryptoObject"),
+                                     std::make_pair(CRYPT_MATERIAL, "CryptoMaterial"),
+                                     std::make_pair(CRYPT_ASSET, "CryptoAsset")})
+  {
+    if (!(cryptoKinds & kind)) {
+      continue;
+    }
+    for (int i = 0; i < cryptoLayers; ++i) {
+      Pass *pass = scene->create_node<Pass>();
+      pass->set_type(PASS_CRYPTOMATTE);
+      pass->set_mode(PassMode::NOISY);
+      pass->set_name(ustring(string_printf("%s%02d", prefix, i)));
+    }
   }
+  scene->film->set_cryptomatte_passes(CryptomatteType(cryptoKinds));
+  scene->film->set_cryptomatte_depth(cryptoLayers);
 }
 
