@@ -57,6 +57,46 @@ static std::optional<float> convertToCyclesScalar(const VtValue &value)
   return std::nullopt;
 }
 
+/* A single number, from whatever shape the value arrives in.
+ *
+ * USD defines no cast from a GfVec3f to a float, so a colour landing on a
+ * scalar socket used to fall through to the warning at the bottom of the
+ * generic conversion and come back as zero. MaterialX's `opacity` is a colour
+ * and the Cycles `alpha` it maps to is a single number: every material that
+ * wrote an opacity - white included, which is what Houdini's material builders
+ * author by default - was turned fully transparent. Averaging the components
+ * is what a greyscale opacity means, and matches for the uniform values that
+ * make up nearly all of them. */
+template<> float convertToCycles<float>(const VtValue &value)
+{
+  if (value.IsHolding<float>()) {
+    return value.UncheckedGet<float>();
+  }
+  if (const std::optional<float> scalar = convertToCyclesScalar(value)) {
+    return *scalar;
+  }
+  if (value.IsHolding<GfVec3f>()) {
+    const GfVec3f v = value.UncheckedGet<GfVec3f>();
+    return (v[0] + v[1] + v[2]) / 3.0f;
+  }
+  if (value.IsHolding<GfVec4f>()) {
+    const GfVec4f v = value.UncheckedGet<GfVec4f>();
+    return (v[0] + v[1] + v[2]) / 3.0f;
+  }
+  if (value.IsHolding<GfVec2f>()) {
+    const GfVec2f v = value.UncheckedGet<GfVec2f>();
+    return (v[0] + v[1]) / 2.0f;
+  }
+
+  const VtValue castedValue = VtValue::Cast<float>(value);
+  if (castedValue.IsHolding<float>()) {
+    return castedValue.UncheckedGet<float>();
+  }
+
+  TF_WARN("Could not convert VtValue to float");
+  return 0.0f;
+}
