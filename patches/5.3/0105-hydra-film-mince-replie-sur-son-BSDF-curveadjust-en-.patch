@@ -933,7 +1064,7 @@ HdMaterialNetworkSchema ExpandMaterialXNodegraphs(HdMaterialNetworkSchema networ
     for (const TfToken &name : nodes.GetNames()) {
       if (auto ds = nodes.Get(name).GetNodeIdentifier()) {
         const std::string id = ds->GetTypedValue(0.0f).GetString();
-        if (id.rfind("ND_", 0) == 0 && !translatable(id)) {
+        if ((id.rfind("ND_", 0) == 0 && !translatable(id)) || id == "ND_separate4_color4") {
           candidate = true;
           break;
         }
@@ -947,6 +1078,8 @@ HdMaterialNetworkSchema ExpandMaterialXNodegraphs(HdMaterialNetworkSchema networ
   const mx::DocumentPtr library = Library();
   Network net = Read(network);
 
+  net.changed |= FoldThinFilm(net);
+
   /* Expanded nodes bring in nodes that may expand in turn. */
   for (int pass = 0; pass < 8; ++pass) {
     bool any = false;
@@ -990,6 +1123,7 @@ HdMaterialNetworkSchema ExpandMaterialXNodegraphs(HdMaterialNetworkSchema networ
       break;
     }
   }
+  net.changed |= RouteImageAlpha(net);
 
   return net.changed ? Write(net) : network;
 }
