+      {"ND_cellnoise3d_float", &kMxCell3dF},
+      {"ND_cellnoise3d", &kMxCell3dC},
+      {"ND_worleynoise2d_float", &kMxWorley2dF},
+      {"ND_worleynoise2d", &kMxWorley2dC},
+      {"ND_worleynoise3d_float", &kMxWorley3dF},
+      {"ND_worleynoise3d", &kMxWorley3dC},
+      {"ND_unifiednoise2d_float", &kMxUnified2dF},
+      {"ND_unifiednoise2d", &kMxUnified2dC},
+      {"ND_unifiednoise3d_float", &kMxUnified3dF},
+      {"ND_unifiednoise3d", &kMxUnified3dC},
       {"ND_flake", &kVoronoi},
