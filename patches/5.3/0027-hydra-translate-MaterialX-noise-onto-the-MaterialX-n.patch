+/* A mapping states its fixed values as text, which suits the enum sockets that
+ * pick a node's mode. A few sockets are plain integers - a noise variant, a
+ * dimension count - and want a number rather than a name. */
+VtValue FixedValue(const SocketType &socket, const char *const text)
+{
+  if (socket.type == SocketType::INT || socket.type == SocketType::UINT) {
+    return VtValue(int(strtol(text, nullptr, 10)));
+  }
+  return VtValue(std::string(text));
+}
+
 /* A Cycles node whose useful output depends on what it feeds: texture nodes
  * carry both a scalar `fac` and a `color`, while MaterialX exposes a single
  * `out`. */
@@ -750,6 +762,79 @@ const std::vector<MtlxEntry> &MtlxTable()
    * the diagonal type as the nearest available - documented as approximate. */
   static const UsdToCyclesMapping kRampTB = makeRamp("diagonal");
 
+  /* MaterialX procedural noise, on the Cycles node that implements the
+   * MaterialX algorithms exactly - same hashes, same normalisation, same
+   * parameter semantics. One node covers every variant, told apart by its
+   * dimension count and noise type; the full parameter map is shared because a
+   * nodedef only ever supplies the inputs it declares. */
+  /* MaterialX procedural noise, on the Cycles node that implements the
+   * MaterialX algorithms exactly - same hashes, same normalisation, same
+   * parameter semantics. One node covers every variant, told apart by its
+   * dimension count and noise type.
+   *
+   * The node evaluates once and offers the result as a float and as a colour,
+   * and which one a MaterialX graph means is decided by the nodedef variant it
+   * used: `ND_fractal3d_float` is a scalar that broadcasts across the
+   * channels, `ND_fractal3d_color3` is three different noises. Reading that
+   * from what the output feeds instead would turn every greyscale noise driving
+   * a colour into a coloured one. Hence the paired table entries below, the
+   * `_float` one winning on length. (The node's vector output carries the same
+   * value as its colour output, so it needs no separate case.)
+   *
+   * The parameter map is shared across the families because a nodedef only ever
+   * supplies the inputs it declares. */
+  auto makeMxNoise = [](const char *const dimensions,
+                        const char *const noiseType,
+                        const char *const out) {
+    UsdToCyclesMapping m{"mx_noise_texture",
+                         {
+                             {TfToken("position"), ustring("vector")},
+                             {TfToken("texcoord"), ustring("vector")},
+                             {TfToken("amplitude"), ustring("amplitude")},
+                             {TfToken("pivot"), ustring("pivot")},
+                             {TfToken("octaves"), ustring("octaves")},
+                             {TfToken("lacunarity"), ustring("lacunarity")},
+                             {TfToken("diminish"), ustring("diminish")},
+                             {TfToken("jitter"), ustring("jitter")},
+                             {TfToken("freq"), ustring("freq")},
+                             {TfToken("offset"), ustring("offset")},
+                             {TfToken("outmin"), ustring("out_min")},
+                             {TfToken("outmax"), ustring("out_max")},
+                             {TfToken("clampoutput"), ustring("clamp_output")},
+                             {TfToken("type"), ustring("unified_type")},
+                             {CyclesMaterialTokens->out, ustring(out)},
+                         }};
+    m.setFixedValues({{ustring("dimensions"), dimensions},
+                      {ustring("noise_type"), noiseType}});
+    return m;
+  };
+  /* Values of the node's noise_type socket, see NodeMxNoiseType. */
+  static const char *const kPerlin = "0";
+  static const char *const kFractal = "1";
+  static const char *const kCell = "2";
+  static const char *const kWorley = "3";
+  static const char *const kUnified = "4";
+  static const UsdToCyclesMapping kMxNoise2dF = makeMxNoise("2", kPerlin, "value");
+  static const UsdToCyclesMapping kMxNoise2dC = makeMxNoise("2", kPerlin, "color");
+  static const UsdToCyclesMapping kMxNoise3dF = makeMxNoise("3", kPerlin, "value");
+  static const UsdToCyclesMapping kMxNoise3dC = makeMxNoise("3", kPerlin, "color");
+  static const UsdToCyclesMapping kMxFractal2dF = makeMxNoise("2", kFractal, "value");
+  static const UsdToCyclesMapping kMxFractal2dC = makeMxNoise("2", kFractal, "color");
+  static const UsdToCyclesMapping kMxFractal3dF = makeMxNoise("3", kFractal, "value");
+  static const UsdToCyclesMapping kMxFractal3dC = makeMxNoise("3", kFractal, "color");
+  static const UsdToCyclesMapping kMxCell2dF = makeMxNoise("2", kCell, "value");
+  static const UsdToCyclesMapping kMxCell2dC = makeMxNoise("2", kCell, "color");
+  static const UsdToCyclesMapping kMxCell3dF = makeMxNoise("3", kCell, "value");
+  static const UsdToCyclesMapping kMxCell3dC = makeMxNoise("3", kCell, "color");
+  static const UsdToCyclesMapping kMxWorley2dF = makeMxNoise("2", kWorley, "value");
+  static const UsdToCyclesMapping kMxWorley2dC = makeMxNoise("2", kWorley, "color");
+  static const UsdToCyclesMapping kMxWorley3dF = makeMxNoise("3", kWorley, "value");
+  static const UsdToCyclesMapping kMxWorley3dC = makeMxNoise("3", kWorley, "color");
+  static const UsdToCyclesMapping kMxUnified2dF = makeMxNoise("2", kUnified, "value");
+  static const UsdToCyclesMapping kMxUnified2dC = makeMxNoise("2", kUnified, "color");
+  static const UsdToCyclesMapping kMxUnified3dF = makeMxNoise("3", kUnified, "value");
+  static const UsdToCyclesMapping kMxUnified3dC = makeMxNoise("3", kUnified, "color");
+
   /* Longest prefix wins, so the specific entries come before their family. */
   static const std::vector<MtlxEntry> table = {
       /* Surfaces and terminals. */
@@ -770,13 +855,26 @@ const std::vector<MtlxEntry> &MtlxTable()
       {"ND_texcoord_", &MtlxTexCoord},
 
       /* Procedurals. */
-      {"ND_noise3d_", &MtlxNoise},
-      {"ND_noise2d_", &MtlxNoise},
-      {"ND_fractal3d_", &MtlxNoise},
-      {"ND_fractal2d_", &MtlxNoise},
-      {"ND_unifiednoise", &MtlxNoise},
-      {"ND_worleynoise", &kVoronoi},
-      {"ND_cellnoise", &kVoronoi},
+      {"ND_noise2d_float", &kMxNoise2dF},
+      {"ND_noise2d_", &kMxNoise2dC},
+      {"ND_noise3d_float", &kMxNoise3dF},
+      {"ND_noise3d_", &kMxNoise3dC},
+      {"ND_fractal2d_float", &kMxFractal2dF},
+      {"ND_fractal2d_", &kMxFractal2dC},
+      {"ND_fractal3d_float", &kMxFractal3dF},
