       {"ND_randomfloat", &kWhiteNoise},
@@ -1299,7 +1397,7 @@ unique_ptr<ShaderGraph> HdCyclesMaterial::BuildShaderGraph(HdMaterialNetworkSche
         if (nodeDesc.mapping) {
           for (const auto &fixed : nodeDesc.mapping->fixedValues()) {
             if (const SocketType *socket = nodeType->find_input(fixed.first)) {
-              SetNodeValue(nodeDesc.node, *socket, VtValue(std::string(fixed.second)));
+              SetNodeValue(nodeDesc.node, *socket, FixedValue(*socket, fixed.second));
             }
           }
 
@@ -1310,7 +1408,7 @@ unique_ptr<ShaderGraph> HdCyclesMaterial::BuildShaderGraph(HdMaterialNetworkSche
               ShaderNode *const helperNode = graph->create_node(helperType);
               for (const auto &fixed : helper.fixedValues) {
                 if (const SocketType *socket = helperType->find_input(fixed.first)) {
-                  SetNodeValue(helperNode, *socket, VtValue(std::string(fixed.second)));
+                  SetNodeValue(helperNode, *socket, FixedValue(*socket, fixed.second));
                 }
               }
 
@@ -1441,6 +1539,16 @@ unique_ptr<ShaderGraph> HdCyclesMaterial::BuildShaderGraph(HdMaterialNetworkSche
     return nullptr;
   }
 
+  /* Cycles can draw the graph it ended up with, which is the only way to see
+   * what a translated network really became - which node types were created
+   * and what stayed connected. Off unless asked for: one file per material,
+   * named after its path, in the directory the variable names. */
+  if (const char *const dumpDir = getenv("HD_CYCLES_DUMP_GRAPH")) {
+    std::string name = GetId().GetString();
+    std::replace(name.begin(), name.end(), '/', '_');
+    graph->dump_graph((std::string(dumpDir) + name + ".dot").c_str());
+  }
+
   /* Retenu pour Sync, qui pose la methode une fois le Shader cree : le graphe
    * se construit desormais avant lui. */
   _hasDisplacement = hasDisplacement;
