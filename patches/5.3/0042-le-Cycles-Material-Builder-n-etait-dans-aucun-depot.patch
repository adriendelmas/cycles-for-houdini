+++ b/src/hydra/CMakeLists.txt
@@ -242,6 +242,13 @@ if(WITH_CYCLES_HYDRA_RENDER_DELEGATE)
     # module it calls. Houdini picks both up from the package's HOUDINI_PATH.
     delayed_install("${CMAKE_CURRENT_SOURCE_DIR}/resources/otls" "hdcycles_flatten_op_textures.hda" "${CYCLES_INSTALL_PATH}/houdini/otls")
     delayed_install("${CMAKE_CURRENT_SOURCE_DIR}/resources" "flatten_op_textures.py" "${CYCLES_INSTALL_PATH}/houdini/python${HOUDINI_PYTHON_VERSION}libs")
+    # Le Cycles Material Builder. Un builder n'est pas un type de noeud mais un
+    # subnet configure, monte par un outil du menu tab: il faut donc le module
+    # qui le monte et l'etagere qui l'appelle. Sans eux, la categorie Cycles
+    # n'apparait pas dans le menu tab et la bibliotheque de VOP reste
+    # inutilisable.
+    delayed_install("${CMAKE_CURRENT_SOURCE_DIR}/resources" "cycles_builder.py" "${CYCLES_INSTALL_PATH}/houdini/scripts/python")
+    delayed_install("${CMAKE_CURRENT_SOURCE_DIR}/resources" "CyclesTools.shelf" "${CYCLES_INSTALL_PATH}/houdini/toolbar")
   else()
     delayed_install("${CMAKE_CURRENT_BINARY_DIR}/resources" "plugInfo.json" "${CYCLES_HYDRA_INSTALL_PATH}/${HdCyclesPluginName}/resources")
   endif()
