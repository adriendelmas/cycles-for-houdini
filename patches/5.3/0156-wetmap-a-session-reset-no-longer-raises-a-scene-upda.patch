From a236ad76d967ff34b3e2f72c71f60bf7ae4b07a4 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Mon, 26 Oct 2026 09:28:11 +0100
Subject: [PATCH 156/160] wetmap: a session reset no longer raises a scene
 update (S2 fix)

Wet map (addition). WetStateManager::tag_reset, called from Session::reset,
raised need_update_, so Scene::need_data_update() - and need_reset(), which
the delegate's render pass reads on every execution - stayed true until the
render thread's device_update ran. On a scene whose update takes seconds
(442 000 instances) every Hydra redraw restarted the session and cancelled
the update in progress; the GPU viewport died with 'illegal address in
CUDA' (gauge.hipnc, 2026-10-26). The accumulators are now zeroed on the
session thread when the delayed reset is applied (Session::update_scene,
zero_device), with no scene update of their own; device_free also clears
the kernel's slot count. bench_wet.py on CPU: 15/15, unchanged.
---
 src/scene/wet_state.cpp | 14 +++++++++++++-
 src/scene/wet_state.h   |  7 ++++++-
 src/session/session.cpp |  6 ++++++
 3 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/src/scene/wet_state.cpp b/src/scene/wet_state.cpp
index 54c400f1..cea057b8 100644
--- a/src/scene/wet_state.cpp
+++ b/src/scene/wet_state.cpp
@@ -109,6 +109,7 @@ void WetStateManager::device_free(Device * /*device*/, DeviceScene *dscene)
   dscene->wet_prev.free();
   dscene->wet_accum.free();
   dscene->wet_count.free();
+  dscene->data.integrator.wet_num_objects = 0;
   keys_.clear();
   need_update_ = true;
   reset_pending_ = true;
@@ -118,7 +119,18 @@ void WetStateManager::device_free(Device * /*device*/, DeviceScene *dscene)
 void WetStateManager::tag_reset()
 {
   reset_pending_ = true;
-  need_update_ = true;
+}
+
+void WetStateManager::zero_device(DeviceScene *dscene)
+{
+  if (!reset_pending_) {
+    return;
+  }
+  if (dscene->wet_accum.device_pointer != 0 && dscene->wet_count.device_pointer != 0) {
+    dscene->wet_accum.zero_to_device();
+    dscene->wet_count.zero_to_device();
+    reset_pending_ = false;
+  }
 }
 
 void WetStateManager::read_back(DeviceScene *dscene)
diff --git a/src/scene/wet_state.h b/src/scene/wet_state.h
index c7072177..67ea05dd 100644
--- a/src/scene/wet_state.h
+++ b/src/scene/wet_state.h
@@ -56,8 +56,13 @@ class WetStateManager {
     return need_update_;
   }
 
-  /* A session reset: the accumulators of the render it cuts short are void. */
+  /* A session reset: the accumulators of the render it cuts short are void.
+   * Raises no scene update - that made every render pass restart the
+   * session while a long device update ran - the zeroing happens on the
+   * session thread when the reset is applied (`zero_device`), or at the next
+   * device update, whichever comes first. */
   void tag_reset();
+  void zero_device(DeviceScene *dscene);
 
   /* On the session thread, once a render completed: the sums come back. */
   void read_back(DeviceScene *dscene);
diff --git a/src/session/session.cpp b/src/session/session.cpp
index ba9d02c4..5108d1c9 100644
--- a/src/session/session.cpp
+++ b/src/session/session.cpp
@@ -737,6 +737,12 @@ bool Session::update_scene(const bool reset_samples)
     profiler.reset(scene->shaders.size(), scene->objects.size());
   }
 
+  /* wetmap: a reset voids the accumulators; on the session thread, without
+   * a scene update of its own. */
+  if (reset_samples) {
+    scene->wet_manager->zero_device(&scene->dscene);
+  }
+
   return reset;
 }
 
