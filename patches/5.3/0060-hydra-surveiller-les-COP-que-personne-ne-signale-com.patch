+/* Qui se sert de quel COP. Sans ce registre, un COP qui change n'a personne a
+ * qui le dire : Solaris ignore la dependance entre un materiau et un noeud de
+ * composition. */
+struct CopUser {
+  PXR_NS::HdRenderIndex *renderIndex = nullptr;
+  PXR_NS::SdfPath materialId;
+
+  bool operator<(const CopUser &other) const
+  {
+    return (renderIndex != other.renderIndex) ? (renderIndex < other.renderIndex) :
+                                                (materialId < other.materialId);
+  }
+};
+
+std::map<std::string, std::set<CopUser>> &Users()
+{
+  static std::map<std::string, std::set<CopUser>> users;
+  return users;
+}
