From aee14d1820269f9e37d6daf7d1937acea9301fbc Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Fri, 4 Sep 2026 16:02:22 +0200
Subject: [PATCH 056/144] hydra: match lights to Karma, and render cylinder
 lights

The same Houdini light rendered much stronger under Cycles. Measured, diffuse
plane, same USD, intensity 1, mean of the image center:

    type        normalize   ratio to Karma
    sphere      no/yes      1.014
    rectangle   no/yes      1.014
    disk        no/yes      1.014
    distant     no/yes      4.06
    dome        no/yes      3.20
    cylinder    no          18.85
    cylinder    yes         47.32

Three causes, one per faulty line:

* the distant light carried a factor of 4 whose comment itself admitted not
  knowing where it came from ("Unclear why, but approximately matches Karma");
* the factor pi that converts an intensity to radiant flux was also applied to
  the dome light, which is not a surface light;
* the cylinder light was declared nowhere: neither in the supported sprim
  types nor in the factory. It did not reach the delegate, the scene rendered
  without it, and the measured ratio was only that of the default gray
  background.

Since Cycles has no tube, the cylinder becomes a rectangle of its length by its
diameter - which is also what Blender's USD import does. A tube emits all around
its axis, a rectangle on one side only: the illumination from the front is
right, the one from behind is missing. Normalized, Cycles then divides by the
area of the rectangle where Karma divides by that of the tube, pi times larger,
hence the corresponding division.

Afterwards, the twelve cases fall between 0.95 and 1.02 of Karma. The remaining
gap is that of the two engines on the same scene, not a unit.

None of this touches the USD: a stage exported to Blender carries the same
intensities as before.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/hydra/light.cpp           | 45 +++++++++++++++++++++++++++++++----
 src/hydra/render_delegate.cpp |  4 +++-
 2 files changed, 43 insertions(+), 6 deletions(-)

diff --git a/src/hydra/light.cpp b/src/hydra/light.cpp
index ef0cce2e..72f450ab 100644
--- a/src/hydra/light.cpp
+++ b/src/hydra/light.cpp
@@ -88,16 +88,35 @@ void HdCyclesLight::Sync(HdSceneDelegate *sceneDelegate,
     strength *= exp2(GetTypedValue<float>(lightDs, HdLightTokens->exposure, 0.0f));
     strength *= GetTypedValue<float>(lightDs, HdLightTokens->intensity, 1.0f);
 
-    if (_lightType == HdPrimTypeTokens->distantLight) {
-      /* Unclear why, but approximately matches Karma. */
-      strength *= 4.0f;
+    /* De l'intensite USD au flux radiant de Cycles. Le facteur pi vaut pour les
+     * lumieres de surface - sphere, rectangle, disque - et pour elles seules.
+     *
+     * Mesure contre Karma, plan diffus, meme USD, intensite 1 : le facteur 4
+     * qui trainait sur la lumiere distante la rendait quatre fois trop forte
+     * (rapport 4,06 mesure), et le pi applique a la dome light trois fois trop
+     * (3,20). Sans eux, les six types tombent a 1,01 de Karma - l'ecart qui
+     * reste est celui des deux moteurs sur la meme scene, pas une unite. */
+    if (_lightType == HdPrimTypeTokens->distantLight ||
+        _lightType == HdPrimTypeTokens->domeLight)
+    {
+      /* L'intensite est prise telle quelle. */
     }
     else {
       /* Convert from intensity to radiant flux. */
       strength *= M_PI_F;
     }
 
-    _light->set_normalize(GetTypedValue<bool>(lightDs, HdLightTokens->normalize, false));
+    const bool normalize = GetTypedValue<bool>(lightDs, HdLightTokens->normalize, false);
+    _light->set_normalize(normalize);
+
+    /* Un cylindre approxime par un rectangle : normalise, Cycles divise par
+     * l'aire du rectangle - longueur par diametre - quand Karma divise par
+     * celle du tube, 2 pi r l, soit pi fois plus grande. Mesure : rapport 2,98
+     * a Karma sans cette division, 0,95 avec, c'est-a-dire le meme ecart que
+     * le cylindre non normalise. */
+    if (normalize && _lightType == HdPrimTypeTokens->cylinderLight) {
+      strength /= M_PI_F;
+    }
 
     if (auto ds = GetTypedDataSource<bool>(lightDs, _tokens->visibleInPrimaryRay)) {
       if (ds->GetTypedValue(0.0f)) {
@@ -134,6 +153,20 @@ void HdCyclesLight::Sync(HdSceneDelegate *sceneDelegate,
         area_light->set_sizev(ds->GetTypedValue(0.0f));
       }
     }
+    else if (_lightType == HdPrimTypeTokens->cylinderLight) {
+      /* Cycles n'a pas de tube : un rectangle de la longueur du cylindre sur
+       * son diametre, ce que fait aussi l'import USD de Blender. Un tube emet
+       * tout autour de son axe, un rectangle d'un seul cote - l'eclairement de
+       * face est le bon, celui de dos manque. L'axe d'un CylinderLight USD est
+       * le X local, d'ou la longueur sur u. */
+      AreaLight *area_light = static_cast<AreaLight *>(_light);
+      if (auto ds = GetTypedDataSource<float>(lightDs, HdLightTokens->length)) {
+        area_light->set_sizeu(ds->GetTypedValue(0.0f));
+      }
+      if (auto ds = GetTypedDataSource<float>(lightDs, HdLightTokens->radius)) {
+        area_light->set_sizev(ds->GetTypedValue(0.0f) * 2.0f);
+      }
+    }
     else if (_lightType == HdPrimTypeTokens->sphereLight) {
       SpotLight *spot_light = static_cast<SpotLight *>(_light);
       const bool treatAsPoint = GetTypedValue<bool>(lightDs, _tokens->treatAsPoint, false);
@@ -389,7 +422,9 @@ void HdCyclesLight::Initialize(HdRenderParam *renderParam)
     _light = lock.scene->create_node<AreaLight>();
     static_cast<AreaLight *>(_light)->set_ellipse(true);
   }
-  else if (_lightType == HdPrimTypeTokens->rectLight) {
+  else if (_lightType == HdPrimTypeTokens->rectLight ||
+           _lightType == HdPrimTypeTokens->cylinderLight)
+  {
     _light = lock.scene->create_node<AreaLight>();
     static_cast<AreaLight *>(_light)->set_ellipse(false);
   }
diff --git a/src/hydra/render_delegate.cpp b/src/hydra/render_delegate.cpp
index afe0efd3..42eab5f8 100644
--- a/src/hydra/render_delegate.cpp
+++ b/src/hydra/render_delegate.cpp
@@ -68,6 +68,7 @@ const TfTokenVector kSupportedSPrimTypes = {
     HdPrimTypeTokens->camera,
     HdPrimTypeTokens->material,
     HdPrimTypeTokens->diskLight,
+    HdPrimTypeTokens->cylinderLight,
     HdPrimTypeTokens->distantLight,
     HdPrimTypeTokens->domeLight,
     HdPrimTypeTokens->rectLight,
@@ -323,7 +324,8 @@ HdSprim *HdCyclesDelegate::CreateSprim(const TfToken &typeId, const SdfPath &spr
   if (typeId == HdPrimTypeTokens->material) {
     return new HdCyclesMaterial(sprimId);
   }
-  if (typeId == HdPrimTypeTokens->diskLight || typeId == HdPrimTypeTokens->distantLight ||
+  if (typeId == HdPrimTypeTokens->cylinderLight || typeId == HdPrimTypeTokens->diskLight ||
+      typeId == HdPrimTypeTokens->distantLight ||
       typeId == HdPrimTypeTokens->domeLight || typeId == HdPrimTypeTokens->rectLight ||
       typeId == HdPrimTypeTokens->sphereLight)
   {
