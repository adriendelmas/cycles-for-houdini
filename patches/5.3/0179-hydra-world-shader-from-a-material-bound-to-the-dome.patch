+/* The network of a material prim the delegate translates: its Cycles one, else
+ * its MaterialX or Karma one, else the universal one; MaterialX nodegraphs
+ * expanded and every input left unwritten given its nodedef's default. */
+HdMaterialNetworkSchema ReadMaterialNetwork(const HdContainerDataSourceHandle &primDs)
+{
+  HdMaterialSchema matSchema = HdMaterialSchema::GetFromParent(primDs);
+  /* Prefer cycles network if it exists, otherwise use universal network. */
+  HdMaterialNetworkSchema network = matSchema.GetMaterialNetwork(CyclesMaterialTokens->cycles);
+  if (!network) {
+    /* MaterialX networks are translated to Cycles nodes, see sMtlxToCycles. */
+    network = matSchema.GetMaterialNetwork(CyclesMaterialTokens->mtlx);
+  }
+  if (!network) {
+    /* A Karma Material Builder writes the same MaterialX nodes under its
+     * own context. The delegate declared `kma` among its render contexts
+     * but never asked for that network, and fell to the preview surface
+     * Houdini writes alongside. */
+    network = matSchema.GetMaterialNetwork(CyclesMaterialTokens->kma);
+  }
+  if (!network) {
+    network = matSchema.GetMaterialNetwork();
+  }
+  if (!network) {
+    return network;
+  }
+  /* MaterialX nodes the table does not know but the library defines as
+   * nodegraphs - switch, ramp4, every hmtlx* node - become their inner
+   * nodes here, which the table does know (mtlx_expand.h). */
+  network = ExpandMaterialXNodegraphs(network, [](const std::string &nodeTypeId) {
+    if (nodeTypeId.starts_with("cycles_") || nodeTypeId.starts_with("cycles:")) {
+      return true;
+    }
+    if (sUsdToCyles->findUsd(TfToken(nodeTypeId))) {
+      return true;
+    }
+    const UsdToCyclesMapping *mapping = FindMtlxMapping(nodeTypeId);
+    return mapping != nullptr && NodeType::find(mapping->nodeType()) != nullptr;
+  });
+  /* Then every MaterialX input left unwritten takes its nodedef's
+   * default, so that no Cycles default stands in for a MaterialX one. */
+  return CompleteMaterialXDefaults(
+      network, [](const std::string &nodeTypeId, const std::string &input) {
+        const UsdToCyclesMapping *mapping = FindMtlxMapping(nodeTypeId);
+        if (mapping == nullptr) {
+          return false;
+        }
+        const TfToken name(input);
+        if (mapping->hasParameterMapping(name)) {
+          return true;
+        }
+        const NodeType *type = NodeType::find(mapping->nodeType());
+        return type != nullptr && type->find_input(ustring(input)) != nullptr;
+      });
+}
