+unique_ptr<ShaderGraph> HdCyclesMaterial::BuildWorldGraph(HdSceneDelegate *sceneDelegate,
+                                                          Scene *scene)
+{
+  const HdMaterialNetworkSchema network = ReadMaterialNetwork(
+      GetPrim(sceneDelegate, GetId()).dataSource);
+  if (!network) {
+    LOG_WARNING << "No material network at " << GetId().GetString()
+                << ", bound to a dome light; the dome keeps its own shader.";
+    return nullptr;
+  }
+  unique_ptr<ShaderGraph> graph = BuildShaderGraph(network);
+  if (graph) {
+    ResolveUdimTiles();
+    BindArchiveImages(scene);
+  }
+  return graph;
+}
