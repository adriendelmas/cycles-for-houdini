  * with one base colour; standard_surface and OpenPBR give the subsurface its
@@ -1184,6 +1496,18 @@ HdMaterialNetworkSchema ExpandMaterialXNodegraphs(HdMaterialNetworkSchema networ
           candidate = true;
           break;
         }
+        /* A BSDF with a weight of its own (FoldClosureWeight). */
+        if (id.ends_with("_bsdf")) {
+          HdMaterialNodeSchema node = nodes.Get(name);
+          HdMaterialConnectionVectorSchema conns = node.GetInputConnections().Get(
+              TfToken("weight"));
+          if (node.GetParameters().Get(TfToken("weight")).GetValue() ||
+              (conns && conns.GetNumElements() > 0))
+          {
+            candidate = true;
+            break;
+          }
+        }
       }
     }
   }
@@ -1196,6 +1520,7 @@ HdMaterialNetworkSchema ExpandMaterialXNodegraphs(HdMaterialNetworkSchema networ
 
   net.changed |= FoldThinFilm(net);
   net.changed |= FoldSurfaceBase(net);
+  net.changed |= FoldClosureWeight(net, library);
 
   /* Expanded nodes bring in nodes that may expand in turn. */
   for (int pass = 0; pass < 8; ++pass) {
@@ -1236,6 +1561,11 @@ HdMaterialNetworkSchema ExpandMaterialXNodegraphs(HdMaterialNetworkSchema networ
       any |= done;
       net.changed |= done;
     }
+    /* After this pass's expansions, so their colour4 nodes are seen; its
+     * float twins may expand in the next. */
+    const bool routed = RouteComputedAlpha(net, library);
+    any |= routed;
+    net.changed |= routed;
     if (!any) {
       break;
     }
