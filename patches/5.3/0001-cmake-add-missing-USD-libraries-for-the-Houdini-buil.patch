From 1f651c0bca27774b15d3c6038e747b48dd6a9750 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Mon, 31 Aug 2026 01:38:53 +0200
Subject: [PATCH 01/59] cmake: add missing USD libraries for the Houdini build

FindUSDHoudini.cmake did not list hdsi, which src/hydra/file_reader.cpp
needs for HdSiExtComputationPrimvarPruningSceneIndex, breaking the link of
the standalone cycles executable and therefore the install target. sdr is
needed by the shader node registry plugin. Houdini ships both.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/cmake/Modules/FindUSDHoudini.cmake |   2 +-
 src/hydra/sdr_cycles.cpp               | 270 +++++++++++++++++++++++++
 src/hydra/sdr_cycles.h                 |  48 +++++
 3 files changed, 319 insertions(+), 1 deletion(-)
 create mode 100644 src/hydra/sdr_cycles.cpp
 create mode 100644 src/hydra/sdr_cycles.h

diff --git a/src/cmake/Modules/FindUSDHoudini.cmake b/src/cmake/Modules/FindUSDHoudini.cmake
index 6c8f631f..c5f6c129 100644
--- a/src/cmake/Modules/FindUSDHoudini.cmake
+++ b/src/cmake/Modules/FindUSDHoudini.cmake
@@ -31,7 +31,7 @@ if(HOUDINI_ROOT AND EXISTS ${HOUDINI_ROOT})
   string(REGEX MATCHALL "[0-9]+" HOUDINI_VERSION_MAJOR ${_houdini_version_major})
 
   # USD
-  set(USD_LIBRARIES hd hgi hgiGL gf arch garch plug tf trace vt work sdf cameraUtil hf pxOsd usd usdImaging usdGeom python)
+  set(USD_LIBRARIES hd hdsi hgi hgiGL sdr gf arch garch plug tf trace vt work sdf cameraUtil hf pxOsd usd usdImaging usdGeom python)
 
   foreach(lib ${USD_LIBRARIES})
     find_library(_pxr_library NAMES pxr_${lib} PATHS ${_library_dir} NO_DEFAULT_PATH)
diff --git a/src/hydra/sdr_cycles.cpp b/src/hydra/sdr_cycles.cpp
new file mode 100644
index 00000000..95469985
--- /dev/null
+++ b/src/hydra/sdr_cycles.cpp
@@ -0,0 +1,270 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#include "hydra/sdr_cycles.h"
+
+#include "graph/node_type.h"
+#include "util/types.h"
+
+#include <pxr/base/gf/matrix4f.h>
+#include <pxr/base/gf/vec2f.h>
+#include <pxr/base/gf/vec3f.h>
+#include <pxr/base/tf/staticTokens.h>
+#include <pxr/usd/sdr/shaderNode.h>
+#include <pxr/usd/sdr/shaderNodeDiscoveryResult.h>
+#include <pxr/usd/sdr/shaderProperty.h>
+#include <pxr/usd/sdr/shaderPropertyMetadata.h>
+
+#include <string>
+
+PXR_NAMESPACE_OPEN_SCOPE
+
+/* clang-format off */
+TF_DEFINE_PRIVATE_TOKENS(_tokens,
+    ((cycles, "cycles"))
+    ((identifierPrefix, "cycles_"))
+);
+/* clang-format on */
+
+namespace {
+
+/* Cycles socket type -> Sdr property type.
+ *
+ * Sdr has no boolean, so booleans are exposed as integers, which is what the
+ * other renderers that register through Sdr do as well. Closures become
+ * terminals so that surface/volume/displacement outputs are connectable but
+ * carry no value. */
+const TfToken &SocketTypeToSdrType(const ccl::SocketType::Type type, size_t &arraySize)
+{
+  arraySize = 0;
+
+  switch (type) {
+    case ccl::SocketType::BOOLEAN:
+    case ccl::SocketType::INT:
+    case ccl::SocketType::UINT:
+    case ccl::SocketType::UINT64:
+    case ccl::SocketType::ENUM:
+      return SdrPropertyTypes->Int;
+    case ccl::SocketType::FLOAT:
+      return SdrPropertyTypes->Float;
+    case ccl::SocketType::COLOR:
+      return SdrPropertyTypes->Color;
+    case ccl::SocketType::VECTOR:
+      return SdrPropertyTypes->Vector;
+    case ccl::SocketType::POINT:
+      return SdrPropertyTypes->Point;
+    case ccl::SocketType::NORMAL:
+      return SdrPropertyTypes->Normal;
+    case ccl::SocketType::POINT2:
+      return SdrPropertyTypes->Vector;
+    case ccl::SocketType::STRING:
+      return SdrPropertyTypes->String;
+    case ccl::SocketType::TRANSFORM:
+      return SdrPropertyTypes->Matrix;
+    case ccl::SocketType::CLOSURE:
+      return SdrPropertyTypes->Terminal;
+    case ccl::SocketType::NODE:
+      return SdrPropertyTypes->String;
+
+    /* Arrays keep the element type and report a non-zero array size. */
+    case ccl::SocketType::BOOLEAN_ARRAY:
+    case ccl::SocketType::INT_ARRAY:
+      arraySize = 1;
+      return SdrPropertyTypes->Int;
+    case ccl::SocketType::FLOAT_ARRAY:
+      arraySize = 1;
+      return SdrPropertyTypes->Float;
+    case ccl::SocketType::COLOR_ARRAY:
+      arraySize = 1;
+      return SdrPropertyTypes->Color;
+    case ccl::SocketType::VECTOR_ARRAY:
+    case ccl::SocketType::POINT2_ARRAY:
+      arraySize = 1;
+      return SdrPropertyTypes->Vector;
+    case ccl::SocketType::POINT_ARRAY:
+      arraySize = 1;
+      return SdrPropertyTypes->Point;
+    case ccl::SocketType::NORMAL_ARRAY:
+      arraySize = 1;
+      return SdrPropertyTypes->Normal;
+    case ccl::SocketType::STRING_ARRAY:
+    case ccl::SocketType::NODE_ARRAY:
+      arraySize = 1;
+      return SdrPropertyTypes->String;
+    case ccl::SocketType::TRANSFORM_ARRAY:
+      arraySize = 1;
+      return SdrPropertyTypes->Matrix;
+
+    default:
+      return SdrPropertyTypes->Unknown;
+  }
+}
+
+/* Read the socket's default out of the static storage Cycles keeps for it.
+ * Returns an empty VtValue for types without a meaningful scalar default. */
+VtValue SocketDefaultValue(const ccl::SocketType &socket)
+{
+  const void *const value = socket.default_value;
+  if (value == nullptr || socket.is_array()) {
+    return VtValue();
+  }
+
+  switch (socket.type) {
+    case ccl::SocketType::BOOLEAN:
+      return VtValue(static_cast<int>(*static_cast<const bool *>(value)));
+    case ccl::SocketType::INT:
+    case ccl::SocketType::ENUM:
+      return VtValue(*static_cast<const int *>(value));
+    case ccl::SocketType::UINT:
+      return VtValue(static_cast<int>(*static_cast<const uint32_t *>(value)));
+    case ccl::SocketType::FLOAT:
+      return VtValue(*static_cast<const float *>(value));
+    case ccl::SocketType::COLOR:
+    case ccl::SocketType::VECTOR:
+    case ccl::SocketType::POINT:
+    case ccl::SocketType::NORMAL: {
+      const ccl::float3 v = *static_cast<const ccl::float3 *>(value);
+      return VtValue(GfVec3f(v.x, v.y, v.z));
+    }
+    case ccl::SocketType::POINT2: {
+      const ccl::float2 v = *static_cast<const ccl::float2 *>(value);
+      return VtValue(GfVec3f(v.x, v.y, 0.0f));
+    }
+    case ccl::SocketType::STRING:
+      return VtValue(std::string(static_cast<const ccl::ustring *>(value)->c_str()));
+    default:
+      return VtValue();
+  }
+}
+
+/* Expose an enum socket's labels so the host can build a menu for it. */
+SdrOptionVec SocketOptions(const ccl::SocketType &socket)
+{
+  SdrOptionVec options;
+  if (socket.type != ccl::SocketType::ENUM || socket.enum_values == nullptr) {
+    return options;
+  }
+
+  for (const auto &entry : *socket.enum_values) {
+    options.emplace_back(TfToken(entry.first.c_str()),
+                         TfToken(std::to_string(entry.second)));
+  }
+  return options;
+}
+
+SdrShaderPropertyUniquePtr MakeProperty(const ccl::SocketType &socket, const bool isOutput)
+{
+  size_t arraySize = 0;
+  const TfToken &type = SocketTypeToSdrType(socket.type, arraySize);
+
+  SdrTokenMap metadata;
+  if (!socket.ui_name.empty()) {
+    metadata[SdrPropertyMetadata->Label] = socket.ui_name.c_str();
+  }
+  /* Only sockets Cycles marks LINKABLE may take a connection. */
+  if (!isOutput && (socket.flags & ccl::SocketType::LINKABLE) == 0) {
+    metadata[SdrPropertyMetadata->Connectable] = "0";
+  }
+
+  return SdrShaderPropertyUniquePtr(new SdrShaderProperty(TfToken(socket.name.c_str()),
+                                                          type,
+                                                          SocketDefaultValue(socket),
+                                                          isOutput,
+                                                          arraySize,
+                                                          metadata,
+                                                          SdrTokenMap(),
+                                                          SocketOptions(socket)));
+}
+
+}  // namespace
+
+SdrCyclesDiscoveryPlugin::SdrCyclesDiscoveryPlugin() = default;
+SdrCyclesDiscoveryPlugin::~SdrCyclesDiscoveryPlugin() = default;
+
+SdrShaderNodeDiscoveryResultVec SdrCyclesDiscoveryPlugin::DiscoverShaderNodes(
+    const Context & /*context*/)
+{
+  SdrShaderNodeDiscoveryResultVec results;
+
+  for (const ccl::ustring &typeName : ccl::NodeType::type_names()) {
+    const ccl::NodeType *const nodeType = ccl::NodeType::find(typeName);
+    if (nodeType == nullptr || nodeType->type != ccl::NodeType::SHADER) {
+      continue;
+    }
+
+    const std::string name(typeName.c_str());
+
+    /* A node listed without a valid, default-marked version is parseable by
+     * identifier but is left out of the registry's identifier enumeration. */
+    results.emplace_back(SdrIdentifier(_tokens->identifierPrefix.GetString() + name),
+                         SdrVersion(1, 0).GetAsDefault(),
+                         name,
+                         TfToken(name),
+                         _tokens->cycles,
+                         _tokens->cycles,
+                         /*uri*/ std::string(),
+                         /*resolvedUri*/ std::string());
+  }
+
+  return results;
+}
+
+const SdrStringVec &SdrCyclesDiscoveryPlugin::GetSearchURIs() const
+{
+  /* Nodes come from the linked Cycles library, not from files on disk. */
+  static const SdrStringVec empty;
+  return empty;
+}
+
+SdrCyclesParserPlugin::SdrCyclesParserPlugin() = default;
+SdrCyclesParserPlugin::~SdrCyclesParserPlugin() = default;
+
+SdrShaderNodeUniquePtr SdrCyclesParserPlugin::ParseShaderNode(
+    const SdrShaderNodeDiscoveryResult &result)
+{
+  const std::string &identifier = result.identifier.GetString();
+  const std::string prefix = _tokens->identifierPrefix.GetString();
+
+  std::string typeName = identifier;
+  if (typeName.rfind(prefix, 0) == 0) {
+    typeName = typeName.substr(prefix.size());
+  }
+
+  const ccl::NodeType *const nodeType = ccl::NodeType::find(ccl::ustring(typeName));
+
+  SdrShaderPropertyUniquePtrVec properties;
+  if (nodeType != nullptr) {
+    for (const ccl::SocketType &input : nodeType->inputs) {
+      properties.push_back(MakeProperty(input, /*isOutput*/ false));
+    }
+    for (const ccl::SocketType &output : nodeType->outputs) {
+      properties.push_back(MakeProperty(output, /*isOutput*/ true));
+    }
+  }
+
+  return SdrShaderNodeUniquePtr(new SdrShaderNode(result.identifier,
+                                                  result.version,
+                                                  result.name,
+                                                  result.function,
+                                                  _tokens->cycles,
+                                                  /*definitionURI*/ std::string(),
+                                                  /*implementationURI*/ std::string(),
+                                                  std::move(properties)));
+}
+
+const SdrTokenVec &SdrCyclesParserPlugin::GetDiscoveryTypes() const
+{
+  static const SdrTokenVec types = {_tokens->cycles};
+  return types;
+}
+
+const TfToken &SdrCyclesParserPlugin::GetSourceType() const
+{
+  return _tokens->cycles;
+}
+
+SDR_REGISTER_DISCOVERY_PLUGIN(SdrCyclesDiscoveryPlugin)
+SDR_REGISTER_PARSER_PLUGIN(SdrCyclesParserPlugin)
+
+PXR_NAMESPACE_CLOSE_SCOPE
diff --git a/src/hydra/sdr_cycles.h b/src/hydra/sdr_cycles.h
new file mode 100644
index 00000000..d9087db6
--- /dev/null
+++ b/src/hydra/sdr_cycles.h
@@ -0,0 +1,48 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include "hydra/config.h"
+
+#include <pxr/usd/sdr/declare.h>
+#include <pxr/usd/sdr/discoveryPlugin.h>
+#include <pxr/usd/sdr/parserPlugin.h>
+
+PXR_NAMESPACE_OPEN_SCOPE
+
+/* Publishes every Cycles shader node into the USD shader definition registry.
+ *
+ * The node set is read from Cycles' own `NodeType` registry at runtime rather
+ * than generated ahead of time, so the nodes exposed to the host application
+ * are always exactly those of the Cycles version this plugin is linked
+ * against.
+ *
+ * The identifiers produced here (`cycles_<node name>`) are the ones the render
+ * delegate's material translation already accepts, see
+ * `HdCyclesMaterial::Sync` in material.cpp. */
+
+class SdrCyclesDiscoveryPlugin final : public SdrDiscoveryPlugin {
+ public:
+  SdrCyclesDiscoveryPlugin();
+  ~SdrCyclesDiscoveryPlugin() override;
+
+  SdrShaderNodeDiscoveryResultVec DiscoverShaderNodes(const Context &context) override;
+
+  const SdrStringVec &GetSearchURIs() const override;
+};
+
+class SdrCyclesParserPlugin final : public SdrParserPlugin {
+ public:
+  SdrCyclesParserPlugin();
+  ~SdrCyclesParserPlugin() override;
+
+  SdrShaderNodeUniquePtr ParseShaderNode(const SdrShaderNodeDiscoveryResult &result) override;
+
+  const SdrTokenVec &GetDiscoveryTypes() const override;
+
+  const TfToken &GetSourceType() const override;
+};
+
+PXR_NAMESPACE_CLOSE_SCOPE
