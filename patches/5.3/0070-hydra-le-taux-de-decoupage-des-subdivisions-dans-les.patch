From 31e205e3c168995db09d321bc21a7298b56a2581 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Wed, 9 Sep 2026 22:24:33 +0200
Subject: [PATCH 070/119] hydra: le taux de decoupage des subdivisions, dans
 les reglages de rendu

La camera de decoupage donnee, il restait a en donner le pas.
`cycles:dicing_rate` - combien de pixels vaut un micropolygone - arrive dans
l'onglet Session, a cote de `Samples`. Blender en expose deux, 1 px au rendu et
8 px dans la vue ; ici un seul, mais qui se change sans recompiler.

Mesure sur la scene de l'audit, en 720x360 :

| taux | index des triangles | triangles | ecart d'image vs 1 px |
|---|---|---|---|
| 1 px | 471 576 o | 19 649 | - |
| 4 px | 32 472 o | 1 353 | 2,8e-5 |
| 8 px | 8 880 o | 370 | 8,0e-5 |

Cinquante-trois fois moins de triangles pour un ecart d'image de 8e-5 sur cette
scene. Doubler le taux divise le nombre de micropolygones par quatre.

Changer le reglage repose la valeur sur les maillages deja synchronises, sinon
il n'aurait porte que sur ce qui arrive apres lui. Le journal dit desormais, par
maillage subdivise, le taux et le niveau maximum retenus - sans quoi un
decoupage en millions de triangles ne se voit que dans la memoire du
peripherique, ou personne ne pense a regarder.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/hydra/mesh.cpp                            | 17 ++++++++-
 src/hydra/render_delegate.cpp                 | 36 +++++++++++++++++++
 src/hydra/render_delegate.h                   |  3 +-
 .../resources/HdCyclesPluginGPU_Global.ds     | 22 ++++++++++++
 src/hydra/resources/HdCyclesPlugin_Global.ds  | 22 ++++++++++++
 src/hydra/session.h                           | 15 ++++++++
 6 files changed, 113 insertions(+), 2 deletions(-)

diff --git a/src/hydra/mesh.cpp b/src/hydra/mesh.cpp
index 1c08463e..8e2acad3 100644
--- a/src/hydra/mesh.cpp
+++ b/src/hydra/mesh.cpp
@@ -8,8 +8,11 @@
 
 #include "hydra/mesh.h"
 #include "hydra/geometry.inl"
+#include "hydra/render_delegate.h"
+#include "hydra/session.h"
 #include "hydra/util.h"
 #include "scene/mesh.h"
+#include "util/log.h"
 
 #include <pxr/base/gf/vec2f.h>
 #include <pxr/imaging/hd/geomSubsetSchema.h>
@@ -690,8 +693,20 @@ void HdCyclesMesh::PopulateTopology(HdSceneDelegate *sceneDelegate)
       }
     }
 
-    _geom->set_subd_dicing_rate(1.0f);
+    /* Le pas du decoupage vient des reglages de rendu ; sans camera de
+     * decoupage renseignee il ne voulait rien dire, avec elle il vaut un
+     * nombre de pixels par micropolygone. */
+    const auto *const cyclesDelegate = static_cast<const HdCyclesDelegate *>(
+        sceneDelegate->GetRenderIndex().GetRenderDelegate());
+    const float dicingRate =
+        static_cast<HdCyclesSession *>(cyclesDelegate->GetRenderParam())->GetDicingRate();
+    _geom->set_subd_dicing_rate(dicingRate);
     _geom->set_subd_max_level(_topology.GetRefineLevel());
+    /* Les deux nombres qui decident du cout d'une surface subdivisee. Sans eux
+     * au journal, un maillage decoupe en millions de triangles ne se voit que
+     * dans la memoire du peripherique, ou personne ne pense a regarder. */
+    LOG_INFO << "Subdivision " << GetId().GetText() << ": dicing rate " << dicingRate
+             << " px, max level " << _topology.GetRefineLevel() << ".";
     _geom->set_subd_objecttoworld(_instances[0]->get_tfm());
   }
 }
diff --git a/src/hydra/render_delegate.cpp b/src/hydra/render_delegate.cpp
index 42eab5f8..eadf44f7 100644
--- a/src/hydra/render_delegate.cpp
+++ b/src/hydra/render_delegate.cpp
@@ -20,6 +20,7 @@
 #include "hydra/session.h"
 #include "hydra/volume.h"
 #include "scene/integrator.h"
+#include "scene/mesh.h"
 #include "scene/scene.h"
 #include "session/session.h"
 #include "util/log.h"
@@ -470,6 +471,16 @@ HdRenderSettingDescriptorList HdCyclesDelegate::GetRenderSettingDescriptors() co
       HdCyclesRenderSettingsTokens->threads,
       VtValue(_renderParam->session->params.threads),
   });
+  /* Le pas du decoupage adaptatif des subdivisions, en pixels : combien de
+   * pixels vaut un micropolygone. Blender en expose deux, 1 px au rendu et
+   * 8 px dans la vue ; ici il n'y en a qu'un, mais il se change sans
+   * recompiler. Doubler la valeur divise le nombre de micropolygones par
+   * quatre. */
+  descriptors.push_back({
+      "Dicing Rate",
+      HdCyclesRenderSettingsTokens->dicingRate,
+      VtValue(_renderParam->GetDicingRate()),
+  });
   descriptors.push_back({
       "Time Limit",
       HdCyclesRenderSettingsTokens->timeLimit,
@@ -514,6 +525,28 @@ void HdCyclesDelegate::SetRenderSetting(const PXR_NS::TfToken &key, const PXR_NS
     samples = std::min(std::max(1, samples), max_samples);
     session->set_samples(samples);
   }
+  else if (key == HdCyclesRenderSettingsTokens->dicingRate) {
+    const float rate = VtValue::Cast<float>(value).GetWithDefault(_renderParam->GetDicingRate());
+    /* Zero ou moins ferait un decoupage infini ; le plancher est celui de
+     * Blender. */
+    const float clamped = std::max(0.1f, rate);
+    if (clamped != _renderParam->GetDicingRate()) {
+      _renderParam->SetDicingRate(clamped);
+      /* Les maillages deja synchronises portent l'ancienne valeur : la leur
+       * reposer les marque modifies, et Cycles les redecoupe. Sans cela, le
+       * reglage n'aurait d'effet que sur ce qui arrive apres lui. */
+      for (Geometry *const geom : scene->geometry) {
+        if (geom->is_mesh()) {
+          Mesh *const mesh = static_cast<Mesh *>(geom);
+          if (mesh->get_subdivision_type() != Mesh::SUBDIVISION_NONE) {
+            mesh->set_subd_dicing_rate(clamped);
+            mesh->tag_update(scene, true);
+          }
+        }
+      }
+      ++_settingsVersion;
+    }
+  }
   else if (key == HdCyclesRenderSettingsTokens->sampleOffset) {
     session->params.sample_subset_offset = VtValue::Cast<int>(value).GetWithDefault(
         session->params.sample_subset_offset);
@@ -604,6 +637,9 @@ VtValue HdCyclesDelegate::GetRenderSetting(const TfToken &key) const
   if (key == HdCyclesRenderSettingsTokens->device) {
     return VtValue(TfToken(Device::string_from_type(session->params.device.type)));
   }
+  if (key == HdCyclesRenderSettingsTokens->dicingRate) {
+    return VtValue(_renderParam->GetDicingRate());
+  }
   if (key == HdCyclesRenderSettingsTokens->threads) {
     return VtValue(session->params.threads);
   }
