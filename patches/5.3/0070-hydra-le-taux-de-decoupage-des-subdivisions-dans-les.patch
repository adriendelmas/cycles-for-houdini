diff --git a/src/hydra/session.h b/src/hydra/session.h
index 4370020b..406f0f53 100644
--- a/src/hydra/session.h
+++ b/src/hydra/session.h
@@ -40,6 +40,20 @@ class HdCyclesSession final : public PXR_NS::HdRenderParam {
     _stageMetersPerUnit = stageMetersPerUnit;
   }
 
+  /* Le pas du decoupage adaptatif des subdivisions, en pixels. Blender expose
+   * les deux : 1 px au rendu, 8 px dans la vue, soit soixante-quatre fois
+   * moins de micropolygones pour naviguer. Range ici parce que le maillage le
+   * lit a la synchronisation, ou seule la session est a portee. */
+  float GetDicingRate() const
+  {
+    return _dicingRate;
+  }
+
+  void SetDicingRate(const float dicingRate)
+  {
+    _dicingRate = dicingRate;
+  }
+
   PXR_NS::HdRenderPassAovBinding GetDisplayAovBinding() const
   {
     return _displayAovBinding;
@@ -96,6 +110,7 @@ class HdCyclesSession final : public PXR_NS::HdRenderParam {
  private:
   const bool _ownCyclesSession;
   double _stageMetersPerUnit = 0.01;
+  float _dicingRate = 1.0f;
   float _shutterOpen = 0.0f;
   float _shutterClose = 0.0f;
   bool _motionBlurEnabled = true;
