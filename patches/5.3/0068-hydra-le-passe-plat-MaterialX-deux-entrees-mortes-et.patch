From 35d48cdd7f0f66d83ed14b920d5eeab942d8be39 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Wed, 9 Sep 2026 18:03:28 +0200
Subject: [PATCH 68/99] hydra: le passe-plat MaterialX, deux entrees mortes, et
 six familles de plus
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

De 549 a 647 nodedefs traduits sur les 823 que compte la bibliotheque
MaterialX 1.39.5 livree avec Houdini, mesures par `tools/mtlx_coverage.py`.

**Deux entrees ne pouvaient rien attraper.** `and` et `or` etaient inscrits
sous `ND_and_` et `ND_or_` ; MaterialX les nomme `ND_logical_and` et
`ND_logical_or`. Aucun graphe n'a jamais pu les atteindre. `not` s'y ajoute.

**Le passe-plat manquait.** MaterialX pose un `dot` pour router un fil et un
`convert` pour changer de type - deux choses que Cycles fait sur le lien
lui-meme. Sans correspondance la chaine se coupait la, et un graphe venu d'un
autre logiciel, ou l'un et l'autre abondent, y perdait ses textures. Un melange
a facteur nul rend son entree telle quelle ; sur une fermeture, ou un melange
de couleurs detruirait tout, c'est une somme a un seul terme.

`convert` vers un shader de surface fait exception : MaterialX en fait une
surface qui emet la couleur donnee, et c'est un noeud `emission`. Le suffixe ne
se lisant pas par prefixe, ce cas est traite dans la recherche elle-meme.

S'ajoutent `constant`, `saturate`, `contrast`, `hextiledimage` et la famille
`gltf_image`. Le noeud hexagonal existait deja dans le moteur - il vient de la
PR Blender 158054, integree ici pour les bruits MaterialX - sans que rien ne
l'atteigne depuis un reseau MaterialX.

Le piege, trouve en le mesurant : `contrast` sur une couleur passait par le
noeud `math` de Cycles, qui est **scalaire**. La couleur y etait reduite a sa
moyenne et ressortait grise. Il en faut deux versions, comme pour les quatre
familles arithmetiques.

Verifie valeur par valeur, pas seulement « pas noir » :
`contrast` x2 pivot 0,5 sur (0,9 0,2 0,1) donne (1,3 0 0) ;
`saturate` a 0,2 donne (0,900 0,760 0,740) ; `dot` et `constant` rendent
exactement ce qu'on leur donne.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/hydra/material.cpp | 179 ++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 177 insertions(+), 2 deletions(-)

diff --git a/src/hydra/material.cpp b/src/hydra/material.cpp
index dfdc9847..3aa097be 100644
--- a/src/hydra/material.cpp
+++ b/src/hydra/material.cpp
@@ -724,6 +724,24 @@ UsdToCyclesMapping MakeMtlxBlend(const char *const mode)
   return mapping;
 }
 
+/* `convert` vers un shader de surface est le seul de la famille qui ne soit pas
+ * un passe-plat : MaterialX en fait une surface qui emet la couleur donnee. Un
+ * melange de couleurs y aurait laisse un terminal sans fermeture - signale,
+ * mais perdu. Hors table parce que le suffixe ne se lit pas par prefixe. */
+const UsdToCyclesMapping &MtlxConvertSurface()
+{
+  static const UsdToCyclesMapping mapping = [] {
+    UsdToCyclesMapping m{"emission",
+                         {
+                             {TfToken("in"), ustring("color")},
+                             {CyclesMaterialTokens->out, ustring("emission")},
+                         }};
+    m.setFixedValues({{ustring("strength"), "1"}});
+    return m;
+  }();
+  return mapping;
+}
+
 /* A nodedef prefix and the mapping it resolves to. Longest prefix wins, so a
  * specific variant can sit in front of its family. */
 struct MtlxEntry {
@@ -1018,6 +1036,128 @@ const std::vector<MtlxEntry> &MtlxTable()
   /* Logic, as close as Cycles' math node gets. */
   static const UsdToCyclesMapping kAnd = MakeMtlxOp("multiply", false, false);
   static const UsdToCyclesMapping kOr = MakeMtlxOp("maximum", false, false);
+  /* `not` : le complement a un. */
+  static const UsdToCyclesMapping kNot = [] {
+    UsdToCyclesMapping m = MakeMtlxOp("subtract", false, false);
+    m.setParameterName(TfToken("in"), ustring("value2"));
+    m.setFixedValues({{ustring("math_type"), "subtract"}, {ustring("value1"), "1"}});
+    return m;
+  }();
+
+  /* Le passe-plat. MaterialX pose un `dot` pour router un fil et un `convert`
+   * pour changer de type - deux choses que Cycles fait sur le lien lui-meme.
+   * Sans correspondance, la chaine se coupait la : un graphe venu d'un autre
+   * logiciel, ou l'un et l'autre abondent, y perdait ses textures. Un melange
+   * a facteur nul rend son entree telle quelle. */
+  static const UsdToCyclesMapping kPassThrough = [] {
+    UsdToCyclesMapping m{"mix_color",
+                         {
+                             {TfToken("in"), ustring("a")},
+                             {CyclesMaterialTokens->out, ustring("result")},
+                         }};
+    m.setFixedValues({{ustring("blend_type"), "mix"}, {ustring("fac"), "0"}});
+    return m;
+  }();
+
+  /* Le meme routage, mais sur une fermeture : un melange de couleurs la
+   * detruirait. Une somme dont un seul terme est branche la laisse passer. */
+  static const UsdToCyclesMapping kPassThroughClosure = {
+      "add_closure",
+      {
+          {TfToken("in"), ustring("closure1")},
+          {CyclesMaterialTokens->out, ustring("closure")},
+      }};
+
+  /* Une constante. Cycles a un noeud par type : `value` pour un scalaire,
+   * `color` pour ce qui a trois composantes. */
+  static const UsdToCyclesMapping kConstantValue = {
+      "value",
+      {
+          {TfToken("value"), ustring("value")},
+          {CyclesMaterialTokens->out, ustring("value")},
+      }};
+  static const UsdToCyclesMapping kConstantColor = {
+      "color",
+      {
+          {TfToken("value"), ustring("value")},
+          {CyclesMaterialTokens->out, ustring("color")},
+      }};
+
+  /* `saturate`. `lumacoeffs` reste sans correspondance : le noeud de Cycles a
+   * Rec.709 en dur, comme pour `luminance`. */
+  static const UsdToCyclesMapping kSaturate = {
+      "hsv",
+      {
+          {TfToken("in"), ustring("color")},
+          {TfToken("amount"), ustring("saturation")},
+          {CyclesMaterialTokens->out, ustring("color")},
+      }};
+
+  /* `contrast` : (in - pivot) x amount + pivot, ecrit en une multiplication
+   * accumulee - in x amount + pivot x (1 - amount), qui est la meme chose. Les
+   * auxiliaires portent les defauts de MaterialX, amount 1 et pivot 0,5, pour
+   * qu'un reseau qui n'ecrit ni l'un ni l'autre reste neutre.
+   *
+   * Il en faut deux versions : le noeud `math` de Cycles est scalaire, et une
+   * couleur qui y entre est reduite a sa moyenne - un contraste sur une
+   * couleur en ressortait gris. */
+  auto makeContrast = [](const bool vector) {
+    const char *const node = vector ? "vector_math" : "math";
+    const char *const a = vector ? "vector1" : "value1";
+    const char *const b = vector ? "vector2" : "value2";
+    const char *const c = vector ? "Vector3" : "Value3";
+    const char *const outSocket = vector ? "vector" : "value";
+    const char *const outName = vector ? "Vector" : "Value";
+    const char *const helperB = vector ? "off:Vector2" : "off:Value2";
+    const char *const one = vector ? "1,1,1" : "1";
+    const char *const half = vector ? "0.5,0.5,0.5" : "0.5";
+    const char *const zero = vector ? "0,0,0" : "0";
+
+    UsdToCyclesMapping m{node,
+                         {
+                             {TfToken("in"), ustring(a)},
+                             {TfToken("amount"),
+                              ustring(std::string(b) + ";inv:" + b)},
+                             {TfToken("pivot"), ustring(std::string("off:") + a)},
+                             {CyclesMaterialTokens->out, ustring(outSocket)},
+                         }};
+    m.setFixedValues({{ustring("math_type"), "multiply_add"}, {ustring(b), one}});
+    m.addHelper({"off",
+                 node,
+                 {{outName, c}},
+                 {{ustring("math_type"), "multiply"},
+                  {ustring(a), half},
+                  {ustring(b), zero}}});
+    m.addHelper({"inv",
+                 node,
+                 {{outName, helperB}},
+                 {{ustring("math_type"), "subtract"},
+                  {ustring(a), one},
+                  {ustring(b), one}}});
+    return m;
+  };
+  static const UsdToCyclesMapping kContrast = makeContrast(false);
+  static const UsdToCyclesMapping kContrastV = makeContrast(true);
+
+  /* L'image en tuiles hexagonales, que la PR Blender 158054 a apportee cote
+   * noyau en meme temps que les bruits MaterialX. Le noeud existait donc deja,
+   * sans que rien ne l'atteigne depuis un reseau MaterialX. */
+  static const MtlxImageTexture kHexTiledImage = {
+      "mx_hextiled_image_texture",
+      {
+          {TfToken("file"), ustring("filename")},
+          {TfToken("texcoord"), ustring("vector")},
+          {TfToken("tiling"), ustring("tiling")},
+          {TfToken("rotation"), ustring("rotation")},
+          {TfToken("rotationrange"), ustring("rotation_range")},
+          {TfToken("scale"), ustring("scale")},
+          {TfToken("scalerange"), ustring("scale_range")},
+          {TfToken("offset"), ustring("offset")},
+          {TfToken("offsetrange"), ustring("offset_range")},
+          {TfToken("falloff"), ustring("falloff")},
+          {TfToken("falloffcontrast"), ustring("falloff_contrast")},
+          {TfToken("lumacoeffs"), ustring("luma_coeffs")},
+      }};
 
   /* Ramps. A left-to-right ramp is a linear gradient driving a mix between the
    * two colours; the gradient's vector input, left unconnected, falls back to
@@ -1300,8 +1440,37 @@ const std::vector<MtlxEntry> &MtlxTable()
       {"ND_transformpoint", &kTransformPoint},
       {"ND_transformvector", &kTransformVector},
       {"ND_transformnormal", &kTransformNormal},
-      {"ND_and_", &kAnd},
-      {"ND_or_", &kOr},
+      /* MaterialX nomme ces deux-la `ND_logical_and` et `ND_logical_or` : les
+       * prefixes d'avant, `ND_and_` et `ND_or_`, ne pouvaient rien attraper. */
+      {"ND_logical_and", &kAnd},
+      {"ND_logical_or", &kOr},
+      {"ND_logical_not", &kNot},
+
+      /* Le routage et la conversion de type, que Cycles fait sur le lien. */
+      {"ND_dot_surfaceshader", &kPassThroughClosure},
+      {"ND_dot_displacementshader", &kPassThroughClosure},
+      {"ND_dot_volumeshader", &kPassThroughClosure},
+      {"ND_dot_", &kPassThrough},
+      {"ND_convert_", &kPassThrough},
+
+      /* Les constantes, un noeud Cycles par type. */
+      {"ND_constant_color", &kConstantColor},
+      {"ND_constant_vector", &kConstantColor},
+      {"ND_constant_", &kConstantValue},
+
+      /* Reglages colorimetriques. */
+      {"ND_saturate_", &kSaturate},
+      {"ND_contrast_color", &kContrastV},
+      {"ND_contrast_vector", &kContrastV},
+      {"ND_contrast_", &kContrast},
+
+      /* Les images : la variante hexagonale, et la famille glTF qui nomme ses
+       * entrees comme `image`. */
+      {"ND_hextiledimage_", &kHexTiledImage},
+      {"ND_gltf_colorimage", &MtlxImage},
+      {"ND_gltf_image_color", &MtlxImage},
+      {"ND_gltf_image_", &kImageData},
+
 
       /* Geometry. */
       {"ND_position_", &MtlxPosition},
@@ -1439,6 +1608,12 @@ const UsdToCyclesMapping *FindMtlxMapping(const std::string &nodeTypeId)
     return isVector ? &kDivV : &kDiv;
   }
 
+  /* Le suffixe ne se lit pas par prefixe : `ND_convert_color3_surfaceshader`
+   * et ses sept freres commencent comme le passe-plat et n'en sont pas un. */
+  if (nodeTypeId.starts_with("ND_convert_") && nodeTypeId.ends_with("_surfaceshader")) {
+    return &MtlxConvertSurface();
+  }
+
   const UsdToCyclesMapping *best = nullptr;
   size_t bestLength = 0;
   for (const MtlxEntry &entry : MtlxTable()) {
