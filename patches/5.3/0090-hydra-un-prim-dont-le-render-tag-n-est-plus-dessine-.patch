From 202c01c0f9f763a24978ba2920a527ee0a1868c2 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Thu, 8 Oct 2026 01:01:33 +0200
Subject: [PATCH 90/98] hydra: un prim dont le render tag n'est plus dessine
 disparait du rendu

Les render tags (les purposes affichees dans Solaris) decident des prims
qu'Hydra synchronise, mais un prim deja construit restait dans la scene
Cycles quand on eteignait son tag. La passe de rendu compare les tags a
chaque execution et masque ou remontre les prims concernes. Sous husk,
mesure : ni proxy ni guide ne sont rendus, comme avant ; le basculement a
chaud ne se mesure que dans Houdini.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/hydra/geometry.h      | 14 +++++++++++++-
 src/hydra/geometry.inl    | 17 ++++++++++++++++-
 src/hydra/render_pass.cpp | 23 ++++++++++++++++++++++-
 src/hydra/render_pass.h   |  4 ++++
 4 files changed, 55 insertions(+), 3 deletions(-)

diff --git a/src/hydra/geometry.h b/src/hydra/geometry.h
index 36479edc..5b029c35 100644
--- a/src/hydra/geometry.h
+++ b/src/hydra/geometry.h
@@ -12,7 +12,16 @@
 
 HDCYCLES_NAMESPACE_OPEN_SCOPE
 
-template<typename Base, typename CyclesBase> class HdCyclesGeometry : public Base {
+/* What the render pass needs to hide a prim whose render tag it does not
+ * draw: Hydra stops syncing such a prim but leaves what it already built. */
+class HdCyclesTaggedPrim {
+ public:
+  virtual ~HdCyclesTaggedPrim() = default;
+  virtual void SetTagVisible(bool visible, PXR_NS::HdRenderParam *renderParam) = 0;
+};
+
+template<typename Base, typename CyclesBase>
+class HdCyclesGeometry : public Base, public HdCyclesTaggedPrim {
  public:
   HdCyclesGeometry(const PXR_NS::SdfPath &rprimId);
 
@@ -25,6 +34,8 @@ template<typename Base, typename CyclesBase> class HdCyclesGeometry : public Bas
 
   void Finalize(PXR_NS::HdRenderParam *renderParam) override;
 
+  void SetTagVisible(bool visible, PXR_NS::HdRenderParam *renderParam) override;
+
  protected:
   void _InitRepr(const PXR_NS::TfToken &reprToken, PXR_NS::HdDirtyBits *dirtyBits) override;
 
@@ -46,6 +57,7 @@ template<typename Base, typename CyclesBase> class HdCyclesGeometry : public Bas
    * geometrie qui se deforme. */
   bool _motionBlur = false;
   HdCyclesObjectProperties _objectProperties;
+  bool _tagVisible = true;
   float _shutterOpen = 0.0f;
   float _shutterClose = 0.0f;
   /* L'obturateur est en images, les velocites d'USD en unites par seconde :
diff --git a/src/hydra/geometry.inl b/src/hydra/geometry.inl
index 6ee57fc6..f1ec2537 100644
--- a/src/hydra/geometry.inl
+++ b/src/hydra/geometry.inl
@@ -51,6 +51,21 @@ HdDirtyBits HdCyclesGeometry<Base, CyclesBase>::GetInitialDirtyBitsMask() const
          HdChangeTracker::DirtyInstancer | HdChangeTracker::DirtyCategories;
 }
 
+template<typename Base, typename CyclesBase>
+void HdCyclesGeometry<Base, CyclesBase>::SetTagVisible(const bool visible,
+                                                       HdRenderParam *renderParam)
+{
+  if (visible == _tagVisible) {
+    return;
+  }
+  _tagVisible = visible;
+  const SceneLock lock(renderParam);
+  for (Object *instance : _instances) {
+    _objectProperties.Apply(instance, Base::IsVisible() && _tagVisible);
+    instance->tag_update(lock.scene);
+  }
+}
+
 template<typename Base, typename CyclesBase>
 HdDirtyBits HdCyclesGeometry<Base, CyclesBase>::_PropagateDirtyBits(HdDirtyBits bits) const
 {
@@ -319,7 +334,7 @@ void HdCyclesGeometry<Base, CyclesBase>::Sync(HdSceneDelegate *sceneDelegate,
       HdChangeTracker::IsInstancerDirty(*dirtyBits, id))
   {
     for (Object *instance : _instances) {
-      _objectProperties.Apply(instance, Base::IsVisible());
+      _objectProperties.Apply(instance, Base::IsVisible() && _tagVisible);
     }
   }
 
