 void HdCyclesRenderPass::_Execute(const HdRenderPassStateSharedPtr &renderPassState,
-                                  const TfTokenVector & /*renderTags*/)
+                                  const TfTokenVector &renderTags)
 {
   Scene *const scene = _renderParam->session->scene.get();
   Session *const session = _renderParam->session;
@@ -113,6 +114,26 @@ void HdCyclesRenderPass::_Execute(const HdRenderPassStateSharedPtr &renderPassSt
   /* Motion blur turned back on, or the shutter moved: the prims synced so far
    * carry no motion samples, or samples over the old shutter. Have them synced
    * again; the render index does it before the next execution. */
+  /* Render tags - Solaris' display purposes - decide which prims Hydra syncs,
+   * but a prim already built stays in the Cycles scene when its tag is
+   * turned off: hide it, and show it again when the tag comes back. */
+  if (!_renderTagsApplied || renderTags != _renderTags) {
+    _renderTags = renderTags;
+    _renderTagsApplied = true;
+    HdRenderIndex *const index = GetRenderIndex();
+    for (const SdfPath &id : index->GetRprimIds()) {
+      /* The render index hands its prims out const; this delegate made them. */
+      HdRprim *const rprim = const_cast<HdRprim *>(index->GetRprim(id));
+      if (auto *const tagged = dynamic_cast<HdCyclesTaggedPrim *>(rprim)) {
+        const bool shown = renderTags.empty() || std::find(renderTags.begin(),
+                                                           renderTags.end(),
+                                                           rprim->GetRenderTag()) !=
+                                                     renderTags.end();
+        tagged->SetTagVisible(shown, _renderParam);
+      }
+    }
+  }
+
   if (_renderParam->TakeMotionResync()) {
     GetRenderIndex()->GetChangeTracker().MarkAllRprimsDirty(
         HdChangeTracker::DirtyTransform | HdChangeTracker::DirtyPoints |
