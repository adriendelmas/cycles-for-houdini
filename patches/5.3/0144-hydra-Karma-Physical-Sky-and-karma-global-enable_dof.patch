+void HdCyclesSession::SetSun(const float3 &direction, const float3 &strength)
+{
+  if (_hasSun && _sunDirection == direction && _sunStrength == strength) {
+    return;
+  }
+  _hasSun = true;
+  _sunDirection = direction;
+  _sunStrength = strength;
+  for (HdCyclesLight *light : _atmospheres) {
+    light->SetSun(direction, strength);
+  }
+}
+
+bool HdCyclesSession::GetSun(float3 *direction, float3 *strength) const
+{
+  if (!_hasSun) {
+    return false;
+  }
+  *direction = _sunDirection;
+  *strength = _sunStrength;
+  return true;
+}
+
+void HdCyclesSession::AddAtmosphere(HdCyclesLight *light)
+{
+  _atmospheres.insert(light);
+}
+
+void HdCyclesSession::RemoveAtmosphere(HdCyclesLight *light)
+{
+  _atmospheres.erase(light);
+}
