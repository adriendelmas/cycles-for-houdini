diff --git a/src/hydra/object_properties.cpp b/src/hydra/object_properties.cpp
new file mode 100644
index 00000000..8f50fb5f
--- /dev/null
+++ b/src/hydra/object_properties.cpp
@@ -0,0 +1,179 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#include "hydra/object_properties.h"
+#include "hydra/util.h"
+#include "kernel/types.h"
+#include "scene/object.h"
+
+#include <pxr/base/tf/stringUtils.h>
+#include <pxr/imaging/hd/primvarSchema.h>
+
+HDCYCLES_NAMESPACE_OPEN_SCOPE
+
+namespace {
+
+const std::string kCycles = "cycles:object:";
+const std::string kKarma = "karma:object:";
+
+/* One ray type of Karma's visibility expressions, as Cycles bits. Karma's
+ * `sss` rays have no Cycles visibility flag of their own. */
+uint KarmaRay(const std::string &name)
+{
+  if (name == "*") {
+    return PATH_RAY_VISIBILITY_ALL;
+  }
+  if (name == "primary" || name == "camera") {
+    return PATH_RAY_VISIBILITY_CAMERA;
+  }
+  if (name == "shadow") {
+    return PATH_RAY_VISIBILITY_SHADOW;
+  }
+  if (name == "diffuse") {
+    return PATH_RAY_VISIBILITY_DIFFUSE;
+  }
+  if (name == "reflect" || name == "glossy") {
+    return PATH_RAY_VISIBILITY_GLOSSY;
+  }
+  if (name == "refract" || name == "transmission") {
+    return PATH_RAY_VISIBILITY_TRANSMIT;
+  }
+  if (name == "volume") {
+    return PATH_RAY_VISIBILITY_VOLUME_SCATTER;
+  }
+  return 0;
+}
+
+bool ReadBool(const HdPrimvarsSchema &primvars, const std::string &name, bool &out)
+{
+  const VtValue value = ReadPrimvar(primvars, TfToken(name));
+  if (value.IsEmpty()) {
+    return false;
+  }
+  if (value.IsHolding<bool>()) {
+    out = value.UncheckedGet<bool>();
+    return true;
+  }
+  if (value.CanCast<int>()) {
+    out = VtValue::Cast<int>(value).UncheckedGet<int>() != 0;
+    return true;
+  }
+  return false;
+}
+
+bool ReadFloat(const HdPrimvarsSchema &primvars, const std::string &name, float &out)
+{
+  const VtValue value = ReadPrimvar(primvars, TfToken(name));
+  if (!value.IsEmpty() && value.CanCast<float>()) {
+    out = VtValue::Cast<float>(value).UncheckedGet<float>();
+    return true;
+  }
+  return false;
+}
+
+bool ReadString(const HdPrimvarsSchema &primvars, const std::string &name, std::string &out)
+{
+  const VtValue value = ReadPrimvar(primvars, TfToken(name));
+  if (value.IsHolding<std::string>()) {
+    out = value.UncheckedGet<std::string>();
+    return true;
+  }
+  if (value.IsHolding<TfToken>()) {
+    out = value.UncheckedGet<TfToken>().GetString();
+    return true;
+  }
+  return false;
+}
+
+}  // namespace
+
+uint HdCyclesObjectProperties::ParseKarmaVisibility(const std::string &expression)
+{
+  /* A union (`|`) of intersections (`&`) of ray names, each one negated by a
+   * leading `-`. Empty: seen by nothing. */
+  uint result = 0;
+  for (const std::string &term : TfStringSplit(expression, "|")) {
+    uint bits = PATH_RAY_VISIBILITY_ALL;
+    bool any = false;
+    for (std::string factor : TfStringSplit(term, "&")) {
+      factor = TfStringTrim(factor);
+      if (factor.empty()) {
+        continue;
+      }
+      any = true;
+      if (factor[0] == '-') {
+        bits &= ~KarmaRay(TfStringTrim(factor.substr(1)));
+      }
+      else {
+        bits &= KarmaRay(factor);
+      }
+    }
+    if (any) {
+      result |= bits;
+    }
+  }
+  return result;
+}
+
+HdCyclesObjectProperties HdCyclesObjectProperties::Read(const HdPrimvarsSchema &primvars)
+{
+  HdCyclesObjectProperties p;
+  p.visibility = PATH_RAY_VISIBILITY_ALL;
+  if (!primvars) {
+    return p;
+  }
+
+  /* Karma's first, so that the Cycles names authored next to them win. */
+  std::string expression;
+  if (ReadString(primvars, kKarma + "rendervisibility", expression)) {
+    p.visibility = ParseKarmaVisibility(expression);
+  }
+  float holdoutMode = 0.0f;
+  if (ReadFloat(primvars, kKarma + "holdoutmode", holdoutMode)) {
+    /* Karma's matte cuts the object out of the image, alpha and all: a
+     * Cycles holdout. Its background mode keeps the shadows and reflections
+     * the object receives over a transparent film: a shadow catcher. */
+    p.holdout = int(holdoutMode) == 1;
+    p.shadowCatcher = int(holdoutMode) == 2;
+  }
+
+  static const std::pair<const char *, uint> rays[] = {
+      {"visibility:camera", PATH_RAY_VISIBILITY_CAMERA},
+      {"visibility:diffuse", PATH_RAY_VISIBILITY_DIFFUSE},
+      {"visibility:glossy", PATH_RAY_VISIBILITY_GLOSSY},
+      {"visibility:transmission", PATH_RAY_VISIBILITY_TRANSMIT},
+      {"visibility:shadow", PATH_RAY_VISIBILITY_SHADOW},
+      {"visibility:volume_scatter", PATH_RAY_VISIBILITY_VOLUME_SCATTER},
+  };
+  for (const auto &[name, bit] : rays) {
+    bool seen = true;
+    if (ReadBool(primvars, kCycles + name, seen)) {
+      p.visibility = seen ? (p.visibility | bit) : (p.visibility & ~bit);
+    }
+  }
+
+  ReadBool(primvars, kCycles + "holdout", p.holdout);
+  ReadBool(primvars, kCycles + "shadow_catcher", p.shadowCatcher);
+  ReadBool(primvars, kCycles + "caustics_caster", p.causticsCaster);
+  ReadBool(primvars, kCycles + "caustics_receiver", p.causticsReceiver);
+  ReadString(primvars, kCycles + "lightgroup", p.lightgroup);
+  ReadFloat(primvars, kCycles + "shadow_terminator_shading_offset", p.terminatorShadingOffset);
+  ReadFloat(primvars, kCycles + "shadow_terminator_geometry_offset", p.terminatorGeometryOffset);
+  ReadFloat(primvars, kCycles + "dicing_rate", p.dicingRate);
+  return p;
+}
+
+void HdCyclesObjectProperties::Apply(Object *object, const bool visible) const
+{
+  object->set_visibility(visible ? (visibility & PATH_RAY_VISIBILITY_ALL) : 0);
+  object->set_use_holdout(holdout);
+  object->set_is_shadow_catcher(shadowCatcher);
+  object->set_is_caustics_caster(causticsCaster);
+  object->set_is_caustics_receiver(causticsReceiver);
+  object->set_lightgroup(ustring(lightgroup));
+  object->set_shadow_terminator_shading_offset(terminatorShadingOffset);
+  object->set_shadow_terminator_geometry_offset(terminatorGeometryOffset);
+}
+
+HDCYCLES_NAMESPACE_CLOSE_SCOPE
