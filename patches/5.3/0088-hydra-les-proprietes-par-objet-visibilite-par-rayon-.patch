@@ -0,0 +1,45 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include "hydra/config.h"
+#include "util/types.h"
+#include "util/unique_ptr.h"
+
+#include <pxr/imaging/hd/primvarsSchema.h>
+
+#include <string>
+
+HDCYCLES_NAMESPACE_OPEN_SCOPE
+
+/* What a prim says about the Cycles objects drawing it, as constant primvars:
+ * `primvars:cycles:object:*`, the names Houdini's Render Geometry Settings
+ * node writes from HdCyclesPlugin_Geometry.ds, and the Karma ones a scene set
+ * up for Karma already carries (`primvars:karma:object:rendervisibility`,
+ * `holdoutmode`). The Cycles names win where both are authored. */
+struct HdCyclesObjectProperties {
+  /* PATH_RAY_VISIBILITY_* bits. */
+  uint visibility = ~0u;
+  bool holdout = false;
+  bool shadowCatcher = false;
+  bool causticsCaster = false;
+  bool causticsReceiver = false;
+  std::string lightgroup;
+  float terminatorShadingOffset = 0.0f;
+  float terminatorGeometryOffset = 0.1f;
+  /* Pixels per micropolygon for this prim; 0 keeps the render setting. */
+  float dicingRate = 0.0f;
+
+  static HdCyclesObjectProperties Read(const PXR_NS::HdPrimvarsSchema &primvars);
+
+  /* Sets the object's sockets. `visible` is the prim's own visibility. */
+  void Apply(CCL_NS::Object *object, bool visible) const;
+
+  /* Karma's render visibility: `*`, `primary|shadow`, `-diffuse&-reflect`...
+   * Exposed for tests. */
+  static uint ParseKarmaVisibility(const std::string &expression);
+};
+
+HDCYCLES_NAMESPACE_CLOSE_SCOPE
