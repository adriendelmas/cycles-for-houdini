@@ -456,6 +456,14 @@ void HdCyclesSession::SyncAovBindings(const HdRenderPassAovBindingVector &aovBin
       pass->set_name(ustring(string_printf("%s%02d", prefix, i)));
     }
   }
+  /* Without its own passes a shadow catcher is folded into the beauty
+   * approximately, as Blender does - otherwise it would render as plain
+   * geometry. */
+  bool shadowCatcherPass = false;
+  for (const Pass *pass : scene->passes) {
+    shadowCatcherPass |= pass->get_type() == PASS_SHADOW_CATCHER;
+  }
+  scene->film->set_use_approximate_shadow_catcher(!shadowCatcherPass);
   scene->film->set_cryptomatte_passes(CryptomatteType(cryptoKinds));
   scene->film->set_cryptomatte_depth(cryptoLayers);
 }
