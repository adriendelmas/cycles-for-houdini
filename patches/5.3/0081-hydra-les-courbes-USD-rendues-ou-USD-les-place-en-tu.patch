+namespace {
+
+/* Each key a weighted sum of input elements. */
+template<typename T, typename W> VtArray<T> ApplyWeights(const VtArray<T> &in, const W &weights)
+{
+  VtArray<T> out(weights.size());
+  for (size_t k = 0; k < weights.size(); ++k) {
+    T sum = in[weights[k].index[0]] * weights[k].weight[0];
+    for (int i = 1; i < weights[k].count; ++i) {
+      sum += in[weights[k].index[i]] * weights[k].weight[i];
+    }
+    out[k] = sum;
+  }
+  return out;
+}
+
+/* A primvar array, resampled to the Cycles keys. Returns an empty value when
+ * the array does not have the size the topology expects. */
+template<typename W>
+VtValue ApplyWeights(const VtValue &value, const W &weights, const size_t expected)
+{
+  if (value.GetArraySize() != expected) {
+    return VtValue();
+  }
+  if (value.IsHolding<VtFloatArray>()) {
+    return VtValue(ApplyWeights(value.UncheckedGet<VtFloatArray>(), weights));
+  }
+  if (value.IsHolding<VtVec2fArray>()) {
+    return VtValue(ApplyWeights(value.UncheckedGet<VtVec2fArray>(), weights));
+  }
+  if (value.IsHolding<VtVec3fArray>()) {
+    return VtValue(ApplyWeights(value.UncheckedGet<VtVec3fArray>(), weights));
+  }
+  if (value.IsHolding<VtVec4fArray>()) {
+    return VtValue(ApplyWeights(value.UncheckedGet<VtVec4fArray>(), weights));
+  }
+  return VtValue();
+}
+
+/* Cubic basis functions, at parameter t of a segment. */
+void BezierWeights(const float t, float w[4])
+{
+  const float s = 1.0f - t;
+  w[0] = s * s * s;
+  w[1] = 3.0f * t * s * s;
+  w[2] = 3.0f * t * t * s;
+  w[3] = t * t * t;
+}
+
+void BsplineWeights(const float t, float w[4])
+{
+  const float t2 = t * t;
+  const float t3 = t2 * t;
+  w[0] = (1.0f - 3.0f * t + 3.0f * t2 - t3) / 6.0f;
+  w[1] = (4.0f - 6.0f * t2 + 3.0f * t3) / 6.0f;
+  w[2] = (1.0f + 3.0f * t + 3.0f * t2 - 3.0f * t3) / 6.0f;
+  w[3] = t3 / 6.0f;
+}
+
