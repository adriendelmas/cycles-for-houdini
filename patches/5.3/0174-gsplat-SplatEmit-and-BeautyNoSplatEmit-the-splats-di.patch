 src/hydra/output_driver.cpp                   |  23 ++++++
 src/hydra/output_driver.h                     |   5 ++
 src/hydra/resources/cycles_aovs.py            |   4 +
 src/hydra/resources/otls/hdcycles_aovs.hda    | Bin 16073 -> 16934 bytes
 .../otls/hdcycles_render_settings.hda         | Bin 76643 -> 77579 bytes
 src/hydra/session.cpp                         |  76 ++++++++++++++++++
 src/hydra/session.h                           |   8 ++
 src/kernel/data_template.h                    |   6 ++
 src/kernel/integrator/intersect_closest.h     |  25 +++++-
 src/scene/film.cpp                            |   5 ++
 10 files changed, 150 insertions(+), 2 deletions(-)

diff --git a/src/hydra/output_driver.cpp b/src/hydra/output_driver.cpp
index 3687497b..696acb0e 100644
--- a/src/hydra/output_driver.cpp
+++ b/src/hydra/output_driver.cpp
@@ -49,6 +49,27 @@ void HdCyclesOutputDriver::MultiplyByColor(const Tile &tile,
   }
 }
 
+void HdCyclesOutputDriver::AddPass(const Tile &tile,
+                                        const TfToken &aovName,
+                                        const size_t channels,
+                                        float *pixels) const
+{
+  const std::string *add = _renderParam->AddPassName(aovName);
+  if (!add || channels < 3) {
+    return;
+  }
+  const size_t count = size_t(tile.size.x) * size_t(tile.size.y);
+  std::vector<float> other(count * 3);
+  if (!tile.get_pass_pixels(*add, 3, other.data())) {
+    return;
+  }
+  for (size_t i = 0; i < count; ++i) {
+    for (size_t c = 0; c < 3; ++c) {
+      pixels[i * channels + c] += other[i * 3 + c];
+    }
+  }
+}
+
 bool HdCyclesOutputDriver::update_render_tile(const Tile &tile)
 {
   std::vector<float> pixels;
@@ -73,6 +94,7 @@ bool HdCyclesOutputDriver::update_render_tile(const Tile &tile)
         float *const data = static_cast<float *>(renderBuffer->Map());
         TF_VERIFY(tile.get_pass_pixels(_renderParam->PassName(aovBinding.aovName), channels, data));
         MultiplyByColor(tile, aovBinding.aovName, channels, data);
+        AddPass(tile, aovBinding.aovName, channels, data);
         renderBuffer->Unmap();
       }
       else {
@@ -81,6 +103,7 @@ bool HdCyclesOutputDriver::update_render_tile(const Tile &tile)
                 _renderParam->PassName(aovBinding.aovName), channels, pixels.data()))
         {
           MultiplyByColor(tile, aovBinding.aovName, channels, pixels.data());
+          AddPass(tile, aovBinding.aovName, channels, pixels.data());
           const bool isId = aovBinding.aovName == HdAovTokens->primId ||
                             aovBinding.aovName == HdAovTokens->elementId ||
                             aovBinding.aovName == HdAovTokens->instanceId;
diff --git a/src/hydra/output_driver.h b/src/hydra/output_driver.h
index 431294c7..00792302 100644
--- a/src/hydra/output_driver.h
+++ b/src/hydra/output_driver.h
@@ -26,6 +26,11 @@ class HdCyclesOutputDriver final : public CCL_NS::OutputDriver {
                        const PXR_NS::TfToken &aovName,
                        size_t channels,
                        float *pixels) const;
+  /* Adds a pass to an AOV's colour channels, when it has one (session.h, AddPassName). */
+  void AddPass(const Tile &tile,
+               const PXR_NS::TfToken &aovName,
+               size_t channels,
+               float *pixels) const;
 
   HdCyclesSession *const _renderParam;
 };
