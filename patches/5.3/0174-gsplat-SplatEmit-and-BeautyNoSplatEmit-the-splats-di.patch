diff --git a/src/hydra/session.cpp b/src/hydra/session.cpp
index f7b8d855..729ce450 100644
--- a/src/hydra/session.cpp
+++ b/src/hydra/session.cpp
@@ -557,6 +557,8 @@ void HdCyclesSession::SyncAovBindings(const HdRenderPassAovBindingVector &aovBin
   _aovBindings = aovBindings;
   _passNames.clear();
   _colorPassNames.clear();
+  _addPassNames.clear();
+  std::set<TfToken> withoutGsplat;
   int cryptoKinds = CRYPT_NONE;
   int cryptoLayers = 0;
   for (const HdRenderPassAovBinding &aovBinding : aovBindings) {
@@ -581,6 +583,58 @@ void HdCyclesSession::SyncAovBindings(const HdRenderPassAovBindingVector &aovBin
       continue;
     }
 
+    /* The composited Gaussian splats' emission seen straight from the camera, a colour AOV
+     * pass the kernel finds by its name and writes instead of the beauty; and the beauty
+     * without it, which is then the beauty pass itself (denoised when the denoiser is on). The
+     * output driver adds the splats back to every other read of the beauty. */
+    static const std::string kGsplatEmission = "gsplat_emission";
+    static const std::string kWithoutGsplatEmission = "combined_without_gsplat_emission";
+    const std::string source = SettingString(aovBinding.aovSettings, "sourceName");
+    const bool gsplatEmission = name == kGsplatEmission || source == kGsplatEmission;
+    const bool withoutGsplatEmission = name == kWithoutGsplatEmission ||
+                                       source == kWithoutGsplatEmission;
+    if (gsplatEmission || withoutGsplatEmission) {
+      bool have = false;
+      for (const Pass *pass : scene->passes) {
+        have |= pass->get_name() == kGsplatEmission;
+      }
+      if (!have) {
+        Pass *pass = scene->create_node<Pass>();
+        pass->set_type(PASS_AOV_COLOR);
+        pass->set_mode(PassMode::NOISY);
+        pass->set_name(ustring(kGsplatEmission));
+      }
+    }
+    if (gsplatEmission) {
+      if (name != kGsplatEmission) {
+        _passNames[aovBinding.aovName] = kGsplatEmission;
+      }
+      continue;
+    }
+    if (withoutGsplatEmission) {
+      withoutGsplat.insert(aovBinding.aovName);
+      std::string beauty;
