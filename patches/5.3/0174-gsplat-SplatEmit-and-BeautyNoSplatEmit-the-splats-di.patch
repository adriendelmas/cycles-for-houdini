+    # without it (denoised with the beauty), computed by the delegate.
+    ("gsplatemission", "SplatEmit", "gsplat_emission"),
+    ("beautynogsplat", "BeautyNoSplatEmit", "combined_without_gsplat_emission"),
 ]
