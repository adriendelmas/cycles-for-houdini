diff --git a/src/scene/wet_state.cpp b/src/scene/wet_state.cpp
new file mode 100644
index 00000000..54c400f1
--- /dev/null
+++ b/src/scene/wet_state.cpp
@@ -0,0 +1,185 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#include "scene/wet_state.h"
+
+#include "device/device.h"
+#include "scene/devicescene.h"
+#include "scene/object.h"
+#include "scene/osl.h"
+#include "scene/scene.h"
+#include "scene/svm.h"
+
+#include "kernel/svm/wet_state.h"
+
+#include "util/log.h"
+#include "util/math.h"
+
+#include <algorithm>
+#include <cmath>
+
+CCL_NAMESPACE_BEGIN
+
+/* Node. */
+
+NODE_DEFINE(WetStateNode)
+{
+  NodeType *type = NodeType::add("wet_state", create, NodeType::SHADER);
+
+  SOCKET_IN_FLOAT(contact, "Contact", 0.0f);
+  SOCKET_IN_FLOAT(wet_rate, "Wet Rate", 1.0f);
+  SOCKET_IN_FLOAT(dry_time, "Dry Time", 1.0f);
+  SOCKET_IN_FLOAT(max_wet, "Max Wet", 1.0f);
+
+  SOCKET_OUT_FLOAT(wet, "Wet");
+
+  return type;
+}
+
+WetStateNode::WetStateNode() : ShaderNode(get_node_type()) {}
+
+void WetStateNode::compile(SVMCompiler &compiler)
+{
+  compiler.add_node(this,
+                    NODE_WET_STATE,
+                    SVMNodeWetState{
+                        .contact = compiler.input_float("Contact"),
+                        .wet_rate = compiler.input_float("Wet Rate"),
+                        .dry_time = compiler.input_float("Dry Time"),
+                        .max_wet = compiler.input_float("Max Wet"),
+                        .out_wet = compiler.output("Wet"),
+                    });
+}
+
+void WetStateNode::compile(OSLCompiler &compiler)
+{
+  compiler.add(this, "node_wet_state");
+}
+
+/* Manager. */
+
+void WetStateManager::device_update(Device * /*device*/, DeviceScene *dscene, Scene *scene)
+{
+  const size_t num = scene->objects.size();
+  /* At least one slot, so that the arrays always exist on the device. */
+  const size_t slots = std::max<size_t>(num, 1);
+
+  bool keys_changed = keys_.size() != num;
+  keys_.resize(num);
+  for (size_t i = 0; i < num; i++) {
+    const ustring key = scene->objects[i]->get_wet_key();
+    if (keys_[i] != key) {
+      keys_[i] = key;
+      keys_changed = true;
+    }
+  }
+
+  if (keys_changed || prev_dirty_) {
+    float *prev = dscene->wet_prev.alloc(slots);
+    for (size_t i = 0; i < slots; i++) {
+      prev[i] = 0.0f;
+      if (i < num && !keys_[i].empty()) {
+        const auto it = state_.find(keys_[i].string());
+        if (it != state_.end()) {
+          prev[i] = it->second;
+        }
+      }
+    }
+    dscene->wet_prev.copy_to_device();
+    prev_dirty_ = false;
+  }
+
+  if (keys_changed || reset_pending_) {
+    float *accum = dscene->wet_accum.alloc(slots * WET_ACCUM_STRIDE);
+    std::fill(accum, accum + slots * WET_ACCUM_STRIDE, 0.0f);
+    dscene->wet_accum.copy_to_device();
+    uint *count = dscene->wet_count.alloc(slots);
+    std::fill(count, count + slots, 0u);
+    dscene->wet_count.copy_to_device();
+    reset_pending_ = false;
+  }
+
+  dscene->data.integrator.wet_num_objects = int(num);
+  need_update_ = false;
+}
+
+void WetStateManager::device_free(Device * /*device*/, DeviceScene *dscene)
+{
+  dscene->wet_prev.free();
+  dscene->wet_accum.free();
+  dscene->wet_count.free();
+  keys_.clear();
+  need_update_ = true;
+  reset_pending_ = true;
+  prev_dirty_ = true;
+}
+
+void WetStateManager::tag_reset()
+{
+  reset_pending_ = true;
+  need_update_ = true;
+}
+
+void WetStateManager::read_back(DeviceScene *dscene)
+{
+  const thread_scoped_lock lock(mutex_);
+  if (dscene->wet_count.size() == 0 || dscene->wet_accum.size() == 0) {
+    return;
+  }
+  dscene->wet_accum.copy_from_device();
+  dscene->wet_count.copy_from_device();
+  accum_.resize(dscene->wet_accum.size());
+  std::copy(dscene->wet_accum.data(), dscene->wet_accum.data() + accum_.size(), accum_.data());
+  count_.resize(dscene->wet_count.size());
+  std::copy(dscene->wet_count.data(), dscene->wet_count.data() + count_.size(), count_.data());
+  have_readback_ = true;
+}
+
+bool WetStateManager::commit(const double dt)
+{
+  vector<float> accum;
+  vector<uint> count;
+  {
+    const thread_scoped_lock lock(mutex_);
+    if (!have_readback_) {
+      return false;
+    }
+    accum.swap(accum_);
+    count.swap(count_);
+    have_readback_ = false;
+  }
+
+  const size_t num = std::min(count.size(), keys_.size());
+  size_t seen = 0;
+  for (size_t i = 0; i < num; i++) {
+    if (count[i] == 0 || keys_[i].empty()) {
+      /* Unseen: the state stays as it was. */
+      continue;
+    }
+    seen++;
+    const float inv = 1.0f / float(count[i]);
+    const float contact = accum[i * WET_ACCUM_STRIDE + 0] * inv;
+    const float wet_rate = accum[i * WET_ACCUM_STRIDE + 1] * inv;
+    const float dry_time = accum[i * WET_ACCUM_STRIDE + 2] * inv;
+    const float max_wet = accum[i * WET_ACCUM_STRIDE + 3] * inv;
+
+    float &wet = state_[keys_[i].string()];
+    const float decay = (dry_time > 0.0f) ? expf(-float(dt) / dry_time) : 0.0f;
+    wet = clamp(wet * decay + wet_rate * float(dt) * contact, 0.0f, max_wet);
+  }
+
+  LOG_INFO << "Wet map: committed " << seen << " of " << num << " objects over " << dt << " s.";
+  prev_dirty_ = true;
+  need_update_ = true;
+  return true;
+}
+
+void WetStateManager::clear()
+{
+  state_.clear();
+  prev_dirty_ = true;
+  need_update_ = true;
+}
+
+CCL_NAMESPACE_END
diff --git a/src/scene/wet_state.h b/src/scene/wet_state.h
new file mode 100644
index 00000000..c7072177
--- /dev/null
+++ b/src/scene/wet_state.h
@@ -0,0 +1,88 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Wet map (addition): a value per object that the renderer keeps from one
+ * frame to the next. The Wet State shader node reads it and feeds this
+ * frame's contact into device accumulators; the manager sizes those to the
+ * objects, uploads the previous state before a render, reads the sums back
+ * when a render completes, and folds them into the state when the host says
+ * the frame changed. The state is kept by the object's `wet_key`, not by its
+ * index, which moves between frames. */
+
+#include "scene/shader_nodes.h"
+
+#include "util/thread.h"
+#include "util/vector.h"
+
+#include <string>
+#include <unordered_map>
+
+CCL_NAMESPACE_BEGIN
+
+class Device;
+class DeviceScene;
+class Scene;
+
+class WetStateNode : public ShaderNode {
+ public:
+  SHADER_NODE_CLASS(WetStateNode)
+
+  bool has_spatial_varying() override
+  {
+    return true;
+  }
+
+  NODE_SOCKET_API(float, contact)
+  NODE_SOCKET_API(float, wet_rate)
+  NODE_SOCKET_API(float, dry_time)
+  NODE_SOCKET_API(float, max_wet)
+};
+
+class WetStateManager {
+ public:
+  WetStateManager() = default;
+  ~WetStateManager() = default;
+
+  /* After the objects are updated: slots per object, previous state uploaded,
+   * accumulators zeroed when a reset is pending. */
+  void device_update(Device *device, DeviceScene *dscene, Scene *scene);
+  void device_free(Device *device, DeviceScene *dscene);
+
+  bool need_update() const
+  {
+    return need_update_;
+  }
+
+  /* A session reset: the accumulators of the render it cuts short are void. */
+  void tag_reset();
+
+  /* On the session thread, once a render completed: the sums come back. */
+  void read_back(DeviceScene *dscene);
+
+  /* On the host, when the frame changes: folds the last completed read-back
+   * into the state. `dt` is the time to the new frame, in seconds. Returns
+   * false when no completed render was read back since the last commit. */
+  bool commit(double dt);
+
+  void clear();
+
+ private:
+  bool need_update_ = true;
+  bool reset_pending_ = true;
+  bool prev_dirty_ = true;
+
+  /* The key of each object slot at the last device update. */
+  vector<ustring> keys_;
+  std::unordered_map<std::string, float> state_;
+
+  /* The read-back of the last completed render, under the mutex. */
+  thread_mutex mutex_;
+  bool have_readback_ = false;
+  vector<float> accum_;
+  vector<uint> count_;
+};
+
+CCL_NAMESPACE_END
