+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#include "stdcycles.h"
+
+/* Wet map (addition). OSL has no access to the per-object state the SVM node
+ * keeps across frames: the OSL form shows the current contact only. */
+shader node_wet_state(float Contact = 0.0,
+                      float WetRate = 1.0,
+                      float DryTime = 1.0,
+                      float MaxWet = 1.0,
+                      output float Wet = 0.0)
+{
+  Wet = min(Contact, MaxWet);
+}
