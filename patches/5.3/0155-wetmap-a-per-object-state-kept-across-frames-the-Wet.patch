diff --git a/src/kernel/svm/wet_state.h b/src/kernel/svm/wet_state.h
new file mode 100644
index 00000000..dfd619a9
--- /dev/null
+++ b/src/kernel/svm/wet_state.h
@@ -0,0 +1,69 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Wet map (addition): a value per object that persists from one frame to the
+ * next. The node reads what the previous frame left for this object and, on
+ * the first samples of the primary camera hits, adds what it sees now to an
+ * accumulator the host folds into the state when the frame changes. */
+
+#include "kernel/globals.h"
+
+#include "kernel/svm/aov.h"
+#include "kernel/svm/node_types.h"
+#include "kernel/svm/util.h"
+
+#include "util/atomic.h"
+
+CCL_NAMESPACE_BEGIN
+
+/* Per object: the sums of contact, wet rate, dry time and max wet. */
+#define WET_ACCUM_STRIDE 4
+
+template<uint node_feature_mask, typename ConstIntegratorGenericState>
+ccl_device_noinline void svm_node_wet_state(KernelGlobals kg,
+                                            ConstIntegratorGenericState state,
+                                            ccl_private ShaderData *sd,
+                                            ccl_private float *ccl_restrict stack,
+                                            const ccl_global SVMNodeWetState &ccl_restrict node,
+                                            ccl_global float *render_buffer,
+                                            const uint32_t path_flag)
+{
+  const float contact = stack_load(stack, node.contact);
+  const float max_wet = stack_load(stack, node.max_wet);
+  float wet = fminf(contact, max_wet);
+
+  const int object = sd->object;
+  if (object != OBJECT_NONE && object < kernel_data.integrator.wet_num_objects) {
+    /* What the previous frame left, and the contact of this one at once:
+     * wetting shows on the frame it happens, drying waits for the commit. */
+    const float prev = kernel_data_array(wet_prev)[object];
+    wet = fminf(fmaxf(prev, contact), max_wet);
+
+    IF_KERNEL_NODES_FEATURE(AOV)
+    {
+      /* Primary camera hits only, as the AOV nodes, and not the second
+       * shading of a shadow catcher; the first samples suffice (every sample
+       * covers the same pixels) and keep the float sums short. */
+      if (svm_node_aov_check(path_flag, render_buffer) &&
+          !(path_flag & PATH_RAY_SHADOW_CATCHER_PASS) &&
+          INTEGRATOR_STATE(state, path, sample) < kernel_data.integrator.wet_accum_samples)
+      {
+        ccl_global float *accum = kernel_data_array(wet_accum) + object * WET_ACCUM_STRIDE;
+        atomic_add_and_fetch_float(accum + 0, contact);
+        atomic_add_and_fetch_float(accum + 1, stack_load(stack, node.wet_rate));
+        atomic_add_and_fetch_float(accum + 2, stack_load(stack, node.dry_time));
+        atomic_add_and_fetch_float(accum + 3, max_wet);
+        atomic_fetch_and_add_uint32(kernel_data_array(wet_count) + object, 1u);
+      }
+    }
+  }
+
+  if (stack_valid(node.out_wet)) {
+    stack_store_float(stack, node.out_wet, wet);
+  }
+}
+
+CCL_NAMESPACE_END
