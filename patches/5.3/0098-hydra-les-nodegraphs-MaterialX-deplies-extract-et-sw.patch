+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include "hydra/config.h"
+
+#include <pxr/imaging/hd/materialNetworkSchema.h>
+
+#include <functional>
+#include <string>
+
+HDCYCLES_NAMESPACE_OPEN_SCOPE
+
+/* Whether the delegate turns a node of this identifier into Cycles nodes. */
+using HdCyclesNodeTranslatable = std::function<bool(const std::string &nodeTypeId)>;
+
+/* Expands, in a Hydra material network, the MaterialX nodes the delegate has
+ * no translation for but whose nodedef the MaterialX library defines as a
+ * nodegraph of simpler nodes - `switch` is ten `ifgreater`, `ramp4` three
+ * `mix`, every `hmtlx*` node of Houdini is a nodegraph - into those nodes,
+ * wired the way the nodegraph wires them, with the outer node's connections
+ * and values carried onto the inner nodes' interface inputs and the nodedef's
+ * own defaults where the outer node authored nothing. Repeats until nothing
+ * left expands, so a nodegraph made of nodegraphs lands on primitives.
+ *
+ * Two nodes with no nodegraph are rewritten by hand: `extract` becomes a
+ * `separate` node read on the indexed output, `swizzle` a `separate` and a
+ * `combine`. Returns the network as it came when nothing needed expanding. */
+PXR_NS::HdMaterialNetworkSchema ExpandMaterialXNodegraphs(
+    PXR_NS::HdMaterialNetworkSchema network, const HdCyclesNodeTranslatable &translatable);
+
+HDCYCLES_NAMESPACE_CLOSE_SCOPE
