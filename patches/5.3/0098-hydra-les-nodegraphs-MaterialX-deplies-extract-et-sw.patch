+      m.addHelper({"sep", "separate_xyz", {{"Y", "inv:Value2"}}, {}});
+    }
+    else {
+      m.addHelper({"sep", "separate_xyz", {{"X", "cmp:Value1"}}, {}});
+    }
+    m.addHelper({"tc", "texture_coordinate", {{"UV", "sep:Vector"}}, {}});
+    return m;
+  };
+  static const UsdToCyclesMapping kSplitLR = makeSplit(false);
+  static const UsdToCyclesMapping kSplitTB = makeSplit(true);
