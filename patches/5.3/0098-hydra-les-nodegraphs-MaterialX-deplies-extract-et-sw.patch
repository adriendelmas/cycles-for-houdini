     const SceneLock lock(renderParam);
 
@@ -3624,6 +3679,27 @@ void HdCyclesMaterial::UpdateConnections(NodeDesc &nodeDesc,
         continue;
       }
 
+      /* A helper may have wired this input as its default - a texture
+       * coordinate into a split's separate node. The network's own
+       * connection is what the material means: it takes the wire over. */
+      if (input->link != nullptr) {
+        /* Cycles slips a conversion node between sockets of different
+         * types - a point into a vector - so the wire's source is read
+         * through those. */
+        ShaderNode *source = input->link->parent;
+        while (source != nullptr && source->special_type == SHADER_SPECIAL_TYPE_AUTOCONVERT &&
+               !source->inputs.empty() && source->inputs[0]->link != nullptr)
+        {
+          source = source->inputs[0]->link->parent;
+        }
+        bool fromHelper = false;
+        for (const auto &helper : nodeDesc.helperNodes) {
+          fromHelper |= helper.second == source;
+        }
+        if (fromHelper) {
+          shaderGraph->disconnect(input);
+        }
+      }
       shaderGraph->connect(output, input);
     }
   }
