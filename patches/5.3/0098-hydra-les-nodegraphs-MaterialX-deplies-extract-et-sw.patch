+HDCYCLES_NAMESPACE_OPEN_SCOPE
+
+namespace mx = MaterialX;
+
+namespace {
+
+/* The MaterialX node library Houdini ships, read once. `CYCLES_MATERIALX_LIBRARIES`
+ * names a folder holding `libraries/` to read instead; `$HFS/houdini/materialx`
+ * is where Houdini keeps its own, which is also what Karma renders from. */
+mx::DocumentPtr Library()
+{
+  static const mx::DocumentPtr document = [] {
+    mx::DocumentPtr doc = mx::createDocument();
+    mx::FileSearchPath searchPath;
+    const std::string override = TfGetenv("CYCLES_MATERIALX_LIBRARIES");
+    if (!override.empty()) {
+      searchPath.append(mx::FilePath(override));
+    }
+    const std::string hfs = TfGetenv("HFS");
+    if (!hfs.empty()) {
+      searchPath.append(mx::FilePath(hfs + "/houdini/materialx"));
+    }
+    searchPath.append(mx::getDefaultDataSearchPath());
+    try {
+      mx::loadLibraries(mx::FilePathVec{mx::FilePath("libraries")}, searchPath, doc);
+    }
+    catch (const std::exception &e) {
+      LOG_WARNING << "MaterialX: could not read the node library: " << e.what()
+                  << ". Nodes defined as nodegraphs will not be expanded.";
+    }
+    LOG_INFO << "MaterialX: node library read, " << doc->getNodeDefs().size() << " nodedefs.";
+    return doc;
+  }();
+  return document;
+}
+
+const TfToken kOut("out");
+
+struct Conn {
+  TfToken upstream;
+  TfToken output;
+};
+
+/* A node of the network, as read from Hydra or made here. */
+struct Node {
+  TfToken typeId;
+  /* The parameter container Hydra handed over, kept for nodes that came from
+   * it; null for a node made here, whose `params` are the whole story. */
+  HdContainerDataSourceHandle originalParams;
+  std::map<TfToken, VtValue> params;
+  std::map<TfToken, std::vector<Conn>> conns;
+  /* Everything else Hydra put on the node, to carry across unchanged. */
+  HdContainerDataSourceHandle original;
+};
+
+struct Network {
+  std::map<TfToken, Node> nodes;
+  std::map<TfToken, Conn> terminals;
+  HdContainerDataSourceHandle original;
+  bool changed = false;
+};
+
+std::string OutputOr(const std::string &name)
+{
+  return name.empty() ? kOut.GetString() : name;
+}
+
+std::string Prefix(const TfToken &name, const std::string &child)
+{
+  const std::string &s = name.GetString();
+  return (!s.empty() && s[0] == '/') ? s + "/" + child : s + "__" + child;
+}
+
+/* A MaterialX value as the type Hydra would carry for it. */
+VtValue MxValue(const std::string &type, const std::string &valueString)
+{
+  if (valueString.empty()) {
+    return VtValue();
+  }
+  mx::ValuePtr value;
+  try {
+    value = mx::Value::createValueFromStrings(valueString, type);
+  }
+  catch (const std::exception &) {
+    return VtValue();
+  }
+  if (!value) {
+    return VtValue();
+  }
+  if (type == "float") {
+    return VtValue(value->asA<float>());
+  }
+  if (type == "integer") {
+    return VtValue(value->asA<int>());
+  }
+  if (type == "boolean") {
+    return VtValue(value->asA<bool>());
+  }
+  if (type == "string") {
+    return VtValue(value->asA<std::string>());
+  }
+  if (type == "filename") {
+    return VtValue(SdfAssetPath(value->asA<std::string>()));
+  }
+  if (type == "color3") {
+    const mx::Color3 c = value->asA<mx::Color3>();
+    return VtValue(GfVec3f(c[0], c[1], c[2]));
+  }
+  if (type == "vector3") {
+    const mx::Vector3 v = value->asA<mx::Vector3>();
+    return VtValue(GfVec3f(v[0], v[1], v[2]));
+  }
+  if (type == "color4") {
+    const mx::Color4 c = value->asA<mx::Color4>();
+    return VtValue(GfVec4f(c[0], c[1], c[2], c[3]));
+  }
+  if (type == "vector4") {
+    const mx::Vector4 v = value->asA<mx::Vector4>();
+    return VtValue(GfVec4f(v[0], v[1], v[2], v[3]));
+  }
+  if (type == "vector2") {
+    const mx::Vector2 v = value->asA<mx::Vector2>();
+    return VtValue(GfVec2f(v[0], v[1]));
+  }
+  return VtValue();
+}
+
+/* ---- Reading the network ------------------------------------------------ */
+
+Network Read(HdMaterialNetworkSchema network)
+{
+  Network net;
+  net.original = network.GetContainer();
+
+  HdMaterialNodeContainerSchema nodes = network.GetNodes();
+  for (const TfToken &name : nodes.GetNames()) {
+    HdMaterialNodeSchema nodeSchema = nodes.Get(name);
+    Node node;
+    node.original = nodeSchema.GetContainer();
+    if (auto ds = nodeSchema.GetNodeIdentifier()) {
+      node.typeId = ds->GetTypedValue(0.0f);
+    }
+    HdMaterialNodeParameterContainerSchema params = nodeSchema.GetParameters();
+    node.originalParams = params.GetContainer();
+    for (const TfToken &pname : params.GetNames()) {
+      if (auto ds = params.Get(pname).GetValue()) {
+        node.params[pname] = ds->GetValue(0.0f);
+      }
+    }
+    HdMaterialConnectionVectorContainerSchema conns = nodeSchema.GetInputConnections();
+    for (const TfToken &cname : conns.GetNames()) {
+      HdMaterialConnectionVectorSchema vec = conns.Get(cname);
+      std::vector<Conn> list;
+      for (size_t i = 0; i < vec.GetNumElements(); ++i) {
+        HdMaterialConnectionSchema c = vec.GetElement(i);
+        Conn conn;
+        if (auto ds = c.GetUpstreamNodePath()) {
+          conn.upstream = ds->GetTypedValue(0.0f);
+        }
+        if (auto ds = c.GetUpstreamNodeOutputName()) {
+          conn.output = ds->GetTypedValue(0.0f);
+        }
+        list.push_back(conn);
+      }
+      node.conns[cname] = std::move(list);
+    }
+    net.nodes[name] = std::move(node);
+  }
+
+  HdMaterialConnectionContainerSchema terminals = network.GetTerminals();
+  for (const TfToken &name : terminals.GetNames()) {
+    HdMaterialConnectionSchema c = terminals.Get(name);
+    Conn conn;
+    if (auto ds = c.GetUpstreamNodePath()) {
+      conn.upstream = ds->GetTypedValue(0.0f);
+    }
+    if (auto ds = c.GetUpstreamNodeOutputName()) {
+      conn.output = ds->GetTypedValue(0.0f);
+    }
+    net.terminals[name] = conn;
+  }
+  return net;
+}
+
+/* ---- Writing it back ---------------------------------------------------- */
+
+HdContainerDataSourceHandle ConnectionDs(const Conn &conn)
+{
+  return HdMaterialConnectionSchema::Builder()
+      .SetUpstreamNodePath(HdRetainedTypedSampledDataSource<TfToken>::New(conn.upstream))
+      .SetUpstreamNodeOutputName(HdRetainedTypedSampledDataSource<TfToken>::New(conn.output))
+      .Build();
+}
+
+HdContainerDataSourceHandle ConnectionsDs(const std::map<TfToken, std::vector<Conn>> &conns)
+{
+  std::vector<TfToken> names;
+  std::vector<HdDataSourceBaseHandle> values;
+  for (const auto &[name, list] : conns) {
+    std::vector<HdDataSourceBaseHandle> elements;
+    for (const Conn &conn : list) {
+      elements.push_back(ConnectionDs(conn));
+    }
+    names.push_back(name);
+    values.push_back(HdRetainedSmallVectorDataSource::New(elements.size(), elements.data()));
+  }
+  return HdRetainedContainerDataSource::New(names.size(), names.data(), values.data());
+}
+
+HdContainerDataSourceHandle ParamsDs(const std::map<TfToken, VtValue> &params)
+{
+  std::vector<TfToken> names;
+  std::vector<HdDataSourceBaseHandle> values;
+  for (const auto &[name, value] : params) {
+    if (value.IsEmpty()) {
+      continue;
+    }
+    names.push_back(name);
+    values.push_back(HdMaterialNodeParameterSchema::Builder()
+                         .SetValue(HdCreateTypedRetainedDataSource(value))
+                         .Build());
+  }
+  return HdRetainedContainerDataSource::New(names.size(), names.data(), values.data());
+}
+
+HdMaterialNetworkSchema Write(const Network &net)
+{
+  std::vector<TfToken> nodeNames;
+  std::vector<HdDataSourceBaseHandle> nodeValues;
+  for (const auto &[name, node] : net.nodes) {
+    HdContainerDataSourceHandle ds;
+    if (node.original) {
+      /* Only the connections may have been redirected. */
+      const TfToken keys[] = {HdMaterialNodeSchemaTokens->inputConnections};
+      const HdDataSourceBaseHandle values[] = {ConnectionsDs(node.conns)};
+      ds = HdOverlayContainerDataSource::New(
+          HdRetainedContainerDataSource::New(1, keys, values), node.original);
+    }
+    else {
+      ds = HdMaterialNodeSchema::Builder()
+               .SetNodeIdentifier(HdRetainedTypedSampledDataSource<TfToken>::New(node.typeId))
+               .SetParameters(ParamsDs(node.params))
+               .SetInputConnections(ConnectionsDs(node.conns))
+               .Build();
+    }
+    nodeNames.push_back(name);
+    nodeValues.push_back(ds);
+  }
+
+  std::vector<TfToken> termNames;
+  std::vector<HdDataSourceBaseHandle> termValues;
+  for (const auto &[name, conn] : net.terminals) {
+    termNames.push_back(name);
+    termValues.push_back(ConnectionDs(conn));
+  }
+
+  /* Everything but the nodes and terminals - interface, config - as it was. */
+  std::vector<TfToken> names;
+  std::vector<HdDataSourceBaseHandle> values;
+  if (net.original) {
+    for (const TfToken &key : net.original->GetNames()) {
+      if (key == HdMaterialNetworkSchemaTokens->nodes ||
+          key == HdMaterialNetworkSchemaTokens->terminals)
+      {
+        continue;
+      }
+      names.push_back(key);
+      values.push_back(net.original->Get(key));
+    }
+  }
+  names.push_back(HdMaterialNetworkSchemaTokens->nodes);
+  values.push_back(
+      HdRetainedContainerDataSource::New(nodeNames.size(), nodeNames.data(), nodeValues.data()));
+  names.push_back(HdMaterialNetworkSchemaTokens->terminals);
+  values.push_back(
+      HdRetainedContainerDataSource::New(termNames.size(), termNames.data(), termValues.data()));
+  return HdMaterialNetworkSchema(
+      HdRetainedContainerDataSource::New(names.size(), names.data(), values.data()));
+}
+
+/* ---- Expanding ---------------------------------------------------------- */
+
+/* Every consumer of (node, output) now reads `to`. Output names are matched
+ * exactly, then by the one output a single-output node has. */
+void Redirect(Network &net,
+              const TfToken &node,
+              const std::map<std::string, Conn> &outputs)
+{
+  auto resolve = [&](Conn &conn) {
+    if (conn.upstream != node) {
+      return;
+    }
+    auto it = outputs.find(OutputOr(conn.output.GetString()));
+    if (it == outputs.end() && outputs.size() == 1) {
+      it = outputs.begin();
+    }
+    if (it != outputs.end()) {
+      conn = it->second;
+    }
+  };
+  for (auto &[name, other] : net.nodes) {
+    for (auto &[input, list] : other.conns) {
+      for (Conn &conn : list) {
+        resolve(conn);
+      }
+    }
+  }
+  for (auto &[name, conn] : net.terminals) {
+    resolve(conn);
+  }
+}
+
+/* The nodegraph implementing a nodedef, or null. */
+mx::NodeGraphPtr NodeGraphOf(const mx::NodeDefPtr &nodeDef)
+{
+  for (const mx::InterfaceElementPtr &impl : Library()->getMatchingImplementations(
+           nodeDef->getName()))
+  {
+    if (impl->isA<mx::NodeGraph>()) {
+      return impl->asA<mx::NodeGraph>();
+    }
+  }
+  return nullptr;
+}
+
+/* An input left unset that MaterialX reads from the geometry - `texcoord`
+ * inputs default to UV0, normals to Nworld - connects to the node that reads
+ * it: the library's geompropdef names the geometric node and its space or
+ * index. One such node per expansion and property. */
+bool BindGeomProp(Node &inner,
+                  const TfToken &innerInput,
+                  const std::string &geomprop,
+                  const TfToken &outerName,
+                  std::map<TfToken, Node> &sink)
+{
+  const mx::GeomPropDefPtr def = Library()->getGeomPropDef(geomprop);
+  if (!def || def->getGeomProp().empty()) {
+    return false;
+  }
+  const TfToken nodeName(Prefix(outerName, "geomprop_" + geomprop));
+  if (!sink.count(nodeName)) {
+    Node geom;
+    geom.typeId = TfToken("ND_" + def->getGeomProp() + "_" + def->getType());
+    if (!def->getSpace().empty()) {
+      geom.params[TfToken("space")] = VtValue(def->getSpace());
+    }
+    /* UV set 0 is what every reader gives unasked; asking for it by index
+     * only draws a warning from the texture coordinate node, which has none. */
+    if (!def->getIndex().empty() && def->getIndex() != "0") {
+      geom.params[TfToken("index")] = VtValue(std::atoi(def->getIndex().c_str()));
+    }
+    sink[nodeName] = std::move(geom);
+  }
+  inner.conns[innerInput] = {Conn{nodeName, kOut}};
+  return true;
+}
+
+/* The default of a nodedef input, authored onto an inner input: its value,
+ * or the geometric property it reads. */
+void BindDefault(Node &inner,
+                 const TfToken &innerInput,
+                 const mx::InputPtr &def,
+                 const TfToken &outerName,
+                 std::map<TfToken, Node> &sink)
+{
+  if (!def) {
+    return;
+  }
+  if (!def->getDefaultGeomPropString().empty() &&
+      BindGeomProp(inner, innerInput, def->getDefaultGeomPropString(), outerName, sink))
+  {
+    return;
+  }
+  const VtValue value = MxValue(def->getType(), def->getValueString());
+  if (!value.IsEmpty()) {
+    inner.params[innerInput] = value;
+  }
+}
+
+/* Carries what the outer node has for an interface input onto an inner one:
+ * its connection, its value, or the nodedef's default. */
+void BindInterface(Node &inner,
+                   const TfToken &innerInput,
+                   const Node &outer,
+                   const TfToken &outerInput,
+                   const mx::NodeDefPtr &nodeDef,
+                   const TfToken &outerName,
+                   std::map<TfToken, Node> &sink)
+{
+  const auto conn = outer.conns.find(outerInput);
+  if (conn != outer.conns.end() && !conn->second.empty()) {
+    inner.conns[innerInput] = conn->second;
+    return;
+  }
+  const auto param = outer.params.find(outerInput);
+  if (param != outer.params.end() && !param->second.IsEmpty()) {
+    inner.params[innerInput] = param->second;
+    return;
+  }
+  BindDefault(inner, innerInput, nodeDef->getActiveInput(outerInput.GetString()), outerName, sink);
+}
+
+bool ExpandNodegraph(Network &net,
+                     const TfToken &name,
+                     const Node &outer,
+                     const mx::NodeDefPtr &nodeDef,
+                     const mx::NodeGraphPtr &graph)
+{
+  std::map<TfToken, Node> made;
+  for (const mx::NodePtr &m : graph->getNodes()) {
+    const mx::NodeDefPtr innerDef = m->getNodeDef();
+    if (!innerDef) {
+      LOG_WARNING << "MaterialX: nodegraph '" << graph->getName() << "' uses '"
+                  << m->getCategory() << "' which has no nodedef; '" << name.GetString()
+                  << "' is not expanded.";
+      return false;
+    }
+    Node inner;
+    inner.typeId = TfToken(innerDef->getName());
+    for (const mx::InputPtr &in : m->getInputs()) {
+      const TfToken innerInput(in->getName());
+      if (!in->getInterfaceName().empty()) {
+        BindInterface(
+            inner, innerInput, outer, TfToken(in->getInterfaceName()), nodeDef, name, made);
+      }
+      else if (!in->getNodeName().empty()) {
+        inner.conns[innerInput] = {Conn{TfToken(Prefix(name, in->getNodeName())),
+                                        TfToken(OutputOr(in->getOutputString()))}};
+      }
+      else if (!in->getValueString().empty()) {
+        const VtValue value = MxValue(in->getType(), in->getValueString());
+        if (!value.IsEmpty()) {
+          inner.params[innerInput] = value;
+        }
+      }
+    }
+    /* Every input the nodegraph leaves unset takes the inner nodedef's own
+     * default, authored: the mapping then receives what MaterialX means, not
+     * what the Cycles node happens to default to - `modulo` divides by 1 in
+     * MaterialX, by 0.5 on an untouched math node. */
+    for (const mx::InputPtr &def : innerDef->getActiveInputs()) {
+      const TfToken innerInput(def->getName());
+      if (inner.params.count(innerInput) || inner.conns.count(innerInput)) {
+        continue;
+      }
+      BindDefault(inner, innerInput, def, name, made);
+    }
+    made[TfToken(Prefix(name, m->getName()))] = std::move(inner);
+  }
+
+  std::map<std::string, Conn> outputs;
+  for (const mx::OutputPtr &out : graph->getOutputs()) {
+    if (out->getNodeName().empty()) {
+      continue;
+    }
+    outputs[out->getName()] = Conn{TfToken(Prefix(name, out->getNodeName())),
+                                   TfToken(OutputOr(out->getOutputString()))};
+  }
+  if (outputs.empty()) {
+    LOG_WARNING << "MaterialX: nodegraph '" << graph->getName() << "' has no output; '"
+                << name.GetString() << "' is not expanded.";
+    return false;
+  }
+
+  for (auto &[innerName, inner] : made) {
+    net.nodes[innerName] = std::move(inner);
+  }
+  Redirect(net, name, outputs);
+  net.nodes.erase(name);
+  LOG_INFO << "MaterialX: '" << outer.typeId.GetString() << "' at " << name.GetString()
+           << " expanded into " << made.size() << " node(s) from its nodegraph.";
+  return true;
+}
+
+/* Component names of a separate node's outputs, in order. */
+std::vector<std::string> SeparateOutputs(const std::string &type)
+{
+  if (type == "color3") {
+    return {"outr", "outg", "outb"};
+  }
+  if (type == "color4") {
+    return {"outr", "outg", "outb", "outa"};
+  }
+  if (type == "vector2") {
+    return {"outx", "outy"};
+  }
+  if (type == "vector3") {
+    return {"outx", "outy", "outz"};
+  }
+  if (type == "vector4") {
+    return {"outx", "outy", "outz", "outw"};
+  }
+  return {};
+}
+
+std::string SeparateNodedef(const std::string &type)
+{
+  const std::vector<std::string> outs = SeparateOutputs(type);
+  return outs.empty() ? "" : "ND_separate" + std::to_string(outs.size()) + "_" + type;
+}
+
+std::string CombineNodedef(const std::string &type)
+{
+  const std::vector<std::string> outs = SeparateOutputs(type);
+  return outs.empty() ? "" : "ND_combine" + std::to_string(outs.size()) + "_" + type;
+}
+
+/* `extract`: `in` read on the component `index` picks. A constant index is a
+ * separate node read on that output; a connected one a `switch` over the
+ * separate's outputs, which the next pass expands. */
+bool ExpandExtract(Network &net,
+                   const TfToken &name,
+                   const Node &outer,
+                   const mx::NodeDefPtr &nodeDef)
+{
+  const mx::InputPtr inDef = nodeDef->getActiveInput("in");
+  const std::string type = inDef ? inDef->getType() : "";
+  const std::string sepId = SeparateNodedef(type);
+  if (sepId.empty()) {
+    return false;
+  }
+  const std::vector<std::string> outs = SeparateOutputs(type);
+
+  Node sep;
+  sep.typeId = TfToken(sepId);
+  BindInterface(sep, TfToken("in"), outer, TfToken("in"), nodeDef, name, net.nodes);
+  const TfToken sepName(Prefix(name, "separate"));
+
+  const auto conn = outer.conns.find(TfToken("index"));
+  if (conn != outer.conns.end() && !conn->second.empty()) {
+    Node sw;
+    sw.typeId = TfToken("ND_switch_float");
+    for (size_t i = 0; i < outs.size(); ++i) {
+      sw.conns[TfToken("in" + std::to_string(i + 1))] = {Conn{sepName, TfToken(outs[i])}};
+    }
+    sw.conns[TfToken("which")] = conn->second;
+    const TfToken swName(Prefix(name, "switch"));
+    net.nodes[sepName] = std::move(sep);
+    net.nodes[swName] = std::move(sw);
+    Redirect(net, name, {{kOut.GetString(), Conn{swName, kOut}}});
+  }
+  else {
+    int index = 0;
+    const auto param = outer.params.find(TfToken("index"));
+    if (param != outer.params.end()) {
+      if (param->second.IsHolding<int>()) {
+        index = param->second.UncheckedGet<int>();
+      }
+      else if (param->second.CanCast<float>()) {
+        index = int(VtValue::Cast<float>(param->second).UncheckedGet<float>());
+      }
+    }
+    index = std::max(0, std::min(index, int(outs.size()) - 1));
+    net.nodes[sepName] = std::move(sep);
+    Redirect(net, name, {{kOut.GetString(), Conn{sepName, TfToken(outs[index])}}});
+  }
+  net.nodes.erase(name);
+  LOG_INFO << "MaterialX: '" << outer.typeId.GetString() << "' at " << name.GetString()
+           << " expanded into a separate node.";
+  return true;
+}
+
+/* `swizzle`: `channels` names, per output component, a component of `in` -
+ * "rgb", "xxy", "r". A separate node reads the input's components, a combine
+ * node assembles the output's; a float in or out needs neither. */
+bool ExpandSwizzle(Network &net,
+                   const TfToken &name,
+                   const Node &outer,
+                   const mx::NodeDefPtr &nodeDef)
+{
+  const mx::InputPtr inDef = nodeDef->getActiveInput("in");
+  const mx::OutputPtr outDef = nodeDef->getActiveOutput("out");
+  if (!inDef || !outDef) {
+    return false;
+  }
+  const std::string inType = inDef->getType();
+  const std::string outType = outDef->getType();
+
+  std::string channels;
+  const auto ch = outer.params.find(TfToken("channels"));
+  if (ch != outer.params.end() && ch->second.CanCast<std::string>()) {
+    channels = VtValue::Cast<std::string>(ch->second).UncheckedGet<std::string>();
+  }
+  if (channels.empty()) {
+    if (const mx::InputPtr def = nodeDef->getActiveInput("channels")) {
+      channels = def->getValueString();
+    }
+  }
+  const std::vector<std::string> inOuts = SeparateOutputs(inType);
+  const std::vector<std::string> outComps = SeparateOutputs(outType);
+  const size_t outCount = outComps.empty() ? 1 : outComps.size();
+
+  /* Where each output component comes from: a separate output, the float
+   * itself, or a value. */
+  TfToken sepName;
+  if (!inOuts.empty()) {
+    Node sep;
+    sep.typeId = TfToken(SeparateNodedef(inType));
+    BindInterface(sep, TfToken("in"), outer, TfToken("in"), nodeDef, name, net.nodes);
+    sepName = TfToken(Prefix(name, "separate"));
+    net.nodes[sepName] = std::move(sep);
+  }
+  auto componentIndex = [](const char c) -> int {
+    switch (c) {
+      case 'r':
+      case 'x':
+        return 0;
+      case 'g':
+      case 'y':
+        return 1;
+      case 'b':
+      case 'z':
+        return 2;
+      case 'a':
+      case 'w':
+        return 3;
+      default:
+        return -1;
+    }
+  };
+  /* The float input, as a connection or a value. */
+  const auto inConn = outer.conns.find(TfToken("in"));
+  VtValue inValue;
+  if (inOuts.empty()) {
+    const auto p = outer.params.find(TfToken("in"));
+    if (p != outer.params.end()) {
+      inValue = p->second;
+    }
+    else if (inDef) {
+      inValue = MxValue(inType, inDef->getValueString());
+    }
+  }
+  auto source = [&](const size_t component, Node &target, const TfToken &input) -> bool {
+    const char c = component < channels.size() ? channels[component] : 0;
+    const int index = componentIndex(c);
+    if (!inOuts.empty()) {
+      if (index < 0 || size_t(index) >= inOuts.size()) {
+        target.params[input] = VtValue(0.0f);
+      }
+      else {
+        target.conns[input] = {Conn{sepName, TfToken(inOuts[index])}};
+      }
+      return true;
+    }
+    if (inConn != outer.conns.end() && !inConn->second.empty()) {
+      target.conns[input] = inConn->second;
+    }
+    else if (!inValue.IsEmpty()) {
+      target.params[input] = inValue;
+    }
+    else {
+      target.params[input] = VtValue(0.0f);
+    }
+    return true;
+  };
+
+  if (outComps.empty()) {
+    /* A float out: the one component, read straight. */
+    const int index = componentIndex(channels.empty() ? 0 : channels[0]);
+    if (!inOuts.empty() && index >= 0 && size_t(index) < inOuts.size()) {
+      Redirect(net, name, {{kOut.GetString(), Conn{sepName, TfToken(inOuts[index])}}});
+    }
+    else if (inOuts.empty() && inConn != outer.conns.end() && !inConn->second.empty()) {
+      Redirect(net, name, {{kOut.GetString(), inConn->second.front()}});
+    }
+    else {
+      Node constant;
+      constant.typeId = TfToken("ND_constant_float");
+      constant.params[TfToken("value")] = inValue.IsEmpty() ? VtValue(0.0f) : inValue;
+      const TfToken constName(Prefix(name, "constant"));
+      net.nodes[constName] = std::move(constant);
+      Redirect(net, name, {{kOut.GetString(), Conn{constName, kOut}}});
+    }
+  }
+  else {
+    Node combine;
+    combine.typeId = TfToken(CombineNodedef(outType));
+    for (size_t i = 0; i < outCount; ++i) {
+      source(i, combine, TfToken("in" + std::to_string(i + 1)));
+    }
+    const TfToken combineName(Prefix(name, "combine"));
+    net.nodes[combineName] = std::move(combine);
+    Redirect(net, name, {{kOut.GetString(), Conn{combineName, kOut}}});
+  }
+  net.nodes.erase(name);
+  LOG_INFO << "MaterialX: '" << outer.typeId.GetString() << "' at " << name.GetString()
+           << " (channels '" << channels << "') expanded into separate/combine nodes.";
+  return true;
+}
+
+}  // namespace
+
+HdMaterialNetworkSchema ExpandMaterialXNodegraphs(HdMaterialNetworkSchema network,
+                                                  const HdCyclesNodeTranslatable &translatable)
+{
+  /* Nothing to do for a network without a MaterialX node the delegate lacks:
+   * the common case, which must stay free. */
+  bool candidate = false;
+  {
+    HdMaterialNodeContainerSchema nodes = network.GetNodes();
+    for (const TfToken &name : nodes.GetNames()) {
+      if (auto ds = nodes.Get(name).GetNodeIdentifier()) {
+        const std::string id = ds->GetTypedValue(0.0f).GetString();
+        if (id.rfind("ND_", 0) == 0 && !translatable(id)) {
+          candidate = true;
+          break;
+        }
+      }
+    }
+  }
+  if (!candidate) {
+    return network;
+  }
+
+  const mx::DocumentPtr library = Library();
+  Network net = Read(network);
+
+  /* Expanded nodes bring in nodes that may expand in turn. */
+  for (int pass = 0; pass < 8; ++pass) {
+    bool any = false;
+    std::vector<TfToken> names;
+    for (const auto &[name, node] : net.nodes) {
+      names.push_back(name);
+    }
+    for (const TfToken &name : names) {
+      const auto it = net.nodes.find(name);
+      if (it == net.nodes.end()) {
+        continue;
+      }
+      const std::string id = it->second.typeId.GetString();
+      if (id.rfind("ND_", 0) != 0 || translatable(id)) {
+        continue;
+      }
+      const mx::NodeDefPtr nodeDef = library->getNodeDef(id);
+      if (!nodeDef) {
+        continue;
+      }
+      /* Copy: the node is erased from the map while it is read. */
+      const Node outer = it->second;
+      const std::string category = nodeDef->getNodeString();
+      bool done = false;
+      if (const mx::NodeGraphPtr graph = NodeGraphOf(nodeDef)) {
+        done = ExpandNodegraph(net, name, outer, nodeDef, graph);
+      }
+      else if (category == "extract") {
+        done = ExpandExtract(net, name, outer, nodeDef);
+      }
+      else if (category == "swizzle") {
+        done = ExpandSwizzle(net, name, outer, nodeDef);
+      }
+      any |= done;
+      net.changed |= done;
+    }
+    if (!any) {
+      break;
+    }
+  }
+
+  return net.changed ? Write(net) : network;
+}
+
+HDCYCLES_NAMESPACE_CLOSE_SCOPE
