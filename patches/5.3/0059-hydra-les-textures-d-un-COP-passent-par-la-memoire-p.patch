+/* Lit les pixels du COP. A n'appeler que depuis le thread de synchronisation :
+ * cuire un noeud Houdini depuis un thread de travail ferait tomber l'hote. */
+CopPixelsPtr Capture(const std::string &opPath)
+{
+  PXR_NS::TfPyInitialize();
+  const PXR_NS::TfPyLock pyLock;
+
+  PyObject *const locals = RunWithPath(kCaptureCode, NodePathOf(opPath));
+  if (locals == nullptr) {
+    return nullptr;
+  }
+
+  PyObject *const ok = PyDict_GetItemString(locals, "_ok");
+  PyObject *const bytes = PyDict_GetItemString(locals, "_bytes");
+  const long width = LongFrom(locals, "_w");
+  const long height = LongFrom(locals, "_h");
+  const long cookCount = LongFrom(locals, "_cook");
+
+  if (ok == nullptr || !PyObject_IsTrue(ok) || bytes == nullptr || !PyBytes_Check(bytes) ||
+      width <= 0 || height <= 0)
+  {
+    PyObject *const err = PyDict_GetItemString(locals, "_err");
+    const char *const text = err ? PyUnicode_AsUTF8(err) : nullptr;
+    LOG_WARNING << "Could not read Houdini COP " << opPath << ": "
+                << (text ? text : "the node does not exist or has no layer")
+                << ". The texture will be missing.";
+    PyErr_Clear();
+    Py_DECREF(locals);
+    return nullptr;
+  }
+
+  char *raw = nullptr;
+  Py_ssize_t size = 0;
+  PyBytes_AsStringAndSize(bytes, &raw, &size);
+
+  const size_t rowBytes = static_cast<size_t>(width) * 4 * sizeof(uint16_t);
+  const size_t expected = rowBytes * static_cast<size_t>(height);
+  if (raw == nullptr || static_cast<size_t>(size) != expected) {
+    LOG_WARNING << "Houdini COP " << opPath << " gave " << size << " bytes where " << expected
+                << " were expected; the texture will be missing.";
+    Py_DECREF(locals);
+    return nullptr;
+  }
+
+  auto pixels = std::make_shared<CopPixels>();
+  pixels->width = static_cast<int>(width);
+  pixels->height = static_cast<int>(height);
+  pixels->cookCount = static_cast<int>(cookCount);
+  pixels->data.resize(expected);
+
+  /* Le buffer d'un COP commence en bas, a la maniere d'Houdini, la ou Cycles
+   * lit sa premiere ligne comme le haut de l'image - mesure : une texture dont
+   * la premiere ligne est rouge ressort rouge en haut. D'ou le retournement,
+   * fait une fois a la lecture plutot qu'a chaque acces. */
+  for (long y = 0; y < height; ++y) {
+    std::memcpy(pixels->data.data() + static_cast<size_t>(y) * rowBytes,
+                raw + static_cast<size_t>(height - 1 - y) * rowBytes,
+                rowBytes);
+  }
+
+  Py_DECREF(locals);
+
+  LOG_INFO << "Read Houdini COP " << opPath << " (" << width << "x" << height << ", cook "
+           << cookCount << ") into memory.";
+  return pixels;
+}
 
