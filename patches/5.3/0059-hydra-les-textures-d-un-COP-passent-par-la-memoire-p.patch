+/* Fait tourner un bout de Python avec `_path` pose, et rend son dictionnaire.
+ * L'appelant en extrait ce qu'il veut, puis le relache. */
+PyObject *RunWithPath(const char *code, const std::string &nodePath)
+{
+  PyObject *const main = PyImport_AddModule("__main__");
+  if (main == nullptr) {
+    PyErr_Clear();
+    return nullptr;
+  }
+
+  PyObject *const globals = PyModule_GetDict(main);
+  PyObject *const locals = PyDict_New();
+  if (locals == nullptr) {
+    PyErr_Clear();
+    return nullptr;
+  }
+
+  PyObject *const path = PyUnicode_FromString(nodePath.c_str());
+  PyDict_SetItemString(locals, "_path", path);
+  Py_XDECREF(path);
+
+  PyObject *const result = PyRun_String(code, Py_file_input, globals, locals);
+  Py_XDECREF(result);
+  if (result == nullptr) {
+    PyErr_Clear();
+    Py_DECREF(locals);
+    return nullptr;
+  }
+  return locals;
+}
