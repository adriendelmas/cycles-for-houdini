+ * relancer Houdini. */
+void HdCyclesMaterial::BindHoudiniCopImages(Scene *scene)
+{
+#ifdef WITH_HOUDINI_COP
+  for (const auto &entry : _nodes) {
+    BindHoudiniCopImage(scene, entry.second.node);
+    for (const auto &helper : entry.second.helperNodes) {
+      BindHoudiniCopImage(scene, helper.second);
+    }
+  }
+#else
+  (void)scene;
+#endif
+}
