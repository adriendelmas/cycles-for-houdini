+void PointCloud::bounds_grow_gsplat(const size_t i,
+                                    const packed_float3 *points,
+                                    const float *radius,
+                                    BoundBox &bounds) const
+{
+  const Attribute *attr_scale = (primitive_type() & PRIMITIVE_GSPLAT) ?
+                                    attributes.find(ATTR_STD_GSPLAT_SCALE) :
+                                    nullptr;
+  const Attribute *attr_rotation = attr_scale ? attributes.find(ATTR_STD_GSPLAT_ROTATION) :
+                                                nullptr;
+  if (!attr_rotation || attr_scale->has_motion() || attr_rotation->has_motion()) {
+    bounds.grow(points[i], radius[i]);
+    return;
+  }
+
+  const float3 scale = fabs(float3(attr_scale->data<packed_float3>()[i]));
+  const float max_scale = reduce_max(scale);
+  if (!(max_scale > 0.0f)) {
+    bounds.grow(points[i], radius[i]);
+    return;
+  }
+
+  const float k = radius[i] / max_scale;
+  const float3x3 R = quaternion_to_rotation(attr_rotation->data<Quaternion>()[i]);
+  const float3 half = k * make_float3(len(R.x * scale), len(R.y * scale), len(R.z * scale));
+  const float3 P = points[i];
+  bounds.grow(P - half);
+  bounds.grow(P + half);
+}
