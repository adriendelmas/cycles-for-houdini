 PXR_NAMESPACE_OPEN_SCOPE
 
@@ -148,4 +151,24 @@ TF_REGISTRY_FUNCTION(TfType)
   HdRendererPluginRegistry::Define<PXR_NS::HdCyclesPluginGPU>();
 }
 
+// USD's implicit surfaces - Sphere, Cube, Cylinder, Cone, Capsule, Plane -
+// reach a render delegate as prims of their own type, which this one does not
+// support, so they were dropped without a word. A scene index turns them
+// into meshes before they get here (implicit_surface.h).
+TF_REGISTRY_FUNCTION(HdSceneIndexPlugin)
+{
+  for (const char *displayName : {"Cycles CPU", "Cycles GPU"}) {
+    HdSceneIndexPluginRegistry::GetInstance().RegisterSceneIndexForRenderer(
+        displayName,
+        [](const std::string & /*renderInstanceId*/,
+           const HdSceneIndexBaseRefPtr &inputScene,
+           const HdContainerDataSourceHandle & /*args*/) -> HdSceneIndexBaseRefPtr {
+          return HD_CYCLES_NS::HdCyclesImplicitSurfaceSceneIndex::New(inputScene);
+        },
+        nullptr,
+        0,
+        HdSceneIndexPluginRegistry::InsertionOrderAtStart);
+  }
+}
+
 PXR_NAMESPACE_CLOSE_SCOPE
