diff --git a/src/hydra/resources/husdplugins/shadertranslators/cycles.py b/src/hydra/resources/husdplugins/shadertranslators/cycles.py
new file mode 100644
index 00000000..f8a2d6e9
--- /dev/null
+++ b/src/hydra/resources/husdplugins/shadertranslators/cycles.py
@@ -0,0 +1,118 @@
+"""Traducteur de shaders USD pour Cycles.
+
+Il n'existe que pour une chose : porter les reglages du materiau - le
+`Cycles Material Properties` - jusqu'a l'USD. Tout le reste est celui
+d'Houdini, hérité tel quel.
+
+Le probleme, dit par SideFX dans son propre code (`husd/mtlxshadertranslator.py`) :
+« Logically, render properties should be authored on the material primitive,
+but Hydra does not forward them to the render delegate. The workaround is to
+author them on the terminal shader prim. » Ce repli existe donc, mais seulement
+dans le traducteur MaterialX, et il suppose Karma faute de mieux
+(`render_context = 'kma'`). Un noeud de proprietes pose dans un reseau Cycles
+etait ainsi branche, active, et n'atteignait jamais l'USD : personne ne le
+lisait.
+
+Le point d'extension est documente dans `husd/shadertranslator.py` : redefinir
+`matchesRenderMask()` et `shaderTranslatorHelper()`, et mettre la logique dans
+un helper derive. C'est exactement ce qui suit.
+"""
+
+from pxr import Usd
+
+from husd import shaderutils
+from husd.shadertranslator import ShaderTranslator, ShaderTranslatorHelper
+
+RENDER_MASK = "cycles"
+# Le prefixe des reglages, tel que le delegate le cherche : `cycles:<socket>`
+# sur un noeud du reseau, releve en lisant ses parametres.
+PROPERTIES_CONNECTOR = "properties"
+# Seuls ces terminaux portent les reglages ; un displacement partage ceux de la
+# surface, comme chez Karma.
+PROPERTY_BEARING_TERMINALS = ("surface", "volume")
+
+
+def _properties_node(terminal_output_name, shader_node, shader_node_output_name):
+    """Le noeud de proprietes branche a cote du terminal, s'il y en a un.
+
+    Repris de `_propertiesShaderNodeSibling`, au contexte de rendu pres : le
+    notre se lit sur le noeud, et vaut `cycles`.
+    """
+    tokens = terminal_output_name.split(":")
+    if len(tokens) < 3 or tokens[-1] not in PROPERTY_BEARING_TERMINALS:
+        return None
+    target_context = tokens[-2]
+
+    output_node = None
+    for wire in shader_node.outputConnections():
+        if wire.inputName() == shader_node_output_name:
+            output_node = wire.outputNode()
+            break
+    if output_node is None:
+        return None
+
+    for wire in output_node.inputConnections():
+        if shaderutils.nodeInputTypeName(output_node, wire.outputName()) != PROPERTIES_CONNECTOR:
+            continue
+        node = wire.inputNode()
+        context = shaderutils.explicitPropertiesContextName(node)
+        if context and target_context in context.split():
+            return node
+    return None
+
+
+class CyclesShaderTranslatorHelper(ShaderTranslatorHelper):
+    def createAndConnectUsdTerminalShader(self,
+                                          shader_node,
+                                          requested_shader_type,
+                                          shader_node_output_name):
+        usd_output_path = ShaderTranslatorHelper.createAndConnectUsdTerminalShader(
+            self, shader_node, requested_shader_type, shader_node_output_name)
+        self._authorCyclesProperties(usd_output_path, shader_node, shader_node_output_name)
+        return usd_output_path
+
+    def _authorCyclesProperties(self, usd_output_path, shader_node, shader_node_output_name):
+        if not usd_output_path:
+            return
+
+        from pxr import UsdShade
+
+        output = UsdShade.Output(self.usdStage().GetAttributeAtPath(usd_output_path))
+        if not output:
+            return
+
+        # Les reglages vont sur le prim du shader terminal, faute que Hydra
+        # transmette ceux du prim Material.
+        terminal = UsdShade.ConnectableAPI(
+            shaderutils.usdFirstConnectedOriginatorSourcePrim(output))
+        if not terminal:
+            return
+
+        node = _properties_node(output.GetFullName(), shader_node, shader_node_output_name)
+        if node is None:
+            return
+
+        for parm_name in node.usdShaderParms():
+            parm_tuple = node.parmTuple(parm_name)
+            if parm_tuple is None:
+                continue
+            translator = self.parameterTranslator(parm_tuple)
+            if translator is None:
+                continue
+            translator.createAndSetAttrib(terminal, Usd.TimeCode.Default())
+
+
+class CyclesShaderTranslator(ShaderTranslator):
+    def matchesRenderMask(self, render_mask):
+        return render_mask == RENDER_MASK
+
+    def shaderTranslatorHelper(self, translator_id, usd_stage, usd_material_path, usd_time_code):
+        return CyclesShaderTranslatorHelper(translator_id, usd_stage,
+                                            usd_material_path, usd_time_code)
+
+
+_translator = CyclesShaderTranslator()
+
+
+def usdShaderTranslator():
+    return _translator
