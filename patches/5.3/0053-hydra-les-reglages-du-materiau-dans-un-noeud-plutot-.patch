@@ -1724,8 +1742,35 @@ void HdCyclesMaterial::UpdateParameters(NodeDesc &nodeDesc,
   }
 }
 
+/* Les reglages du materiau, poses sur le Shader lui-meme.
+ *
+ * Le Shader est un `Node` comme un autre : ses sockets - displacement_method,
+ * volume_step_rate, emission_sampling_method, pass_id... - se cherchent dans
+ * son NodeType et s'ecrivent avec la meme machinerie que ceux d'un noeud de
+ * shading. Nommer un socket qui n'existe pas est signale plutot qu'ignore :
+ * c'est la meme regle que pour `cycles:integrator:<socket>`, un nom mal
+ * orthographie etant indiscernable d'un reglage sans effet. */
+void HdCyclesMaterial::ApplyShaderSettings()
+{
+  if (!_shader) {
+    return;
+  }
+
+  for (const auto &setting : _shaderSettings) {
+    const SocketType *const socket = _shader->type->find_input(ustring(setting.first));
+    if (socket == nullptr) {
+      LOG_WARNING << "No Cycles material setting 'cycles:" << setting.first
+                  << "', value ignored.";
+      continue;
+    }
+    SetNodeValue(_shader, *socket, setting.second);
+  }
+}
+
 void HdCyclesMaterial::UpdateParameters(HdMaterialNetworkSchema network)
 {
+  _shaderSettings.clear();
+
   HdMaterialNodeContainerSchema nodes = network.GetNodes();
   for (const TfToken &nodeName : nodes.GetNames()) {
     const SdfPath nodePath = MaterialNodeNameToSdfPath(nodeName);
@@ -1880,6 +1925,7 @@ void HdCyclesMaterial::UpdateConnections(NodeDesc &nodeDesc,
 unique_ptr<ShaderGraph> HdCyclesMaterial::BuildShaderGraph(HdMaterialNetworkSchema network)
 {
   _nodes.clear();
+  _shaderSettings.clear();
 
   unique_ptr<ShaderGraph> graph = make_unique<ShaderGraph>();
 
@@ -2051,9 +2097,9 @@ unique_ptr<ShaderGraph> HdCyclesMaterial::BuildShaderGraph(HdMaterialNetworkSche
        * diagnostics de Tf, et un terminal qui tombe est precisement ce qu'il
        * ne faut pas perdre - le materiau rend alors sans son displacement, ou
        * sans son volume, sans un mot. */
-      LOG_WARNING << "No terminal input '" << (inputName ? inputName : "<null>") << "' for '"
-                  << terminalName.GetText() << "' from '" << upstreamNodePath.GetText()
-                  << "', terminal dropped.";
+      LOG_WARNING << "No terminal input '" << (inputName ? inputName : "<null>")
+                  << "' for '" << terminalName.GetText() << "' from '"
+                  << upstreamNodePath.GetText() << "', terminal dropped.";
       continue;
     }
 
