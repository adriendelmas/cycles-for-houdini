From 68fb30de9fa6d6ae7a1025be33a25c09d59779ba Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Thu, 8 Oct 2026 09:12:31 +0200
Subject: [PATCH 102/112] hydra: les tailles verifiees avant lecture, plus de
 segfault sur un attribut illisible

Un attribut dont USD n'a pas pu lire la valeur - un type mal orthographie,
normal[] au lieu de normal3f[] - arrive au delegue comme un tableau vide du
bon type. Le test de type passait, le controle de taille etait un TF_VERIFY,
qui signale et continue, et la boucle lisait hors du tableau : husk mourait
d'une segmentation fault la ou Karma ignore l'attribut (K-57). Les normales
du maillage, ses points et les largeurs d'un nuage de points verifient
maintenant le compte que leur interpolation exige, previennent et ignorent
l'attribut. tools/bench_robust.py : trois fichiers abimes, trois plantages
avant, trois rendus apres.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/hydra/mesh.cpp       | 51 +++++++++++++++++++++++++++++++++-------
 src/hydra/pointcloud.cpp | 15 ++++++++----
 2 files changed, 53 insertions(+), 13 deletions(-)

diff --git a/src/hydra/mesh.cpp b/src/hydra/mesh.cpp
index c94f261f..1cce1fdd 100644
--- a/src/hydra/mesh.cpp
+++ b/src/hydra/mesh.cpp
@@ -181,7 +181,17 @@ void HdCyclesMesh::PopulatePoints(HdSceneDelegate *sceneDelegate)
 
   const auto &points = value.UncheckedGet<VtVec3fArray>();
 
-  TF_VERIFY(points.size() >= static_cast<size_t>(_topology.GetNumPoints()));
+  /* A size check that stops. TF_VERIFY only reports, and the copy below
+   * then read past the end of the array: an attribute whose value USD could
+   * not parse arrives as an empty array of the right type, which passes the
+   * type test above. */
+  if (points.size() < static_cast<size_t>(_topology.GetNumPoints())) {
+    TF_WARN("Points of %s: %zu values where the topology needs %d, mesh skipped",
+            GetId().GetText(),
+            points.size(),
+            _topology.GetNumPoints());
+    return;
+  }
 
   const bool subdivision = _geom->get_subdivision_type() != Mesh::SUBDIVISION_NONE;
   AttributeSet &attributes = (subdivision) ? _geom->subd_attributes : _geom->attributes;
@@ -250,9 +260,38 @@ void HdCyclesMesh::PopulateNormals(HdSceneDelegate *sceneDelegate)
 
   const auto &normals = value.UncheckedGet<VtVec3fArray>();
 
-  if (interpolation == HdInterpolationConstant) {
-    TF_VERIFY(normals.size() == 1);
+  /* The count each interpolation needs, checked before any read: a `normals`
+   * attribute whose value USD could not parse (`normal[]`, not a type name)
+   * comes through as an empty VtVec3fArray, and the loops below read past its
+   * end - a segfault under husk (K-57). Without normals the mesh is shaded
+   * from its faces, which is what Karma does with the same file. */
+  size_t expected = 0;
+  switch (interpolation) {
+    case HdInterpolationConstant:
+      expected = 1;
+      break;
+    case HdInterpolationUniform:
+      expected = static_cast<size_t>(_topology.GetNumFaces());
+      break;
+    case HdInterpolationVertex:
+    case HdInterpolationVarying:
+      expected = _geom->num_verts();
+      break;
+    case HdInterpolationFaceVarying:
+      expected = static_cast<size_t>(_topology.GetNumFaceVaryings());
+      break;
+    default:
+      return;
+  }
+  if (normals.size() < expected) {
+    TF_WARN("Normals of %s: %zu values where %zu are needed, ignored",
+            GetId().GetText(),
+            normals.size(),
+            expected);
+    return;
+  }
 
+  if (interpolation == HdInterpolationConstant) {
     const GfVec3f constantNormal = normals[0];
 
     packed_normal *const N =
@@ -262,13 +301,9 @@ void HdCyclesMesh::PopulateNormals(HdSceneDelegate *sceneDelegate)
     }
   }
   else if (interpolation == HdInterpolationUniform) {
-    TF_VERIFY(normals.size() == static_cast<size_t>(_topology.GetNumFaces()));
     /* Nothing to do, face normals are computed on demand in the kernel. */
   }
   else if (interpolation == HdInterpolationVertex || interpolation == HdInterpolationVarying) {
-    TF_VERIFY(normals.size() == static_cast<size_t>(_topology.GetNumPoints()) &&
-              static_cast<size_t>(_topology.GetNumPoints()) == _geom->num_verts());
-
     packed_normal *const N =
         _geom->attributes.add(ATTR_STD_VERTEX_NORMAL)->data_for_write<packed_normal>();
     for (size_t i = 0; i < _geom->num_verts(); ++i) {
@@ -276,8 +311,6 @@ void HdCyclesMesh::PopulateNormals(HdSceneDelegate *sceneDelegate)
     }
   }
   else if (interpolation == HdInterpolationFaceVarying) {
-    TF_VERIFY(normals.size() == static_cast<size_t>(_topology.GetNumFaceVaryings()));
-
     /* One normal per corner, which is what Houdini writes as soon as the
      * normal lives on vertices rather than on points -- its usual case. Cycles
      * can carry them since ATTR_STD_CORNER_NORMAL exists, and it always
diff --git a/src/hydra/pointcloud.cpp b/src/hydra/pointcloud.cpp
index 6747404f..e2a6bf76 100644
--- a/src/hydra/pointcloud.cpp
+++ b/src/hydra/pointcloud.cpp
@@ -123,9 +123,18 @@ void HdCyclesPoints::PopulateWidths(HdSceneDelegate *sceneDelegate)
   const auto &widths = value.UncheckedGet<VtFloatArray>();
   float *radius = _geom->get_radius_for_write();
 
-  if (interpolation == HdInterpolationConstant) {
-    TF_VERIFY(widths.size() == 1);
+  /* Checked before reading, as for the mesh normals (K-57): an unparsable
+   * value is an empty array, and TF_VERIFY does not stop the read. */
+  const size_t expected = interpolation == HdInterpolationConstant ? 1 : _geom->num_points();
+  if (widths.size() < expected) {
+    TF_WARN("Widths of %s: %zu values where %zu are needed, ignored",
+            GetId().GetText(),
+            widths.size(),
+            expected);
+    return;
+  }
 
+  if (interpolation == HdInterpolationConstant) {
     const float constantRadius = widths[0] * 0.5f;
 
     for (size_t i = 0; i < _geom->num_points(); ++i) {
@@ -135,8 +144,6 @@ void HdCyclesPoints::PopulateWidths(HdSceneDelegate *sceneDelegate)
   /* On points, `varying` and `vertex` are the same thing: one value each. A
    * varying width used to be skipped and left the radius unset. */
   else if (interpolation == HdInterpolationVertex || interpolation == HdInterpolationVarying) {
-    TF_VERIFY(widths.size() == _geom->num_points());
-
     for (size_t i = 0; i < _geom->num_points(); ++i) {
       radius[i] = widths[i] * 0.5f;
     }
