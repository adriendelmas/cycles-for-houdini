From 7deebe0aad30f0043c0c8727d5ccd80f4f605b6f Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Mon, 31 Aug 2026 02:14:06 +0200
Subject: [PATCH 06/62] hydra: give unbound volumes the default volume shader

Geometry with no material binding fell back to scene->default_surface
regardless of its type. A Volume needs a shader carrying a volume closure,
so an unbound volume had its grid loaded - the NanoVDB texture is allocated
and the memory shows up in the stats - but nothing to scatter in it, and
rendered as if it were not there at all.

Pick default_volume for Volume geometry instead.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/hydra/geometry.inl | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/hydra/geometry.inl b/src/hydra/geometry.inl
index 9c1f3e45..69d96109 100644
--- a/src/hydra/geometry.inl
+++ b/src/hydra/geometry.inl
@@ -11,8 +11,11 @@
 #include "scene/geometry.h"
 #include "scene/object.h"
 #include "scene/scene.h"
+#include "scene/volume.h"
 #include "util/hash.h"
 
+#include <type_traits>
+
 #include <pxr/imaging/hd/materialBindingSchema.h>
 #include <pxr/imaging/hd/materialBindingsSchema.h>
 #include <pxr/imaging/hd/sceneDelegate.h>
@@ -93,6 +96,12 @@ void HdCyclesGeometry<Base, CyclesBase>::Sync(HdSceneDelegate *sceneDelegate,
     if (material && material->GetCyclesShader()) {
       usedShaders[0] = material->GetCyclesShader();
     }
+    else if constexpr (std::is_same_v<CyclesBase, Volume>) {
+      /* Volumes need a shader with a volume closure. Falling back to the
+       * default surface shader leaves the grid loaded but nothing to scatter
+       * in it, so an unbound volume renders as if it were not there. */
+      usedShaders[0] = lock.scene->default_volume;
+    }
     else {
       usedShaders[0] = lock.scene->default_surface;
     }
