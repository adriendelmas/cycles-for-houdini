+/* Whether two socket types can be linked without changing what the value
+ * means: a closure to a closure, any three-component value to another, any
+ * scalar to another. Cycles inserts the conversions itself. */
+bool SameSocketClass(const SocketType::Type a, const SocketType::Type b)
+{
+  auto classOf = [](const SocketType::Type t) {
+    switch (t) {
+      case SocketType::CLOSURE:
+        return 0;
+      case SocketType::COLOR:
+      case SocketType::VECTOR:
+      case SocketType::POINT:
+      case SocketType::NORMAL:
+        return 1;
+      case SocketType::FLOAT:
+      case SocketType::INT:
+      case SocketType::UINT:
+      case SocketType::BOOLEAN:
+        return 2;
+      default:
+        return 3 + int(t);
+    }
+  };
+  return classOf(a) == classOf(b);
+}
