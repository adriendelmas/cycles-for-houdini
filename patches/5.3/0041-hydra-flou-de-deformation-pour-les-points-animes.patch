+std::vector<VtVec3fArray> SampleDeformingPoints(const HdSampledDataSourceHandle &pointsDs,
+                                                const float shutterOpen,
+                                                const float shutterClose,
+                                                const int steps,
+                                                const size_t minPoints)
+{
+  std::vector<VtVec3fArray> samples;
+  if (!pointsDs || steps < 2) {
+    return samples;
+  }
+
+  samples.resize(steps);
+  for (int step = 0; step < steps; ++step) {
+    /* Les memes instants regulierement espaces que pour les transforms :
+     * Cycles etale ses pas de mouvement lineairement sur l'obturateur, un
+     * echantillonnage irregulier flouterait le long d'une trajectoire faussee. */
+    const float t = shutterOpen + (shutterClose - shutterOpen) * step / float(steps - 1);
+    const VtValue sampled = pointsDs->GetValue(t);
+    if (!sampled.IsHolding<VtVec3fArray>()) {
+      return {};
+    }
+    samples[step] = sampled.UncheckedGet<VtVec3fArray>();
+    if (samples[step].size() < minPoints) {
+      return {};
+    }
+  }
+
+  for (int step = 1; step < steps; ++step) {
+    if (samples[step] != samples[0]) {
+      return samples;
+    }
+  }
+  return {};
+}
+
+void WriteMotionPositions(Geometry *geom,
+                          Attribute *attr_P,
+                          const std::vector<VtVec3fArray> &samples,
+                          const size_t count)
+{
+  const int steps = int(samples.size());
+  geom->set_motion_steps(steps);
+  geom->set_use_motion_blur(true);
+  attr_P->add_motion(geom);
+
+  int attrStep = 1;
+  for (int step = 0; step < steps; ++step) {
+    const int buffer = (step == steps / 2) ? 0 : attrStep++;
+    std::copy_n(reinterpret_cast<const packed_float3 *>(samples[step].data()),
+                count,
+                attr_P->data_for_write<packed_float3>(buffer));
+  }
+}
