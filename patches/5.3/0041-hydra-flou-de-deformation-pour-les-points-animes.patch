@@ -75,9 +81,29 @@ void HdCyclesCurves::PopulatePoints(HdSceneDelegate *sceneDelegate)
 
   static_assert(sizeof(GfVec3f) == sizeof(packed_float3));
 
+  const size_t numKeys = std::min(points.size(), _geom->num_keys());
   std::copy_n(reinterpret_cast<const packed_float3 *>(points.data()),
-              std::min(points.size(), _geom->num_keys()),
+              numKeys,
               _geom->get_position_for_write());
+
+  /* Des courbes qui se deforment - de la fourrure, une chevelure simulee -
+   * rendaient nettes faute d'echantillons le long de l'obturateur. */
+  const std::vector<VtVec3fArray> samples =
+      _motionBlur ?
+          SampleDeformingPoints(pointsDs, _shutterOpen, _shutterClose, kMotionSteps, numKeys) :
+          std::vector<VtVec3fArray>();
+
+  Attribute *attr_P = _geom->attributes.find(ATTR_STD_POSITION);
+  if (attr_P == nullptr) {
+    return;
+  }
+  if (!samples.empty()) {
+    WriteMotionPositions(_geom, attr_P, samples, numKeys);
+  }
+  else if (attr_P->has_motion()) {
+    attr_P->remove_motion();
+    _geom->set_use_motion_blur(false);
+  }
 }
 
