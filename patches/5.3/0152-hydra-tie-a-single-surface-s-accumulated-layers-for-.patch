+/* A standard_surface whose inputs are accumulated layer by layer by a chain
+ * of adds - Houdini's Material Mixer in its single-surface mode writes, per
+ * input, acc_k = acc_(k-1) + (layer_k - acc_(k-1)) x w_k. Nothing keeps the
+ * layers apart for the SVM compiler, which evaluated every layer's tiled
+ * lookups before the first add: the ten-layer terrain overflowed the 255
+ * stack slots and rendered black. Each layer's own geometry lookups are
+ * tied to the previous accumulation, as FoldSurfaceMix does with its mixes
+ * (K-115). */
+bool TieSumChains(Network &net)
+{
+  static const TfToken kSurfaceTerminal("surface"), kIn("in"), kIn1("in1"), kIn2("in2");
+  constexpr size_t kMinLayers = 3;
+
+  const auto terminal = net.terminals.find(kSurfaceTerminal);
+  if (terminal == net.terminals.end()) {
+    return false;
+  }
+  const TfToken topName = terminal->second.upstream;
+  const auto topIt = net.nodes.find(topName);
+  if (topIt == net.nodes.end() ||
+      topIt->second.typeId.GetString().rfind("ND_standard_surface_surfaceshader", 0) != 0)
+  {
+    return false;
+  }
+  const auto idOf = [&](const TfToken &name) -> std::string {
+    const auto it = net.nodes.find(name);
+    return it == net.nodes.end() ? std::string() : it->second.typeId.GetString();
+  };
+  const auto firstConn = [&](const TfToken &name, const TfToken &input) -> const Conn * {
+    const auto it = net.nodes.find(name);
+    if (it == net.nodes.end()) {
+      return nullptr;
+    }
+    const auto c = it->second.conns.find(input);
+    return c == it->second.conns.end() || c->second.empty() ? nullptr : &c->second[0];
+  };
+
+  std::vector<Conn> starts;
+  for (const auto &[input, list] : topIt->second.conns) {
+    if (!list.empty()) {
+      starts.push_back(list[0]);
+    }
+  }
+  /* The height, accumulated the same way, behind the displacement node. */
+  static const TfToken kDisplacementTerminal("displacement"), kDisplacement("displacement");
+  if (const auto d = net.terminals.find(kDisplacementTerminal); d != net.terminals.end()) {
+    if (idOf(d->second.upstream).rfind("ND_displacement_", 0) == 0) {
+      if (const Conn *c = firstConn(d->second.upstream, kDisplacement)) {
+        starts.push_back(*c);
+      }
+    }
+  }
+  LayerTies ties(net, topName);
+  int chains = 0;
+  for (const Conn &start : starts) {
+    TfToken name = start.upstream;
+    /* A normal goes through a normalize first. */
+    if (idOf(name).rfind("ND_normalize_", 0) == 0) {
+      const Conn *c = firstConn(name, kIn);
+      if (!c) {
+        continue;
+      }
+      name = c->upstream;
+    }
+    /* The accumulations, top down: each add's in1 is the previous one. */
+    std::vector<TfToken> accs;
+    while (idOf(name).rfind("ND_add_", 0) == 0) {
+      accs.push_back(name);
+      const Conn *c = firstConn(name, kIn1);
+      if (!c) {
+        break;
+      }
+      name = c->upstream;
+    }
+    if (accs.size() < kMinLayers) {
+      continue;
+    }
+    std::reverse(accs.begin(), accs.end());
+    for (size_t i = 1; i < accs.size(); ++i) {
+      const Conn *term = firstConn(accs[i], kIn2);
+      if (!term) {
+        continue;
+      }
+      /* ND_add_float, ND_add_color3FA: the accumulation's type. */
+      std::string type = idOf(accs[i - 1]).substr(strlen("ND_add_"));
+      if (type.size() > 2 && type.compare(type.size() - 2, 2, "FA") == 0) {
+        type.resize(type.size() - 2);
+      }
+      const Conn previous{accs[i - 1], kOut};
+      ties.tieLeaves(term->upstream, ties.depend(previous, type), previous);
+    }
+    chains += 1;
+  }
+  if (chains) {
+    LOG_INFO << "MaterialX: " << topName.GetString() << ": " << chains
+             << " inputs accumulated layer by layer, each layer tied to the previous one ("
+             << ties.made << " nodes).";
+  }
+  return chains > 0;
+}
