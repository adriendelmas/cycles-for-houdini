diff --git a/src/kernel/osl/services_shared.h b/src/kernel/osl/services_shared.h
index adc6ee18..ff7bcdc4 100644
--- a/src/kernel/osl/services_shared.h
+++ b/src/kernel/osl/services_shared.h
@@ -774,6 +774,9 @@ ccl_device bool osl_shared_texture(KernelGlobals kg,
         if (int(options->tblur)) {
           flags |= NODE_AO_GLOBAL_RADIUS;
         }
+        if (int(options->swidth)) {
+          flags |= NODE_AO_RAYCAST_VISIBILITY;
+        }
         result[0] = svm_ao(kg, state, sd, N, radius, num_samples, flags);
         status = true;
       }
diff --git a/src/kernel/osl/shaders/node_ambient_occlusion.osl b/src/kernel/osl/shaders/node_ambient_occlusion.osl
index e3a8f6f7..80f8ba9f 100644
--- a/src/kernel/osl/shaders/node_ambient_occlusion.osl
+++ b/src/kernel/osl/shaders/node_ambient_occlusion.osl
@@ -10,6 +10,7 @@ shader node_ambient_occlusion(color ColorIn = color(1.0, 1.0, 1.0),
                               normal Normal = N,
                               int inside = 0,
                               int only_local = 0,
+                              int raycast_visibility = 0,
                               output color ColorOut = color(1.0, 1.0, 1.0),
                               output float AO = 1.0)
 {
@@ -28,6 +29,8 @@ shader node_ambient_occlusion(color ColorIn = color(1.0, 1.0, 1.0),
                "sblur",
                only_local,
                "tblur",
-               global_radius);
+               global_radius,
+               "swidth",
+               raycast_visibility);
   ColorOut = ColorIn * AO;
 }
diff --git a/src/kernel/svm/ao.h b/src/kernel/svm/ao.h
index e252e837..dd18f8ed 100644
--- a/src/kernel/svm/ao.h
+++ b/src/kernel/svm/ao.h
@@ -86,7 +86,12 @@ ccl_device float svm_ao(
       }
     }
     else {
-      if (!scene_intersect_shadow(kg, &ray, PATH_RAY_VISIBILITY_SHADOW_OPAQUE)) {
+      /* wetmap: the raycast visibility bit picks the objects a shader may
+       * measure against (the water), as the Raycast node does. */
+      const uint visibility = (flags & NODE_AO_RAYCAST_VISIBILITY) ?
+                                  PATH_RAY_VISIBILITY_RAYCAST :
+                                  PATH_RAY_VISIBILITY_SHADOW_OPAQUE;
+      if (!scene_intersect_shadow(kg, &ray, visibility)) {
         unoccluded++;
       }
     }
diff --git a/src/kernel/svm/types.h b/src/kernel/svm/types.h
index b7d77da2..474b1522 100644
--- a/src/kernel/svm/types.h
+++ b/src/kernel/svm/types.h
@@ -431,6 +431,8 @@ enum NodeAO {
   NODE_AO_ONLY_LOCAL = (1 << 0),
   NODE_AO_INSIDE = (1 << 1),
   NODE_AO_GLOBAL_RADIUS = (1 << 2),
+  /* wetmap: trace against the objects visible to raycast rays only. */
+  NODE_AO_RAYCAST_VISIBILITY = (1 << 3),
 };
 
 enum ShaderType {
diff --git a/src/scene/shader_nodes.cpp b/src/scene/shader_nodes.cpp
index 42a541b8..acbdee39 100644
--- a/src/scene/shader_nodes.cpp
+++ b/src/scene/shader_nodes.cpp
@@ -3470,6 +3470,8 @@ NODE_DEFINE(AmbientOcclusionNode)
 
   SOCKET_BOOLEAN(inside, "Inside", false);
   SOCKET_BOOLEAN(only_local, "Only Local", false);
+  /* wetmap: occluded by the objects visible to raycast rays only. */
+  SOCKET_BOOLEAN(raycast_visibility, "Raycast Visibility", false);
 
   SOCKET_OUT_COLOR(color, "Color");
   SOCKET_OUT_FLOAT(ao, "AO");
@@ -3483,7 +3485,8 @@ void AmbientOcclusionNode::compile(SVMCompiler &compiler)
 {
   ShaderInput *distance_in = input("Distance");
 
-  int flags = (inside ? NODE_AO_INSIDE : 0) | (only_local ? NODE_AO_ONLY_LOCAL : 0);
+  int flags = (inside ? NODE_AO_INSIDE : 0) | (only_local ? NODE_AO_ONLY_LOCAL : 0) |
+              (raycast_visibility ? NODE_AO_RAYCAST_VISIBILITY : 0);
 
   if (!distance_in->link && distance == 0.0f) {
     flags |= NODE_AO_GLOBAL_RADIUS;
@@ -3507,6 +3510,7 @@ void AmbientOcclusionNode::compile(OSLCompiler &compiler)
   compiler.parameter(this, "samples");
   compiler.parameter(this, "inside");
   compiler.parameter(this, "only_local");
+  compiler.parameter(this, "raycast_visibility");
   compiler.add(this, "node_ambient_occlusion");
 }
 
