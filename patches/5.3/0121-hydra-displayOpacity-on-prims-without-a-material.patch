diff --git a/src/hydra/session.cpp b/src/hydra/session.cpp
index 802e5698..cd4a7a86 100644
--- a/src/hydra/session.cpp
+++ b/src/hydra/session.cpp
@@ -290,9 +290,16 @@ HdCyclesSession::HdCyclesSession(const SessionParams &params)
     ObjectInfoNode *objectNode = graph->create_node<ObjectInfoNode>();
 
     DiffuseBsdfNode *diffuseNode = graph->create_node<DiffuseBsdfNode>();
+    /* displayOpacity, through the object's alpha: what it leaves goes
+     * through, as in Karma. */
+    TransparentBsdfNode *clearNode = graph->create_node<TransparentBsdfNode>();
+    MixClosureNode *mixNode = graph->create_node<MixClosureNode>();
 
     graph->connect(objectNode->output("Color"), diffuseNode->input("Color"));
-    graph->connect(diffuseNode->output("BSDF"), graph->output()->input("Surface"));
+    graph->connect(objectNode->output("Alpha"), mixNode->input("Fac"));
+    graph->connect(clearNode->output("BSDF"), mixNode->input("Closure1"));
+    graph->connect(diffuseNode->output("BSDF"), mixNode->input("Closure2"));
+    graph->connect(mixNode->output("Closure"), graph->output()->input("Surface"));
 
     // Create the instanceId AOV output
     const ustring instanceId(HdAovTokens->instanceId.GetString());
