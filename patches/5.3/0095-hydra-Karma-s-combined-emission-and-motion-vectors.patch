From 8d8766264f3af7c950868e23e1b9b13591d0970a Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Thu, 8 Oct 2026 03:41:04 +0200
Subject: [PATCH 095/141] hydra: Karma's combined emission and motion vectors

Karma's Render Settings node writes its combined emission `C.*O` and its motion
vectors `ray:motionvector`: the first came out black, the second became an empty
shader AOV. Both go to their Cycles pass. tools/bench_karma_settings.py renders
a stage built with this node and verifies each of its variables.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/hydra/session.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/hydra/session.cpp b/src/hydra/session.cpp
index 79ae0f1b..254071a3 100644
--- a/src/hydra/session.cpp
+++ b/src/hydra/session.cpp
@@ -95,6 +95,7 @@ const std::unordered_map<std::string, PassType> kRawSourceToPass = {
     {"ray:hitN", PASS_NORMAL},
     {"ray:hitNg", PASS_NORMAL},
     {"ray:hituv", PASS_UV},
+    {"ray:motionvector", PASS_MOTION},
 };
 
 /* The light path expressions Karma's render settings write for its light
@@ -119,6 +120,7 @@ const std::unordered_map<std::string, LightPass> kLpeToPass = {
     {"CVL", {PASS_VOLUME_DIRECT, PASS_NONE}},
     {"CV.+L", {PASS_VOLUME_INDIRECT, PASS_NONE}},
     {"CO", {PASS_EMISSION, PASS_NONE}},
+    {"C.*O", {PASS_EMISSION, PASS_NONE}},
     {"C[LO]", {PASS_EMISSION, PASS_NONE}},
 };
 
