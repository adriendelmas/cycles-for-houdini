+/* Unary and binary arithmetic all collapse onto one Cycles node whose mode is
+ * picked by an enum, which is what the fixed values are for. MaterialX names a
+ * unary input `in` and binary ones `in1`/`in2`. */
+UsdToCyclesMapping MakeMtlxOp(const char *const mode, const bool vector, const bool unary)
+{
+  const char *const a = vector ? "vector1" : "value1";
+  const char *const b = vector ? "vector2" : "value2";
+  const char *const outSocket = vector ? "vector" : "value";
+
+  UsdToCyclesMapping mapping{vector ? "vector_math" : "math",
+                             {
+                                 {TfToken("in"), ustring(a)},
+                                 {TfToken("in1"), ustring(a)},
+                                 {TfToken("in2"), ustring(b)},
+                                 {CyclesMaterialTokens->out, ustring(outSocket)},
+                             }};
+  mapping.setFixedValues({{ustring("math_type"), mode}});
+  (void)unary;
+  return mapping;
+}
+
+/* Compositing operators are one mix_color node with a blend mode. */
+UsdToCyclesMapping MakeMtlxBlend(const char *const mode)
+{
+  UsdToCyclesMapping mapping{"mix_color",
+                             {
+                                 {TfToken("fg"), ustring("a")},
+                                 {TfToken("bg"), ustring("b")},
+                                 {TfToken("in1"), ustring("a")},
+                                 {TfToken("in2"), ustring("b")},
+                                 {TfToken("mix"), ustring("fac")},
+                                 {CyclesMaterialTokens->out, ustring("result")},
+                             }};
+  mapping.setFixedValues({{ustring("blend_type"), mode}});
+  return mapping;
+}
