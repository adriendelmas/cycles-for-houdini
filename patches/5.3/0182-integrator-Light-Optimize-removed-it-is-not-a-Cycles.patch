From 5e8e0c77086826f6d3e7a063d4d70b69a038a3d0 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Tue, 17 Nov 2026 13:05:07 +0100
Subject: [PATCH 182/182] integrator: Light Optimize removed, it is not a
 Cycles feature

Use Light Optimize / Light Optimize Factor (871b5d5b) scaled the intensity the
adaptive sampling criterion sees and the sample clamps. It was added for this
plugin only and Cycles has no such setting, so it goes: the sockets, the
adaptive_exposure film member (back to padding), and the section of the Render
Settings tab. The .ds files are regenerated and the Cycles Render Settings LOP
rebuilt, 68 settings.
---
 .../resources/HdCyclesPluginGPU_Global.ds     |  49 ------------------
 src/hydra/resources/HdCyclesPlugin_Global.ds  |  49 ------------------
 .../otls/hdcycles_render_settings.hda         | Bin 78213 -> 77166 bytes
 src/kernel/data_template.h                    |   5 +-
 src/kernel/film/adaptive_sampling.h           |   2 +-
 src/scene/film.cpp                            |   1 -
 src/scene/integrator.cpp                      |  17 ++----
 src/scene/integrator.h                        |   8 ---
 8 files changed, 6 insertions(+), 125 deletions(-)

diff --git a/src/hydra/resources/HdCyclesPluginGPU_Global.ds b/src/hydra/resources/HdCyclesPluginGPU_Global.ds
index b348f7e1..c59446b0 100644
--- a/src/hydra/resources/HdCyclesPluginGPU_Global.ds
+++ b/src/hydra/resources/HdCyclesPluginGPU_Global.ds
@@ -1362,55 +1362,6 @@
         disablewhen  R"({ xn__cyclesintegratorao_additive_factor_control_h9bk == block } { xn__cyclesintegratorao_additive_factor_control_h9bk == none })"
     }
     }
-    groupcollapsible {
-        name "cycles_light_optimize"
-        label "Light Optimize"
-        grouptag { "group_default" "1" }
-    parm {
-        name    "xn__cyclesintegratoruse_light_optimize_control_h9bk"
-        label   "Use Light Optimize"
-        type    string
-        default { "none" }
-        menujoin {
-            [ "import loputils" ]
-            [ "return loputils.createEditPropertiesControlMenu(kwargs, 'bool')" ]
-            language python
-        }
-        parmtag { "sidefx::look" "icon" }
-    }
-    parm {
-        name    "xn__cyclesintegratoruse_light_optimize_gwbk"
-        label   "Use Light Optimize"
-        type    toggle
-        size    1
-        default { 0 }
-        parmtag { "spare_category" "Cycles" }
-        parmtag { "usdvaluetype" "bool" }
-        disablewhen  R"({ xn__cyclesintegratoruse_light_optimize_control_h9bk == block } { xn__cyclesintegratoruse_light_optimize_control_h9bk == none })"
-    }
-    parm {
-        name    "xn__cyclesintegratorlight_optimize_factor_control_dfck"
-        label   "Light Optimize Factor"
-        type    string
-        default { "none" }
-        menujoin {
-            [ "import loputils" ]
-            [ "return loputils.createEditPropertiesControlMenu(kwargs, 'float')" ]
-            language python
-        }
-        parmtag { "sidefx::look" "icon" }
-    }
-    parm {
-        name    "xn__cyclesintegratorlight_optimize_factor_c1bk"
-        label   "Light Optimize Factor"
-        type    float
-        size    1
-        default { 10.0 }
-        parmtag { "spare_category" "Cycles" }
-        parmtag { "usdvaluetype" "float" }
-        disablewhen  R"({ xn__cyclesintegratorlight_optimize_factor_control_dfck == block } { xn__cyclesintegratorlight_optimize_factor_control_dfck == none })"
-    }
-    }
     groupcollapsible {
         name "cycles_advanced"
         label "Advanced"
