diff --git a/src/kernel/data_template.h b/src/kernel/data_template.h
index aaf609fb..e1753b0d 100644
--- a/src/kernel/data_template.h
+++ b/src/kernel/data_template.h
@@ -157,9 +157,8 @@ KERNEL_STRUCT_MEMBER(film, int, use_approximate_shadow_catcher)
 KERNEL_STRUCT_MEMBER(film, int, pass_guiding_color)
 KERNEL_STRUCT_MEMBER(film, int, pass_guiding_probability)
 KERNEL_STRUCT_MEMBER(film, int, pass_guiding_avg_roughness)
-/* Exposure as the adaptive sampling criterion sees it: the film exposure, times the light
- * optimize factor when it is on (Integrator::get_light_optimize_scale()). */
-KERNEL_STRUCT_MEMBER(film, float, adaptive_exposure)
+/* Padding. */
+KERNEL_STRUCT_MEMBER(film, int, pad1)
 /* Composited Gaussian splat emission seen straight from the camera: a colour AOV pass named
  * `gsplat_emission` (Film::device_update()), written by integrator_intersect_gsplat_composite(). */
 KERNEL_STRUCT_MEMBER(film, int, pass_gsplat_emission)
diff --git a/src/kernel/film/adaptive_sampling.h b/src/kernel/film/adaptive_sampling.h
index a4f6f54f..07b9e68d 100644
--- a/src/kernel/film/adaptive_sampling.h
+++ b/src/kernel/film/adaptive_sampling.h
@@ -56,7 +56,7 @@ ccl_device bool film_adaptive_sampling_convergence_check(KernelGlobals kg,
   const float4 I = kernel_read_pass_float4(buffer + kernel_data.film.pass_combined);
 
   const float sample = __float_as_uint(buffer[kernel_data.film.pass_sample_count]);
-  const float intensity_scale = kernel_data.film.adaptive_exposure / sample;
+  const float intensity_scale = kernel_data.film.exposure / sample;
 
   /* The per pixel error as seen in section 2.1 of
    * "A hierarchical automatic stopping condition for Monte Carlo global illumination" */
diff --git a/src/scene/film.cpp b/src/scene/film.cpp
index 2b866cdf..d73524ef 100644
--- a/src/scene/film.cpp
+++ b/src/scene/film.cpp
@@ -159,7 +159,6 @@ void Film::device_update(Device *device, DeviceScene *dscene, Scene *scene)
 
   /* update data */
   kfilm->exposure = exposure;
-  kfilm->adaptive_exposure = exposure * scene->integrator->get_light_optimize_scale();
   kfilm->pass_alpha_threshold = pass_alpha_threshold;
   kfilm->pass_flag = 0;
   kfilm->denoising_pass_flag = 0;
diff --git a/src/scene/integrator.cpp b/src/scene/integrator.cpp
index 73d87198..7fbf9e5a 100644
--- a/src/scene/integrator.cpp
+++ b/src/scene/integrator.cpp
@@ -131,12 +131,6 @@ NODE_DEFINE(Integrator)
 
   SOCKET_FLOAT(sample_clamp_direct, "Sample Clamp Direct", 0.0f);
   SOCKET_FLOAT(sample_clamp_indirect, "Sample Clamp Indirect", 10.0f);
-  /* Light optimize: the render sampled as if every light and emission were Factor times
-   * brighter and the image divided by Factor afterwards. Only the absolute thresholds see the
-   * difference - the adaptive sampling criterion, which then samples dark areas longer, and the
-   * clamps - so those are what it scales; the lights themselves are left alone. */
-  SOCKET_BOOLEAN(use_light_optimize, "Use Light Optimize", false);
-  SOCKET_FLOAT(light_optimize_factor, "Light Optimize Factor", 10.0f);
   SOCKET_BOOLEAN(motion_blur, "Motion Blur", false);
 
   SOCKET_INT(aa_samples, "AA Samples", 0);
@@ -322,16 +316,11 @@ void Integrator::device_update(Device *device, DeviceScene *dscene, Scene *scene
   kintegrator->guiding_directional_sampling_type = guiding_params.sampling_type;
   kintegrator->guiding_roughness_threshold = guiding_params.roughness_threshold;
 
-  /* With light optimize the clamps cut where they would on Factor times brighter light. */
-  const float light_optimize_scale = get_light_optimize_scale();
-  kintegrator->sample_clamp_direct = (sample_clamp_direct == 0.0f) ?
-                                         FLT_MAX :
-                                         sample_clamp_direct * 3.0f / light_optimize_scale;
+  kintegrator->sample_clamp_direct = (sample_clamp_direct == 0.0f) ? FLT_MAX :
+                                                                     sample_clamp_direct * 3.0f;
   kintegrator->sample_clamp_indirect = (sample_clamp_indirect == 0.0f) ?
                                            FLT_MAX :
-                                           sample_clamp_indirect * 3.0f / light_optimize_scale;
-  /* Also written by the film, whichever of the two updates last. */
-  dscene->data.film.adaptive_exposure = scene->film->get_exposure() * light_optimize_scale;
