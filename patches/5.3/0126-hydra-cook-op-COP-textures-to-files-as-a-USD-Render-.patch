diff --git a/src/hydra/resources/husdplugins/outputprocessors/hdcycles_cookcoptextures.py b/src/hydra/resources/husdplugins/outputprocessors/hdcycles_cookcoptextures.py
new file mode 100644
index 00000000..4e89de04
--- /dev/null
+++ b/src/hydra/resources/husdplugins/outputprocessors/hdcycles_cookcoptextures.py
@@ -0,0 +1,58 @@
+"""hdCycles: cook `op:` COP textures to image files as a USD ROP saves.
+
+A texture path may point at a COP (`op:/img/net/OUT`). Houdini's viewport
+reads it from the live session, but husk - the USD Render ROP's renderer,
+and every render farm - runs without one: Karma renders the texture black,
+Cycles its missing-image colour. This processor cooks each referenced COP to
+an EXR beside the layer being written and points the saved USD at it, so
+the render that follows, here or on a farm, reads a real file.
+
+hdCycles adds it to every new USD Render ROP (scripts/lop and scripts/out);
+add it by hand on an existing one (Output Processors).
+"""
+
+import os
+
+import hou
+import husd.outputprocessor as base
+
+
+class CookCopTexturesOutputProcessor(base.OutputProcessor):
+    def __init__(self):
+        super(CookCopTexturesOutputProcessor, self).__init__()
+        self.frame = 1.0
+        self.cache = {}
+
+    @staticmethod
+    def name():
+        return 'hdcycles_cookcoptextures'
+
+    @staticmethod
+    def displayName():
+        return 'Cook COP Textures to Files (op: paths)'
+
+    def beginSave(self, config_node, config_overrides, lop_node, t, stage_variables):
+        super(CookCopTexturesOutputProcessor, self).beginSave(
+            config_node, config_overrides, lop_node, t, stage_variables)
+        self.frame = hou.timeToFrame(t)
+        # One cook per COP and frame: a new frame cooks again.
+        self.cache = {}
+
+    def processReferencePath(self, asset_path, referencing_layer_path, asset_is_layer):
+        if asset_is_layer or not asset_path.startswith('op:'):
+            return asset_path
+        # Imported here: plugins load before the package's python libs are on
+        # the path.
+        import flatten_op_textures
+        directory = os.path.join(os.path.dirname(referencing_layer_path), 'cop_textures')
+        try:
+            os.makedirs(directory, exist_ok=True)
+        except OSError:
+            return asset_path
+        cooked = flatten_op_textures._flatten(asset_path[len('op:'):], self.frame, directory,
+                                              self.cache)
+        return cooked.replace(os.sep, '/') if cooked else asset_path
+
+
+def usdOutputProcessor():
+    return CookCopTexturesOutputProcessor
diff --git a/src/hydra/resources/scripts/lop/usdrender_rop_OnCreated.py b/src/hydra/resources/scripts/lop/usdrender_rop_OnCreated.py
new file mode 100644
index 00000000..27201512
--- /dev/null
+++ b/src/hydra/resources/scripts/lop/usdrender_rop_OnCreated.py
@@ -0,0 +1,9 @@
+# hdCycles: a new USD Render LOP cooks its `op:` COP textures to files as it
+# saves, so husk and render farms can read them (hdcycles_cookcoptextures).
+import loputils
+
+node = kwargs['node']
+parm = node.parm('outputprocessors')
+if parm is not None and node.parm('enableoutputprocessor_hdcycles_cookcoptextures') is None:
+    loputils.handleOutputProcessorAdd(
+        {'node': node, 'parm': parm, 'script_value': 'hdcycles_cookcoptextures'})
