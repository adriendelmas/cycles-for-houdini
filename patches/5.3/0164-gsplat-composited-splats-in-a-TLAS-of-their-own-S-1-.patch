@@ -1991,6 +1990,46 @@ void OptiXDevice::build_bvh(BVH *bvh, Progress &progress, bool refit)
       }
     }
 
+    /* Composited Gaussian splats go to a TLAS of their own: no other ray ever hits them, and the
+     * ray that composites them then traverses them alone, not the whole scene. */
+    device_vector<OptixInstance> gsplat_instances(
+        this, "optix gsplat tlas instances", MEM_READ_ONLY);
+    unsigned int num_gsplat_instances = 0;
+    for (unsigned int i = 0; i < num_instances; ++i) {
+      num_gsplat_instances += composite_instance[i];
+    }
+    if (num_gsplat_instances) {
+      gsplat_instances.alloc(num_gsplat_instances);
+      unsigned int kept = 0, moved = 0;
+      for (unsigned int i = 0; i < num_instances; ++i) {
+        if (composite_instance[i]) {
+          gsplat_instances[moved] = instances[i];
+          gsplat_instances[moved++].visibilityMask = 0xFF;
+        }
+        else {
+          instances[kept++] = instances[i];
+        }
+      }
+      num_instances = kept;
+    }
+
+    /* Its memory is freed with a delay, as any BVH (~BVHOptiX()). */
+    gsplat_tlas.reset();
+    gsplat_tlas_handle = 0;
+    if (num_gsplat_instances) {
+      gsplat_instances.copy_to_device();
+      gsplat_tlas = make_unique<BVHOptiX>(
+          bvh->params, vector<Geometry *>(), vector<Object *>(), this);
+      OptixBuildInput gsplat_input = {};
+      gsplat_input.type = OPTIX_BUILD_INPUT_TYPE_INSTANCES;
+      gsplat_input.instanceArray.instances = gsplat_instances.device_pointer;
+      gsplat_input.instanceArray.numInstances = num_gsplat_instances;
+      if (!build_optix_bvh(gsplat_tlas.get(), OPTIX_BUILD_OPERATION_BUILD, gsplat_input, 0)) {
+        progress.set_error("Failed to build OptiX acceleration structure");
+      }
+      gsplat_tlas_handle = gsplat_tlas->traversable_handle;
+    }
+
     /* Upload instance descriptions. */
     instances.resize(num_instances);
     instances.copy_to_device();
@@ -2037,6 +2076,8 @@ void OptiXDevice::const_copy_to(const char *name, void *host, const size_t size)
     /* Update traversable handle (since it is different for each device on multi devices). */
     KernelData *const data = (KernelData *)host;
     *(OptixTraversableHandle *)&data->device_bvh = tlas_handle;
+    static_assert(offsetof(KernelData, pad3) == offsetof(KernelData, pad2) + sizeof(int));
+    *(OptixTraversableHandle *)&data->pad2 = gsplat_tlas_handle;
 
     update_launch_params(offsetof(KernelParamsOptiX, data), host, size);
     return;
