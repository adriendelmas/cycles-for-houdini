diff --git a/src/kernel/geom/gsplat_intersect.h b/src/kernel/geom/gsplat_intersect.h
index d29537c2..06dc699e 100644
--- a/src/kernel/geom/gsplat_intersect.h
+++ b/src/kernel/geom/gsplat_intersect.h
@@ -221,6 +221,70 @@ ccl_device_forceinline bool gsplat_intersect_response(KernelGlobals kg,
   return true;
 }
 
+/* The response of a composited splat, read once: for a splat that does not move, its S^-1 R^T
+ * comes precomputed (PointCloud::pack_gsplat_inverse()) instead of being rebuilt from the
+ * rotation and the scale, and the radiance comes with the opacity. Same result as
+ * gsplat_intersect_response(). */
+ccl_device_forceinline bool gsplat_composite_response(KernelGlobals kg,
+                                                      const float3 ray_P,
+                                                      const float3 ray_D,
+                                                      const float ray_tmin,
+                                                      const float ray_tmax,
+                                                      const int object,
+                                                      const int prim,
+                                                      const float time,
+                                                      const int primitive_type,
+                                                      ccl_private float &r_response,
+                                                      ccl_private float3 &r_radiance)
+{
+  if (primitive_type & PRIMITIVE_MOTION) {
+    float t;
+    if (!gsplat_intersect_response(kg,
+                                   ray_P,
+                                   ray_D,
+                                   ray_tmin,
+                                   ray_tmax,
+                                   object,
+                                   prim,
+                                   time,
+                                   primitive_type,
+                                   t,
+                                   r_response))
+    {
+      return false;
+    }
+    r_radiance = make_float3(motion_gsplat_radiance_base(kg, object, prim, time));
+    return true;
+  }
+
+  const int position_offset = kernel_data_fetch(objects, object).position_offset;
+  const float4 point = kernel_data_fetch(points, position_offset + prim);
+  float sphere_t;
+  if (!point_intersect_test<false>(point, ray_P, ray_D, ray_tmin, ray_tmax, &sphere_t)) {
+    return false;
+  }
+
+  const float3 M0 = make_float3(kernel_data_fetch(gsplat_inverse, prim * 3 + 0));
+  const float3 M1 = make_float3(kernel_data_fetch(gsplat_inverse, prim * 3 + 1));
+  const float3 M2 = make_float3(kernel_data_fetch(gsplat_inverse, prim * 3 + 2));
+
+  const float3 o = ray_P - make_float3(point);
+  const float3 o_g = make_float3(dot(M0, o), dot(M1, o), dot(M2, o));
+  const float3 d_g = make_float3(dot(M0, ray_D), dot(M1, ray_D), dot(M2, ray_D));
+  const float t = -dot(o_g, d_g) / dot(d_g, d_g);
+  if (!(t >= ray_tmin && t <= ray_tmax)) {
+    return false;
+  }
+
+  /* M (x - mu) with x = P + t D, by linearity. */
+  const float3 e_g = o_g + t * d_g;
+  const float4 base = kernel_data_fetch(attributes_float4,
+                                        gsplat_attr_radiance_base_offset(kg, object) + prim);
+  r_response = base.w * fast_expf(-0.5f * dot(e_g, e_g));
+  r_radiance = make_float3(base);
+  return true;
+}
+
 /* Emission and transmittance of the composited Gaussian splats along one path segment.
  *
  * The splats are summed in no particular order, as weighted-average order independent
@@ -246,10 +310,19 @@ ccl_device_forceinline void gsplat_composite_accumulate(KernelGlobals kg,
                                                         const float time,
                                                         const int primitive_type)
 {
-  float t;
   float response;
-  if (!gsplat_intersect_response(
-          kg, ray_P, ray_D, ray_tmin, ray_tmax, object, prim, time, primitive_type, t, response))
+  float3 radiance;
+  if (!gsplat_composite_response(kg,
+                                 ray_P,
+                                 ray_D,
+                                 ray_tmin,
+                                 ray_tmax,
+                                 object,
+                                 prim,
+                                 time,
+                                 primitive_type,
+                                 response,
+                                 radiance))
   {
     return;
   }
@@ -263,8 +336,7 @@ ccl_device_forceinline void gsplat_composite_accumulate(KernelGlobals kg,
   response = fminf(response, 0.9999f);
 
   /* In composite mode the base radiance holds the splat's linear colour. */
-  const float4 radiance_base = motion_gsplat_radiance_base(kg, object, prim, time);
-  accum.radiance += response * make_float3(radiance_base);
+  accum.radiance += response * radiance;
   accum.response += response;
   accum.log_transmittance += logf(1.0f - response);
 }
