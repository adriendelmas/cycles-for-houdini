diff --git a/src/scene/pointcloud.cpp b/src/scene/pointcloud.cpp
index 75d57486..3b25fe01 100644
--- a/src/scene/pointcloud.cpp
+++ b/src/scene/pointcloud.cpp
@@ -330,6 +330,31 @@ void PointCloud::bounds_grow_gsplat(const size_t i,
   bounds.grow(P + half);
 }
 
+void PointCloud::pack_gsplat_inverse(float4 *rows) const
+{
+  if ((primitive_type() & PRIMITIVE_GSPLAT) == 0) {
+    return;
+  }
+  const Attribute *attr_scale = attributes.find(ATTR_STD_GSPLAT_SCALE);
+  const Attribute *attr_rotation = attributes.find(ATTR_STD_GSPLAT_ROTATION);
+  if (!attr_scale || !attr_rotation || attr_scale->has_motion() || attr_rotation->has_motion()) {
+    return;
+  }
+  const packed_float3 *scale = attr_scale->data<packed_float3>();
+  const Quaternion *rotation = attr_rotation->data<Quaternion>();
+
+  parallel_for(blocked_range<size_t>(0, num_points(), 1024), [&](const blocked_range<size_t> &r) {
+    for (size_t i = r.begin(); i != r.end(); i++) {
+      /* Row k of S^-1 R^T is column k of R over scale k (gsplat_intersect_response()). */
+      const float3x3 R = quaternion_to_rotation(rotation[i]);
+      const float3 inv_scale = one_float3() / float3(scale[i]);
+      rows[i * 3 + 0] = make_float4(make_float3(R.x.x, R.y.x, R.z.x) * inv_scale.x, 0.0f);
+      rows[i * 3 + 1] = make_float4(make_float3(R.x.y, R.y.y, R.z.y) * inv_scale.y, 0.0f);
+      rows[i * 3 + 2] = make_float4(make_float3(R.x.z, R.y.z, R.z.z) * inv_scale.z, 0.0f);
+    }
+  });
+}
+
 void PointCloud::update_gsplat_radii()
 {
   /* Calculate radius attribute to bound the Gaussian splats based on the splat scale, allowing
diff --git a/src/scene/pointcloud.h b/src/scene/pointcloud.h
index 5a02b8fe..f2931529 100644
--- a/src/scene/pointcloud.h
+++ b/src/scene/pointcloud.h
@@ -112,6 +112,10 @@ class PointCloud : public Geometry {
     return gsplat_composite && (primitive_type() & PRIMITIVE_GSPLAT);
   }
 
+  /* S^-1 R^T of every splat, three float4 rows each (gsplat_composite_response()); untouched
+   * for points and for splats whose scale or rotation move. */
+  void pack_gsplat_inverse(float4 *rows) const;
+
   /* Bounds of point i for a BVH: for a Gaussian splat, the axis-aligned box of its ellipsoid
    * cut where its bounding sphere was (radius = k * max sigma, semi-axes k * sigma); a stretched
    * splat's box is several times thinner than the sphere's, and every ray crossing the sphere
