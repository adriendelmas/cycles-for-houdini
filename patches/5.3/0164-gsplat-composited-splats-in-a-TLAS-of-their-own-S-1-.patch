index a5620b62..42d83f61 100644
--- a/src/scene/geometry_mesh.cpp
+++ b/src/scene/geometry_mesh.cpp
@@ -139,6 +139,26 @@ void GeometryManager::device_update_mesh(Device * /*unused*/,
     }
 
     dscene->points_shader.copy_to_device();
+
+    /* The ray-space transform of each Gaussian splat, S^-1 R^T, so that the kernel reads it
+     * instead of rebuilding it from the rotation and the scale at every ray it tests
+     * (gsplat_composite_response()). Splats whose scale or rotation move keep the general path. */
+    bool have_gsplats = false;
+    for (Geometry *geom : scene->geometry) {
+      have_gsplats |= geom->is_pointcloud() &&
+                      (static_cast<PointCloud *>(geom)->primitive_type() & PRIMITIVE_GSPLAT);
+    }
+    if (have_gsplats) {
+      float4 *inverse = dscene->gsplat_inverse.alloc(point_size * 3);
+      std::fill_n(inverse, point_size * 3, zero_float4());
+      for (Geometry *geom : scene->geometry) {
+        if (geom->is_pointcloud()) {
+          static_cast<PointCloud *>(geom)->pack_gsplat_inverse(
+              &inverse[static_cast<PointCloud *>(geom)->prim_offset * 3]);
