     delayed_install("${CMAKE_CURRENT_SOURCE_DIR}/resources" "MainMenuCommon.xml" "${CYCLES_INSTALL_PATH}/houdini")
     delayed_install("${CMAKE_CURRENT_SOURCE_DIR}/resources" "cycles_device.py" "${CYCLES_INSTALL_PATH}/houdini/scripts/python")
     delayed_install("${CMAKE_CURRENT_SOURCE_DIR}/resources" "pythonrc.py" "${CYCLES_INSTALL_PATH}/houdini/scripts")
