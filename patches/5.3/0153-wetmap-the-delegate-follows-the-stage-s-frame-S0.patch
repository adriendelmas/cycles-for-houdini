 #include "util/thread.h"
 #include "util/types.h"
 
@@ -371,6 +372,10 @@ class HdCyclesSession final : public PXR_NS::HdRenderParam {
   CCL_NS::Session *session;
   bool keep_nodes;
 
+  /* Wet map (addition): the frame the state belongs to. Here and not on the
+   * render pass, which batch renders build anew. */
+  HdCyclesWetState wetState;
+
  private:
   const bool _ownCyclesSession;
