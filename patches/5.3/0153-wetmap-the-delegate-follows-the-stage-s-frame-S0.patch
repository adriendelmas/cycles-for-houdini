diff --git a/src/hydra/wet_state.cpp b/src/hydra/wet_state.cpp
new file mode 100644
index 00000000..cc21eaad
--- /dev/null
+++ b/src/hydra/wet_state.cpp
@@ -0,0 +1,49 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#include "hydra/wet_state.h"
+
+#include "util/log.h"
+
+#include <pxr/imaging/hd/sceneGlobalsSchema.h>
+#include <pxr/imaging/hd/sceneIndex.h>
+
+HDCYCLES_NAMESPACE_OPEN_SCOPE
+
+bool HdCyclesWetState::OnExecute(const HdRenderIndex &index)
+{
+  const HdSceneIndexBaseRefPtr si = index.GetTerminalSceneIndex();
+  if (!si) {
+    return false;
+  }
+  const HdSceneGlobalsSchema globals = HdSceneGlobalsSchema::GetFromSceneIndex(si);
+  if (const auto fpsDs = globals.GetTimeCodesPerSecond()) {
+    const double fps = fpsDs->GetTypedValue(0.0f);
+    if (fps > 0.0) {
+      _fps = fps;
+    }
+  }
+  const auto frameDs = globals.GetCurrentFrame();
+  if (!frameDs) {
+    /* Without a frame the state cannot advance; the node still renders the
+     * current contact. */
+    if (!_warnedNoFrame) {
+      _warnedNoFrame = true;
+      LOG_INFO << "Wet map: the scene globals carry no current frame, the state stays still.";
+    }
+    return false;
+  }
+  const double frame = frameDs->GetTypedValue(0.0f);
+  if (_haveFrame && frame == _frame) {
+    return false;
+  }
+  _deltaSeconds = _haveFrame ? (frame - _frame) / _fps : 0.0;
+  LOG_INFO << "Wet map: frame " << (_haveFrame ? std::to_string(_frame) : std::string("none"))
+           << " -> " << frame << " (" << _deltaSeconds << " s at " << _fps << " fps).";
+  _frame = frame;
+  _haveFrame = true;
+  return true;
+}
+
+HDCYCLES_NAMESPACE_CLOSE_SCOPE
diff --git a/src/hydra/wet_state.h b/src/hydra/wet_state.h
new file mode 100644
index 00000000..627046dd
--- /dev/null
+++ b/src/hydra/wet_state.h
@@ -0,0 +1,47 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Wet map (addition, docs/WETMAP_PLAN.md): the host side of the per-object
+ * state that persists from one frame to the next. It follows the frame the
+ * stage is at, so that the state advances once per frame change and never on
+ * the viewport's restarts of the same frame. */
+
+#include "hydra/config.h"
+
+#include <pxr/imaging/hd/renderIndex.h>
+
+HDCYCLES_NAMESPACE_OPEN_SCOPE
+
+class HdCyclesWetState {
+ public:
+  /* Once per render pass execution, before the session is reset: reads the
+   * stage's current frame and frame rate from the scene globals. Returns true
+   * when the frame changed since the last call. */
+  bool OnExecute(const PXR_NS::HdRenderIndex &index);
+
+  bool HasFrame() const
+  {
+    return _haveFrame;
+  }
+  double Frame() const
+  {
+    return _frame;
+  }
+  /* Seconds between the previous frame and this one; 0 before the second frame. */
+  double DeltaSeconds() const
+  {
+    return _deltaSeconds;
+  }
+
+ private:
+  bool _haveFrame = false;
+  bool _warnedNoFrame = false;
+  double _frame = 0.0;
+  double _fps = 24.0;
+  double _deltaSeconds = 0.0;
+};
+
+HDCYCLES_NAMESPACE_CLOSE_SCOPE
