index 4a7e9076..d97bf619 100644
--- a/src/hydra/render_pass.cpp
+++ b/src/hydra/render_pass.cpp
@@ -117,6 +117,9 @@ void HdCyclesRenderPass::_Execute(const HdRenderPassStateSharedPtr &renderPassSt
     session->progress.reset();
   }
 
+  /* Wet map (addition): follow the stage's frame. */
+  _renderParam->wetState.OnExecute(*GetRenderIndex());
+
   /* Motion blur turned back on, or the shutter moved: the prims synced so far
    * carry no motion samples, or samples over the old shutter. Have them synced
    * again; the render index does it before the next execution. */
diff --git a/src/hydra/session.h b/src/hydra/session.h
index e3e04588..9e95d0ef 100644
--- a/src/hydra/session.h
+++ b/src/hydra/session.h
@@ -6,6 +6,7 @@
 #pragma once
 
 #include "hydra/config.h"
