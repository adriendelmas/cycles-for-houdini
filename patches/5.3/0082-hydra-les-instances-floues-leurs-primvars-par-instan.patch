+std::vector<HdCyclesInstancer::InstancePrimvar> HdCyclesInstancer::ComputeInstancePrimvars(
+    const SdfPath &prototypeId)
+{
+  HdSceneDelegate *const sceneDelegate = GetDelegate();
+  const SdfPath &id = GetId();
+  const HdSceneIndexPrim prim = GetPrim(sceneDelegate, id);
+
+  HdInstancerTopologySchema topology = HdInstancerTopologySchema::GetFromParent(prim.dataSource);
+  const VtIntArray instanceIndices = topology ?
+                                         topology.ComputeInstanceIndicesForProto(prototypeId) :
+                                         VtIntArray();
+  const size_t numLocal = instanceIndices.size();
+
+  std::vector<InstancePrimvar> local;
+  const HdPrimvarsSchema primvars = HdPrimvarsSchema::GetFromParent(prim.dataSource);
+  for (const TfToken &name : PrimvarNamesAtInterpolation(primvars, HdInterpolationInstance)) {
+    /* The transform arrays are instance primvars too. */
+    if (name == HdInstancerTokens->instanceTranslations ||
+        name == HdInstancerTokens->instanceRotations ||
+        name == HdInstancerTokens->instanceScales ||
+        name == HdInstancerTokens->instanceTransforms ||
+        TfStringStartsWith(name.GetString(), "hydra:") ||
+        TfStringStartsWith(name.GetString(), "__"))
+    {
+      continue;
+    }
+    const VtValue value = ReadPrimvar(primvars, name);
+    float element[4];
+    const int components = ArrayElement(value, 0, element);
+    if (components == 0) {
+      continue;
+    }
+    InstancePrimvar pv;
+    pv.name = name;
+    pv.role = ReadPrimvarRole(primvars, name);
+    pv.components = components;
+    pv.values.resize(size_t(components) * numLocal);
+    for (size_t i = 0; i < numLocal; ++i) {
+      ArrayElement(value, size_t(instanceIndices[i]), element);
+      std::copy(element, element + components, pv.values.begin() + i * components);
+    }
+    local.push_back(std::move(pv));
+  }
+
+  const SdfPath parentId = GetParentInstancerId();
+  auto *const parentInstancer = parentId.IsEmpty() ?
+                                    nullptr :
+                                    static_cast<HdCyclesInstancer *>(
+                                        sceneDelegate->GetRenderIndex().GetInstancer(parentId));
+  if (!parentInstancer) {
+    return local;
+  }
+
+  /* Nested: the instances are ordered parent-major, as the transforms are. */
+  const size_t numParent = parentInstancer->ComputeInstanceTransforms(id).size();
+  std::vector<InstancePrimvar> parent = parentInstancer->ComputeInstancePrimvars(id);
+  std::vector<InstancePrimvar> result;
+  for (const InstancePrimvar &pv : local) {
+    InstancePrimvar expanded = pv;
+    expanded.values.resize(size_t(pv.components) * numLocal * numParent);
+    for (size_t p = 0; p < numParent; ++p) {
+      std::copy(pv.values.begin(),
+                pv.values.end(),
+                expanded.values.begin() + p * numLocal * pv.components);
+    }
+    result.push_back(std::move(expanded));
+  }
+  for (const InstancePrimvar &pv : parent) {
+    bool shadowed = false;
+    for (const InstancePrimvar &own : local) {
+      shadowed |= own.name == pv.name;
+    }
+    if (shadowed || pv.values.size() != size_t(pv.components) * numParent) {
+      continue;
+    }
+    InstancePrimvar expanded = pv;
+    expanded.values.resize(size_t(pv.components) * numLocal * numParent);
+    for (size_t p = 0; p < numParent; ++p) {
+      for (size_t l = 0; l < numLocal; ++l) {
+        std::copy(pv.values.begin() + p * pv.components,
+                  pv.values.begin() + (p + 1) * pv.components,
+                  expanded.values.begin() + (p * numLocal + l) * pv.components);
+      }
+    }
+    result.push_back(std::move(expanded));
+  }
+  return result;
+}
