+namespace {
+
+/* One element of a numeric array as floats, or 0 components when the type
+ * is not one a Cycles object attribute can hold. */
+int ArrayElement(const VtValue &value, const size_t index, float out[4])
+{
+  if (value.IsHolding<VtFloatArray>()) {
+    const VtFloatArray &a = value.UncheckedGet<VtFloatArray>();
+    out[0] = index < a.size() ? a[index] : 0.0f;
+    return 1;
+  }
+  if (value.IsHolding<VtDoubleArray>()) {
+    const VtDoubleArray &a = value.UncheckedGet<VtDoubleArray>();
+    out[0] = index < a.size() ? float(a[index]) : 0.0f;
+    return 1;
+  }
+  if (value.IsHolding<VtIntArray>()) {
+    const VtIntArray &a = value.UncheckedGet<VtIntArray>();
+    out[0] = index < a.size() ? float(a[index]) : 0.0f;
+    return 1;
+  }
+  if (value.IsHolding<VtVec2fArray>()) {
+    const VtVec2fArray &a = value.UncheckedGet<VtVec2fArray>();
+    const GfVec2f v = index < a.size() ? a[index] : GfVec2f(0.0f);
+    out[0] = v[0];
+    out[1] = v[1];
+    return 2;
+  }
+  if (value.IsHolding<VtVec3fArray>()) {
+    const VtVec3fArray &a = value.UncheckedGet<VtVec3fArray>();
+    const GfVec3f v = index < a.size() ? a[index] : GfVec3f(0.0f);
+    out[0] = v[0];
+    out[1] = v[1];
+    out[2] = v[2];
+    return 3;
+  }
+  if (value.IsHolding<VtVec4fArray>()) {
+    const VtVec4fArray &a = value.UncheckedGet<VtVec4fArray>();
+    const GfVec4f v = index < a.size() ? a[index] : GfVec4f(0.0f);
+    for (int i = 0; i < 4; ++i) {
+      out[i] = v[i];
+    }
+    return 4;
+  }
+  return 0;
+}
