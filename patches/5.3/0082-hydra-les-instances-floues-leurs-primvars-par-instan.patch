+/* Cycles attributes hold arrays of floats. A constant primvar authored as a
+ * scalar - `float primvars:heat = 0.5`, not `float[]` - has no array size, so
+ * the copy below moved nothing and the attribute read back as zero; doubles
+ * and integers were refused outright. Bring all of them to a float array. */
+template<typename From, typename To> bool ConvertArray(const VtValue &in, VtValue &out)
+{
+  if (in.IsHolding<From>()) {
+    out = VtValue(VtArray<To>(1, To(in.UncheckedGet<From>())));
+    return true;
+  }
+  if (in.IsHolding<VtArray<From>>()) {
+    const VtArray<From> &src = in.UncheckedGet<VtArray<From>>();
+    VtArray<To> dst(src.size());
+    for (size_t i = 0; i < src.size(); ++i) {
+      dst[i] = To(src[i]);
+    }
+    out = VtValue(dst);
+    return true;
+  }
+  return false;
+}
+
+VtValue AsFloatArray(const VtValue &value)
+{
+  VtValue out;
+  if (value.IsHolding<float>()) {
+    return VtValue(VtFloatArray(1, value.UncheckedGet<float>()));
+  }
+  if (value.IsHolding<GfVec2f>()) {
+    return VtValue(VtVec2fArray(1, value.UncheckedGet<GfVec2f>()));
+  }
+  if (value.IsHolding<GfVec3f>()) {
+    return VtValue(VtVec3fArray(1, value.UncheckedGet<GfVec3f>()));
+  }
+  if (value.IsHolding<GfVec4f>()) {
+    return VtValue(VtVec4fArray(1, value.UncheckedGet<GfVec4f>()));
+  }
+  if (ConvertArray<double, float>(value, out) || ConvertArray<int, float>(value, out) ||
+      ConvertArray<GfVec2d, GfVec2f>(value, out) || ConvertArray<GfVec3d, GfVec3f>(value, out) ||
+      ConvertArray<GfVec4d, GfVec4f>(value, out))
+  {
+    return out;
+  }
+  return value;
+}
