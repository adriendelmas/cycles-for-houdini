From a01c665ea9ffd20b9dc3d641e441431c8a5f440c Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Mon, 31 Aug 2026 13:33:28 +0200
Subject: [PATCH 11/53] hydra: create the shared GL context before draw() can
 return early

draw() returns early when the display AOV binding is missing, when its
dimensions do not match, or when the render buffer is not in use, and
gl_context_create() sat after all three. The Cycles render thread calls
update_begin() from the moment the session starts, so until a draw finally got
all the way through there was no context and every frame reported
'PathTraceDisplay implementation could not begin update'.

draw() runs on the thread the host makes its GL context current on, which is
the only place a shareable context can be built - doing it from the display
driver constructor does not work, as the render pass is not necessarily
constructed on that thread.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/hydra/display_driver.cpp | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/hydra/display_driver.cpp b/src/hydra/display_driver.cpp
index 381e65bc..02f042c6 100644
--- a/src/hydra/display_driver.cpp
+++ b/src/hydra/display_driver.cpp
@@ -264,6 +264,13 @@ void HdCyclesDisplayDriver::zero()
 
 void HdCyclesDisplayDriver::draw(const Params &params)
 {
+  /* Create the shared context before anything can return early. draw() runs on
+   * the thread the host makes its GL context current on, which is the only
+   * place a shareable context can be built - and the render thread calls
+   * update_begin() from the moment the session starts, so waiting until a draw
+   * got all the way through left it reporting a failure on every frame. */
+  gl_context_create();
+
   auto *const renderBuffer = static_cast<HdCyclesRenderBuffer *>(
       _renderParam->GetDisplayAovBinding().renderBuffer);
   if (!renderBuffer ||  // Ensure this render buffer matches the texture dimensions
@@ -276,8 +283,6 @@ void HdCyclesDisplayDriver::draw(const Params &params)
     return;
   }
 
-  gl_context_create();
-
   // Cycles 'DisplayDriver' only supports 'half4' format
   TF_VERIFY(renderBuffer->GetFormat() == HdFormatFloat16Vec4);
 
