+void HdCyclesSession::SetObjectCategories(Object *object, std::vector<TfToken> categories)
+{
+  std::sort(categories.begin(), categories.end());
+  auto &current = _objectCategories[object];
+  if (current != categories) {
+    current = std::move(categories);
+    _lightLinkingDirty = true;
+  }
+}
+
+void HdCyclesSession::SetLightLinks(Object *light, TfToken lightLink, TfToken shadowLink)
+{
+  auto &current = _lightLinks[light];
+  if (current.first != lightLink || current.second != shadowLink) {
+    current = {lightLink, shadowLink};
+    _lightLinkingDirty = true;
+  }
+}
+
+void HdCyclesSession::ForgetObject(Object *object)
+{
+  _lightLinkingDirty |= _objectCategories.erase(object) + _lightLinks.erase(object) > 0;
+}
+
+/* Hydra links a light to the prims of a category; Cycles to sets. A receiver
+ * belongs to one light set, the one of its combination of linked categories,
+ * and a light lists the sets it reaches: all of them when it links nothing,
+ * else the sets whose combination holds its category. Set 0 is the prims in
+ * no linked category, which a linked light leaves out. Shadows work the same
+ * way with blocker sets. */
+void HdCyclesSession::UpdateLightLinking(Scene *scene)
+{
+  _lightLinkingDirty = false;
+
+  for (const bool shadow : {false, true}) {
+    std::set<TfToken> linked;
+    for (const auto &entry : _lightLinks) {
+      const TfToken &link = shadow ? entry.second.second : entry.second.first;
+      if (!link.IsEmpty()) {
+        linked.insert(link);
+      }
+    }
+
+    /* The sets: one per distinct combination of linked categories. */
+    std::map<std::vector<TfToken>, int> sets;
+    std::map<Object *, int> setOf;
+    for (const auto &[object, categories] : _objectCategories) {
+      std::vector<TfToken> key;
+      for (const TfToken &category : categories) {
+        if (linked.count(category)) {
+          key.push_back(category);
+        }
+      }
+      int index = 0;
+      if (!key.empty()) {
+        const auto it = sets.find(key);
+        if (it != sets.end()) {
+          index = it->second;
+        }
+        else if (int(sets.size()) + 1 < LIGHT_LINK_SET_MAX) {
+          index = int(sets.size()) + 1;
+          sets.emplace(key, index);
+        }
+        else {
+          LOG_WARNING << "More than " << LIGHT_LINK_SET_MAX - 1
+                      << " combinations of linked lights; the rest are lit by every light.";
+        }
+      }
+      setOf[object] = index;
+    }
+
+    for (const auto &[object, index] : setOf) {
+      if (shadow) {
+        object->set_blocker_shadow_set(index);
+      }
+      else {
+        object->set_receiver_light_set(index);
+      }
+      object->tag_update(scene);
+    }
+
+    for (const auto &[light, links] : _lightLinks) {
+      const TfToken &link = shadow ? links.second : links.first;
+      uint64_t mask = LIGHT_LINK_MASK_ALL;
+      if (!link.IsEmpty()) {
+        mask = 0;
+        for (const auto &[key, index] : sets) {
+          if (std::find(key.begin(), key.end(), link) != key.end()) {
+            mask |= uint64_t(1) << index;
+          }
+        }
+      }
+      if (shadow) {
+        light->set_shadow_set_membership(mask);
+      }
+      else {
+        light->set_light_set_membership(mask);
+      }
+      light->tag_update(scene);
+    }
+  }
+}
+
 void HdCyclesSession::UpdateScene()
 {
   Scene *const scene = session->scene.get();
 
+  if (_lightLinkingDirty) {
+    UpdateLightLinking(scene);
+  }
+
   // Update background depending on presence of a background light
   if (scene->light_manager->need_update() || _backgroundDirty) {
     _backgroundDirty = false;
