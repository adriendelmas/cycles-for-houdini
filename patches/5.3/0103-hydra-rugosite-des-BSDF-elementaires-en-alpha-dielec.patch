From b88fdd424be0b2562460d1827bc3a51858fcad02 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Thu, 8 Oct 2026 09:34:52 +0200
Subject: [PATCH 103/129] hydra: rugosite des BSDF elementaires en alpha,
 dielectric_bsdf selon scatter_mode

La rugosite de conductor_bsdf et dielectric_bsdf est deja l'alpha GGX dans
MaterialX (mx_conductor_bsdf.glsl l'emploie telle quelle ; standard_surface
met la sienne au carre via roughness_anisotropy avant de la passer), et
Cycles met au carre sa propre roughness : elevee deux fois, un metal fait
main a alpha 0,25 avait des reflets 2,2 fois plus forts que chez Karma. Une
racine carree la ramene. Et dielectric_bsdf finissait en verre quel que soit
son scatter_mode, dont le defaut "R" est une reflexion seule - le vernis
d'un empilement : sphere 12 fois trop claire. Un noeud par mode maintenant :
R un principled sans diffus ni transmission, T un refraction_bsdf, RT le
verre. tools/bench_agree.py : pics a 0,96 et 1,00 de Karma (K-58).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/hydra/material.cpp | 100 ++++++++++++++++++++++++++++++++++-------
 1 file changed, 83 insertions(+), 17 deletions(-)

diff --git a/src/hydra/material.cpp b/src/hydra/material.cpp
index 52e29897..f76c5525 100644
--- a/src/hydra/material.cpp
+++ b/src/hydra/material.cpp
@@ -877,6 +877,64 @@ UsdToCyclesMapping MakeMtlxStandardSurfaceGlass()
   return mapping;
 }
 
+/* The roughness of MaterialX's elementary BSDFs is already the GGX alpha -
+ * `mx_conductor_bsdf.glsl` clamps it and uses it as such, and
+ * standard_surface squares its `specular_roughness` through
+ * `roughness_anisotropy` before handing it over. Cycles squares its own
+ * `roughness` socket. Passed straight through, it was squared twice: a
+ * hand-built conductor at alpha 0.25 peaked 2.2 times above Karma's
+ * (tools/bench_agree.py, 2026-10-08). This helper takes the square root back;
+ * a vector2 (anisotropic) roughness is averaged on the way in. */
+const UsdToCyclesMapping::Helper kAlphaToRoughness = {
+    "rsq",
+    "math",
+    {{"Value", "Roughness"}},
+    {{ustring("math_type"), "sqrt"}, {ustring("value1"), "0.05"}}};
+
+/* `dielectric_bsdf`, one mapping per `scatter_mode`. The mode defaults to
+ * "R" - reflection only, the coat of a hand-built layer stack - and every
+ * mode used to land on glass_bsdf, which transmits: a default dielectric
+ * sphere rendered twelve times brighter than Karma's, the floor showing
+ * through. "R" is a principled with neither diffuse nor transmission - its
+ * dielectric Fresnel at `ior`, tinted by `tint` - "T" a refraction_bsdf,
+ * "RT" the glass. */
+UsdToCyclesMapping MakeMtlxDielectric(const char scatterMode)
+{
+  if (scatterMode == 'R') {
+    UsdToCyclesMapping m{"principled_bsdf",
+                         {
+                             {TfToken("tint"), ustring("specular_tint")},
+                             {TfToken("roughness"), ustring("rsq:value1")},
+                             {TfToken("normal"), ustring("normal")},
+                             {TfToken("ior"), ustring("ior")},
+                             {TfToken("thinfilm_thickness"), ustring("thin_film_thickness")},
+                             {TfToken("thinfilm_ior"), ustring("thin_film_ior")},
+                             {CyclesMaterialTokens->out, ustring("BSDF")},
+                         }};
+    m.setFixedValues({{ustring("base_color"), "0,0,0"},
+                      {ustring("metallic"), "0"},
+                      {ustring("transmission_weight"), "0"}});
+    m.addHelper(kAlphaToRoughness);
+    return m;
+  }
+  UsdToCyclesMapping m{scatterMode == 'T' ? "refraction_bsdf" : "glass_bsdf",
+                       {
+                           {TfToken("tint"), ustring("color")},
+                           {TfToken("roughness"), ustring("rsq:value1")},
+                           {TfToken("normal"), ustring("normal")},
+                           {TfToken("ior"), ustring("IOR")},
+                           {TfToken("thinfilm_thickness"), ustring("thin_film_thickness")},
+                           {TfToken("thinfilm_ior"), ustring("thin_film_ior")},
+                           {CyclesMaterialTokens->out, ustring("BSDF")},
+                       }};
+  m.addHelper(kAlphaToRoughness);
+  return m;
+}
+
+const UsdToCyclesMapping MtlxDielectricR = MakeMtlxDielectric('R');
+const UsdToCyclesMapping MtlxDielectricT = MakeMtlxDielectric('T');
+const UsdToCyclesMapping MtlxDielectricRT = MakeMtlxDielectric('B');
+
 /* An image node, with the wrapping and filtering MaterialX asks for.
  *
  * Three of the four address modes are spelled the same on both sides, so the
@@ -1685,13 +1743,13 @@ const std::vector<MtlxEntry> &MtlxTable()
    * takes exactly those two; the glossy_bsdf this used to land on has a
    * colour and no index, so every conductor rendered white. The defaults are
    * MaterialX's, gold. `roughness` is a vector2 (anisotropic) and is averaged
-   * onto Cycles' scalar. */
+   * onto Cycles' scalar, then square-rooted (kAlphaToRoughness). */
   static const UsdToCyclesMapping kConductor = [] {
     UsdToCyclesMapping m{"metallic_bsdf",
                          {
                              {TfToken("ior"), ustring("ior")},
                              {TfToken("extinction"), ustring("k")},
-                             {TfToken("roughness"), ustring("roughness")},
+                             {TfToken("roughness"), ustring("rsq:value1")},
                              {TfToken("normal"), ustring("normal")},
                              {TfToken("tangent"), ustring("tangent")},
                              {TfToken("thinfilm_thickness"), ustring("thin_film_thickness")},
@@ -1701,22 +1759,9 @@ const std::vector<MtlxEntry> &MtlxTable()
     m.setFixedValues({{ustring("fresnel_type"), "physical_conductor"},
                       {ustring("ior"), "0.183,0.421,1.373"},
                       {ustring("k"), "3.424,2.346,1.771"}});
+    m.addHelper(kAlphaToRoughness);
     return m;
   }();
-  /* `dielectric_bsdf`: `tint` colours both lobes, as glass_bsdf's colour does.
-   * `scatter_mode` is not carried - an "R" dielectric (reflection only, the
-   * coat of a hand-built layer stack) still transmits here. */
-  static const UsdToCyclesMapping kDielectric = {
-      "glass_bsdf",
-      {
-          {TfToken("tint"), ustring("color")},
-          {TfToken("roughness"), ustring("roughness")},
-          {TfToken("normal"), ustring("normal")},
-          {TfToken("ior"), ustring("IOR")},
-          {TfToken("thinfilm_thickness"), ustring("thin_film_thickness")},
-          {TfToken("thinfilm_ior"), ustring("thin_film_ior")},
-          {CyclesMaterialTokens->out, ustring("BSDF")},
-      }};
   static const UsdToCyclesMapping kDiffuse = {
       "diffuse_bsdf",
       {
@@ -2380,7 +2425,7 @@ const std::vector<MtlxEntry> &MtlxTable()
       {"ND_measured_edf", &kEmission},
       {"ND_generalized_schlick_edf", &kEmission},
       {"ND_conductor_bsdf", &kConductor},
-      {"ND_dielectric_bsdf", &kDielectric},
+      {"ND_dielectric_bsdf", &MtlxDielectricRT},
       {"ND_oren_nayar_diffuse_bsdf", &kDiffuse},
       {"ND_burley_diffuse_bsdf", &kDiffuse},
       {"ND_subsurface_bsdf", &kSubsurface},
@@ -3729,6 +3774,19 @@ namespace {
  * CompleteMaterialXDefaults (0099) writes every unwritten input, it is on
  * every standard_surface, and the value has to speak. A written dispersion
  * keeps the whole principled, the only node that renders it. */
+std::string ScatterModeOf(HdMaterialNodeSchema nodeSchema)
+{
+  const auto ds = nodeSchema.GetParameters().Get(TfToken("scatter_mode")).GetValue();
+  const VtValue value = ds ? ds->GetValue(0.0f) : VtValue();
+  if (value.IsHolding<TfToken>()) {
+    return value.UncheckedGet<TfToken>().GetString();
+  }
+  if (value.IsHolding<std::string>()) {
+    return value.UncheckedGet<std::string>();
+  }
+  return "R";
+}
+
 bool AsksForGlassLobe(HdMaterialNodeSchema nodeSchema)
 {
   HdMaterialNodeParameterContainerSchema params = nodeSchema.GetParameters();
@@ -3810,6 +3868,14 @@ unique_ptr<ShaderGraph> HdCyclesMaterial::BuildShaderGraph(HdMaterialNetworkSche
         if (nodeDesc.mapping == &MtlxStandardSurface && AsksForGlassLobe(nodeSchema)) {
           nodeDesc.mapping = &MtlxStandardSurfaceGlass;
         }
+        /* A dielectric reflects, transmits or both by its scatter mode, "R"
+         * when unwritten (MakeMtlxDielectric). */
+        if (nodeDesc.mapping == &MtlxDielectricRT) {
+          const std::string mode = ScatterModeOf(nodeSchema);
+          nodeDesc.mapping = mode == "T" ? &MtlxDielectricT :
+                             mode == "RT" ? &MtlxDielectricRT :
+                                            &MtlxDielectricR;
+        }
         if (nodeDesc.mapping) {
           cyclesType = nodeDesc.mapping->nodeType();
         }
