+    <toolMenuContext name="network">
+      <contextNetType>LOP</contextNetType>
+    </toolMenuContext>
+    <toolSubmenu>Rendering/Cycles</toolSubmenu>
+    <script scriptType="python"><![CDATA[import loptoolutils
+node = loptoolutils.genericTool(kwargs, 'hdcycles::cycles_render_settings::1.0',
+                                nodename='cyclesrendersettings')
+nodename = node.name()
+kwargs['inputnodename'] = nodename
+kwargs['inputs'] = [(nodename, 0)]
+kwargs['nodepositionx'] = str(node.position().x())
+kwargs['nodepositiony'] = str(node.position().y() - 0.5)
+rpass = loptoolutils.genericTool(kwargs, 'renderpass')
+rpass.parm("renderSource_control").set('set')
+rpass.parm("renderSource").setExpression('chs("../%s/primpath")' % nodename)
