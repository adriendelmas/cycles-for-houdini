     for i in range(1, node.evalParm("shaderaovs") + 1):
         name = node.evalParm("shaderaov%d" % i).strip()
-        if not name:
+        if not name or not _enabled(node, "shaderaovenable%d" % i):
             continue
         if node.parm("shaderaovtype%d" % i).evalAsString() == "value":
             out.append((name, name, "float", "float"))
@@ -107,6 +115,9 @@ def requested(node):
 
 
 def _target_products(stage, node):
+    if node.parm("productpath"):
