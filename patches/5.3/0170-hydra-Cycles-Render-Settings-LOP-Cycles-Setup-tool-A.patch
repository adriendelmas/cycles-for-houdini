     aovs = requested(asset)
+    if asset.parm("productpath"):
+        # The beauty first, as Karma's settings write it.
+        aovs.insert(0, ("C", "C", "color4f", "color4h"))
     if not aovs:
         return
 
@@ -148,3 +162,108 @@ def run(node):
         rel = product.GetOrderedVarsRel()
         targets = list(rel.GetTargets())
         rel.SetTargets(targets + [p for p in var_paths if p not in targets])
+
+
+# Auto Fill: the light groups and shader AOVs the scene uses.
+
+LIGHT_GROUP_ATTRS = (
+    "primvars:cycles:object:lightgroup",  # Render Geometry Settings, Cycles tab
+    "primvars:karma:object:lpetag",  # LPE Tag LOP, geometry tag
+    "inputs:karma:light:lpetag",  # a light's LPE Tag (Karma tab), LPE Tag LOP
+    "karma:light:lpetag",
+    "inputs:cycles:lightgroup",
+    "cycles:lightgroup",
+)
+
+
+def _input_stage(node):
+    inputs = [n for n in node.inputs() if n is not None]
+    return inputs[0].stage() if inputs else node.stage()
+
+
+def scene_light_groups(stage):
+    """Every light group name set on a prim or a light, sorted."""
+    time = Usd.TimeCode(hou.frame())
+    found = set()
+    for prim in stage.Traverse():
+        for name in LIGHT_GROUP_ATTRS:
+            attr = prim.GetAttribute(name)
+            if attr and attr.HasAuthoredValue():
+                value = attr.Get(time)
+                if value:
+                    found.add(str(value).strip())
+    found.discard("")
+    return sorted(found)
+
+
+def scene_shader_aovs(stage):
+    """(name, "color" or "value") of every Cycles AOV Output node, sorted by name."""
+    found = {}
+    for prim in stage.Traverse():
+        if prim.GetTypeName() != "Shader":
+            continue
+        shader_id = prim.GetAttribute("info:id")
+        if not shader_id or shader_id.Get() != "cycles_aov_output":
+            continue
+        name_attr = prim.GetAttribute("inputs:name")
+        name = (name_attr.Get() if name_attr else "") or ""
+        if not name.strip():
+            continue
+        # A value AOV when only the value input is wired or set.
+        kind = "color"
+        for attr in prim.GetAttributes():
+            low = attr.GetName().lower()
+            used = attr.HasAuthoredConnections() or attr.HasAuthoredValue()
+            if low == "inputs:value" and used:
+                kind = "value"
+            elif low == "inputs:color" and used:
+                kind = "color"
+                break
+        found.setdefault(name.strip(), kind)
+    return sorted(found.items())
+
+
+def _append_entries(node, count_parm, entries, fill):
+    """Appends the entries a multiparm does not list yet; returns how many."""
+    count = node.parm(count_parm)
+    start = count.eval()
+    count.set(start + len(entries))
+    for offset, entry in enumerate(entries):
+        fill(start + offset + 1, entry)
+    return len(entries)
+
+
+def autofill_light_groups(node):
+    have = {node.evalParm("lightgroup%d" % i).strip()
+            for i in range(1, node.evalParm("lightgroups") + 1)}
+    new = [g for g in scene_light_groups(_input_stage(node)) if g not in have]
+
+    def fill(i, group):
+        node.parm("lightgroup%d" % i).set(group)
+        node.parm("lightgroupenable%d" % i).set(1)
+
+    added = _append_entries(node, "lightgroups", new, fill)
+    _report(node, "light group", added)
+
+
+def autofill_shader_aovs(node):
+    have = {node.evalParm("shaderaov%d" % i).strip()
+            for i in range(1, node.evalParm("shaderaovs") + 1)}
+    new = [(n, k) for n, k in scene_shader_aovs(_input_stage(node)) if n not in have]
+
+    def fill(i, entry):
+        node.parm("shaderaov%d" % i).set(entry[0])
+        node.parm("shaderaovtype%d" % i).set(entry[1])
+        node.parm("shaderaovenable%d" % i).set(1)
+
+    added = _append_entries(node, "shaderaovs", new, fill)
+    _report(node, "shader AOV", added)
+
+
+def _report(node, what, added):
+    message = ("Added %d %s%s." % (added, what, "" if added == 1 else "s") if added
+               else "No new %s found in the input stage." % what)
+    if hou.isUIAvailable():
+        hou.ui.setStatusMessage(message)
+    else:
+        print(node.path() + ": " + message)
