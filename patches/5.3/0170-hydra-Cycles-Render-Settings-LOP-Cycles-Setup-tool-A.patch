       <keyword>Cycles</keyword>
     </keywordList>
   </tool>
+  <tool name="lop_cycles_setup" label="Cycles (Setup)" icon="opdef:/hdcycles::Lop/cycles_render_settings::1.0?IconImage">
+    <helpText><![CDATA[Cycles Render Settings, a Render Pass on its settings and a USD Render ROP on Cycles GPU, as Karma (Setup) does for Karma.]]></helpText>
