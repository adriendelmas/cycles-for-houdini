+kwargs['nodepositionx'] = str(rpass.position().x())
+kwargs['nodepositiony'] = str(rpass.position().y() - 0.5)
+rop = loptoolutils.genericTool(kwargs, 'usdrender_rop')
+rop.parm("renderpass").setExpression('chs("../%s/primpath")' % rpass.name())
+rop.parm("renderer").set("HdCyclesPluginGPU")
