@@ -0,0 +1,98 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#include "hydra/archive_image.h"
+
+#include "util/image_metadata.h"
+#include "util/log.h"
+
+#include <OpenImageIO/filesystem.h>
+
+#include <pxr/usd/ar/asset.h>
+#include <pxr/usd/ar/resolvedPath.h>
+#include <pxr/usd/ar/resolver.h>
+
+HDCYCLES_NAMESPACE_OPEN_SCOPE
+
+bool IsArchiveImagePath(const std::string &path)
+{
+  const size_t bracket = path.rfind('[');
+  return bracket != std::string::npos && path.back() == ']' &&
+         (path.rfind(".usdz[", bracket) != std::string::npos ||
+          path.rfind(".USDZ[", bracket) != std::string::npos ||
+          path.rfind(".zip[", bracket) != std::string::npos);
+}
+
+HdCyclesArchiveImageLoader::HdCyclesArchiveImageLoader(std::string path) : _path(std::move(path))
+{
+  const size_t bracket = _path.rfind('[');
+  _inner = bracket == std::string::npos ? _path : _path.substr(bracket + 1, _path.size() - bracket - 2);
+}
+
+bool HdCyclesArchiveImageLoader::Read()
+{
+  if (_bytes) {
+    return true;
+  }
+  const std::shared_ptr<PXR_NS::ArAsset> asset = PXR_NS::ArGetResolver().OpenAsset(
+      PXR_NS::ArResolvedPath(_path));
+  if (!asset) {
+    LOG_WARNING << "Texture " << _path << " could not be opened in its archive.";
+    return false;
+  }
+  _size = asset->GetSize();
+  _bytes = asset->GetBuffer();
+  if (!_bytes || _size == 0) {
+    LOG_WARNING << "Texture " << _path << " is empty in its archive.";
+    _bytes.reset();
+    return false;
+  }
+  return true;
+}
+
+bool HdCyclesArchiveImageLoader::load_metadata(CCL_NS::ImageMetaData &metadata,
+                                               const CCL_NS::ImageLoaderParams &params,
+                                               CCL_NS::Progress & /*progress*/)
+{
+  if (!Read()) {
+    params.load_failure_num++;
+    return false;
+  }
+  OIIO::Filesystem::IOMemReader reader(_bytes.get(), _size);
+  if (!metadata.oiio_load_metadata(_inner, nullptr, &reader)) {
+    LOG_WARNING << "Texture " << _path << " could not be decoded.";
+    params.load_failure_num++;
+    return false;
+  }
+  return true;
+}
+
+bool HdCyclesArchiveImageLoader::load_pixels(const CCL_NS::ImageMetaData &metadata, void *pixels)
+{
+  if (!Read()) {
+    return false;
+  }
+  OIIO::Filesystem::IOMemReader reader(_bytes.get(), _size);
+  const bool ok = metadata.oiio_load_pixels(_inner, pixels, true, &reader);
+  /* The bytes are not needed past the device upload. */
+  _bytes.reset();
+  _size = 0;
+  if (!ok) {
+    return false;
+  }
+  metadata.conform_pixels(pixels);
+  return true;
+}
+
+CCL_NS::string HdCyclesArchiveImageLoader::name() const
+{
+  return _path;
+}
+
+bool HdCyclesArchiveImageLoader::equals(const CCL_NS::ImageLoader &other) const
+{
+  return _path == static_cast<const HdCyclesArchiveImageLoader &>(other)._path;
+}
+
+HDCYCLES_NAMESPACE_CLOSE_SCOPE
