+  /* Material binding purposes: a `material:binding:full` - what Houdini's
+   * Assign Material LOP writes when asked for a purpose - reached the
+   * delegate only under `materialBindings/full`, which nothing read: the
+   * prim rendered unbound, with the default surface, while Karma bound it.
+   * The delegate's GetMaterialBindingPurpose says `full`, but the emulation
+   * resolves the all-purpose binding alone. This scene index copies the
+   * first purpose found, `full` then all-purpose, onto the all-purpose one
+   * (K-112). */
+  for (const char *displayName : {"Cycles CPU", "Cycles GPU"}) {
+    HdSceneIndexPluginRegistry::GetInstance().RegisterSceneIndexForRenderer(
+        displayName,
+        [](const std::string & /*renderInstanceId*/,
+           const HdSceneIndexBaseRefPtr &inputScene,
+           const HdContainerDataSourceHandle & /*args*/) -> HdSceneIndexBaseRefPtr {
+          return HdsiMaterialBindingResolvingSceneIndex::New(
+              inputScene,
+              {HdTokens->full, HdMaterialBindingsSchemaTokens->allPurpose},
+              HdMaterialBindingsSchemaTokens->allPurpose);
+        },
+        nullptr,
+        0,
+        HdSceneIndexPluginRegistry::InsertionOrderAtEnd);
+  }
 }
 
