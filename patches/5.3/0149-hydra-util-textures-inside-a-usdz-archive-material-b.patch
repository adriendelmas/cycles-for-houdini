+void HdCyclesMaterial::BindArchiveImages(Scene *scene)
+{
+  static const ustring kFilename("filename");
+  auto bind = [&](Node *const node) {
+    ImageSlotTextureNode *const slot = dynamic_cast<ImageSlotTextureNode *>(node);
+    if (slot == nullptr || !slot->handle.empty()) {
+      return;
+    }
+    const SocketType *const socket = slot->type->find_input(kFilename);
+    if (socket == nullptr) {
+      return;
+    }
+    const std::string path = slot->get_string(*socket).string();
+    if (!IsArchiveImagePath(path)) {
+      return;
+    }
+    ImageParams params;
+    if (ImageTextureNode *const image = dynamic_cast<ImageTextureNode *>(slot)) {
+      params = image->image_params();
+    }
+    else if (EnvironmentTextureNode *const env = dynamic_cast<EnvironmentTextureNode *>(slot)) {
+      params = env->image_params();
+    }
+    else {
+      return;
+    }
+    slot->handle = scene->image_manager->add_image(
+        std::make_unique<HdCyclesArchiveImageLoader>(path), params);
+  };
+  for (const auto &entry : _nodes) {
+    bind(entry.second.node);
+    for (const auto &helper : entry.second.helperNodes) {
+      bind(helper.second);
+    }
+  }
+}
+
 void HdCyclesMaterial::BindHoudiniCopImages(Scene *scene, HdSceneDelegate *sceneDelegate)
 {
 #ifdef WITH_HOUDINI_COP
