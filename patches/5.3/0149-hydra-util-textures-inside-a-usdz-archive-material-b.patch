@@ -0,0 +1,42 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include "hydra/config.h"
+
+#include "scene/image_loader.h"
+
+#include <memory>
+#include <string>
+
+HDCYCLES_NAMESPACE_OPEN_SCOPE
+
+/* A texture inside a USD archive - `asset.usdz[textures/color.jpg]`, the
+ * form every MEGALIB asset ships its textures in - which OpenImageIO cannot
+ * open by path. USD's resolver reads the bytes; OpenImageIO decodes them
+ * from memory (K-111). */
+bool IsArchiveImagePath(const std::string &path);
+
+class HdCyclesArchiveImageLoader final : public CCL_NS::ImageLoader {
+ public:
+  explicit HdCyclesArchiveImageLoader(std::string path);
+
+  bool load_metadata(CCL_NS::ImageMetaData &metadata,
+                     const CCL_NS::ImageLoaderParams &params,
+                     CCL_NS::Progress &progress) override;
+  bool load_pixels(const CCL_NS::ImageMetaData &metadata, void *pixels) override;
+  CCL_NS::string name() const override;
+  bool equals(const CCL_NS::ImageLoader &other) const override;
+
+ private:
+  bool Read();
+
+  std::string _path;
+  std::string _inner;
+  std::shared_ptr<const char> _bytes;
+  size_t _size = 0;
+};
+
+HDCYCLES_NAMESPACE_CLOSE_SCOPE
