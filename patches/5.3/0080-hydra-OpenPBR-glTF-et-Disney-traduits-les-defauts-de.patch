+/* UsdTransform2d -> Cycles mapping, which applies scale, then rotation, then
+ * translation, the order the USD spec gives. The values change shape on the
+ * way: a rotation in degrees about the texture's Z becomes a radian vector,
+ * two-component scale and translation become three-component ones. Only
+ * values are transformed; a connected rotation or scale is linked as is. */
+class UsdToCyclesTransform2d : public UsdToCyclesMapping {
+ public:
+  using UsdToCyclesMapping::UsdToCyclesMapping;
+
+  std::string parameterName(const TfToken &name,
+                            const ShaderInput *inputConnection,
+                            VtValue *value) const override
+  {
+    static const TfToken in("in"), rotation("rotation"), scale("scale"),
+        translation("translation"), result("result");
+    if (inputConnection && name == result) {
+      return "vector";
+    }
+    if (name == in) {
+      return "vector";
+    }
+    auto vec2 = [](const VtValue &v, const float fallback, GfVec2f *out) {
+      if (v.IsHolding<GfVec2f>()) {
+        *out = v.UncheckedGet<GfVec2f>();
+        return true;
+      }
+      if (v.IsHolding<GfVec2d>()) {
+        const GfVec2d d = v.UncheckedGet<GfVec2d>();
+        *out = GfVec2f(float(d[0]), float(d[1]));
+        return true;
+      }
+      *out = GfVec2f(fallback);
+      return false;
+    };
+    if (name == rotation) {
+      if (value) {
+        const float degrees = VtValue::Cast<float>(*value).GetWithDefault(0.0f);
+        *value = VtValue(GfVec3f(0.0f, 0.0f, GfDegreesToRadians(degrees)));
+      }
+      return "rotation";
+    }
+    if (name == scale) {
+      GfVec2f s;
+      if (value && vec2(*value, 1.0f, &s)) {
+        *value = VtValue(GfVec3f(s[0], s[1], 1.0f));
+      }
+      return "scale";
+    }
+    if (name == translation) {
+      GfVec2f t;
+      if (value && vec2(*value, 0.0f, &t)) {
+        *value = VtValue(GfVec3f(t[0], t[1], 0.0f));
+      }
+      return "location";
+    }
     return UsdToCyclesMapping::parameterName(name, inputConnection, value);
   }
 };
