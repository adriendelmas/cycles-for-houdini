+/* OpenPBR, on the same principled BSDF and the same helpers as
+ * standard_surface: the two models share their lobes, not their names, units
+ * or defaults. Every input of open_pbr_surface.mtlx is named here, either
+ * mapped or listed as dropped.
+ *
+ * - `subsurface_radius` is a distance and `subsurface_radius_scale` a colour,
+ *   the other way round from Cycles: they land on scale and radius.
+ * - `thin_film_thickness` is in micrometres and weighted by
+ *   `thin_film_weight`; Cycles wants nanometres. A product and a factor of a
+ *   thousand.
+ * - The dispersion pair is Cycles' own pair, same meaning.
+ * - `fuzz` becomes sheen - Cycles' microfibre sheen is not OpenPBR's fuzz
+ *   model, the colour and the weight are what carry over.
+ * - Dropped, for want of a counterpart: `coat_darkening`, the two roughness
+ *   anisotropies' exact parametrisation (sent to `anisotropic` as is),
+ *   `transmission_depth`, `transmission_scatter`,
+ *   `transmission_scatter_anisotropy`, `subsurface_color` (Cycles colours
+ *   subsurface by the base colour), `geometry_coat_tangent`. */
+UsdToCyclesMapping MakeMtlxOpenPbr()
+{
+  UsdToCyclesMapping m = MakeMtlxStandardSurface();
+  m.setParameterName(TfToken("base_weight"), ustring("basew:vector2"));
+  m.setParameterName(TfToken("base_diffuse_roughness"), ustring("diffuse_roughness"));
+  m.setParameterName(TfToken("base_metalness"), ustring("metallic"));
+  m.setParameterName(TfToken("specular_weight"), ustring("spec:value1"));
+  m.setParameterName(TfToken("specular_ior"), ustring("ior"));
+  m.setParameterName(TfToken("specular_roughness_anisotropy"), ustring("anisotropic"));
+  m.setParameterName(TfToken("transmission_weight"), ustring("transmission_weight"));
+  m.setParameterName(TfToken("transmission_dispersion_scale"),
+                     ustring("transmission_dispersion_scale"));
+  m.setParameterName(TfToken("transmission_dispersion_abbe_number"),
+                     ustring("transmission_dispersion_abbe_number"));
+  m.setParameterName(TfToken("subsurface_weight"), ustring("subsurface_weight"));
+  m.setParameterName(TfToken("subsurface_radius"), ustring("subsurface_scale"));
+  m.setParameterName(TfToken("subsurface_radius_scale"), ustring("subsurface_radius"));
+  m.setParameterName(TfToken("subsurface_scatter_anisotropy"), ustring("subsurface_anisotropy"));
+  m.setParameterName(TfToken("fuzz_weight"), ustring("sheen_weight"));
+  m.setParameterName(TfToken("fuzz_color"), ustring("sheen_tint"));
+  m.setParameterName(TfToken("fuzz_roughness"), ustring("sheen_roughness"));
+  m.setParameterName(TfToken("coat_weight"), ustring("coat_weight"));
+  m.setParameterName(TfToken("coat_ior"), ustring("coat_ior"));
+  m.setParameterName(TfToken("thin_film_weight"), ustring("tfw:value1"));
+  m.setParameterName(TfToken("thin_film_thickness"), ustring("tfw:value2"));
+  m.setParameterName(TfToken("thin_film_ior"), ustring("thin_film_ior"));
+  m.setParameterName(TfToken("emission_luminance"), ustring("emission_strength"));
+  m.setParameterName(TfToken("geometry_opacity"), ustring("alpha"));
+  m.setParameterName(TfToken("geometry_thin_walled"), ustring("thin_wall"));
+  m.setParameterName(TfToken("geometry_normal"), ustring("normal"));
+  m.setParameterName(TfToken("geometry_tangent"), ustring("tangent"));
+  m.setParameterName(TfToken("geometry_coat_normal"), ustring("coat_normal"));
+
+  /* OpenPBR's defaults, open_pbr_surface.mtlx. */
+  m.setFixedValues({{ustring("transmission_dispersion_scale"), "0"},
+                    {ustring("transmission_dispersion_abbe_number"), "20"},
+                    {ustring("subsurface_radius"), "1,0.5,0.25"},
+                    {ustring("subsurface_scale"), "1"},
+                    {ustring("roughness"), "0.3"},
+                    {ustring("sheen_roughness"), "0.5"},
+                    {ustring("coat_roughness"), "0"},
+                    {ustring("coat_ior"), "1.6"},
+                    {ustring("thin_film_ior"), "1.4"}});
+
+  /* thin_film_thickness [nm] = weight * thickness [um] * 1000. The scale
+   * helper first, so the product can be wired into it. */
+  m.addHelper({"tfs",
+               "math",
+               {{"Value", "Thin Film Thickness"}},
+               {{ustring("math_type"), "multiply"},
+                {ustring("value1"), "0"},
+                {ustring("value2"), "1000"}}});
+  m.addHelper({"tfw",
+               "math",
+               {{"Value", "tfs:Value1"}},
+               {{ustring("math_type"), "multiply"},
+                {ustring("value1"), "0"},
+                {ustring("value2"), "0.5"}}});
+  return m;
+}
+
+const UsdToCyclesMapping MtlxOpenPbr = MakeMtlxOpenPbr();
+
+/* glTF PBR (gltf_pbr.mtlx) on the principled BSDF. Its defaults are the glTF
+ * specification's - white, fully metallic, fully rough - very far from
+ * Cycles', so all of them are pinned.
+ *
+ * - `specular` is KHR_materials_specular's factor, neutral at one: halved
+ *   onto Cycles' level, like standard_surface's.
+ * - Sheen has no weight in glTF; its colour is the weight. Cycles' sheen is
+ *   switched fully on and tinted by that colour, black meaning none.
+ * - `iridescence` weights `iridescence_thickness` (nanometres) into the thin
+ *   film.
+ * - `dispersion` is 20 / Abbe number; with Cycles' Abbe number pinned at 20
+ *   the scale is the glTF value as is.
+ * - `anisotropy_rotation` is in radians, Cycles' rotation a fraction of a
+ *   turn.
+ * - `alpha` is passed whatever `alpha_mode` says: an OPAQUE material with an
+ *   alpha below one renders see-through here.
+ * - Dropped: `occlusion`, `thickness`, `attenuation_distance`,
+ *   `attenuation_color`, `alpha_cutoff`. */
+UsdToCyclesMapping MakeMtlxGltfPbr()
+{
+  UsdToCyclesMapping m{"principled_bsdf",
+                       {
+                           {TfToken("base_color"), ustring("base_color")},
+                           {TfToken("metallic"), ustring("metallic")},
+                           {TfToken("roughness"), ustring("roughness")},
+                           {TfToken("normal"), ustring("normal")},
+                           {TfToken("tangent"), ustring("tangent")},
+                           {TfToken("transmission"), ustring("transmission_weight")},
+                           {TfToken("specular"), ustring("spec:value1")},
+                           {TfToken("specular_color"), ustring("specular_tint")},
+                           {TfToken("ior"), ustring("ior")},
+                           {TfToken("alpha"), ustring("alpha")},
+                           {TfToken("iridescence"), ustring("irid:value1")},
+                           {TfToken("iridescence_ior"), ustring("thin_film_ior")},
+                           {TfToken("iridescence_thickness"), ustring("irid:value2")},
+                           {TfToken("sheen_color"), ustring("sheen_tint")},
+                           {TfToken("sheen_roughness"), ustring("sheen_roughness")},
+                           {TfToken("clearcoat"), ustring("coat_weight")},
+                           {TfToken("clearcoat_roughness"), ustring("coat_roughness")},
+                           {TfToken("clearcoat_normal"), ustring("coat_normal")},
+                           {TfToken("emissive"), ustring("emission_color")},
+                           {TfToken("emissive_strength"), ustring("emission_strength")},
+                           {TfToken("anisotropy_strength"), ustring("anisotropic")},
+                           {TfToken("anisotropy_rotation"), ustring("arot:value1")},
+                           {TfToken("dispersion"), ustring("transmission_dispersion_scale")},
+                           {CyclesMaterialTokens->out, ustring("BSDF")},
+                       }};
+  m.setFixedValues({{ustring("base_color"), "1,1,1"},
+                    {ustring("metallic"), "1"},
+                    {ustring("roughness"), "1"},
+                    {ustring("ior"), "1.5"},
+                    {ustring("sheen_weight"), "1"},
+                    {ustring("sheen_tint"), "0,0,0"},
+                    {ustring("sheen_roughness"), "0"},
+                    {ustring("coat_roughness"), "0"},
+                    {ustring("emission_color"), "0,0,0"},
+                    {ustring("emission_strength"), "1"},
+                    {ustring("thin_film_ior"), "1.3"},
+                    {ustring("transmission_dispersion_abbe_number"), "20"}});
+  m.addHelper({"spec",
+               "math",
+               {{"Value", "Specular IOR Level"}},
+               {{ustring("math_type"), "multiply"},
+                {ustring("value1"), "1.0"},
+                {ustring("value2"), "0.5"}}});
+  m.addHelper({"irid",
+               "math",
+               {{"Value", "Thin Film Thickness"}},
+               {{ustring("math_type"), "multiply"},
+                {ustring("value1"), "0"},
+                {ustring("value2"), "100"}}});
+  m.addHelper({"arot",
+               "math",
+               {{"Value", "Anisotropic Rotation"}},
+               {{ustring("math_type"), "multiply"},
+                {ustring("value1"), "0"},
+                {ustring("value2"), "0.15915494"}}});
+  return m;
+}
+
+const UsdToCyclesMapping MtlxGltfPbr = MakeMtlxGltfPbr();
+
+/* Disney's principled BRDF (disney_principled.mtlx), the model Blender's
+ * principled BSDF descends from - most inputs carry straight over.
+ *
+ * - `specular` 0.5 is an F0 of 0.04, which is Cycles' level 0.5: same scale.
+ * - `specularTint` and `sheenTint` are floats tinting towards the base
+ *   colour; Cycles' tints are colours. A mix from white to the base colour by
+ *   the tint amount gives them.
+ * - `clearcoatGloss` maps to a microfacet alpha of lerp(0.1, 0.001, gloss) in
+ *   Disney's paper; Cycles' roughness is sqrt(alpha). Gloss 1 lands on 0.032,
+ *   Cycles' own coat default.
+ * - Defaults are Disney's: a 0.16 grey base, sheen tint 0.5. */
+UsdToCyclesMapping MakeMtlxDisneyPrincipled()
+{
+  UsdToCyclesMapping m{"principled_bsdf",
+                       {
+                           {TfToken("baseColor"), ustring("base_color;stint:b;shtint:b")},
+                           {TfToken("metallic"), ustring("metallic")},
+                           {TfToken("roughness"), ustring("roughness")},
+                           {TfToken("anisotropic"), ustring("anisotropic")},
+                           {TfToken("specular"), ustring("specular_ior_level")},
+                           {TfToken("specularTint"), ustring("stint:fac")},
+                           {TfToken("sheen"), ustring("sheen_weight")},
+                           {TfToken("sheenTint"), ustring("shtint:fac")},
+                           {TfToken("clearcoat"), ustring("coat_weight")},
+                           {TfToken("clearcoatGloss"), ustring("cg:value1")},
+                           {TfToken("specTrans"), ustring("transmission_weight")},
+                           {TfToken("ior"), ustring("ior")},
+                           {TfToken("subsurface"), ustring("subsurface_weight")},
+                           {TfToken("subsurfaceDistance"), ustring("subsurface_radius")},
+                           {TfToken("normal"), ustring("normal")},
+                           {TfToken("tangent"), ustring("tangent")},
+                           {CyclesMaterialTokens->out, ustring("BSDF")},
+                       }};
+  m.setFixedValues({{ustring("base_color"), "0.16,0.16,0.16"},
+                    {ustring("subsurface_radius"), "1,1,1"},
+                    {ustring("subsurface_scale"), "1"}});
+  auto tint = [](const char *const name, const char *const target, const char *const fac) {
+    return UsdToCyclesMapping::Helper{name,
+                                      "mix_color",
+                                      {{"Result", target}},
+                                      {{ustring("blend_type"), "mix"},
+                                       {ustring("fac"), fac},
+                                       {ustring("a"), "1,1,1"},
+                                       {ustring("b"), "0.16,0.16,0.16"}}};
+  };
+  m.addHelper(tint("stint", "Specular Tint", "0"));
+  m.addHelper(tint("shtint", "Sheen Tint", "0.5"));
+  m.addHelper({"cr", "math", {{"Value", "Coat Roughness"}}, {{ustring("math_type"), "sqrt"}}});
+  m.addHelper({"cg",
+               "math",
+               {{"Value", "cr:Value1"}},
+               {{ustring("math_type"), "multiply_add"},
+                {ustring("value1"), "1"},
+                {ustring("value2"), "-0.099"},
+                {ustring("value3"), "0.1"}}});
+  return m;
+}
+
+const UsdToCyclesMapping MtlxDisneyPrincipled = MakeMtlxDisneyPrincipled();
