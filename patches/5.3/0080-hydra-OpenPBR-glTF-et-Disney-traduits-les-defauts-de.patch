+        return "sep:Red";
+      }
+      if (name == g) {
+        return "sep:Green";
+      }
+      if (name == b) {
+        return "sep:Blue";
+      }
+      if (name == a) {
+        return "alpha";
+      }
+    }
+
+    return UsdToCyclesMapping::parameterName(name, inputConnection, value);
+  }
+};
