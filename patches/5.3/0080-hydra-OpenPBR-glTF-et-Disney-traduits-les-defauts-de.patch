+    /* The outputs. `scale` and `bias` apply to the colour on its way out
+     * (rgb * scale + bias, the standard normal-map encoding is scale 2, bias
+     * -1), so `rgb` is read after the helper that applies them; and each
+     * single channel is a channel - a roughness read from `g` of a packed
+     * occlusion/roughness/metal texture used to get the average of all three.
+     * Alpha comes straight off the image: the alpha components of scale and
+     * bias are not carried. */
+    if (inputConnection) {
+      static const TfToken r("r"), g("g"), b("b"), a("a"), rgb("rgb");
+      if (name == rgb) {
+        return "sb:Vector";
+      }
