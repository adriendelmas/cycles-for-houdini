   mapping.setFixedValues({{ustring("transmission_dispersion_scale"), "1"},
-                          {ustring("transmission_dispersion_abbe_number"), "0"}});
+                          {ustring("transmission_dispersion_abbe_number"), "0"},
+                          /* Le rayon de diffusion de Cycles vaut (1, 0,2, 0,1),
+                           * une peau ; celui de MaterialX vaut (1, 1, 1), neutre.
+                           * Hydra ne transmet que les entrees ecrites, donc un
+                           * reseau qui n'y touche pas heritait d'une teinte de
+                           * chair qu'il n'avait pas demandee. Le defaut de
+                           * MaterialX est pose ici, et la correspondance
+                           * ci-dessus le remplace des que le reseau l'ecrit. */
+                          {ustring("subsurface_radius"), "1,1,1"}});
   /* The helper drives the level unconditionally, so it has to carry MaterialX's
    * own default of 1 for the case where the network never writes `specular` at
    * all - otherwise an unauthored input would be actively set to something
@@ -372,13 +405,56 @@ UsdToCyclesMapping MakeMtlxStandardSurface()
                      {{ustring("math_type"), "multiply"},
                       {ustring("value1"), "1.0"},
                       {ustring("value2"), "0.5"}}});
+  /* Le mix qui separe la couleur de transmission de la couleur de base. Il est
+   * declare en premier parce que les deux auxiliaires suivants se branchent
+   * dessus, et que les auxiliaires sont montes dans l'ordre.
+   *
+   * Approximation assumee : Cycles teinte diffuse et transmission par le meme
+   * `base_color`, la separation se fait donc par type de rayon plutot que par
+   * fermeture. Un rayon qui traverse voit `transmission_color`, les autres la
+   * couleur de base. Le defaut porte ici est celui de MaterialX, blanc, ce qui
+   * n'est pas neutre : sans cette entree, Cycles teintait la transmission de la
+   * couleur de base, ce que ne dit pas standard_surface. */
+  mapping.addHelper({"tcol",
+                     "mix_color",
+                     {{"Result", "Base Color"}},
+                     {{ustring("blend_type"), "mix"},
+                      {ustring("fac"), "0"},
+                      {ustring("a"), "0.8,0.8,0.8"},
+                      {ustring("b"), "1,1,1"}}});
+  mapping.addHelper({"tray", "light_path", {{"Is Transmission Ray", "tcol:Factor"}}, {}});
+  /* La couleur de sous-surface. Cycles n'a pas d'albedo propre au
+   * sous-surfacique : son `principled_bsdf` melange diffus et sous-surface
+   * selon `subsurface_weight`, les deux tirant leur couleur de `base_color`.
+   * On teinte donc la couleur de base par `subsurface_color`, mais **a la
+   * hauteur du poids** : a 0 la couleur de base est intacte, a 1 elle vaut
+   * l'albedo que MaterialX demande. C'est exact aux deux bouts, approche entre
+   * les deux, et surtout ca ne tache pas le diffus d'un materiau qui ne fait
+   * pas de sous-surface - l'objection qui avait fait ecarter cette entree.
+   *
+   * Mesure : multiplier plutot le *rayon* par la couleur, l'autre route
+   * possible, inverse la teinte - un subsurface_color rouge rend l'objet
+   * cyan, le rouge diffusant plus loin au lieu de ressortir. */
+  mapping.addHelper({"sstint",
+                     "vector_math",
+                     {{"Vector", "tcol:A"}},
+                     {{ustring("math_type"), "multiply"},
+                      {ustring("vector1"), "0.8,0.8,0.8"},
+                      {ustring("vector2"), "1,1,1"}}});
+  mapping.addHelper({"sscol",
+                     "mix_color",
+                     {{"Result", "sstint:Vector2"}},
+                     {{ustring("blend_type"), "mix"},
+                      {ustring("fac"), "0"},
+                      {ustring("a"), "1,1,1"},
+                      {ustring("b"), "1,1,1"}}});
   /* `base` is a weight on the diffuse colour and Cycles has no socket for it,
    * so the colour is multiplied on the way in. Both MaterialX defaults are
    * carried here - a base of 1 and a base_color of 0.8 grey - so a network that
    * writes neither still gets what it would have got. */
   mapping.addHelper({"basew",
                      "vector_math",
-                     {{"Vector", "Base Color"}},
+                     {{"Vector", "sstint:Vector1"}},
                      {{ustring("math_type"), "multiply"},
                       {ustring("vector1"), "0.8,0.8,0.8"},
                       {ustring("vector2"), "1,1,1"}}});
