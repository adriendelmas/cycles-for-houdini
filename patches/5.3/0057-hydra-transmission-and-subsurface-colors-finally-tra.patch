diff --git a/src/hydra/material.cpp b/src/hydra/material.cpp
index fe8ed783..86e26285 100644
--- a/src/hydra/material.cpp
+++ b/src/hydra/material.cpp
@@ -184,6 +184,25 @@ class UsdToCyclesMapping {
 
 /* An input mapped to "<helper>:<socket>" is written to that helper node. No
  * Cycles socket name contains a colon, so the split is unambiguous. */
+/* Les cibles d'une entree qui en pilote plusieurs, separees par ';'. */
+std::vector<std::string> SplitTargets(const std::string &mapped)
+{
+  std::vector<std::string> targets;
+  size_t start = 0;
+  while (start <= mapped.size()) {
+    const size_t sep = mapped.find(';', start);
+    const size_t end = (sep == std::string::npos) ? mapped.size() : sep;
+    if (end > start) {
+      targets.push_back(mapped.substr(start, end - start));
+    }
+    if (sep == std::string::npos) {
+      break;
+    }
+    start = sep + 1;
+  }
+  return targets;
+}
+
 std::pair<std::string, std::string> SplitHelperTarget(const std::string &mapped)
 {
   const size_t colon = mapped.find(':');
@@ -292,9 +311,7 @@ class MtlxFacOrColor : public UsdToCyclesMapping {
  *
  * Socket names verified against the Cycles node registry. Inputs with no
  * Cycles counterpart are deliberately left unmapped and are ignored:
- *  - base / specular / transmission_color: weights and tints Cycles folds into
- *    other inputs,
- *  - subsurface_color: Cycles derives it from base_color,
+ *  - base / specular: weights Cycles folds into other inputs,
  *  - transmission_extra_roughness. */
 UsdToCyclesMapping MakeMtlxStandardSurface();
 
