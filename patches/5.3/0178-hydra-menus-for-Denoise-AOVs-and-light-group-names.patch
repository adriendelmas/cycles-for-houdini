From 0f039b7567a90fd585b1a48fc89670b0f90684c1 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Tue, 3 Nov 2026 19:27:16 +0100
Subject: [PATCH 178/182] hydra: menus for Denoise AOVs and light group names

Denoise AOVs (Cycles Render Settings) toggles render var names in and out
of its list, as Karma's denoiser AOV field: those the node declares and
those on the input stage. Light group names (Cycles AOVs, Cycles Render
Settings, Render Geometry Settings' Cycles tab) offer the groups already
set on the input stage's prims and lights; typed text still works. The
menu scripts reload cycles_aovs when Houdini loaded an older one.
---
 .../resources/HdCyclesPluginGPU_Geometry.ds   |   8 ++++
 .../resources/HdCyclesPlugin_Geometry.ds      |   8 ++++
 src/hydra/resources/cycles_aovs.py            |  38 ++++++++++++++++++
 src/hydra/resources/otls/hdcycles_aovs.hda    | Bin 16934 -> 17326 bytes
 .../otls/hdcycles_render_settings.hda         | Bin 78112 -> 78894 bytes
 5 files changed, 54 insertions(+)

diff --git a/src/hydra/resources/HdCyclesPluginGPU_Geometry.ds b/src/hydra/resources/HdCyclesPluginGPU_Geometry.ds
index 20f2a4fb..d0dab332 100644
--- a/src/hydra/resources/HdCyclesPluginGPU_Geometry.ds
+++ b/src/hydra/resources/HdCyclesPluginGPU_Geometry.ds
@@ -255,6 +255,14 @@
         type    string
         size    1
         default { "" }
+        menureplace {
+            [ "import cycles_aovs" ]
+            [ "if not hasattr(cycles_aovs, 'light_group_menu'):" ]
+            [ "    import importlib" ]
+            [ "    importlib.reload(cycles_aovs)" ]
+            [ "return cycles_aovs.light_group_menu(kwargs['node'])" ]
+            language python
+        }
         parmtag { "spare_category" "Cycles" }
         parmtag { "usdvaluetype" "string" }
         disablewhen  R"({ xn__primvarscyclesobjectlightgroup_control_02bgg == block } { xn__primvarscyclesobjectlightgroup_control_02bgg == none })"
diff --git a/src/hydra/resources/HdCyclesPlugin_Geometry.ds b/src/hydra/resources/HdCyclesPlugin_Geometry.ds
index 20f2a4fb..d0dab332 100644
--- a/src/hydra/resources/HdCyclesPlugin_Geometry.ds
+++ b/src/hydra/resources/HdCyclesPlugin_Geometry.ds
@@ -255,6 +255,14 @@
         type    string
         size    1
         default { "" }
+        menureplace {
+            [ "import cycles_aovs" ]
+            [ "if not hasattr(cycles_aovs, 'light_group_menu'):" ]
+            [ "    import importlib" ]
+            [ "    importlib.reload(cycles_aovs)" ]
+            [ "return cycles_aovs.light_group_menu(kwargs['node'])" ]
+            language python
+        }
         parmtag { "spare_category" "Cycles" }
         parmtag { "usdvaluetype" "string" }
         disablewhen  R"({ xn__primvarscyclesobjectlightgroup_control_02bgg == block } { xn__primvarscyclesobjectlightgroup_control_02bgg == none })"
diff --git a/src/hydra/resources/cycles_aovs.py b/src/hydra/resources/cycles_aovs.py
index 1c469743..27261ed8 100644
--- a/src/hydra/resources/cycles_aovs.py
+++ b/src/hydra/resources/cycles_aovs.py
@@ -278,3 +278,41 @@ def _report(node, what, added):
         hou.ui.setStatusMessage(message)
     else:
         print(node.path() + ": " + message)
+
+
+# Menus: the names to pick from, as Houdini menus want them ([token, label, ...]).
+
+def _pairs(names):
+    seen, out = set(), []
+    for name in names:
+        if name and name not in seen:
+            seen.add(name)
+            out += [name, name]
+    return out
+
+
+def light_group_menu(node):
+    """The light groups set on the input stage's prims and lights."""
+    try:
+        return _pairs(scene_light_groups(_input_stage(node)))
+    except Exception:
+        return []
+
+
+def denoise_menu(node):
+    """The render vars this node declares, then those already on the input stage."""
+    names = []
+    try:
+        if node.parm("productpath"):
+            names.append("C")
+        names += [aov[0] for aov in requested(node)]
+    except Exception:
+        pass
+    try:
+        for prim in _input_stage(node).Traverse():
+            if prim.IsA(UsdRender.Var):
+                attr = prim.GetAttribute("driver:parameters:aov:name")
+                names.append((attr.Get() if attr else None) or prim.GetName())
+    except Exception:
+        pass
+    return _pairs(names)
