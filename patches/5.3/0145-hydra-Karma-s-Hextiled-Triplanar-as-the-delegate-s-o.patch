+      <input name="in2" type="float" nodename="ex" />
+    </power>
+    <dotproduct name="dw" type="float">
+      <input name="in1" type="vector3" nodename="wp" />
+      <input name="in2" type="vector3" value="1, 1, 1" />
+    </dotproduct>
+    <divide name="w" type="vector3">
