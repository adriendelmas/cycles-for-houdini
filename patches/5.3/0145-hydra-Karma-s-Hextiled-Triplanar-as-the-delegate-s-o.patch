From b513c48e13c81429b1923cb0043fbbbedd3bfb70 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Sun, 25 Oct 2026 05:14:37 +0100
Subject: [PATCH 145/146] hydra: Karma's Hextiled Triplanar as the delegate's
 own nodegraphs

kma_hextiled_triplanar_color and kma_hextiled_triplanar_normal, the ids the
Karma Hextiled Triplanar VOP writes, had no node in the delegate. Both are
nodegraphs in mtlx_nodegraphs.h now, transcribed from Karma's own
($HFS/houdini/karmaNodeGraphs.json): the file hex-tiled three times on
Cycles' hextiledimage, projected along the object's axes, blended by |N|
raised to 1/blend. The normal form builds each projection's tangent frame as
Karma does, flips the green on the faces looking down an axis, blends towards
N by height and takes the sum to world space.

Karma's hextiling parameters map onto Cycles': size is the tiling, rot and
rand_rot the rotation range, scale and rand_scale the scale range, contrast
the falloff gain, contrast_falloff the luminance weight; weightexp and seed
have no counterpart, so the tiles fall elsewhere at the same size and
orientation. The expansion takes these ids besides ND_.

transformvector, transformnormal and transformpoint between object and world
space join the table, on Cycles' vector transform node; `tospace` picks the
direction. (K-106)

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hydra/material.cpp      |  50 ++-
 src/hydra/mtlx_expand.cpp   |  15 +-
 src/hydra/mtlx_nodegraphs.h | 675 ++++++++++++++++++++++++++++++++++++
 3 files changed, 734 insertions(+), 6 deletions(-)

diff --git a/src/hydra/material.cpp b/src/hydra/material.cpp
index efdc6b0b..af96b2e8 100644
--- a/src/hydra/material.cpp
+++ b/src/hydra/material.cpp
@@ -1185,6 +1185,34 @@ UsdToCyclesMapping MakeMtlxTangentObject()
 }
 const UsdToCyclesMapping MtlxTangentObject = MakeMtlxTangentObject();
 
+/* transformvector, transformnormal and transformpoint between object and
+ * world space: Cycles' vector transform node. The table carries the
+ * object-to-world ones; `tospace` picks the other direction when the
+ * mapping is chosen (K-106). */
+UsdToCyclesMapping MakeMtlxTransform(const char *const type,
+                                     const char *const from,
+                                     const char *const to)
+{
+  UsdToCyclesMapping m{"vector_transform",
+                       {{TfToken("in"), ustring("vector")},
+                        {TfToken("fromspace"), ustring("")},
+                        {TfToken("tospace"), ustring("")},
+                        {CyclesMaterialTokens->out, ustring("vector")}}};
+  m.setFixedValues({{ustring("transform_type"), type},
+                    {ustring("convert_from"), from},
+                    {ustring("convert_to"), to}});
+  return m;
+}
+const UsdToCyclesMapping MtlxTransformVector = MakeMtlxTransform("vector", "object", "world");
+const UsdToCyclesMapping MtlxTransformVectorToObject = MakeMtlxTransform(
+    "vector", "world", "object");
+const UsdToCyclesMapping MtlxTransformNormal = MakeMtlxTransform("normal", "object", "world");
+const UsdToCyclesMapping MtlxTransformNormalToObject = MakeMtlxTransform(
+    "normal", "world", "object");
+const UsdToCyclesMapping MtlxTransformPoint = MakeMtlxTransform("point", "object", "world");
+const UsdToCyclesMapping MtlxTransformPointToObject = MakeMtlxTransform(
+    "point", "world", "object");
+
 /* MaterialX `mix` is `mix(bg, fg, mix)`: the foreground wins as `mix` goes to
  * one (stdlib_genglsl_impl.mtlx). Cycles' mix returns `b` at a factor of one,
  * so the foreground is `b` and the background `a`. It was the other way round
@@ -2761,6 +2789,9 @@ const std::vector<MtlxEntry> &MtlxTable()
       /* Geometry. */
       {"ND_position_", &MtlxPosition},
       {"ND_normal_", &MtlxNormalLookup},
+      {"ND_transformvector_", &MtlxTransformVector},
+      {"ND_transformnormal_", &MtlxTransformNormal},
+      {"ND_transformpoint_", &MtlxTransformPoint},
       {"ND_tangent_", &MtlxTangentLookup},
       {"ND_bitangent_", &kBitangent},
       {"ND_viewdirection", &kViewDirection},
@@ -4461,11 +4492,11 @@ namespace {
  * CompleteMaterialXDefaults (0099) writes every unwritten input, it is on
  * every standard_surface, and the value has to speak. A written dispersion
  * keeps the whole principled, the only node that renders it. */
-/* The `space` of a geometric lookup; MaterialX's default, "object", when
- * unwritten. "model" is object space to a renderer. */
-std::string SpaceOf(HdMaterialNodeSchema nodeSchema)
+/* The `space` of a geometric lookup (or the space input named); MaterialX's
+ * default, "object", when unwritten. "model" is object space to a renderer. */
+std::string SpaceOf(HdMaterialNodeSchema nodeSchema, const char *const input = "space")
 {
-  const auto ds = nodeSchema.GetParameters().Get(TfToken("space")).GetValue();
+  const auto ds = nodeSchema.GetParameters().Get(TfToken(input)).GetValue();
   const VtValue value = ds ? ds->GetValue(0.0f) : VtValue();
   std::string space = "object";
   if (value.IsHolding<TfToken>()) {
@@ -4589,6 +4620,17 @@ unique_ptr<ShaderGraph> HdCyclesMaterial::BuildShaderGraph(HdMaterialNetworkSche
             nodeDesc.mapping = &MtlxTangentObject;
           }
         }
+        if (nodeDesc.mapping == &MtlxTransformVector || nodeDesc.mapping == &MtlxTransformNormal ||
+            nodeDesc.mapping == &MtlxTransformPoint)
+        {
+          if (SpaceOf(nodeSchema, "tospace") == "object") {
+            nodeDesc.mapping = nodeDesc.mapping == &MtlxTransformVector ?
+                                   &MtlxTransformVectorToObject :
+                               nodeDesc.mapping == &MtlxTransformNormal ?
+                                   &MtlxTransformNormalToObject :
+                                   &MtlxTransformPointToObject;
+          }
+        }
         if (nodeDesc.mapping == &MtlxGltfPbr) {
           nodeDesc.mapping = MtlxGltfPbrFor(nodeSchema);
         }
diff --git a/src/hydra/mtlx_expand.cpp b/src/hydra/mtlx_expand.cpp
index d990edbd..5c0dd551 100644
--- a/src/hydra/mtlx_expand.cpp
+++ b/src/hydra/mtlx_expand.cpp
@@ -1767,6 +1767,17 @@ HdMaterialNetworkSchema CompleteMaterialXDefaults(HdMaterialNetworkSchema networ
   return net.changed ? Write(net) : network;
 }
 
+namespace {
+
+/* The ids the expansion takes: the library's, and Karma's hextiled triplanar,
+ * whose nodegraph the delegate ships (mtlx_nodegraphs.h, K-106). */
+bool Expandable(const std::string &id)
+{
+  return id.rfind("ND_", 0) == 0 || id.rfind("kma_hextiled_triplanar_", 0) == 0;
+}
+
+}  // namespace
+
 HdMaterialNetworkSchema ExpandMaterialXNodegraphs(HdMaterialNetworkSchema network,
                                                   const HdCyclesNodeTranslatable &translatable)
 {
@@ -1778,7 +1789,7 @@ HdMaterialNetworkSchema ExpandMaterialXNodegraphs(HdMaterialNetworkSchema networ
     for (const TfToken &name : nodes.GetNames()) {
       if (auto ds = nodes.Get(name).GetNodeIdentifier()) {
         const std::string id = ds->GetTypedValue(0.0f).GetString();
-        if ((id.rfind("ND_", 0) == 0 && !translatable(id)) || id == "ND_separate4_color4" ||
+        if ((Expandable(id) && !translatable(id)) || id == "ND_separate4_color4" ||
             id.rfind("ND_open_pbr_surface_surfaceshader", 0) == 0 ||
             id.rfind("ND_standard_surface_surfaceshader", 0) == 0)
         {
@@ -1842,7 +1853,7 @@ HdMaterialNetworkSchema ExpandMaterialXNodegraphs(HdMaterialNetworkSchema networ
         continue;
       }
       const std::string id = it->second.typeId.GetString();
-      if (id.rfind("ND_", 0) != 0 || translatable(id)) {
+      if (!Expandable(id) || translatable(id)) {
         continue;
       }
       const mx::NodeDefPtr nodeDef = library->getNodeDef(id);
