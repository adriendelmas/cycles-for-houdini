     <output name="out" type="vector3" nodename="n" />
   </nodegraph>
 
+
+)MTLX"
+    /* Split: MSVC caps one string literal at 16 KB; adjacent ones join. */
+    R"MTLX(
+  <!-- Karma's Hextiled Triplanar, colour (kma_hextiled_triplanar_color in
+       $HFS/houdini/karmaNodeGraphs.json): the file hex-tiled three times,
+       projected along the object's axes - st (z, 1-y), (x, 1-z), (x, y) -
+       and blended by |N| raised to 1/blend, normalised. Karma's hextiling
