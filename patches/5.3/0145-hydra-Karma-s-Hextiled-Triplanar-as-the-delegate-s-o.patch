+    </divide>
+    <combine2 name="tiling" type="vector2">
+      <input name="in1" type="float" nodename="freq" />
+      <input name="in2" type="float" nodename="freq" />
+    </combine2>
+    <multiply name="halfspan" type="float">
+      <input name="in1" type="float" interfacename="rand_rot" />
