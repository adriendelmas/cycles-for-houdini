From 1aa942a0e6909118bc6236668d413ac135711cea Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Mon, 31 Aug 2026 19:36:49 +0200
Subject: [PATCH 15/65] hydra: OptiX kernel install path, and Houdini render
 property definitions

Install the OptiX kernels inside the Houdini tree, same as the CUDA ones -
they were landing beside it, where the delegate never looks.

Add soho/parameters/HdCyclesPlugin_Global.ds, which is where Houdini reads a
renderer's tab in the Render Settings LOP from. Generated from Cycles' own
integrator socket declarations by tools/gen_render_properties.py rather than
kept by hand, so the exposed settings follow the linked Cycles version. 59
properties across 9 tabs, each with the set/block/none control parameter
Houdini's own definitions use.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/hydra/CMakeLists.txt                      |    5 +
 .../resources/HdCyclesPluginGPU_Global.ds     | 1358 +++++++++++++++++
 src/hydra/resources/HdCyclesPlugin_Global.ds  | 1358 +++++++++++++++++
 src/kernel/device/optix/CMakeLists.txt        |    9 +-
 4 files changed, 2729 insertions(+), 1 deletion(-)
 create mode 100644 src/hydra/resources/HdCyclesPluginGPU_Global.ds
 create mode 100644 src/hydra/resources/HdCyclesPlugin_Global.ds

diff --git a/src/hydra/CMakeLists.txt b/src/hydra/CMakeLists.txt
index 31dc1948..4d3e8e2f 100644
--- a/src/hydra/CMakeLists.txt
+++ b/src/hydra/CMakeLists.txt
@@ -223,6 +223,11 @@ if(WITH_CYCLES_HYDRA_RENDER_DELEGATE)
     # UsdRenderers.json across HOUDINI_PATH, which the cycles.json package
     # points at this install.
     delayed_install("${CMAKE_CURRENT_SOURCE_DIR}/resources" "UsdRenderers.json" "${CYCLES_INSTALL_PATH}/houdini")
+    # Render property definitions. Houdini fills a renderer's tab in the Render
+    # Settings LOP from soho/parameters/<RendererName>_Global.ds, looked up by
+    # renderer name - hence one per plugin variant.
+    delayed_install("${CMAKE_CURRENT_SOURCE_DIR}/resources" "HdCyclesPlugin_Global.ds" "${CYCLES_INSTALL_PATH}/houdini/soho/parameters")
+    delayed_install("${CMAKE_CURRENT_SOURCE_DIR}/resources" "HdCyclesPluginGPU_Global.ds" "${CYCLES_INSTALL_PATH}/houdini/soho/parameters")
   else()
     delayed_install("${CMAKE_CURRENT_BINARY_DIR}/resources" "plugInfo.json" "${CYCLES_HYDRA_INSTALL_PATH}/${HdCyclesPluginName}/resources")
   endif()
diff --git a/src/hydra/resources/HdCyclesPluginGPU_Global.ds b/src/hydra/resources/HdCyclesPluginGPU_Global.ds
new file mode 100644
index 00000000..dc23f248
