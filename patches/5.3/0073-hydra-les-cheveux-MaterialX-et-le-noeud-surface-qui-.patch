+        }
+        else {
+          LOG_WARNING << "No input '" << dstSocketName.GetText() << "' on Cycles node '"
+                      << nodePath.GetText() << "', connection dropped.";
+        }
+        continue;
+      }
+
+      const std::string outputName = outputMapping ?
+                                         outputMapping->parameterName(upstreamOutputName, input) :
+                                         upstreamOutputName.GetString();
+      ShaderOutput *output = FindOutput(sourceNode, outputName);
+
+      if (!output) {
+        LOG_WARNING << "MaterialX: Cycles node '" << srcNodeIt->second.node->name.c_str()
+                    << "' has no output '" << outputName << "', connection to "
+                    << nodePath.GetText() << "." << dstSocketName.GetText() << " dropped.";
+        continue;
+      }
+
+      shaderGraph->connect(output, input);
+    }
   }
 }
 
