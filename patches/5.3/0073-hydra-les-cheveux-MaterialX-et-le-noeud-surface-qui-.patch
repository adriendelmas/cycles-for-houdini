 1 file changed, 390 insertions(+), 60 deletions(-)

diff --git a/src/hydra/material.cpp b/src/hydra/material.cpp
index 3aa097be..150f4301 100644
--- a/src/hydra/material.cpp
+++ b/src/hydra/material.cpp
@@ -742,6 +742,320 @@ const UsdToCyclesMapping &MtlxConvertSurface()
   return mapping;
 }
 
+/* ------------------------------------------------------------------------
+ * Les cheveux, selon Chiang et al. 2016 - le modele que MaterialX et Cycles
+ * implementent l'un comme l'autre, ce qui permet une traduction exacte plutot
+ * qu'une ressemblance.
+ *
+ * Une seule difference d'unites, et elle compte. La rugosite que le BSDF de
+ * MaterialX recoit (`roughness_R`) est deja convertie en variance longitudinale
+ * et en echelle azimutale - c'est le travail de `chiang_hair_roughness`, qui
+ * part d'une rugosite « artiste » beta. Le principled hair de Cycles, lui,
+ * attend beta et fait la conversion lui-meme, avec les memes polynomes au
+ * facteur sqrt(pi/8) pres, que MaterialX applique a l'usage plutot qu'a la
+ * conversion. D'ou deux regles :
+ *
+ * - `chiang_hair_roughness` ne convertit rien et transmet beta tel quel ;
+ * - une valeur ecrite directement sur `roughness_R` est ramenee a beta en
+ *   inversant les polynomes.
+ *
+ * Les lobes TT et TRT n'ont pas de rugosite propre chez Cycles : il les derive
+ * de la principale, a v/4 et 4v - exactement ce que donnent les echelles par
+ * defaut de `chiang_hair_roughness`, 0,5 et 2 au carre. Ils sont donc recus sans
+ * avertissement, dans des auxiliaires sans sortie que Cycles elague ; une
+ * echelle modifiee, elle, se signale sur le noeud de rugosite.
+ * ------------------------------------------------------------------------ */
+
+/* Inverse de x -> f(x), croissante sur [0, 1]. Soixante bissections suffisent
+ * largement a la precision d'un float. */
+template<typename F> float InvertMonotonic(const F &f, const float target)
+{
+  float lo = 0.0f;
+  float hi = 1.0f;
+  if (target <= f(lo)) {
+    return lo;
+  }
+  if (target >= f(hi)) {
+    return hi;
+  }
+  for (int i = 0; i < 60; ++i) {
+    const float mid = 0.5f * (lo + hi);
+    if (f(mid) < target) {
+      lo = mid;
+    }
+    else {
+      hi = mid;
+    }
+  }
+  return 0.5f * (lo + hi);
+}
+
+/* Variance longitudinale -> beta, l'inverse de `mx_chiang_hair_roughness`. */
+float ChiangLongitudinalBeta(const float variance)
+{
+  return InvertMonotonic(
+      [](const float r) {
+        const float p = 0.726f * r + 0.812f * r * r + 3.7f * powf(r, 20.0f);
+        return p * p;
+      },
+      variance);
+}
+
+/* Echelle azimutale -> beta. */
+float ChiangAzimuthalBeta(const float scale)
+{
+  return InvertMonotonic(
+      [](const float r) { return 0.265f * r + 1.194f * r * r + 5.372f * powf(r, 22.0f); },
+      scale);
+}
+
+class MtlxChiangHair : public UsdToCyclesMapping {
+ public:
+  using UsdToCyclesMapping::UsdToCyclesMapping;
+
+  std::string parameterName(const TfToken &name,
+                            const ShaderInput *inputConnection,
+                            VtValue *value) const override
+  {
+    static const TfToken roughnessR("roughness_R");
+    if (value && name == roughnessR) {
+      GfVec2f vs(0.1f, 0.1f);
+      if (value->IsHolding<GfVec2f>()) {
+        vs = value->UncheckedGet<GfVec2f>();
+      }
+      else if (value->IsHolding<GfVec2d>()) {
+        const GfVec2d d = value->UncheckedGet<GfVec2d>();
+        vs = GfVec2f(float(d[0]), float(d[1]));
+      }
+      *value = VtValue(
+          GfVec3f(ChiangLongitudinalBeta(vs[0]), ChiangAzimuthalBeta(vs[1]), 0.0f));
+    }
+    return UsdToCyclesMapping::parameterName(name, inputConnection, value);
+  }
+};
+
+UsdToCyclesMapping::Helper MathHelper(const char *const name,
+                                      const char *const wireTo,
+                                      UsdToCyclesMapping::FixedMap fixed)
+{
+  return UsdToCyclesMapping::Helper{name, "math", {{"Value", wireTo}}, std::move(fixed)};
+}
+
+const UsdToCyclesMapping &MtlxChiangHairBsdf()
+{
+  static const MtlxChiangHair mapping = [] {
+    MtlxChiangHair m{"principled_hair_bsdf",
+                     {
+                         {TfToken("absorption_coefficient"), ustring("absorption_coefficient")},
+                         {TfToken("ior"), ustring("ior")},
+                         {TfToken("roughness_R"), ustring("rsep:vector")},
+                         {TfToken("roughness_TT"), ustring("rtt:vector")},
+                         {TfToken("roughness_TRT"), ustring("rtrt:vector")},
+                         {TfToken("cuticle_angle"), ustring("cut:value1")},
+                         {CyclesMaterialTokens->out, ustring("BSDF")},
+                     }};
+    /* Le modele de Chiang, parametre par l'absorption : c'est ce que MaterialX
+     * decrit. Les defauts sont ceux de MaterialX - une absorption nulle, un
+     * cheveu blanc - et non ceux de Cycles, qui donnent un brun. */
+    m.setFixedValues({{ustring("model"), "Chiang"},
+                      {ustring("parametrization"), "Absorption coefficient"},
+                      {ustring("absorption_coefficient"), "0,0,0"}});
+    /* roughness_R, ramene a beta, se separe en rugosite longitudinale et
+     * radiale. Le defaut (0,1 ; 0,1) de MaterialX, en variance, vaut ce beta. */
+    m.addHelper({"rsep",
+                 "separate_xyz",
+                 {{"X", "Roughness"}, {"Y", "Radial Roughness"}},
+                 {{ustring("vector"), "0.320609,0.198975,0"}}});
+    /* L'inclinaison des ecailles : MaterialX la donne dans [0, 1] et la remappe
+     * sur [-pi/2, pi/2] ; Cycles la veut en radians. 0,5 - le defaut - ne
+     * penche pas, alors que le defaut de Cycles penche de 2 degres. */
+    m.addHelper(MathHelper("cut",
+                           "Offset",
+                           {{ustring("math_type"), "multiply_add"},
+                            {ustring("value1"), "0.5"},
+                            {ustring("value2"), "3.14159265"},
+                            {ustring("value3"), "-1.57079633"}}));
+    m.addHelper({"rtt", "separate_xyz", {}, {}});
+    m.addHelper({"rtrt", "separate_xyz", {}, {}});
+    return m;
+  }();
+  return mapping;
+}
+
+/* `chiang_hair_roughness` : transmettre beta, sans conversion - Cycles la fait.
+ * Les trois sorties portent la meme paire, TT et TRT n'etant pas lues. */
+const UsdToCyclesMapping &MtlxChiangHairRoughness()
+{
+  static const UsdToCyclesMapping mapping = [] {
+    UsdToCyclesMapping m{"combine_xyz",
+                         {
+                             {TfToken("longitudinal"), ustring("x")},
+                             {TfToken("azimuthal"), ustring("y")},
+                             {TfToken("roughness_R"), ustring("vector")},
+                             {TfToken("roughness_TT"), ustring("vector")},
+                             {TfToken("roughness_TRT"), ustring("vector")},
+                         }};
+    m.setFixedValues({{ustring("x"), "0.1"}, {ustring("y"), "0.2"}});
+    return m;
+  }();
+  return mapping;
+}
+
+/* `chiang_hair_absorption_from_color`, la formule de MaterialX au terme pres :
+ *
+ *   sigma = log(clamp(color, 0.001, 1)) / b(beta_n),  absorption = sigma^2
+ *
+ * ou b est un polynome de degre 5, calcule ici par la methode de Horner en cinq
+ * multiplications accumulees. C'est d'ailleurs ce que fait Cycles en
+ * parametrisation par couleur ; le refaire en noeuds garde la rugosite
+ * azimutale propre a ce noeud, qui peut differer de celle du BSDF. Quand la
+ * couleur est constante, Cycles replie tout le calcul a la compilation. */
+const UsdToCyclesMapping &MtlxChiangHairAbsorptionFromColor()
+{
+  static const UsdToCyclesMapping mapping = [] {
+    UsdToCyclesMapping m{"vector_math",
+                         {
+                             {TfToken("color"), ustring("cmax:vector1")},
+                             {TfToken("azimuthal_roughness"),
+                              ustring("t0:value1;t1:value2;t2:value2;t3:value2;t4:value2")},
+                             {TfToken("absorption"), ustring("vector")},
+                         }};
+    m.setFixedValues({{ustring("math_type"), "multiply"}});
+    /* sigma, entrant deux fois dans le produit final : sigma^2. */
+    m.addHelper({"div",
+                 "vector_math",
+                 {{"Vector", "Vector1"}, {"Vector", "Vector2"}},
+                 {{ustring("math_type"), "divide"}}});
+    m.addHelper({"comb", "combine_xyz", {{"Vector", "div:Vector1"}}, {}});
+    const UsdToCyclesMapping::FixedMap ln = {{ustring("math_type"), "logarithm"},
+                                             {ustring("value2"), "2.718281828"}};
+    m.addHelper(MathHelper("lr", "comb:X", ln));
+    m.addHelper(MathHelper("lg", "comb:Y", ln));
+    m.addHelper(MathHelper("lb", "comb:Z", ln));
+    m.addHelper({"sep",
+                 "separate_xyz",
+                 {{"X", "lr:Value1"}, {"Y", "lg:Value1"}, {"Z", "lb:Value1"}},
+                 {}});
+    m.addHelper({"cmin",
+                 "vector_math",
+                 {{"Vector", "sep:Vector"}},
+                 {{ustring("math_type"), "minimum"}, {ustring("vector2"), "1,1,1"}}});
+    m.addHelper({"cmax",
+                 "vector_math",
+                 {{"Vector", "cmin:Vector1"}},
+                 {{ustring("math_type"), "maximum"},
+                  {ustring("vector1"), "1,1,1"},
+                  {ustring("vector2"), "0.001,0.001,0.001"}}});
+    /* b(beta_n) par Horner, du terme de plus haut degre vers la constante. */
+    m.addHelper(MathHelper("t4",
+                           "div:Vector2",
+                           {{ustring("math_type"), "multiply_add"},
+                            {ustring("value2"), "0.2"},
+                            {ustring("value3"), "5.969"}}));
+    m.addHelper(MathHelper("t3",
+                           "t4:Value1",
+                           {{ustring("math_type"), "multiply_add"},
+                            {ustring("value2"), "0.2"},
+                            {ustring("value3"), "-0.215"}}));
+    m.addHelper(MathHelper("t2",
+                           "t3:Value1",
+                           {{ustring("math_type"), "multiply_add"},
+                            {ustring("value2"), "0.2"},
+                            {ustring("value3"), "2.532"}}));
+    m.addHelper(MathHelper("t1",
+                           "t2:Value1",
+                           {{ustring("math_type"), "multiply_add"},
+                            {ustring("value2"), "0.2"},
+                            {ustring("value3"), "-10.73"}}));
+    m.addHelper(MathHelper("t0",
+                           "t1:Value1",
+                           {{ustring("math_type"), "multiply_add"},
+                            {ustring("value1"), "0.2"},
+                            {ustring("value2"), "0.245"},
+                            {ustring("value3"), "5.574"}}));
+    return m;
+  }();
+  return mapping;
+}
+
+/* `deon_hair_absorption_from_melanin`, la formule de MaterialX :
+ *
+ *   m = -log(max(1 - concentration, 1e-4))
+ *   absorption = max(m (1-r) (-log eumelanin) + m r (-log pheomelanin), 0)
+ *
+ * Les deux signes moins se compensent : c'est log(max(1-c, 1e-4)) fois le
+ * melange, par la rougeur, des logarithmes des deux couleurs. Les constantes de
+ * MaterialX ne sont pas celles de la parametrisation par melanine de Cycles -
+ * s'y fier aurait donne une autre teinte ; le calcul est donc refait ici. */
+const UsdToCyclesMapping &MtlxDeonHairAbsorptionFromMelanin()
+{
+  static const UsdToCyclesMapping mapping = [] {
+    UsdToCyclesMapping m{"vector_math",
+                         {
+                             {TfToken("melanin_concentration"), ustring("m1:value2")},
+                             {TfToken("melanin_redness"), ustring("mix:fac")},
+                             {TfToken("eumelanin_color"), ustring("sepE:vector")},
+                             {TfToken("pheomelanin_color"), ustring("sepP:vector")},
+                             {TfToken("absorption"), ustring("vector")},
+                         }};
+    m.setFixedValues({{ustring("math_type"), "maximum"}, {ustring("vector2"), "0,0,0"}});
+    m.addHelper(
+        {"scale", "vector_math", {{"Vector", "Vector1"}}, {{ustring("math_type"), "scale"}}});
+    m.addHelper({"mix", "mix_vector", {{"Result", "scale:Vector1"}}, {{ustring("fac"), "0.5"}}});
+    m.addHelper({"combE", "combine_xyz", {{"Vector", "mix:A"}}, {}});
+    m.addHelper({"combP", "combine_xyz", {{"Vector", "mix:B"}}, {}});
+    const UsdToCyclesMapping::FixedMap ln = {{ustring("math_type"), "logarithm"},
+                                             {ustring("value2"), "2.718281828"}};
+    m.addHelper(MathHelper("eR", "combE:X", ln));
+    m.addHelper(MathHelper("eG", "combE:Y", ln));
+    m.addHelper(MathHelper("eB", "combE:Z", ln));
+    m.addHelper(MathHelper("pR", "combP:X", ln));
+    m.addHelper(MathHelper("pG", "combP:Y", ln));
+    m.addHelper(MathHelper("pB", "combP:Z", ln));
+    m.addHelper({"sepE",
+                 "separate_xyz",
+                 {{"X", "eR:Value1"}, {"Y", "eG:Value1"}, {"Z", "eB:Value1"}},
+                 {{ustring("vector"), "0.657704,0.498077,0.254107"}}});
+    m.addHelper({"sepP",
+                 "separate_xyz",
+                 {{"X", "pR:Value1"}, {"Y", "pG:Value1"}, {"Z", "pB:Value1"}},
+                 {{ustring("vector"), "0.829444,0.67032,0.349938"}}});
+    /* log(max(1 - concentration, 1e-4)), le facteur d'echelle du melange. */
+    m.addHelper(MathHelper("m3", "scale:Scale", ln));
+    m.addHelper(MathHelper(
+        "m2", "m3:Value1", {{ustring("math_type"), "maximum"}, {ustring("value2"), "0.0001"}}));
+    m.addHelper(MathHelper("m1",
+                           "m2:Value1",
+                           {{ustring("math_type"), "subtract"},
+                            {ustring("value1"), "1"},
+                            {ustring("value2"), "0.25"}}));
+    return m;
+  }();
+  return mapping;
+}
+
+/* `surface` : le BSDF, l'EDF qui s'y ajoute, et l'opacite qui melange le tout
+ * avec du transparent. C'est par lui qu'un BSDF nu - un cheveu, un dielectrique
+ * - devient un shader de surface dans un reseau MaterialX d'Houdini. Absent de
+ * la table, il coupait le reseau entier : le terminal ne recevait rien. */
+const UsdToCyclesMapping &MtlxSurface()
+{
+  static const UsdToCyclesMapping mapping = [] {
+    UsdToCyclesMapping m{"mix_closure",
+                         {
+                             {TfToken("bsdf"), ustring("add:closure1")},
+                             {TfToken("edf"), ustring("add:closure2")},
+                             {TfToken("opacity"), ustring("fac")},
+                             {CyclesMaterialTokens->out, ustring("closure")},
+                         }};
+    m.setFixedValues({{ustring("fac"), "1"}});
+    m.addHelper({"add", "add_closure", {{"Closure", "Closure2"}}, {}});
+    m.addHelper({"tr", "transparent_bsdf", {{"BSDF", "Closure1"}}, {}});
+    return m;
+  }();
+  return mapping;
+}
