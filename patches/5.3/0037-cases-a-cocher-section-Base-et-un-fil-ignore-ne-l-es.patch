   /* Ranges and clamping, all on nodes Cycles already has. */
   static const UsdToCyclesMapping kClamp = [] {
@@ -1591,10 +1591,24 @@ void HdCyclesMaterial::UpdateConnections(NodeDesc &nodeDesc,
     }
 
     if (!input) {
-      TF_WARN("Ignoring connection on '%s.%s', input '%s' was not found",
-              nodePath.GetText(),
-              dstSocketName.GetText(),
-              dstSocketName.GetText());
+      /* Distinguish a socket that does not exist from one Cycles refuses to
+       * link. The second is the interesting case: an image filename, a
+       * colour space, a projection mode - values the scene must know before
+       * it is built, since a texture is loaded into memory rather than
+       * evaluated per sample. Blender draws no socket for them either. Said
+       * through the Cycles logger rather than TF_WARN, which husk swallows,
+       * so that the connection no longer vanishes in silence. */
+      const SocketType *const unlinkable = target->type->find_input(ustring(inputName));
+      if (unlinkable != nullptr) {
+        LOG_WARNING << "Cycles does not take a connection on '" << nodePath.GetText() << "."
+                    << dstSocketName.GetText()
+                    << "': the value has to be known when the scene is built, so the link is "
+                       "ignored and the parameter's own value is used.";
+      }
+      else {
+        LOG_WARNING << "No input '" << dstSocketName.GetText() << "' on Cycles node '"
+                    << nodePath.GetText() << "', connection dropped.";
+      }
       continue;
     }
 
diff --git a/src/hydra/sdr_cycles.cpp b/src/hydra/sdr_cycles.cpp
index 9337f7c3..de23f091 100644
--- a/src/hydra/sdr_cycles.cpp
+++ b/src/hydra/sdr_cycles.cpp
@@ -173,6 +173,13 @@ SdrShaderPropertyUniquePtr MakeProperty(const ccl::SocketType &socket, const boo
   if (socket.type == ccl::SocketType::BOOLEAN) {
     metadata[SdrPropertyMetadata->Widget] = "checkBox";
   }
+  /* `thin_wall` is a boolean that Cycles declares as an int so that it can be
+   * linked - it is the only SOCKET_IN_INT in the whole node set, and its
+   * default is written `int(false)`. Nothing at runtime distinguishes it from
+   * a count, so it is named here rather than guessed at. */
+  if (socket.type == ccl::SocketType::INT && socket.name == ccl::ustring("thin_wall")) {
+    metadata[SdrPropertyMetadata->Widget] = "checkBox";
+  }
   /* A filename is a file, not free text: hosts that know it can offer a file
    * browser rather than asking for a path to be typed or pasted. */
   if (socket.type == ccl::SocketType::STRING && socket.name == ccl::ustring("filename")) {
diff --git a/src/scene/shader_nodes.cpp b/src/scene/shader_nodes.cpp
index 55f12f96..9581a710 100644
--- a/src/scene/shader_nodes.cpp
+++ b/src/scene/shader_nodes.cpp
@@ -1536,8 +1536,24 @@ NODE_DEFINE(MxNoiseTextureNode)
 {
   NodeType *type = NodeType::add("mx_noise_texture", create, NodeType::SHADER);
 
-  SOCKET_INT(dimensions, "Dimensions", 3);
-  SOCKET_INT(noise_type, "Noise Type", 0);
+  /* Declared as enums rather than plain integers so that a host offers the
+   * choice by name: a bare number leaves nothing to say that three means 3D or
+   * that two means cell noise, and every other Cycles node with a mode does it
+   * this way. The values match NodeMxNoiseType. */
+  static NodeEnum dimensions_enum;
+  dimensions_enum.insert("2D", 2);
+  dimensions_enum.insert("3D", 3);
+  SOCKET_ENUM(dimensions, "Dimensions", dimensions_enum, 3);
+
+  static NodeEnum noise_type_enum;
+  /* Les valeurs suivent NodeMxNoiseType, qui vit dans le kernel : le code de
+   * scene ne l'inclut pas, et n'a pas a le faire. */
+  noise_type_enum.insert("perlin", 0);
+  noise_type_enum.insert("fractal", 1);
+  noise_type_enum.insert("cell", 2);
+  noise_type_enum.insert("worley", 3);
+  noise_type_enum.insert("unified", 4);
+  SOCKET_ENUM(noise_type, "Noise Type", noise_type_enum, 0);
 
   /* Left unconnected, fall back to texture coordinates the way the other
    * procedural textures do, rather than evaluating everywhere at the origin. */
