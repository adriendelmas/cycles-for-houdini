  * Vider le handle quand un des sockets qui decrivent l'image a change suffit :
  * Cycles la redemande a la compilation suivante, et son gestionnaire la
  * reconnait si c'est la meme, donc rien n'est recharge pour rien. */
+/* Les textures UDIM.
+ *
+ * Cycles sait lire une serie de tuiles, mais il faut lui dire lesquelles : le
+ * socket `tiles` porte leurs numeros, et le gestionnaire d'images remplace
+ * `<UDIM>` ou `<UVTILE>` du nom de fichier par chacun d'eux. Blender remplit
+ * cette liste depuis son image ; ici personne ne le faisait, et un chemin en
+ * `<UDIM>` partait tel quel, a la recherche d'un fichier qui n'existe pas.
+ *
+ * Les tuiles se trouvent donc comme Blender les trouve : en listant le dossier.
+ * Houdini ecrit aussi `%(UDIM)d` et `%(UVTILE)d`, que Cycles ne connait pas ;
+ * ils sont ramenes aux deux jetons qu'il sait remplacer. */
+static bool FindUdimTiles(std::string &filename, array<int> &tiles)
+{
+  string_replace(filename, "%(UDIM)d", "<UDIM>");
+  string_replace(filename, "%(UVTILE)d", "<UVTILE>");
+
+  const bool isUdim = filename.find("<UDIM>") != std::string::npos;
+  const bool isUvTile = filename.find("<UVTILE>") != std::string::npos;
+  if (!isUdim && !isUvTile) {
+    return false;
+  }
+
+  const std::string token = isUdim ? "<UDIM>" : "<UVTILE>";
+  const std::string dirname = path_dirname(filename);
+  const std::string basename = path_filename(filename);
+  const size_t at = basename.find(token);
+  if (at == std::string::npos) {
+    LOG_WARNING << "UDIM token in a directory name is not supported: " << filename;
+    return true;
+  }
+
+  auto escape = [](const std::string &text) {
+    static const std::regex special(R"([.^$|()\[\]{}*+?\\])");
+    return std::regex_replace(text, special, R"(\$&)");
+  };
+  const std::string pattern = escape(basename.substr(0, at)) +
+                              (isUdim ? R"((\d{4}))" : R"(u(\d+)_v(\d+))") +
+                              escape(basename.substr(at + token.size()));
+#ifdef _WIN32
+  const std::regex matcher(pattern, std::regex::icase);
+#else
+  const std::regex matcher(pattern);
+#endif
+
+  std::vector<std::string> entries;
+  OIIO::Filesystem::get_directory_entries(dirname.empty() ? "." : dirname, entries);
+
+  std::set<int> found;
+  for (const std::string &entry : entries) {
+    std::smatch match;
+    const std::string name = path_filename(entry);
+    if (!std::regex_match(name, match, matcher)) {
+      continue;
+    }
+    if (isUdim) {
+      const int tile = std::stoi(match[1].str());
+      if (tile >= 1001) {
+        found.insert(tile);
+      }
+    }
+    else {
+      /* `u1_v1` est la tuile 1001 : u compte de 1 a 10, v par dizaines. */
+      const int u = std::stoi(match[1].str());
+      const int v = std::stoi(match[2].str());
+      if (u >= 1 && u <= 10 && v >= 1) {
+        found.insert(1001 + (u - 1) + (v - 1) * 10);
+      }
+    }
+  }
+
+  tiles.clear();
+  for (const int tile : found) {
+    tiles.push_back_slow(tile);
+  }
+  if (tiles.empty()) {
+    LOG_WARNING << "No UDIM tile found for " << filename;
+  }
+  return true;
+}
+
+void HdCyclesMaterial::ResolveUdimTiles()
+{
+  static const ustring kFilename("filename");
+  static const ustring kTiles("tiles");
+
+  auto resolve = [](Node *node) {
+    if (node == nullptr) {
+      return;
+    }
+    const SocketType *const filenameSocket = node->type->find_input(kFilename);
+    const SocketType *const tilesSocket = node->type->find_input(kTiles);
+    if (filenameSocket == nullptr || tilesSocket == nullptr ||
+        tilesSocket->type != SocketType::INT_ARRAY)
+    {
+      return;
+    }
+
+    std::string filename = node->get_string(*filenameSocket).string();
+    if (filename.empty() || string_startswith(filename, "op:")) {
+      return;
+    }
+
+    array<int> tiles;
+    if (FindUdimTiles(filename, tiles)) {
+      node->set(*filenameSocket, ustring(filename));
+    }
+    /* Un chemin qui n'a plus de jeton doit aussi perdre ses tuiles. */
+    node->set(*tilesSocket, tiles);
+  };
+
+  for (const auto &entry : _nodes) {
+    resolve(entry.second.node);
+    for (const auto &helper : entry.second.helperNodes) {
+      resolve(helper.second);
+    }
+  }
+}
