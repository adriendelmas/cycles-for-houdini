+/* OIDN on an AOV's colour channels, guided by the albedo and normal passes when they are there,
+ * on the final tile only: the AOVs listed in `cycles:denoise_aovs`. */
+void HdCyclesOutputDriver::Denoise(const Tile &tile,
+                                   const TfToken &aovName,
+                                   const size_t channels,
+                                   float *pixels) const
+{
+#ifdef WITH_OPENIMAGEDENOISE
+  if (!_finalTile || channels < 3 || !_renderParam->DenoiseAov(aovName)) {
+    if (_finalTile) {
+      LOG_DEBUG << "Not denoising AOV '" << aovName.GetString() << "'.";
+    }
+    return;
+  }
+  const size_t width = size_t(tile.size.x), height = size_t(tile.size.y);
+  const size_t count = width * height;
+  std::vector<float> color(count * 3), output(count * 3), albedo(count * 3), normal(count * 3);
+  for (size_t i = 0; i < count; ++i) {
+    for (size_t c = 0; c < 3; ++c) {
+      color[i * 3 + c] = pixels[i * channels + c];
+    }
+  }
+  const std::string &albedoPass = _renderParam->GuideAlbedoPass();
+  const std::string &normalPass = _renderParam->GuideNormalPass();
+  const bool haveAlbedo = !albedoPass.empty() &&
+                          tile.get_pass_pixels(albedoPass, 3, albedo.data());
+  const bool haveNormal = haveAlbedo && !normalPass.empty() &&
+                          tile.get_pass_pixels(normalPass, 3, normal.data());
+
+  oidn::DeviceRef device = oidn::newDevice(oidn::DeviceType::CPU);
+  device.commit();
+  oidn::FilterRef filter = device.newFilter("RT");
+  filter.setImage("color", color.data(), oidn::Format::Float3, width, height);
+  if (haveAlbedo) {
+    filter.setImage("albedo", albedo.data(), oidn::Format::Float3, width, height);
+  }
+  if (haveNormal) {
+    filter.setImage("normal", normal.data(), oidn::Format::Float3, width, height);
+  }
+  filter.setImage("output", output.data(), oidn::Format::Float3, width, height);
+  filter.set("hdr", true);
+  filter.commit();
+  filter.execute();
+  const char *message = nullptr;
+  if (device.getError(message) != oidn::Error::None) {
+    LOG_WARNING << "Denoising AOV '" << aovName.GetString() << "' failed: "
+                << (message ? message : "");
+    return;
+  }
+  LOG_INFO << "Denoised AOV '" << aovName.GetString() << "' (" << width << "x" << height
+           << (haveAlbedo ? ", albedo" : "") << (haveNormal ? ", normal" : "") << ").";
+  for (size_t i = 0; i < count; ++i) {
+    for (size_t c = 0; c < 3; ++c) {
+      pixels[i * channels + c] = output[i * 3 + c];
+    }
+  }
+#else
+  (void)tile;
+  (void)aovName;
+  (void)channels;
+  (void)pixels;
+#endif
+}
+
 bool HdCyclesOutputDriver::update_render_tile(const Tile &tile)
 {
   std::vector<float> pixels;
@@ -115,6 +186,13 @@ bool HdCyclesOutputDriver::update_render_tile(const Tile &tile)
       if (format == HdFormatInvalid) {
         continue;  // Skip invalid AOV bindings
       }
+      /* Cycles sends one more progressive update after the final write (PathTrace::render(),
+       * update_display() after write_tile_buffer()): it would put the noisy pass back over a
+       * denoised AOV. */
+      if (!_finalTile && renderBuffer->IsConverged() && _renderParam->DenoiseAov(aovBinding.aovName))
+      {
+        continue;
+      }
 
       const size_t channels = HdGetComponentCount(format);
       // Avoid extra copy by mapping render buffer directly when dimensions/format match the tile
@@ -127,6 +205,7 @@ bool HdCyclesOutputDriver::update_render_tile(const Tile &tile)
         MultiplyByColor(tile, aovBinding.aovName, channels, data);
         AddPass(tile, aovBinding.aovName, channels, data);
         ScaleGsplat(aovBinding.aovName, tile, channels, data);
+        Denoise(tile, aovBinding.aovName, channels, data);
         renderBuffer->Unmap();
       }
       else {
@@ -137,6 +216,7 @@ bool HdCyclesOutputDriver::update_render_tile(const Tile &tile)
           MultiplyByColor(tile, aovBinding.aovName, channels, pixels.data());
           AddPass(tile, aovBinding.aovName, channels, pixels.data());
           ScaleGsplat(aovBinding.aovName, tile, channels, pixels.data());
+          Denoise(tile, aovBinding.aovName, channels, pixels.data());
           const bool isId = aovBinding.aovName == HdAovTokens->primId ||
                             aovBinding.aovName == HdAovTokens->elementId ||
                             aovBinding.aovName == HdAovTokens->instanceId;
