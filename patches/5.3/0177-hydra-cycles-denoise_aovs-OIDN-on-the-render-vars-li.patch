diff --git a/src/hydra/session.cpp b/src/hydra/session.cpp
index 729ce450..3df91cfc 100644
--- a/src/hydra/session.cpp
+++ b/src/hydra/session.cpp
@@ -11,6 +11,7 @@
 // overload taking a 'Node *', rather than the one taking a 'bool'
 #include "scene/background.h"
 #include "scene/film.h"
+#include "scene/integrator.h"
 #include "scene/pass.h"
 #include "scene/hair.h"
 #include "scene/light.h"
@@ -26,6 +27,7 @@
 #include <cctype>
 #include <cstring>
 #include <set>
+#include <tuple>
 
 HDCYCLES_NAMESPACE_OPEN_SCOPE
 
@@ -713,6 +715,45 @@ void HdCyclesSession::SyncAovBindings(const HdRenderPassAovBindingVector &aovBin
     }
   }
 
+  /* AOVs to denoise in the output driver: albedo and normal guides, under names it can read
+   * (the film's own denoising passes have none). The beauty is left to Cycles' denoiser when it
+   * is on, as is every read of it. */
+  _guideAlbedo.clear();
+  _guideNormal.clear();
+  _alreadyDenoised.clear();
+  if (!_denoiseAovs.empty()) {
+    for (const auto &[type, fallback, out] :
+         {std::make_tuple(PASS_DENOISING_ALBEDO, "denoising_albedo", &_guideAlbedo),
+          std::make_tuple(PASS_DENOISING_NORMAL, "denoising_normal", &_guideNormal)})
+    {
+      for (const Pass *pass : scene->passes) {
+        if (pass->get_type() == type && !pass->get_name().empty()) {
+          *out = pass->get_name().string();
+          break;
+        }
+      }
+      if (out->empty()) {
+        Pass *pass = scene->create_node<Pass>();
+        pass->set_type(type);
+        pass->set_mode(PassMode::NOISY);
+        pass->set_name(ustring(fallback));
+        *out = fallback;
+      }
+    }
+    if (scene->integrator->get_use_denoise()) {
+      for (const HdRenderPassAovBinding &aovBinding : aovBindings) {
+        const std::string &passName = PassName(aovBinding.aovName);
+        for (const Pass *pass : scene->passes) {
+          if (pass->get_name() == passName && pass->get_type() == PASS_COMBINED &&
+              pass->get_lightgroup().empty())
+          {
+            _alreadyDenoised.insert(aovBinding.aovName);
+          }
+        }
+      }
+    }
+  }
+
   /* The kernel writes every layer of every enabled kind, objects first, then
    * materials, then assets: create them all, in that order, whichever the
    * render vars asked for. */
diff --git a/src/hydra/session.h b/src/hydra/session.h
index dc4a3221..b61793f2 100644
--- a/src/hydra/session.h
+++ b/src/hydra/session.h
@@ -9,9 +9,11 @@
 #include "util/thread.h"
 #include "util/types.h"
 
+#include <algorithm>
 #include <cmath>
 #include <map>
 #include <set>
+#include <vector>
 #include <string>
 
 #include <pxr/imaging/cameraUtil/framing.h>
@@ -182,6 +184,50 @@ class HdCyclesSession final : public PXR_NS::HdRenderParam {
     _maxSubdivisions = maxSubdivisions;
   }
 
+  /* AOVs the output driver runs OIDN on at the end of the render (`cycles:denoise_aovs`,
+   * names separated by spaces or commas), guided by albedo and normal passes it adds. */
+  void SetDenoiseAovs(const std::string &list)
+  {
+    std::vector<std::string> names;
+    std::string name;
+    for (const char c : list + " ") {
+      if (c == ' ' || c == ',' || c == '\t' || c == '\n') {
+        if (!name.empty()) {
+          names.push_back(name);
+        }
+        name.clear();
+      }
+      else {
+        name += c;
+      }
+    }
+    if (names != _denoiseAovs) {
+      _denoiseAovs = names;
+      _aovBindingsDirty = true;
+    }
+  }
+  bool DenoiseAov(const PXR_NS::TfToken &aovName) const
+  {
+    return std::find(_denoiseAovs.begin(), _denoiseAovs.end(), aovName.GetString()) !=
+               _denoiseAovs.end() &&
+           !_alreadyDenoised.count(aovName);
+  }
+  const std::string &GuideAlbedoPass() const
+  {
+    return _guideAlbedo;
+  }
+  const std::string &GuideNormalPass() const
+  {
+    return _guideNormal;
+  }
+  /* True once after the passes must be built again (the denoise list changed). */
+  bool TakeAovBindingsDirty()
+  {
+    const bool dirty = _aovBindingsDirty;
+    _aovBindingsDirty = false;
+    return dirty;
+  }
+
   float GetDicingRate() const
   {
     return _dicingRate;
@@ -418,6 +464,11 @@ class HdCyclesSession final : public PXR_NS::HdRenderParam {
   std::map<PXR_NS::TfToken, std::string> _passNames;
   std::map<PXR_NS::TfToken, std::string> _colorPassNames;
   std::map<PXR_NS::TfToken, std::string> _addPassNames;
+  std::vector<std::string> _denoiseAovs;
+  std::set<PXR_NS::TfToken> _alreadyDenoised;
+  std::string _guideAlbedo;
+  std::string _guideNormal;
+  bool _aovBindingsDirty = false;
   PXR_NS::HdRenderPassAovBinding _displayAovBinding;
 };
 
