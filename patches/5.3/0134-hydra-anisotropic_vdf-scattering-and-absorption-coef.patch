From 5872680fae5023527864aaf1983ac92a63cfc551 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Sat, 10 Oct 2026 11:46:17 +0200
Subject: [PATCH 134/141] hydra: anisotropic_vdf scattering and absorption
 coefficients

MaterialX's anisotropic_vdf takes `absorption` and `scattering`, the
coefficients sigma_a and sigma_s; the mapping read an `albedo` the node
does not have, so both were dropped and every such medium was Cycles'
default scatter volume. The scattering is now the scatter volume's colour
at density 1 and the absorption an absorption_vdf added beside it (K-92).
---
 src/hydra/material.cpp    | 20 ++++++++-----
 src/hydra/mtlx_expand.cpp | 63 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 76 insertions(+), 7 deletions(-)

diff --git a/src/hydra/material.cpp b/src/hydra/material.cpp
index b96560d1..f267c6f0 100644
--- a/src/hydra/material.cpp
+++ b/src/hydra/material.cpp
@@ -2122,13 +2122,19 @@ const std::vector<MtlxEntry> &MtlxTable()
                   {ustring("vector2"), "0,0,0"}}});
     return m;
   }();
-  static const UsdToCyclesMapping kScatterVdf = {
-      "scatter_volume",
-      {
-          {TfToken("albedo"), ustring("color")},
-          {TfToken("anisotropy"), ustring("anisotropy")},
-          {CyclesMaterialTokens->out, ustring("volume")},
-      }};
+  /* `anisotropic_vdf`'s scattering coefficient is the scatter volume's
+   * colour at density 1; its absorption becomes an absorption VDF beside it
+   * (mtlx_expand.cpp, K-92). */
+  static const UsdToCyclesMapping kScatterVdf = [] {
