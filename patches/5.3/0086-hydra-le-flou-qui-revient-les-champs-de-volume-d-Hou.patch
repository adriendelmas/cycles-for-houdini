diff --git a/src/hydra/session.cpp b/src/hydra/session.cpp
index ce8aedff..d0fe6d82 100644
--- a/src/hydra/session.cpp
+++ b/src/hydra/session.cpp
@@ -116,8 +116,10 @@ void HdCyclesSession::UpdateScene()
   Scene *const scene = session->scene.get();
 
   // Update background depending on presence of a background light
-  if (scene->light_manager->need_update()) {
+  if (scene->light_manager->need_update() || _backgroundDirty) {
+    _backgroundDirty = false;
     Light *background_light = nullptr;
+    Object *background_object = nullptr;
     bool have_lights = false;
     for (Object *object : scene->objects) {
       if (!object->get_geometry()->is_light()) {
@@ -129,13 +131,15 @@ void HdCyclesSession::UpdateScene()
       Light *light = static_cast<Light *>(object->get_geometry());
       if (light->is_background_light()) {
         background_light = light;
+        background_object = object;
         break;
       }
     }
 
     if (!background_light) {
       scene->background->set_shader(scene->default_background);
-      scene->background->set_transparent(true);
+      scene->background->set_transparent(_transparentOverride != 0);
+      scene->background->set_visibility(PATH_RAY_VISIBILITY_ALL);
 
       /* Set background color depending to non-zero value if there are no
        * lights in the scene, to match behavior of other renderers. */
@@ -148,7 +152,16 @@ void HdCyclesSession::UpdateScene()
     }
     else {
       scene->background->set_shader(background_light->get_shader());
-      scene->background->set_transparent(false);
+      /* The dome's ray visibility is the background's: a dome hidden from
+       * camera rays (`visibleInPrimaryRay` off) still lights the scene and
+       * leaves the film transparent behind it, as in Karma. Before, the
+       * flag reached the light's object, which camera rays never look at,
+       * and with a dome the film was always opaque. */
+      const uint visibility = background_object->get_visibility();
+      scene->background->set_visibility(visibility);
+      const bool seen = (visibility & PATH_RAY_VISIBILITY_CAMERA) != 0;
+      scene->background->set_transparent(
+          _transparentOverride >= 0 ? _transparentOverride != 0 : !seen);
     }
 
     scene->background->tag_update(scene);
