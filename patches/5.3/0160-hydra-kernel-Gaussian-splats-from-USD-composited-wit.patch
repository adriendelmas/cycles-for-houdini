+VtVec3fArray ReadVec3Array(const HdPrimvarsSchema &primvars, const TfToken &name)
+{
+  const VtValue value = ReadPrimvar(primvars, name);
+  if (value.IsHolding<VtVec3fArray>()) {
+    return value.UncheckedGet<VtVec3fArray>();
+  }
+  VtVec3fArray result;
+  if (value.IsHolding<VtVec3hArray>()) {
+    const VtVec3hArray &half = value.UncheckedGet<VtVec3hArray>();
+    result.resize(half.size());
+    GfVec3f *out = result.data();
+    for (size_t i = 0; i < half.size(); ++i) {
+      out[i] = GfVec3f(half[i]);
+    }
+  }
+  return result;
+}
+
+VtQuatfArray ReadQuatArray(const HdPrimvarsSchema &primvars, const TfToken &name)
+{
+  const VtValue value = ReadPrimvar(primvars, name);
+  if (value.IsHolding<VtQuatfArray>()) {
+    return value.UncheckedGet<VtQuatfArray>();
+  }
+  VtQuatfArray result;
+  if (value.IsHolding<VtQuathArray>()) {
+    const VtQuathArray &half = value.UncheckedGet<VtQuathArray>();
+    result.resize(half.size());
+    GfQuatf *out = result.data();
+    for (size_t i = 0; i < half.size(); ++i) {
+      out[i] = GfQuatf(half[i]);
+    }
+  }
+  return result;
+}
+
+VtFloatArray ReadFloatArray(const HdPrimvarsSchema &primvars, const TfToken &name)
+{
+  const VtValue value = ReadPrimvar(primvars, name);
+  if (value.IsHolding<VtFloatArray>()) {
+    return value.UncheckedGet<VtFloatArray>();
+  }
+  VtFloatArray result;
+  if (value.IsHolding<VtHalfArray>()) {
+    const VtHalfArray &half = value.UncheckedGet<VtHalfArray>();
+    result.resize(half.size());
+    float *out = result.data();
+    for (size_t i = 0; i < half.size(); ++i) {
+      out[i] = float(half[i]);
+    }
+  }
+  return result;
+}
+
+/* `cycles:gsplat:mode`, a constant token or string: "composite" or "stochastic". */
+bool ReadSplatMode(const HdPrimvarsSchema &primvars, const TfToken &name, bool &composite)
+{
+  VtValue value = ReadPrimvar(primvars, name);
+  if (value.IsHolding<VtArray<TfToken>>() && value.GetArraySize() == 1) {
+    value = VtValue(value.UncheckedGet<VtArray<TfToken>>()[0]);
+  }
+  else if (value.IsHolding<VtArray<std::string>>() && value.GetArraySize() == 1) {
+    value = VtValue(value.UncheckedGet<VtArray<std::string>>()[0]);
+  }
+
+  std::string mode;
+  if (value.IsHolding<TfToken>()) {
+    mode = value.UncheckedGet<TfToken>().GetString();
+  }
+  else if (value.IsHolding<std::string>()) {
+    mode = value.UncheckedGet<std::string>();
+  }
+  else {
+    return false;
+  }
+  composite = (mode != "stochastic");
+  return true;
+}
+
+}  // namespace
