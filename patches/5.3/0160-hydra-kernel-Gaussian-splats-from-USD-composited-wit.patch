+/* Composited Gaussian splats answer the composite ray only: no camera, bounce or shadow ray
+ * carries their mask bit, so those rays skip them without calling the user geometry. */
+static uint embree_geometry_mask(const Object *ob)
+{
+  const Geometry *geom = ob->get_geometry();
+  if (geom->is_pointcloud() && static_cast<const PointCloud *>(geom)->is_gsplat_composite()) {
+    return PATH_RAY_VISIBILITY_GSPLAT_COMPOSITE;
+  }
+  return ob->visibility_for_tracing();
+}
