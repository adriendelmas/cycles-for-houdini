+void HdCyclesPoints::PopulateSplats(HdSceneDelegate *sceneDelegate)
+{
+  const HdSceneIndexPrim prim = GetPrim(sceneDelegate, GetId());
+  const HdPrimvarsSchema primvars = HdPrimvarsSchema::GetFromParent(prim.dataSource);
+
+  const VtVec3fArray positions = ReadVec3Array(primvars, _splatTokens->positions);
+  const size_t numPoints = positions.size();
+
+  _geom->resize(int(numPoints));
+  _geom->set_render_as(PointCloud::RENDER_AS_GSPLATS);
+  if (numPoints == 0) {
+    return;
+  }
+
+  static_assert(sizeof(GfVec3f) == sizeof(packed_float3));
+  std::copy_n(reinterpret_cast<const packed_float3 *>(positions.data()),
+              numPoints,
+              _geom->get_position_for_write());
+
+  /* ponytail: no motion blur on splats - the point count of a splat field
+   * changes from frame to frame anyway. Upgrade with velocity blur if asked. */
+  if (Attribute *attr_P = _geom->attributes.find(ATTR_STD_POSITION)) {
+    if (attr_P->has_motion()) {
+      attr_P->remove_motion();
+      _geom->set_use_motion_blur(false);
+    }
+  }
+
+  const VtVec3fArray scales = ReadVec3Array(primvars, _splatTokens->scales);
+  const VtQuatfArray orientations = ReadQuatArray(primvars, _splatTokens->orientations);
+  const VtFloatArray opacities = ReadFloatArray(primvars, _splatTokens->opacities);
+  const VtVec3fArray shCoefficients = ReadVec3Array(primvars, _splatTokens->shCoefficients);
+
+  int shDegree = 3;
+  const VtValue degreeValue = ReadPrimvar(primvars, _splatTokens->shDegree);
+  if (degreeValue.CanCast<int>()) {
+    shDegree = VtValue::Cast<int>(degreeValue).UncheckedGet<int>();
+  }
+  const size_t shPerPoint = size_t(shDegree + 1) * size_t(shDegree + 1);
+  const bool hasSh = shDegree >= 0 && !shCoefficients.empty() &&
+                     shCoefficients.size() >= numPoints * shPerPoint;
+
+  /* Composited unless asked otherwise: Karma XPU draws splats without noise by
+   * default, and a stochastic hit at the low opacity of a glowing haze (0.01)
+   * keeps a relative noise of 10 per sample. Trained splats, which carry
+   * spherical harmonics and are dense, stay stochastic: blending them out of
+   * order would show what is behind them. */
+  bool composite = !hasSh;
+  ReadSplatMode(primvars, _splatTokens->mode, composite);
+  _geom->set_gsplat_composite(composite);
+
+  /* The colour: displayColor, which a SOP Import writes from Cd. */
+  const VtValue colorValue = ReadPrimvar(primvars, HdTokens->displayColor);
+  const VtVec3fArray colors = colorValue.IsHolding<VtVec3fArray>() ?
+                                  colorValue.UncheckedGet<VtVec3fArray>() :
+                                  VtVec3fArray();
+  const bool perPointColor = colors.size() >= numPoints;
+  const GfVec3f constantColor = colors.empty() ? GfVec3f(1.0f) : colors[0];
+
+  Attribute *attr_scale = _geom->attributes.add(ATTR_STD_GSPLAT_SCALE);
+  Attribute *attr_rotation = _geom->attributes.add(ATTR_STD_GSPLAT_ROTATION);
+  Attribute *attr_base = _geom->attributes.add(ATTR_STD_GSPLAT_RADIANCE_BASE);
+  packed_float3 *scale = attr_scale->data_for_write<packed_float3>();
+  Quaternion *rotation = attr_rotation->data_for_write<Quaternion>();
+  float4 *base = attr_base->data_for_write<float4>();
+
+  /* Order 0 spherical harmonics constant, to turn a linear colour into the
+   * coefficient the splat shader of Cycles expects (gsplat_radiance(): sRGB of
+   * C0 * coefficient + 0.5). ponytail: assumes a Rec.709 scene linear space;
+   * only used by stochastic splats without harmonics. */
+  constexpr float kShC0 = 0.28209479177387814f;
+
+  const bool hasScales = scales.size() >= numPoints;
+  const bool hasOrientations = orientations.size() >= numPoints;
+  const bool hasOpacities = opacities.size() >= numPoints;
+
+  for (size_t i = 0; i < numPoints; ++i) {
+    scale[i] = hasScales ? make_float3(scales[i][0], scales[i][1], scales[i][2]) :
+                           PointCloud::DEFAULT_GSPLAT_SCALE;
+
+    if (hasOrientations) {
+      const GfQuatf &q = orientations[i];
+      const GfVec3f &im = q.GetImaginary();
+      rotation[i] = make_quaternion(q.GetReal(), im[0], im[1], im[2]);
+    }
+    else {
+      rotation[i] = identity_quaternion();
+    }
+
+    const GfVec3f &c = perPointColor ? colors[i] : constantColor;
+    float3 radiance = make_float3(c[0], c[1], c[2]);
+    if (!composite) {
+      if (hasSh) {
+        const GfVec3f &dc = shCoefficients[i * shPerPoint];
+        radiance = make_float3(dc[0], dc[1], dc[2]);
+      }
+      else {
+        radiance = (color_linear_to_srgb_v3(radiance) - make_float3(0.5f)) / kShC0;
+      }
+    }
+    base[i] = make_float4(radiance, hasOpacities ? opacities[i] : 1.0f);
+  }
+}
