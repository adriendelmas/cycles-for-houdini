+ustring ColorSpaceManager::srgb_texture_colorspace()
+{
+#ifdef WITH_OCIO
+  OCIO::ConstConfigRcPtr config = nullptr;
+  try {
+    config = OCIO::GetCurrentConfig();
+  }
+  catch (const OCIO::Exception &) {
+    return u_colorspace_srgb;
+  }
+  if (config) {
+    /* OCIO v2 configs alias it srgb_tx; ACES 1.x studio configs name it in
+     * full; simple configs call it sRGB. */
+    static const char *const names[] = {
+        "srgb_tx", "sRGB - Texture", "Utility - sRGB - Texture", "sRGB"};
+    for (const char *name : names) {
+      try {
+        if (const OCIO::ConstColorSpaceRcPtr space = config->getColorSpace(name)) {
+          return ustring(space->getName());
+        }
+      }
+      catch (const OCIO::Exception &) {
+      }
+    }
+  }
+#endif
+  return u_colorspace_srgb;
+}
+
+ustring ColorSpaceManager::resolve_texture_colorspace(const string &name)
+{
+  if (name.empty() || name == "auto") {
+    return u_colorspace_auto;
+  }
+  if (name == "raw" || name == "data" || name == "Raw" || name == "Utility - Raw") {
+    return u_colorspace_data;
+  }
+  if (name == "sRGB" || name == "srgb_texture" || name == "srgb_tx") {
+    return srgb_texture_colorspace();
+  }
+#ifdef WITH_OCIO
+  try {
+    const OCIO::ConstConfigRcPtr config = OCIO::GetCurrentConfig();
+    if (config) {
+      if (const OCIO::ConstColorSpaceRcPtr space = config->getColorSpace(name.c_str())) {
+        return ustring(space->getName());
+      }
+    }
+  }
+  catch (const OCIO::Exception &) {
+  }
+#endif
+  if (name == "lin_rec709" || name == "Linear" || name == "linear") {
+    return u_colorspace_scene_linear;
+  }
+  return u_colorspace_auto;
+}
