From 46ed3b9709e0e7fc258e22c69898f081aba5469b Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Mon, 26 Oct 2026 09:54:09 +0100
Subject: [PATCH 157/162] wetmap: no device write at a reset before the kernels
 are loaded (S2 fix)

Wet map (addition). The zeroing of the accumulators at a delayed reset
(0156) touched device memory from Session::update_scene; an interactive
session loads its kernels late, and before that the CUDA device has no
module to bind a global to. It now runs only when Scene::are_kernels_loaded()
(a new getter on the protected flag); otherwise the next device update
zeroes them, after the kernels. Read alongside: upstream's own
Scene::update_camera_resolution uploads the kernel data from
run_update_for_next_iteration before path_trace_->load_kernels(), which
logs 'Invalid handle in cuModuleGetGlobal' on the first reset of an
interactive session - harmless, re-uploaded at the end of the scene update,
and not this addition's.
---
 src/scene/scene.h       | 7 +++++++
 src/session/session.cpp | 6 ++++--
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/scene/scene.h b/src/scene/scene.h
index c0354c4d..5781bf23 100644
--- a/src/scene/scene.h
+++ b/src/scene/scene.h
@@ -194,6 +194,13 @@ class Scene : public NodeOwner {
   thread_mutex mutex;
   bool scene_updated_while_loading_kernels = false;
 
+  /* wetmap: whether the device holds its kernels, for a device write made
+   * outside of the scene update. */
+  bool are_kernels_loaded() const
+  {
+    return kernels_loaded;
+  }
+
   /* scene update statistics */
   unique_ptr<SceneUpdateStats> update_stats;
 
diff --git a/src/session/session.cpp b/src/session/session.cpp
index 5108d1c9..cd35d20b 100644
--- a/src/session/session.cpp
+++ b/src/session/session.cpp
@@ -738,8 +738,10 @@ bool Session::update_scene(const bool reset_samples)
   }
 
   /* wetmap: a reset voids the accumulators; on the session thread, without
-   * a scene update of its own. */
-  if (reset_samples) {
+   * a scene update of its own, and never before the kernels are loaded - an
+   * interactive session loads them late, and the device has no module to
+   * bind a global to until then. The next device update zeroes them else. */
+  if (reset_samples && scene->are_kernels_loaded()) {
     scene->wet_manager->zero_device(&scene->dscene);
   }
 
