diff --git a/src/hydra/resources/cycles_builder.py b/src/hydra/resources/cycles_builder.py
index 490e53f3..291ae7b0 100644
--- a/src/hydra/resources/cycles_builder.py
+++ b/src/hydra/resources/cycles_builder.py
@@ -1,55 +1,52 @@
-"""Le Cycles Material Builder.
-
-Un builder n'est pas un type de nœud : c'est un `subnet` configuré, monté par
-un outil du menu tab. C'est ainsi que Houdini fabrique le Karma Material
-Builder et le USD MaterialX Builder — relevé dans
-`voptoolutils._setupMtlXBuilderSubnet`.
-
-Trois choses le rendent reconnaissable, et il en manquait à chaque fois une
-dans mes tentatives précédentes :
-
-* `setMaterialFlag(True)` — sans lui la Material Library ne voit pas un
-  matériau et n'exporte rien du tout ;
-* un unique `suboutput` à trois entrées nommées `surface`/`displacement`/
-  `volume`, dont le rôle exporté se déduit du connecteur du nœud branché sur
-  chacune — pas du nom qu'on lui donne. Cycles n'a qu'un seul type de
-  fermeture (un volume et un BSDF de surface sont tous deux `terminal` côté
-  Sdr), donc `tools/build_cycles_vops.py` ment sciemment sur les quelques
-  nœuds qui ne terminent jamais qu'un seul type de réseau — `displacement` et
-  `vector_displacement` prennent le connecteur `displacement`,
-  `principled_volume` et consorts prennent `atmosphere` — pour que Houdini
-  les distingue d'un BSDF de surface, ordinairement `surface`. Sans ce
-  mensonge ciblé, brancher l'un d'eux ici lève "Input data type does not
-  match output for input 'suboutput'" (vérifié) ;
-* un `tabmenumask`, qui restreint le menu tab aux nœuds Cycles pour que le
-  réseau ne se mélange pas avec ceux d'un autre moteur.
+"""The Cycles Material Builder.
+
+A builder is not a node type: it is a configured `subnet`, set up by a tab
+menu tool. That is how Houdini makes the Karma Material Builder and the USD
+MaterialX Builder - seen in `voptoolutils._setupMtlXBuilderSubnet`.
+
+Three things make it recognisable, and each earlier attempt missed one:
+
+* `setMaterialFlag(True)` - without it the Material Library does not see a
+  material and exports nothing at all;
+* a single `suboutput` with three inputs named `surface`/`displacement`/
+  `volume`, whose exported role follows from the connector of the node wired
+  into each - not from the name given to it. Cycles has a single closure
+  type (a volume and a surface BSDF are both `terminal` on the Sdr side), so
+  `tools/build_cycles_vops.py` knowingly lies about the few nodes that only
+  ever end one kind of network - `displacement` and `vector_displacement`
+  take the `displacement` connector, `principled_volume` and its kind take
+  `atmosphere` - so that Houdini tells them apart from a surface BSDF,
+  ordinarily `surface`. Without that targeted lie, wiring one of them here
+  raises "Input data type does not match output for input 'suboutput'"
+  (verified);
+* a `tabmenumask`, which restricts the tab menu to Cycles nodes so the
+  network does not mix with another engine's.
 """
 
 import hou
 
-# Le masque suit la construction de Houdini : le mot-clé du moteur, puis les
-# utilitaires et les nœuds de subnet dont tout réseau a besoin.
+# The mask follows Houdini's own: the engine's keyword, then the utilities
+# and the subnet nodes every network needs.
 UTILITY_NODES = "parameter constant collect null genericshader"
 SUBNET_NODES = "subnet subnetconnector suboutput subinput"
-# Le masque filtre par **motif de nom de type**. Un jeton comme "Cycles" ne
-# correspond à aucun type et ne filtre rien ; `cycles_*` prend nos cent nœuds et
-# rejette mécaniquement ceux de MaterialX et de Karma, qu'un graphe Cycles ne
-# doit pas contenir — un shader mêlant les deux ne rendrait qu'ici, et pas à
-# l'export vers Blender.
+# The mask filters by **type name pattern**. A token like "Cycles" matches no
+# type and filters nothing; `cycles_*` takes our hundred nodes and mechanically
+# rejects MaterialX's and Karma's, which a Cycles graph must not hold - a
+# shader mixing the two would render here only, not once exported to Blender.
 CYCLES_TAB_MASK = "cycles_* {} {}".format(UTILITY_NODES, SUBNET_NODES)
 
 RENDER_CONTEXT = "cycles"
 
-# Les trois sorties d'un matériau Cycles, comme dans Blender - un seul
-# `suboutput`, une entrée par terminal - plus les réglages du matériau, qui
-# n'en sont pas une : `properties` ne termine aucun réseau, Houdini replie les
-# paramètres du nœud branché là dans le prim Shader du terminal, préfixés
-# `cycles:`. C'est l'entrée qu'a aussi le builder de Karma.
+# The three outputs of a Cycles material, as in Blender - one `suboutput`, one
+# input per terminal - plus the material's settings, which are not one:
+# `properties` ends no network, Houdini folds the parameters of the node wired
+# there into the terminal's Shader prim, prefixed `cycles:`. Karma's builder
+# has the same input.
 TERMINALS = ("surface", "displacement", "volume", "properties")
 
 
 def _add_subnet_parms(subnet, folder_label):
-    """Le masque du menu tab et le contexte de rendu, dans un dossier repliable."""
+    """The tab menu mask and the render context, in a collapsible folder."""
     parms = subnet.parmTemplateGroup()
 
     mask = hou.properties.parmTemplate("op", "tabmenumask")
@@ -72,7 +69,7 @@ def _add_subnet_parms(subnet, folder_label):
 
 
 def setup(subnet, folder_label="Cycles Material Builder"):
-    """Configure un subnet déjà créé en builder Cycles."""
+    """Configure an already created subnet as a Cycles builder."""
     _add_subnet_parms(subnet, folder_label)
 
     inputs = subnet.node("subinput1")
@@ -93,20 +90,20 @@ def setup(subnet, folder_label="Cycles Material Builder"):
     for index, name in enumerate(TERMINALS):
         outputs.parm("name%d" % (index + 1)).set(name)
 
-    # Les réglages du matériau, posés d'emblée comme chez Karma : le nœud est
-    # inerte tant qu'aucune case n'est cochée, et le trouver déjà là vaut mieux
-    # que d'avoir à deviner qu'il existe.
+    # The material's settings, placed from the start as Karma does: the node
+    # is inert while no box is ticked, and finding it already there beats
+    # having to guess it exists.
     properties = subnet.createNode("cycles_material_properties", "material_properties")
     properties.setPosition(hou.Vector2(-0.2883, -3.8721))
     outputs.setInput(TERMINALS.index("properties"), properties, 0)
 
-    # Sans ce drapeau la Material Library ne reconnaît pas un matériau.
+    # Without this flag the Material Library does not recognise a material.
     subnet.setMaterialFlag(True)
     return subnet
 
 
 def create(kwargs, name="cyclesmaterial"):
-    """Point d'entrée de l'outil du menu tab."""
+    """Entry point of the tab menu tool."""
     import voptoolutils
     subnet = voptoolutils.genericTool(kwargs, "subnet", name)
     return setup(subnet)
