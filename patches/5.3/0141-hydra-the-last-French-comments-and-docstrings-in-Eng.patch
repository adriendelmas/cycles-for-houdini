-# oneAPI, Metal). La valeur vide laisse decider l'entree du menu des moteurs.
+# The strings `Device::type_from_string` accepts, plus "GPU", which the plugin
+# resolves to the first backend the machine offers (OptiX, CUDA, HIP, oneAPI,
+# Metal). The empty value lets the renderer menu entry decide.
 DEVICES = [
     ("", "Default (renderer entry)"),
     ("GPU", "GPU (best available)"),
@@ -48,20 +47,20 @@ DEVICES = [
 if sys.platform == "darwin":
     DEVICES.append(("METAL", "Metal"))
 
-# Rien ici ne verifie qu'un peripherique existe : c'est Cycles qui le fait, et
-# il retombe sur le CPU en le disant dans son log. Presenter une liste filtree
-# demanderait d'enumerer les peripheriques hors du process de rendu, ce que la
-# bibliotheque ne propose pas depuis Python.
+# Nothing here checks that a device exists: Cycles does, and falls back on the
+# CPU saying so in its log. Showing a filtered list would need the devices
+# enumerated outside the render process, which the library does not offer
+# from Python.
 
 
 def preference_file():
-    """Le fichier ou le choix survit a la fermeture d'Houdini."""
+    """The file where the choice survives Houdini being closed."""
     home = hou.text.expandString("$HOUDINI_USER_PREF_DIR")
