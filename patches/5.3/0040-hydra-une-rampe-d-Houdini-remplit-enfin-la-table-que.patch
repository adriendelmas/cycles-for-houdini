 #include <algorithm>
+#include <set>
 #include "hydra/material.h"
 
 #include "util/log.h"
@@ -1465,11 +1466,181 @@ void HdCyclesMaterial::Sync(HdSceneDelegate *sceneDelegate,
   *dirtyBits = DirtyBits::Clean;
 }
 
+/* Houdini n'ecrit pas une rampe comme un tableau. Il la decoupe en quatre
+ * parametres - un entier `<nom>` portant le nombre de cles, un `<nom>_keys` de
+ * positions, un `<nom>_values` de valeurs et un `<nom>_basis` d'interpolation -
+ * la ou Cycles attend une table plate a pas constant, celle que Blender remplit
+ * a RAMP_TABLE_SIZE entrees. Sans cette traduction, Color Ramp, RGB Curves et
+ * Vector Curves recoivent un tableau vide: leur compile() renonce des la
+ * premiere ligne et le noeud ne calcule rien du tout. */
+
+namespace {
+
+const TfToken kRampBasisConstant("constant", TfToken::Immortal);
+const TfToken kRampBasisCatmullRom("catmull-rom", TfToken::Immortal);
+
+/* Le segment de rampe qui contient t. Les cles sont croissantes. */
+int RampSegment(const VtFloatArray &keys, const float t)
+{
+  int lo = 0;
+  while (lo + 1 < int(keys.size()) - 1 && keys[lo + 1] <= t) {
+    lo++;
+  }
+  return lo;
+}
+
+template<typename Array, typename T>
+T SampleRamp(const Array &values, const VtFloatArray &keys, const TfToken &basis, const float t)
+{
+  const int last = int(values.size()) - 1;
+  if (last <= 0 || t <= keys[0]) {
+    return values[0];
+  }
+  if (t >= keys[last]) {
+    return values[last];
+  }
+
+  const int i = RampSegment(keys, t);
+  if (basis == kRampBasisConstant) {
+    return values[i];
+  }
+
+  const float span = keys[i + 1] - keys[i];
+  const float f = span > 0.0f ? (t - keys[i]) / span : 0.0f;
+  const T p1 = values[i];
+  const T p2 = values[i + 1];
+  if (basis != kRampBasisCatmullRom) {
+    return p1 + (p2 - p1) * f;
+  }
+
+  /* Catmull-Rom sur les quatre cles autour du segment, les extremites
+   * dupliquees aux bords faute de voisin. */
+  const T p0 = values[i > 0 ? i - 1 : i];
+  const T p3 = values[i + 2 <= last ? i + 2 : last];
+  const float f2 = f * f;
+  const float f3 = f2 * f;
+  return (p1 * 2.0f + (p2 - p0) * f + (p0 * 2.0f - p1 * 5.0f + p2 * 4.0f - p3) * f2 +
+          (p1 * 3.0f - p0 - p2 * 3.0f + p3) * f3) *
+         0.5f;
+}
+
+/* Reassemble les rampes que porte cette network et les pose sur le noeud.
+ * Les parametres consommes sont notes: les reecrire ensuite un a un ferait
+ * atterrir le compte de cles, un entier, sur le socket tableau lui-meme. */
+void BakeHoudiniRamps(ShaderNode *node,
+                      HdMaterialNodeParameterContainerSchema params,
+                      std::set<TfToken> &consumed)
+{
+  if (node == nullptr || node->type == nullptr) {
+    return;
+  }
+
+  auto valueOf = [&](const TfToken &name) -> VtValue {
+    const auto value = params.Get(name).GetValue();
+    return value ? value->GetValue(0.0f) : VtValue();
+  };
+
+  static const std::string suffix = "_values";
+  for (const TfToken &paramName : params.GetNames()) {
+    const std::string &full = paramName.GetString();
+    if (full.size() <= suffix.size() ||
+        full.compare(full.size() - suffix.size(), suffix.size(), suffix) != 0)
+    {
+      continue;
+    }
+
+    const std::string base = full.substr(0, full.size() - suffix.size());
+    const SocketType *socket = node->type->find_input(ustring(base));
+    if (socket == nullptr || !socket->is_array()) {
+      continue;
+    }
+
+    const TfToken keysName(base + "_keys");
+    const VtValue keysValue = valueOf(keysName);
+    if (!keysValue.IsHolding<VtFloatArray>()) {
+      continue;
+    }
+    const VtFloatArray keys = keysValue.UncheckedGet<VtFloatArray>();
+    if (keys.empty()) {
+      continue;
+    }
+
+    const TfToken basisName(base + "_basis");
+    const VtValue basisValue = valueOf(basisName);
+    TfToken basis;
+    if (basisValue.IsHolding<TfToken>()) {
+      basis = basisValue.UncheckedGet<TfToken>();
+    }
+    else if (basisValue.IsHolding<std::string>()) {
+      basis = TfToken(basisValue.UncheckedGet<std::string>());
+    }
+
+    const VtValue values = valueOf(paramName);
+    bool baked = false;
+
+    if (values.IsHolding<VtVec3fArray>()) {
+      const VtVec3fArray v = values.UncheckedGet<VtVec3fArray>();
+      if (!v.empty() && v.size() == keys.size()) {
+        array<packed_float3> table(RAMP_TABLE_SIZE);
+        for (int i = 0; i < RAMP_TABLE_SIZE; i++) {
+          const float t = float(i) / float(RAMP_TABLE_SIZE - 1);
+          const GfVec3f s = SampleRamp<VtVec3fArray, GfVec3f>(v, keys, basis, t);
+          table[i] = make_float3(s[0], s[1], s[2]);
+        }
+        node->set(*socket, table);
+        baked = true;
+      }
+    }
+    else if (values.IsHolding<VtFloatArray>()) {
+      const VtFloatArray v = values.UncheckedGet<VtFloatArray>();
+      if (!v.empty() && v.size() == keys.size()) {
+        array<float> table(RAMP_TABLE_SIZE);
+        for (int i = 0; i < RAMP_TABLE_SIZE; i++) {
+          const float t = float(i) / float(RAMP_TABLE_SIZE - 1);
+          table[i] = SampleRamp<VtFloatArray, float>(v, keys, basis, t);
+        }
+        node->set(*socket, table);
+        baked = true;
+      }
+    }
+
+    if (!baked) {
+      LOG_WARNING << "Ramp '" << base << "' on Cycles node '" << node->name.c_str()
+                  << "' has no usable keys; the node will not shade.";
+      continue;
+    }
+
+    consumed.insert(paramName);
+    consumed.insert(keysName);
+    consumed.insert(basisName);
+    consumed.insert(TfToken(base));
+
+    /* Cycles renonce a compiler une rampe dont le canal alpha n'a pas la meme
+     * taille, et la rampe d'Houdini n'en porte pas: opaque partout. */
+    const SocketType *alpha = node->type->find_input(ustring(base + "_alpha"));
+    if (alpha != nullptr && alpha->type == SocketType::FLOAT_ARRAY) {
+      array<float> opaque(RAMP_TABLE_SIZE);
+      for (int i = 0; i < RAMP_TABLE_SIZE; i++) {
+        opaque[i] = 1.0f;
+      }
+      node->set(*alpha, opaque);
+    }
+  }
+}
+
+}  // namespace
+
 void HdCyclesMaterial::UpdateParameters(NodeDesc &nodeDesc,
                                         HdMaterialNodeParameterContainerSchema params,
                                         const SdfPath &nodePath)
 {
+  std::set<TfToken> rampParams;
+  BakeHoudiniRamps(nodeDesc.node, params, rampParams);
+
   for (const TfToken &paramName : params.GetNames()) {
+    if (rampParams.find(paramName) != rampParams.end()) {
+      continue;
+    }
     auto valueDs = params.Get(paramName).GetValue();
     if (!valueDs) {
       continue;
