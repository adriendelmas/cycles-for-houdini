+    <output name="out" type="color3" nodename="based" />
+  </nodegraph>
+
+  <!-- standard_surface mixes its diffuse and its subsurface by `subsurface`,
+       each with its colour; the principled colours both with base_color. Both
+       colours are first raised to the coat gamma, 1 + coat * coat_affect_color
