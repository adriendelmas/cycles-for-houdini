+/* The base colour of the two surface models whose base is more than one
+ * colour. Cycles' principled colours its diffuse, its subsurface and its metal
+ * with one base colour; standard_surface and OpenPBR give the subsurface its
+ * own, standard_surface tints both by its coat (coat_affect_color), and
+ * OpenPBR darkens the base under its coat. A helper node - a nodegraph
+ * of mtlx_nodegraphs.h - computes the colour the principled should take from
+ * the surface's own inputs, and feeds its base_color; OpenPBR's base_weight,
+ * folded into it, is set to 1. Measured against Karma by
+ * tools/surface_audit.py: subsurface_color did nothing, coat_weight darkened
+ * five times less than it should. */
+bool FoldSurfaceBase(Network &net)
+{
+  struct Model {
+    const char *surface;
+    const char *helper;
+    std::vector<const char *> inputs;
+    bool weightFolded;
+  };
+  static const Model kModels[] = {
+      {"ND_open_pbr_surface_surfaceshader",
+       "ND_cycles_open_pbr_base",
+       {"base_weight",
+        "base_color",
+        "base_metalness",
+        "specular_weight",
+        "subsurface_weight",
+        "subsurface_color",
+        "coat_weight",
+        "coat_ior",
+        "coat_darkening"},
+       true},
+      {"ND_standard_surface_surfaceshader",
+       "ND_cycles_standard_surface_base",
+       {"base_color", "subsurface", "subsurface_color", "coat", "coat_affect_color"},
+       false},
+  };
+  static const TfToken kBaseColor("base_color"), kBaseWeight("base_weight");
+  bool any = false;
+  std::vector<TfToken> names;
+  for (const auto &[name, node] : net.nodes) {
+    names.push_back(name);
+  }
+  for (const TfToken &name : names) {
+    Node &surface = net.nodes[name];
+    const Model *model = nullptr;
+    for (const Model &m : kModels) {
+      if (surface.typeId.GetString().rfind(m.surface, 0) == 0) {
+        model = &m;
+      }
+    }
+    if (model == nullptr) {
+      continue;
+    }
+    Node helper;
+    helper.typeId = TfToken(model->helper);
+    for (const char *input : model->inputs) {
+      const TfToken in(input);
+      if (const auto c = surface.conns.find(in); c != surface.conns.end() && !c->second.empty()) {
+        helper.conns[in] = c->second;
+      }
+      else if (const auto v = surface.params.find(in); v != surface.params.end()) {
+        helper.params[in] = v->second;
+      }
+    }
+    const TfToken helperName(Prefix(name, "cycles_base"));
+    net.nodes[helperName] = std::move(helper);
+    surface.conns[kBaseColor] = {Conn{helperName, kOut}};
+    if (model->weightFolded) {
+      surface.conns.erase(kBaseWeight);
+      AddParams(surface, {{kBaseWeight, VtValue(1.0f)}});
+    }
+    any = true;
+  }
+  return any;
+}
+
