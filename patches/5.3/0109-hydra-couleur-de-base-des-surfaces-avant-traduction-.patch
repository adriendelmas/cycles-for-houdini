+      <input name="in2" type="float" nodename="gamma" />
+    </power>
+    <max name="sspos" type="color3">
+      <input name="in1" type="color3" interfacename="subsurface_color" />
+      <input name="in2" type="float" value="0" />
+    </max>
+    <power name="ssgamma" type="color3">
+      <input name="in1" type="color3" nodename="sspos" />
+      <input name="in2" type="float" nodename="gamma" />
+    </power>
+    <mix name="mixed" type="color3">
