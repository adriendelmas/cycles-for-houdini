+/* glTF by `alpha_mode`: 0 OPAQUE (the alpha unused), 1 MASK (1 where alpha
+ * >= alpha_cutoff, else 0), 2 BLEND (the alpha as is, MtlxGltfPbr). */
+UsdToCyclesMapping MakeMtlxGltfPbrAlpha(const int mode)
+{
+  UsdToCyclesMapping m = MakeMtlxGltfPbr();
+  m.setParameterName(TfToken("alpha_mode"), ustring(""));
+  if (mode == 0) {
+    m.setParameterName(TfToken("alpha"), ustring(""));
+    m.setParameterName(TfToken("alpha_cutoff"), ustring(""));
+  }
+  else if (mode == 1) {
+    m.setParameterName(TfToken("alpha"), ustring("cut:value1"));
+    m.setParameterName(TfToken("alpha_cutoff"), ustring("cut:value2"));
+    m.addHelper({"msk",
+                 "math",
+                 {{"Value", "Alpha"}},
+                 {{ustring("math_type"), "subtract"}, {ustring("value1"), "1"}}});
+    m.addHelper({"cut",
+                 "math",
+                 {{"Value", "msk:Value2"}},
+                 {{ustring("math_type"), "less_than"},
+                  {ustring("value1"), "1"},
+                  {ustring("value2"), "0.5"}}});
+  }
+  else {
+    m.setParameterName(TfToken("alpha_cutoff"), ustring(""));
+  }
+  return m;
+}
+const UsdToCyclesMapping MtlxGltfPbrOpaque = MakeMtlxGltfPbrAlpha(0);
+const UsdToCyclesMapping MtlxGltfPbrMask = MakeMtlxGltfPbrAlpha(1);
+const UsdToCyclesMapping MtlxGltfPbrBlend = MakeMtlxGltfPbrAlpha(2);
+
+/* The glTF mapping for a node's `alpha_mode`, OPAQUE when unwritten. */
+const UsdToCyclesMapping *MtlxGltfPbrFor(HdMaterialNodeSchema nodeSchema)
+{
+  const auto ds = nodeSchema.GetParameters().Get(TfToken("alpha_mode")).GetValue();
+  const VtValue value = ds ? ds->GetValue(0.0f) : VtValue();
+  int mode = 0;
+  if (value.IsHolding<int>()) {
+    mode = value.UncheckedGet<int>();
+  }
+  else if (value.CanCast<int>()) {
+    mode = VtValue::Cast<int>(value).UncheckedGet<int>();
+  }
+  return mode == 1 ? &MtlxGltfPbrMask : mode == 2 ? &MtlxGltfPbrBlend : &MtlxGltfPbrOpaque;
+}
