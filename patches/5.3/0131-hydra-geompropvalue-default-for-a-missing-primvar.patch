+namespace {
+
+std::map<const Shader *, std::vector<HdCyclesGeomPropDefault>> &GeomPropRegistry()
+{
+  static std::map<const Shader *, std::vector<HdCyclesGeomPropDefault>> registry;
+  return registry;
+}
+
+/* The non-zero defaults of the network's geompropvalue nodes. */
+std::vector<HdCyclesGeomPropDefault> CollectGeomPropDefaults(HdMaterialNetworkSchema network)
+{
+  std::vector<HdCyclesGeomPropDefault> result;
+  HdMaterialNodeContainerSchema nodes = network.GetNodes();
+  for (const TfToken &name : nodes.GetNames()) {
+    HdMaterialNodeSchema node = nodes.Get(name);
+    const auto idDs = node.GetNodeIdentifier();
+    if (!idDs || !idDs->GetTypedValue(0.0f).GetString().starts_with("ND_geompropvalue")) {
+      continue;
+    }
+    HdMaterialNodeParameterContainerSchema params = node.GetParameters();
+    const auto propDs = params.Get(TfToken("geomprop")).GetValue();
+    const auto defaultDs = params.Get(TfToken("default")).GetValue();
+    if (!propDs || !defaultDs) {
+      continue;
+    }
+    const VtValue prop = propDs->GetValue(0.0f);
+    HdCyclesGeomPropDefault d;
+    d.name = prop.IsHolding<TfToken>() ? prop.UncheckedGet<TfToken>().GetString() :
+             prop.IsHolding<std::string>() ? prop.UncheckedGet<std::string>() :
+                                             std::string();
+    const VtValue value = defaultDs->GetValue(0.0f);
+    if (value.IsHolding<float>()) {
+      d.components = 1;
+      d.value[0] = value.UncheckedGet<float>();
+    }
+    else if (value.IsHolding<int>()) {
+      d.components = 1;
+      d.value[0] = float(value.UncheckedGet<int>());
+    }
+    else if (value.IsHolding<GfVec2f>()) {
+      d.components = 2;
+      std::copy_n(value.UncheckedGet<GfVec2f>().data(), 2, d.value);
+    }
+    else if (value.IsHolding<GfVec3f>()) {
+      d.components = 3;
+      std::copy_n(value.UncheckedGet<GfVec3f>().data(), 3, d.value);
+    }
+    else if (value.IsHolding<GfVec4f>()) {
+      d.components = 4;
+      std::copy_n(value.UncheckedGet<GfVec4f>().data(), 4, d.value);
+    }
+    const bool zero = std::all_of(d.value, d.value + 4, [](float v) { return v == 0.0f; });
+    if (!d.name.empty() && d.components > 0 && !zero) {
+      result.push_back(std::move(d));
+    }
+  }
+  return result;
+}
+
+}  // namespace
+
+const std::vector<HdCyclesGeomPropDefault> &HdCyclesGeomPropDefaults(const Shader *shader)
+{
+  static const std::vector<HdCyclesGeomPropDefault> none;
+  const auto it = GeomPropRegistry().find(shader);
+  return it != GeomPropRegistry().end() ? it->second : none;
+}
+
 void HdCyclesMaterial::Sync(HdSceneDelegate *sceneDelegate,
                             HdRenderParam *renderParam,
                             HdDirtyBits *dirtyBits)
@@ -3579,6 +3653,15 @@ void HdCyclesMaterial::Sync(HdSceneDelegate *sceneDelegate,
       _shader->set_graph(std::move(graph));
       _shader->tag_update(lock.scene);
     }
+
+    if (_shader) {
+      if (network) {
+        GeomPropRegistry()[_shader] = CollectGeomPropDefaults(network);
+      }
+      else {
+        GeomPropRegistry().erase(_shader);
+      }
+    }
   }
 
   *dirtyBits = DirtyBits::Clean;
@@ -4741,6 +4824,7 @@ void HdCyclesMaterial::Finalize(HdRenderParam *renderParam)
   const bool keep_nodes = static_cast<const HdCyclesSession *>(renderParam)->keep_nodes;
 
   _nodes.clear();
+  GeomPropRegistry().erase(_shader);
 
   if (!keep_nodes) {
     lock.scene->delete_node(_shader);
