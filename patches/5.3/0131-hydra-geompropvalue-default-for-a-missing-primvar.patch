+++ b/src/hydra/geometry.inl
@@ -168,7 +168,8 @@ void HdCyclesGeometry<Base, CyclesBase>::Sync(HdSceneDelegate *sceneDelegate,
   }
 
   if (HdChangeTracker::IsTransformDirty(*dirtyBits, id) ||
-      HdChangeTracker::IsInstancerDirty(*dirtyBits, id))
+      HdChangeTracker::IsInstancerDirty(*dirtyBits, id) ||
+      (*dirtyBits & HdChangeTracker::DirtyMaterialId))
   {
     /* Per-instance primvars become object attributes, which an attribute
      * node reads when the geometry has none of that name; `displayColor`
@@ -213,6 +214,27 @@ void HdCyclesGeometry<Base, CyclesBase>::Sync(HdSceneDelegate *sceneDelegate,
           instance->set_alpha(v[0]);
         }
       }
+      /* The defaults of the materials' geompropvalue nodes (K-90), read
+       * where neither the geometry nor the instance has the primvar. */
+      for (const Node *node : _geom->get_used_shaders()) {
+        for (const HdCyclesGeomPropDefault &d :
+             HdCyclesGeomPropDefaults(static_cast<const Shader *>(node)))
+        {
+          const ustring name(d.name);
+          if (std::any_of(instance->attributes.begin(),
+                          instance->attributes.end(),
+                          [&](const ParamValue &p) { return p.name() == name; }))
+          {
+            continue;
+          }
+          const TypeDesc type = d.components == 1 ? TypeFloat :
+                                d.components == 2 ? TypeFloat2 :
+                                d.components == 3 ? TypeColor :
+                                                    TypeRGBA;
+          instance->attributes.emplace_back(d.name, type, 1, d.value);
+          attributesChanged = true;
+        }
+      }
     }
     if (attributesChanged) {
       /* Object attributes are packed with the geometry's. */
