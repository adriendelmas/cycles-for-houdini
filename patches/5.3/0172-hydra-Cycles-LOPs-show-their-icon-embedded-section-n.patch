From 701005804443f6cc5b3e002ebf25f5a1a9849d34 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Tue, 3 Nov 2026 17:48:40 +0100
Subject: [PATCH 172/180] hydra: Cycles LOPs show their icon - embedded section
 named IconImage.png

Houdini resolves an embedded icon only when the section name carries the
image's extension: IconImage was reported as an icon that does not exist.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/hydra/resources/CyclesTools.shelf         |   2 +-
 src/hydra/resources/otls/hdcycles_aovs.hda    | Bin 16095 -> 16073 bytes
 .../otls/hdcycles_render_settings.hda         | Bin 76677 -> 76643 bytes
 3 files changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/hydra/resources/CyclesTools.shelf b/src/hydra/resources/CyclesTools.shelf
index 2ebe6fa4..c35de88e 100644
--- a/src/hydra/resources/CyclesTools.shelf
+++ b/src/hydra/resources/CyclesTools.shelf
@@ -13,7 +13,7 @@ cycles_builder.create(kwargs)
       <keyword>Cycles</keyword>
     </keywordList>
   </tool>
-  <tool name="lop_cycles_setup" label="Cycles (Setup)" icon="opdef:/hdcycles::Lop/cycles_render_settings::1.0?IconImage">
+  <tool name="lop_cycles_setup" label="Cycles (Setup)" icon="opdef:/hdcycles::Lop/cycles_render_settings::1.0?IconImage.png">
     <helpText><![CDATA[Cycles Render Settings, a Render Pass on its settings and a USD Render ROP on Cycles GPU, as Karma (Setup) does for Karma.]]></helpText>
     <toolMenuContext name="viewer">
       <contextNetType>LOP</contextNetType>
