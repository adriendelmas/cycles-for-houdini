From fd65ce54f83e1302d306fbe127161fcf9058ac8c Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Mon, 31 Aug 2026 19:54:57 +0200
Subject: [PATCH 16/39] hydra: tag a light's object for update, and keep
 unresolvable asset paths

Moving or rotating a light modified its object's transform but nothing tagged
that object, and Scene::need_data_update() looks at the managers rather than at
individual nodes - so the scene never asked for an update and the render kept
showing the light where it used to be. Only the light node itself was tagged,
which is why changing intensity did come through. Geometry rprims tag their
objects unconditionally for exactly this reason.

Also fall back to the authored asset path when the resolver returns nothing,
the way volume fields and light textures already do. Returning the empty string
turned an unresolvable texture into a silently missing one, with no hint of
which path had failed.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/hydra/light.cpp     | 8 ++++++++
 src/hydra/node_util.cpp | 7 ++++++-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/hydra/light.cpp b/src/hydra/light.cpp
index 1457e775..ef0cce2e 100644
--- a/src/hydra/light.cpp
+++ b/src/hydra/light.cpp
@@ -185,6 +185,14 @@ void HdCyclesLight::Sync(HdSceneDelegate *sceneDelegate,
     _light->tag_update(lock.scene);
   }
 
+  /* The light's object carries its transform, and Scene::need_data_update()
+   * looks at the managers rather than at individual nodes - so without tagging
+   * it here, moving or rotating a light modified the object but never asked
+   * for a scene update, and the render kept showing the light where it used to
+   * be. Geometry rprims tag their objects unconditionally for the same
+   * reason. */
+  _object->tag_update(lock.scene);
+
   *dirtyBits = DirtyBits::Clean;
 }
 
diff --git a/src/hydra/node_util.cpp b/src/hydra/node_util.cpp
index e609d102..05b5b8c8 100644
--- a/src/hydra/node_util.cpp
+++ b/src/hydra/node_util.cpp
@@ -74,7 +74,12 @@ template<> ustring convertToCycles<ustring>(const VtValue &value)
   }
   if (value.IsHolding<SdfAssetPath>()) {
     const SdfAssetPath &path = value.UncheckedGet<SdfAssetPath>();
-    return ustring(path.GetResolvedPath());
+    /* Fall back to the authored path when the resolver produced nothing, the
+     * way volume fields and light textures already do. Returning the empty
+     * string instead turns an unresolvable texture into a silently missing
+     * one, with no hint of which path failed. */
+    const std::string &resolved = path.GetResolvedPath();
+    return ustring(resolved.empty() ? path.GetAssetPath() : resolved);
   }
 
   if (value.CanCast<TfToken>()) {
