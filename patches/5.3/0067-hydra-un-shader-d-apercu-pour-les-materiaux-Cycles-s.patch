From 960037f8115acfff2e2f9f324f2b34e9f42a0e2d Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Wed, 9 Sep 2026 17:24:54 +0200
Subject: [PATCH 67/77] hydra: un shader d'apercu pour les materiaux Cycles,
 sinon le viewport reste gris
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Le viewport de Houdini ne rend que du MaterialX, qu'il compile lui-meme, et de
l'`UsdPreviewSurface`. Un materiau Cycles n'etant ni l'un ni l'autre, il
ressortait gris - ni couleur, ni texture, ni rugosite, ni normale.

Solaris prevoit pourtant le pont : a cote du shader propre au moteur, il ecrit
un `UsdPreviewSurface` construit par un « preview shader translator ». Celui
d'origine lit des etiquettes `ogl_*` posees sur les parametres du VOP ; nos
noeuds sont engendres depuis le registre Sdr et n'en portent aucune, donc
`usdPreviewShaderInputInfos()` rendait une liste vide et
`createAndConnectUsdTerminalPreviewShader()` renoncait sans un mot. Les scenes
de banc en gardent la trace : `HoudiniHasAutoPreviewShader = 1` est bien pose
sur le shader, et aucun prim `UsdPreviewSurface` n'a jamais ete ecrit.

Plutot que de tatouer des centaines de parametres engendres, on lit le graphe
Cycles lui-meme : `base_color` est la couleur diffuse, et si elle est branchee
a un `cycles_image_texture`, on sait aussi quel fichier lire. C'est la methode
du traducteur MaterialX de SideFX, tenue un cran plus loin puisqu'on remonte
aussi a travers un `normal_map`, un `bump` ou une poignee de noeuds de
retouche, et qu'on va chercher le displacement la ou il pend vraiment - sur
`outputs:cycles:displacement`, pas sur le shader de surface.

Verifie en batch sur un materiau a quatre textures : l'apercu porte
`diffuseColor`, `roughness`, `normal` (en `raw`, echelle 2 biais -1) et
`displacement` (biais recentre sur le `midlevel` du noeud), chacun relie a son
`UsdUVTexture` et a un lecteur de primvar `st`.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 .../husdplugins/shadertranslators/cycles.py   | 326 ++++++++++++++++++
 1 file changed, 326 insertions(+)

diff --git a/src/hydra/resources/husdplugins/shadertranslators/cycles.py b/src/hydra/resources/husdplugins/shadertranslators/cycles.py
index f8a2d6e9..09115ba8 100644
--- a/src/hydra/resources/husdplugins/shadertranslators/cycles.py
+++ b/src/hydra/resources/husdplugins/shadertranslators/cycles.py
@@ -116,3 +116,329 @@ _translator = CyclesShaderTranslator()
 
 def usdShaderTranslator():
     return _translator
+
+
+# ---------------------------------------------------------------------------
+# Le shader d'apercu, pour le viewport
+# ---------------------------------------------------------------------------
+#
+# Le viewport de Houdini ne sait pas rendre un graphe Cycles : il rend du
+# MaterialX, qu'il compile lui-meme, et de l'`UsdPreviewSurface`. Un materiau
+# Cycles n'etant ni l'un ni l'autre, il ressortait gris - pas de couleur, pas de
+# texture, pas de rugosite, pas de normale.
+#
+# Solaris prevoit pourtant le pont : a cote du shader propre au moteur, il
+# ecrit un `UsdPreviewSurface` construit par un « preview shader translator ».
+# Celui d'origine lit des etiquettes `ogl_*` posees sur les parametres du VOP ;
+# nos noeuds sont engendres depuis le registre Sdr et n'en portent aucune, donc
+# `usdPreviewShaderInputInfos()` rendait une liste vide et
+# `createAndConnectUsdTerminalPreviewShader()` renoncait sans un mot. Les scenes
+# de banc le montrent : `HoudiniHasAutoPreviewShader = 1` est bien pose sur le
+# shader, mais aucun prim `UsdPreviewSurface` n'a jamais ete ecrit.
+#
+# Plutot que de tatouer des centaines de parametres engendres, on lit le graphe
+# Cycles lui-meme, qui dit la meme chose en plus sur : `base_color` est la
+# couleur diffuse, et si elle est branchee a un `cycles_image_texture`, on sait
+# aussi quel fichier lire. C'est la methode du traducteur MaterialX de SideFX
+# (`MaterialXPreviewShaderTranslatorHelper`), tenue un cran plus loin puisqu'on
+# remonte aussi a travers un `normal_map` ou un `bump`.
+
+from husd.previewshadertranslator import PreviewShaderTranslator as PreviewTranslatorBase
+from husd.previewshadertranslator import PreviewShaderTranslatorHelper as PreviewHelperBase
+from husd.previewshadertranslator import UsdShaderInputInfo
+
+# Ce que chaque terminal Cycles sait dire d'un UsdPreviewSurface. La cle est
+# l'entree du preview, la valeur le socket Cycles a lire.
+SURFACE_INPUTS = {
+    "cycles_principled_bsdf": {
+        "diffuseColor": "base_color",
+        "metallic": "metallic",
+        "roughness": "roughness",
+        "ior": "ior",
+        "opacity": "alpha",
+        "emissiveColor": "emission_color",
+        "clearcoat": "coat_weight",
+        "clearcoatRoughness": "coat_roughness",
+        "normal": "normal",
+    },
+    "cycles_diffuse_bsdf": {
+        "diffuseColor": "color",
+        "roughness": "roughness",
+        "normal": "normal",
+    },
+    "cycles_glossy_bsdf": {
+        "diffuseColor": "color",
+        "roughness": "roughness",
+        "normal": "normal",
+    },
+    "cycles_metallic_bsdf": {
+        "diffuseColor": "base_color",
+        "roughness": "roughness",
+        "normal": "normal",
+    },
+    "cycles_glass_bsdf": {
+        "diffuseColor": "color",
+        "roughness": "roughness",
+        "ior": "IOR",
+        "normal": "normal",
+    },
+    "cycles_refraction_bsdf": {
+        "diffuseColor": "color",
+        "roughness": "roughness",
+        "ior": "IOR",
+        "normal": "normal",
+    },
+    "cycles_toon_bsdf": {"diffuseColor": "color", "normal": "normal"},
+    "cycles_velvet_bsdf": {"diffuseColor": "color", "normal": "normal"},
+    "cycles_sheen_bsdf": {"diffuseColor": "color", "roughness": "roughness",
+                          "normal": "normal"},
+    "cycles_translucent_bsdf": {"diffuseColor": "color", "normal": "normal"},
+    "cycles_transparent_bsdf": {"diffuseColor": "color"},
+    "cycles_subsurface_scattering": {"diffuseColor": "color", "normal": "normal"},
+    "cycles_emission": {"emissiveColor": "color"},
+    "cycles_principled_hair_bsdf": {"diffuseColor": "color", "roughness": "roughness"},
+}
+
+# Ce que vaut une entree que personne n'a touchee. Houdini n'ecrit en USD que
+# les parametres modifies, et les defauts de Cycles ne sont pas ceux de
+# l'UsdPreviewSurface - une base_color laissee telle quelle vaut 0,8 chez
+# Cycles contre 0,18 pour l'apercu, soit un materiau notablement plus sombre
+# dans le viewport que dans le rendu.
+DEFAULT_VALUES = {
+    "diffuseColor": (0.8, 0.8, 0.8),
+    "roughness": 0.5,
+    "metallic": 0.0,
+    "ior": 1.5,
+    "opacity": 1.0,
+}
+
+# Les metaux sont metalliques, et rien dans le graphe ne le dit autrement.
+FIXED_INPUTS = {
+    "cycles_metallic_bsdf": {"metallic": 1.0},
+    "cycles_glossy_bsdf": {"metallic": 1.0},
+}
+
+# Ce qui, branche sur une entree, porte en fait une image un cran plus loin.
+# La valeur est le socket a suivre.
+IMAGE_RELAYS = {
+    "cycles_normal_map": "color",
+    "cycles_bump": "height",
+    "cycles_displacement": "height",
+    "cycles_gamma": "color",
+    "cycles_brightness_contrast": "color",
+    "cycles_invert": "color",
+    "cycles_hsv": "color",
+    "cycles_rgb_curves": "value",
+    "cycles_vector_curves": "value",
+    "cycles_map_range": "value",
+    "cycles_clamp": "value",
+    "cycles_math": "value1",
+    "cycles_mix_color": "color1",
+    "cycles_mix_float": "a",
+    "cycles_separate_color": "color",
+}
+
+IMAGE_NODES = (
+    "cycles_image_texture",
+    "cycles_environment_texture",
+    "cycles_mx_hextiled_image_texture",
+)
+
+# Cycles nomme le bouclage comme USD, a « periodic » pres.
+WRAP_MODES = {
+    "periodic": "repeat",
+    "clamp": "clamp",
+    "black": "black",
+    "mirror": "mirror",
+}
+
+
+def _connected_shader(usd_input):
+    """Le shader branche sur cette entree, s'il y en a un."""
+    if not usd_input:
+        return None
+    return shaderutils.usdFirstConnectedShader(usd_input)
+
+
+def _shader_id(usd_shader):
+    return usd_shader.GetShaderId() if usd_shader else ""
+
+
+def _find_image(usd_shader, depth=0):
+    """L'image au bout de la chaine, en traversant ce qui se traverse.
+
+    Une couleur de base branchee directement sur une texture est le cas
+    courant ; une normale passe presque toujours par un `normal_map`, et une
+    hauteur par un `bump`. S'arreter au premier noeud rendrait le viewport muet
+    dans les deux cas les plus utiles.
+    """
+    if usd_shader is None or depth > 4:
+        return None
+    shader_id = _shader_id(usd_shader)
+    if shader_id in IMAGE_NODES:
+        return usd_shader
+    relay = IMAGE_RELAYS.get(shader_id)
+    if relay is None:
+        return None
+    return _find_image(_connected_shader(usd_shader.GetInput(relay)), depth + 1)
+
+
+def _as_text(value):
+    """Le nom de fichier, qu'il arrive en chaine ou en asset."""
+    if value is None:
+        return None
+    path = getattr(value, "path", None)
+    if path:
+        return path
+    text = str(value)
+    return text or None
+
+
+def _fill_texture(info, usd_image, time_code):
+    """Reporte sur l'apercu ce que la texture Cycles sait d'elle-meme."""
+    filename = _as_text(_input_value(usd_image, "filename", time_code))
+    if not filename:
+        return False
+
+    info.myTexFile = filename
+    # Cycles ne multiplie pas la texture par la valeur du parametre qu'elle
+    # remplace ; l'apercu ne doit pas le faire non plus.
+    info.myTexAutoScaleFlag = False
+
+    extension = _input_value(usd_image, "extension", time_code)
+    if extension is not None:
+        wrap = WRAP_MODES.get(str(extension))
+        if wrap:
+            info.myTexWrapS = wrap
+            info.myTexWrapT = wrap
+
+    if info.myTexColorSpace is None:
+        colorspace = _input_value(usd_image, "colorspace", time_code)
+        if colorspace is not None:
+            text = str(colorspace).lower()
+            if text in ("raw", "non-color", "data"):
+                info.myTexColorSpace = "raw"
+            elif "srgb" in text:
+                info.myTexColorSpace = "sRGB"
+    return True
+
+
+def _input_value(usd_shader, name, time_code):
+    if usd_shader is None:
+        return None
+    usd_input = usd_shader.GetInput(name)
+    if not usd_input:
+        return None
+    return usd_input.Get(time_code)
+
+
+class CyclesPreviewShaderTranslatorHelper(PreviewHelperBase):
+    """Construit l'UsdPreviewSurface a partir du graphe Cycles.
+
+    La classe mere appelle ce crochet pour chaque entree du preview, avec
+    l'`info` qu'elle a su tirer des etiquettes `ogl_*` - donc toujours `None`
+    chez nous. On la fabrique alors depuis le shader Cycles lui-meme.
+    """
+
+    def __init__(self, usd_stage, usd_material_path, usd_time_code):
+        PreviewHelperBase.__init__(self, usd_stage, usd_material_path, usd_time_code)
+
+    def usdPreviewShaderInputInfo(self, usd_main_shader,
+                                  preview_input_name, preview_input_type, info):
+        if info is not None:
+            return info
+
+        if preview_input_name == "displacement":
+            return self._displacementInfo(preview_input_name, preview_input_type)
+
+        shader_id = _shader_id(usd_main_shader)
+        fixed = FIXED_INPUTS.get(shader_id, {})
+        if preview_input_name in fixed:
+            return UsdShaderInputInfo(None, preview_input_type, preview_input_name,
+                                      value=fixed[preview_input_name])
+
+        socket = SURFACE_INPUTS.get(shader_id, {}).get(preview_input_name)
+        if socket is None:
+            return None
+
+        usd_input = usd_main_shader.GetInput(socket)
+
+        value = None
+        if usd_input and preview_input_name != "normal":
+            value = usd_input.Get(self.myUsdTimeCode)
+        if value is None and preview_input_name != "normal":
+            value = DEFAULT_VALUES.get(preview_input_name)
+        if preview_input_name == "emissiveColor" and value is not None:
+            # Une couleur d'emission blanche a force zero ne s'allume pas.
+            strength = _input_value(usd_main_shader, "emission_strength", self.myUsdTimeCode)
+            if strength is None:
+                strength = 0.0
+            value = tuple(component * strength for component in value)
+
+        info = UsdShaderInputInfo(socket, preview_input_type, preview_input_name, value=value)
+        if preview_input_name == "normal":
+            # Une carte de normales se lit crue et s'etale de [0,1] a [-1,1].
+            info.myTexScale = (2, 2, 2, 1)
+            info.myTexOffset = (-1, -1, -1, 0)
+            info.myTexColorSpace = "raw"
+
+        usd_image = _find_image(_connected_shader(usd_input)) if usd_input else None
+        if usd_image is not None:
+            _fill_texture(info, usd_image, self.myUsdTimeCode)
+        elif value is None:
+            return None
+        return info
+
+    def _displacementInfo(self, preview_input_name, preview_input_type):
+        """Le displacement ne pend pas au shader de surface mais au materiau.
+
+        Cycles lui donne sa propre sortie - `outputs:cycles:displacement` -, et
+        c'est de la que le viewport doit tirer sa hauteur.
+        """
+        material = self.myUsdMaterial
+        if not material:
+            return None
+        output = material.GetOutput("cycles:displacement")
+        if not output:
+            return None
+        source = shaderutils.usdFirstConnectedShader(output)
+        if source is None:
+            return None
+
+        height = source.GetInput("height")
+        usd_image = _find_image(_connected_shader(height) or source)
+        if usd_image is None:
+            return None
+
+        info = UsdShaderInputInfo(None, preview_input_type, preview_input_name, value=0.0)
+        if not _fill_texture(info, usd_image, self.myUsdTimeCode):
+            return None
+        info.myTexColorSpace = "raw"
+
+        # `height` est recentre sur `midlevel` puis mis a l'echelle, comme le
+        # fait le noeud displacement de Cycles.
+        scale = _input_value(source, "scale", self.myUsdTimeCode)
+        midlevel = _input_value(source, "midlevel", self.myUsdTimeCode)
+        scale = 1.0 if scale is None else float(scale)
+        midlevel = 0.5 if midlevel is None else float(midlevel)
+        info.myTexScale = (scale, scale, scale, 1)
+        info.myTexOffset = (-midlevel * scale, -midlevel * scale, -midlevel * scale, 0)
+        return info
+
+
+class CyclesPreviewShaderTranslator(PreviewTranslatorBase):
+    def __init__(self):
+        PreviewTranslatorBase.__init__(self)
+
+    def matchesRenderContext(self, render_context):
+        return render_context == RENDER_MASK
+
+    def previewShaderTranslatorHelper(self, usd_stage, usd_material_path, usd_time_code):
+        return CyclesPreviewShaderTranslatorHelper(usd_stage, usd_material_path, usd_time_code)
+
+
+_preview_translator = CyclesPreviewShaderTranslator()
+
+
+def usdPreviewShaderTranslator():
+    return _preview_translator
