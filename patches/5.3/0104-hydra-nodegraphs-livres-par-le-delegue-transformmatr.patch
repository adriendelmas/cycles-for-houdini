 }
 
+/* A matrix value, whatever precision Hydra carries it in, as rows of
+ * doubles; false when the value is not a matrix of that size. */
+bool MatrixRows(const VtValue &value, const int size, double rows[4][4])
+{
+  if (size == 3 && (value.IsHolding<GfMatrix3d>() || value.IsHolding<GfMatrix3f>())) {
+    const GfMatrix3d m = value.IsHolding<GfMatrix3d>() ?
+                             value.UncheckedGet<GfMatrix3d>() :
+                             GfMatrix3d(value.UncheckedGet<GfMatrix3f>());
+    for (int r = 0; r < 3; ++r) {
+      for (int c = 0; c < 3; ++c) {
+        rows[r][c] = m[r][c];
+      }
+    }
+    return true;
+  }
+  if (size == 4 && (value.IsHolding<GfMatrix4d>() || value.IsHolding<GfMatrix4f>())) {
+    const GfMatrix4d m = value.IsHolding<GfMatrix4d>() ?
+                             value.UncheckedGet<GfMatrix4d>() :
+                             GfMatrix4d(value.UncheckedGet<GfMatrix4f>());
+    for (int r = 0; r < 4; ++r) {
+      for (int c = 0; c < 4; ++c) {
+        rows[r][c] = m[r][c];
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+/* `transformmatrix` with a constant matrix: Cycles has no matrix type, but a
+ * constant matrix is only coefficients. MaterialX multiplies a row vector on
+ * the left, as USD does (stdlib/genglsl/lib/mx_math.glsl builds the GLSL
+ * matrix from the values column by column, then `m * v`), so
+ * out[i] = sum_j in[j] * M[j][i] - a dot product of the input with column i,
+ * plus the last row's term when the input was extended by a 1 (vector3 by a
+ * 4x4, vector2 by a 3x3). One dotproduct per output component, and a combine.
+ * `hmtlxcomplementcolor` converts to XYZ and back this way. A connected
+ * matrix (creatematrix, invertmatrix...) has nothing constant to read and is
+ * left alone; so is vector4, whose fourth channel the delegate drops (K-17). */
+bool ExpandTransformMatrix(Network &net,
+                           const TfToken &name,
+                           const Node &outer,
+                           const mx::NodeDefPtr &nodeDef)
+{
+  const mx::InputPtr inDef = nodeDef->getActiveInput("in");
+  const mx::InputPtr matDef = nodeDef->getActiveInput("mat");
+  if (!inDef || !matDef || outer.conns.count(TfToken("mat"))) {
+    return false;
+  }
+  const std::string inType = inDef->getType();
+  const int dim = inType == "vector2" ? 2 : inType == "vector3" ? 3 : 0;
+  const int size = matDef->getType() == "matrix33" ? 3 : matDef->getType() == "matrix44" ? 4 : 0;
+  if (dim == 0 || size == 0 || dim > size) {
+    return false;
+  }
+  const auto p = outer.params.find(TfToken("mat"));
+  const VtValue matValue = p != outer.params.end() ? p->second :
+                                                      MxValue(matDef->getType(),
+                                                              matDef->getValueString());
+  double m[4][4] = {};
+  if (!MatrixRows(matValue, size, m)) {
+    return false;
+  }
+  /* The input extended by a 1 brings in the row past its last component. */
+  const bool affine = size > dim;
+
+  const std::string dotNodedef = inType == "vector2" ? "ND_dotproduct_vector2" :
+                                                       "ND_dotproduct_vector3";
+  Node combine;
+  combine.typeId = TfToken(CombineNodedef(inType));
+  for (int i = 0; i < dim; ++i) {
+    Node dot;
+    dot.typeId = TfToken(dotNodedef);
+    BindInterface(dot, TfToken("in1"), outer, TfToken("in"), nodeDef, name, net.nodes);
+    if (dim == 2) {
+      dot.params[TfToken("in2")] = VtValue(GfVec2f(float(m[0][i]), float(m[1][i])));
+    }
+    else {
+      dot.params[TfToken("in2")] = VtValue(
+          GfVec3f(float(m[0][i]), float(m[1][i]), float(m[2][i])));
+    }
+    const TfToken dotName(Prefix(name, "dot" + std::to_string(i)));
+    net.nodes[dotName] = std::move(dot);
+    const TfToken input("in" + std::to_string(i + 1));
+    if (affine && m[dim][i] != 0.0) {
+      Node add;
+      add.typeId = TfToken("ND_add_float");
+      add.conns[TfToken("in1")] = {Conn{dotName, kOut}};
+      add.params[TfToken("in2")] = VtValue(float(m[dim][i]));
+      const TfToken addName(Prefix(name, "offset" + std::to_string(i)));
+      net.nodes[addName] = std::move(add);
+      combine.conns[input] = {Conn{addName, kOut}};
+    }
+    else {
+      combine.conns[input] = {Conn{dotName, kOut}};
+    }
+  }
+  const TfToken combineName(Prefix(name, "combine"));
+  net.nodes[combineName] = std::move(combine);
+  Redirect(net, name, {{kOut.GetString(), Conn{combineName, kOut}}});
+  net.nodes.erase(name);
+  LOG_INFO << "MaterialX: '" << outer.typeId.GetString() << "' at " << name.GetString()
+           << " expanded into dot products with its constant matrix.";
+  return true;
+}
+
 }  // namespace
 
