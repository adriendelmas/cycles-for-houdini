+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Nodegraphs the delegate adds to the MaterialX library it expands from.
+ *
+ * Some nodedefs of the library have no nodegraph - their implementations are
+ * GLSL and OSL functions - and nothing in the mapping table: Karma renders
+ * them, the delegate dropped them. Most are a few lines of arithmetic, and
+ * written here as nodegraphs of stdlib nodes the table does translate, they
+ * go through the same expansion as `switch` or `ramp4` (mtlx_expand.cpp).
+ * Each one transcribes the library's own GLSL, named above it, line for line.
+ *
+ * Kept as XML so that tools/mtlx_rules.py reads the same text (between the
+ * raw-string markers) and counts these nodedefs as expanded. */
+
+static const char *const kCyclesMaterialXNodegraphs = R"MTLX(<?xml version="1.0"?>
+<materialx version="1.39">
+
+  <!-- pbrlib/genglsl/mx_roughness_anisotropy.glsl. The anisotropic branch
+       also covers anisotropy <= 0, where the aspect is 1 and both components
+       are roughness squared. -->
+  <nodegraph name="NG_cycles_roughness_anisotropy" nodedef="ND_roughness_anisotropy">
+    <multiply name="rr" type="float">
+      <input name="in1" type="float" interfacename="roughness" />
+      <input name="in2" type="float" interfacename="roughness" />
+    </multiply>
+    <clamp name="rsq" type="float">
+      <input name="in" type="float" nodename="rr" />
+      <input name="low" type="float" value="0.00000001" />
+      <input name="high" type="float" value="1" />
+    </clamp>
+    <clamp name="aniso" type="float">
+      <input name="in" type="float" interfacename="anisotropy" />
+      <input name="low" type="float" value="0" />
+      <input name="high" type="float" value="0.98" />
+    </clamp>
+    <subtract name="oneminus" type="float">
+      <input name="in1" type="float" value="1" />
+      <input name="in2" type="float" nodename="aniso" />
+    </subtract>
+    <sqrt name="aspect" type="float">
+      <input name="in" type="float" nodename="oneminus" />
+    </sqrt>
+    <divide name="xwide" type="float">
+      <input name="in1" type="float" nodename="rsq" />
+      <input name="in2" type="float" nodename="aspect" />
+    </divide>
+    <min name="x" type="float">
+      <input name="in1" type="float" nodename="xwide" />
+      <input name="in2" type="float" value="1" />
+    </min>
+    <multiply name="y" type="float">
+      <input name="in1" type="float" nodename="rsq" />
+      <input name="in2" type="float" nodename="aspect" />
+    </multiply>
+    <combine2 name="xy" type="vector2">
+      <input name="in1" type="float" nodename="x" />
+      <input name="in2" type="float" nodename="y" />
+    </combine2>
+    <output name="out" type="vector2" nodename="xy" />
+  </nodegraph>
+
+  <!-- pbrlib/genglsl/mx_roughness_dual.glsl: a negative y takes x. -->
+  <nodegraph name="NG_cycles_roughness_dual" nodedef="ND_roughness_dual">
+    <separate2 name="split" type="multioutput">
+      <input name="in" type="vector2" interfacename="roughness" />
+    </separate2>
+    <ifgreatereq name="ry" type="float">
+      <input name="value1" type="float" nodename="split" output="outy" />
+      <input name="value2" type="float" value="0" />
+      <input name="in1" type="float" nodename="split" output="outy" />
+      <input name="in2" type="float" nodename="split" output="outx" />
+    </ifgreatereq>
+    <multiply name="xx" type="float">
+      <input name="in1" type="float" nodename="split" output="outx" />
+      <input name="in2" type="float" nodename="split" output="outx" />
+    </multiply>
+    <multiply name="yy" type="float">
+      <input name="in1" type="float" nodename="ry" />
+      <input name="in2" type="float" nodename="ry" />
+    </multiply>
+    <clamp name="x" type="float">
+      <input name="in" type="float" nodename="xx" />
+      <input name="low" type="float" value="0.00000001" />
+      <input name="high" type="float" value="1" />
+    </clamp>
+    <clamp name="y" type="float">
+      <input name="in" type="float" nodename="yy" />
+      <input name="low" type="float" value="0.00000001" />
+      <input name="high" type="float" value="1" />
+    </clamp>
+    <combine2 name="xy" type="vector2">
+      <input name="in1" type="float" nodename="x" />
+      <input name="in2" type="float" nodename="y" />
+    </combine2>
+    <output name="out" type="vector2" nodename="xy" />
+  </nodegraph>
+
+  <!-- pbrlib/genglsl/mx_artistic_ior.glsl - Gulbrandsen, "Artist Friendly
+       Metallic Fresnel", 2014: reflectivity and edge colour to a complex
+       index of refraction, per channel. -->
+  <nodegraph name="NG_cycles_artistic_ior" nodedef="ND_artistic_ior">
+    <clamp name="r" type="color3">
+      <input name="in" type="color3" interfacename="reflectivity" />
+      <input name="low" type="float" value="0" />
+      <input name="high" type="float" value="0.99" />
+    </clamp>
+    <!-- stdlib has no colour sqrt: a power of one half. -->
+    <power name="rsqrt" type="color3">
+      <input name="in1" type="color3" nodename="r" />
+      <input name="in2" type="float" value="0.5" />
+    </power>
+    <subtract name="oneminusr" type="color3">
+      <input name="in1" type="color3" value="1, 1, 1" />
+      <input name="in2" type="color3" nodename="r" />
+    </subtract>
+    <add name="oneplusr" type="color3">
+      <input name="in1" type="color3" value="1, 1, 1" />
+      <input name="in2" type="color3" nodename="r" />
+    </add>
+    <divide name="nmin" type="color3">
+      <input name="in1" type="color3" nodename="oneminusr" />
+      <input name="in2" type="color3" nodename="oneplusr" />
+    </divide>
+    <add name="oneplusrs" type="color3">
+      <input name="in1" type="color3" value="1, 1, 1" />
+      <input name="in2" type="color3" nodename="rsqrt" />
