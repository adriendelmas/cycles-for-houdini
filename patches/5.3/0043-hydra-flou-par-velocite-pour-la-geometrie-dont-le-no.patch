-std::vector<VtVec3fArray> SampleDeformingPoints(const HdSampledDataSourceHandle &pointsDs,
+/* Les positions au temps demande, extrapolees d'un champ de vitesses.
+ *
+ * Les velocites d'USD sont en unites par seconde, l'obturateur en images :
+ * c'est la cadence qui fait le pont. Les accelerations, si elles sont ecrites,
+ * courbent la trajectoire au second ordre - un projectile floute alors le long
+ * de son arc et non de sa corde. */
+static std::vector<VtVec3fArray> SampleFromVelocities(const HdPrimvarsSchema &primvars,
+                                                      const HdSampledDataSourceHandle &pointsDs,
+                                                      const float shutterOpen,
+                                                      const float shutterClose,
+                                                      const int steps,
+                                                      const size_t minPoints,
+                                                      const double timeCodesPerSecond)
+{
+  const VtValue velValue = ReadPrimvar(primvars, HdTokens->velocities);
+  if (!velValue.IsHolding<VtVec3fArray>()) {
+    return {};
+  }
+  const VtVec3fArray velocities = velValue.UncheckedGet<VtVec3fArray>();
+  if (velocities.size() < minPoints || minPoints == 0) {
+    return {};
+  }
+
+  const VtValue baseValue = pointsDs ? pointsDs->GetValue(0.0f) : VtValue();
+  if (!baseValue.IsHolding<VtVec3fArray>()) {
+    return {};
+  }
+  const VtVec3fArray base = baseValue.UncheckedGet<VtVec3fArray>();
+  if (base.size() < minPoints) {
+    return {};
+  }
+
+  bool moves = false;
+  for (size_t i = 0; i < minPoints && !moves; ++i) {
+    moves = velocities[i] != GfVec3f(0.0f);
+  }
+  if (!moves) {
+    return {};
+  }
+
+  VtVec3fArray accelerations;
+  const VtValue accValue = ReadPrimvar(primvars, HdTokens->accelerations);
+  if (accValue.IsHolding<VtVec3fArray>()) {
+    const VtVec3fArray candidate = accValue.UncheckedGet<VtVec3fArray>();
+    if (candidate.size() >= minPoints) {
+      accelerations = candidate;
+    }
+  }
+
+  const double fps = timeCodesPerSecond > 0.0 ? timeCodesPerSecond : 24.0;
+  std::vector<VtVec3fArray> samples(steps);
+  for (int step = 0; step < steps; ++step) {
+    const float frames = shutterOpen + (shutterClose - shutterOpen) * step / float(steps - 1);
+    const float dt = float(frames / fps);
+    VtVec3fArray at = base;
+    for (size_t i = 0; i < minPoints; ++i) {
+      at[i] += velocities[i] * dt;
+      if (!accelerations.empty()) {
+        at[i] += accelerations[i] * (0.5f * dt * dt);
+      }
+    }
+    samples[step] = std::move(at);
+  }
+  return samples;
+}
+
+std::vector<VtVec3fArray> SampleDeformingPoints(const HdPrimvarsSchema &primvars,
+                                                const HdSampledDataSourceHandle &pointsDs,
                                                 const float shutterOpen,
                                                 const float shutterClose,
                                                 const int steps,
-                                                const size_t minPoints)
+                                                const size_t minPoints,
+                                                const double timeCodesPerSecond)
 {
   std::vector<VtVec3fArray> samples;
   if (!pointsDs || steps < 2) {
     return samples;
   }
 
+  /* USD donne la priorite aux velocites sur l'interpolation entre echantillons,
+   * et pour une bonne raison : quand le nombre de points varie, il n'y a rien a
+   * interpoler, et c'est alors la seule source de flou. */
+  samples = SampleFromVelocities(
+      primvars, pointsDs, shutterOpen, shutterClose, steps, minPoints, timeCodesPerSecond);
+  if (!samples.empty()) {
+    return samples;
+  }
+
   samples.resize(steps);
   for (int step = 0; step < steps; ++step) {
     /* Les memes instants regulierement espaces que pour les transforms :
