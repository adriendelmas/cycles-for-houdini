From 66fac9a8da5707a3d2495a053a9df474c210fcce Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Wed, 7 Oct 2026 17:39:22 +0200
Subject: [PATCH 079/146] hydra: color/vector MaterialX operators, and three
 wrong scalar ones

Cycles' math node is scalar: a color that goes into it is averaged.
`ND_clamp_color3`, `ND_max_color3`, `ND_sqrt_color3` and the whole family came
out gray. The color and vector variants now have their twin: vector_math for the
operations it carries per component, a separate - three math - combine for exp,
ln, sqrt, asin, acos and atan2, min(max()) for clamp, vector_map_range for remap,
range and smoothstep.

Three operators were wrong even as scalars:
- `ln` went through Cycles' logarithm, whose base is the second input, 0.5 by
  default: it rendered ln(x) / ln(0.5). Base set to e.
- `modulo` is MaterialX's floored modulo (mx_mod); Cycles' truncates and differs
  for any negative operand. floored_modulo as scalar, wrap(x, y, 0) as vector.
- `atan2` names its operands iny and inx: neither reached the node.

`invert` becomes amount - in, which is what it is, `amount` included; `luminance`
takes MaterialX's ACEScg coefficients and accepts a plugged-in lumacoeffs.

MaterialX bench: fifteen new cases, values computed from the definitions; on the
previous DLL clamp, max and sqrt came out gray, ln and modulo black, invert and
atan2 lost an input. All exact now, 31 cases out of 31. mtlx_inputs: 542 nodedefs
without loss, versus 528. The 97-node bench without regression, hair 4/0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/hydra/material.cpp | 221 +++++++++++++++++++++++++++++++++++++----
 1 file changed, 204 insertions(+), 17 deletions(-)

diff --git a/src/hydra/material.cpp b/src/hydra/material.cpp
index 6671732d..c0152e37 100644
--- a/src/hydra/material.cpp
+++ b/src/hydra/material.cpp
@@ -1140,7 +1140,9 @@ const std::vector<MtlxEntry> &MtlxTable()
   static const UsdToCyclesMapping kSubV = MakeMtlxOp("subtract", true, false);
   static const UsdToCyclesMapping kMulV = MakeMtlxOp("multiply", true, false);
   static const UsdToCyclesMapping kDivV = MakeMtlxOp("divide", true, false);
-  static const UsdToCyclesMapping kMod = MakeMtlxOp("modulo", false, false);
+  /* MaterialX `mx_mod` is the floored modulo, x - y * floor(x / y); Cycles'
+   * plain "modulo" truncates and differs for every negative operand. */
+  static const UsdToCyclesMapping kMod = MakeMtlxOp("floored_modulo", false, false);
   static const UsdToCyclesMapping kAbs = MakeMtlxOp("absolute", false, true);
   static const UsdToCyclesMapping kSign = MakeMtlxOp("sign", false, true);
   static const UsdToCyclesMapping kFloor = MakeMtlxOp("floor", false, true);
@@ -1149,14 +1151,31 @@ const std::vector<MtlxEntry> &MtlxTable()
   static const UsdToCyclesMapping kFract = MakeMtlxOp("fraction", false, true);
   static const UsdToCyclesMapping kPow = MakeMtlxOp("power", false, false);
   static const UsdToCyclesMapping kExp = MakeMtlxOp("exponent", false, true);
-  static const UsdToCyclesMapping kLn = MakeMtlxOp("logarithm", false, true);
+  /* Cycles' logarithm takes its base on the second input, which defaults to
+   * 0.5: left alone, `ln` returned log(x) / log(0.5), the natural logarithm
+   * scaled by -1.44. The base is pinned to e. */
+  static const UsdToCyclesMapping kLn = [] {
+    UsdToCyclesMapping m = MakeMtlxOp("logarithm", false, true);
+    m.setFixedValues({{ustring("math_type"), "logarithm"}, {ustring("value2"), "2.718281828"}});
+    return m;
+  }();
   static const UsdToCyclesMapping kSqrt = MakeMtlxOp("sqrt", false, true);
   static const UsdToCyclesMapping kSin = MakeMtlxOp("sine", false, true);
   static const UsdToCyclesMapping kCos = MakeMtlxOp("cosine", false, true);
   static const UsdToCyclesMapping kTan = MakeMtlxOp("tangent", false, true);
   static const UsdToCyclesMapping kAsin = MakeMtlxOp("arcsine", false, true);
   static const UsdToCyclesMapping kAcos = MakeMtlxOp("arccosine", false, true);
-  static const UsdToCyclesMapping kAtan2 = MakeMtlxOp("arctan2", false, false);
+  /* `atan2` names its operands `iny` and `inx` (mx_atan(iny, inx)), not
+   * in1/in2: neither reached the node before. Cycles' arctan2 is atan2(a, b).
+   * MaterialX defaults are y = 0, x = 1. */
+  static const UsdToCyclesMapping kAtan2 = [] {
+    UsdToCyclesMapping m = MakeMtlxOp("arctan2", false, false);
+    m.setParameterName(TfToken("iny"), ustring("value1"));
+    m.setParameterName(TfToken("inx"), ustring("value2"));
+    m.setFixedValues(
+        {{ustring("math_type"), "arctan2"}, {ustring("value1"), "0"}, {ustring("value2"), "1"}});
+    return m;
+  }();
   static const UsdToCyclesMapping kMin = MakeMtlxOp("minimum", false, false);
   static const UsdToCyclesMapping kMax = MakeMtlxOp("maximum", false, false);
 
@@ -1752,20 +1771,33 @@ const std::vector<MtlxEntry> &MtlxTable()
   static const UsdToCyclesMapping kRemap = makeRange("linear");
   static const UsdToCyclesMapping kSmoothStep = makeRange("smoothstep");
 
-  /* `invert` leaves `amount` unmapped: Cycles inverts about one and mixes by
-   * `fac`, which matches MaterialX only at the default amount of 1. */
-  static const UsdToCyclesMapping kInvert = {"invert",
-                                             {
-                                                 {TfToken("in"), ustring("color")},
-                                                 {CyclesMaterialTokens->out, ustring("color")},
-                                             }};
-  /* `luminance` leaves `lumacoeffs` unmapped - the Cycles node has Rec.709
-   * baked in - so a graph asking for different weights gets these. */
-  static const UsdToCyclesMapping kLuminance = {"rgb_to_bw",
-                                                {
-                                                    {TfToken("in"), ustring("color")},
-                                                    {CyclesMaterialTokens->out, ustring("val")},
-                                                }};
+  /* `invert` is `amount - in` (stdlib), amount 1 by default. A subtraction
+   * says that exactly; Cycles' own invert node mixes towards 1 - in and could
+   * not take the amount. The colour and vector variants get the vector twin
+   * in FindMtlxMapping. */
+  static const UsdToCyclesMapping kInvert = [] {
+    UsdToCyclesMapping m{"math",
+                         {
+                             {TfToken("in"), ustring("value2")},
+                             {TfToken("amount"), ustring("value1")},
+                             {CyclesMaterialTokens->out, ustring("value")},
+                         }};
+    m.setFixedValues({{ustring("math_type"), "subtract"}, {ustring("value1"), "1"}});
+    return m;
+  }();
+  /* `luminance` is dot(in, lumacoeffs), ACEScg weights by default, spread to
+   * grey. rgb_to_bw had Rec.709 baked in and could not take other weights. */
+  static const UsdToCyclesMapping kLuminance = [] {
+    UsdToCyclesMapping m{"vector_math",
+                         {
+                             {TfToken("in"), ustring("vector1")},
+                             {TfToken("lumacoeffs"), ustring("vector2")},
+                             {CyclesMaterialTokens->out, ustring("value")},
+                         }};
+    m.setFixedValues({{ustring("math_type"), "dot_product"},
+                      {ustring("vector2"), "0.2722287,0.6740818,0.0536895"}});
+    return m;
+  }();
 
   /* Colour space conversion. Cycles splits and joins a colour in a chosen
    * space, so the pair does the conversion: separate in one space, combine in
@@ -2042,6 +2074,155 @@ const std::vector<MtlxEntry> &MtlxTable()
   return table;
 }
 
+/* One scalar operation applied to each channel: separate, three `math` nodes,
+ * combine. For the functions vector_math does not have - exp, ln, sqrt, the
+ * inverse trigonometry. `fixed2` pins the second operand (the base of a
+ * logarithm); `binary` adds a second separate for a two-operand function,
+ * fed by `in2Name`. `in1Default` and `in2Default` are MaterialX's. */
+UsdToCyclesMapping MakePerChannel(const char *const mode,
+                                  const char *const in1Name,
+                                  const char *const in1Default,
+                                  const char *const in2Name = nullptr,
+                                  const char *const in2Default = nullptr,
+                                  const char *const fixed2 = nullptr)
+{
+  UsdToCyclesMapping m{"combine_xyz",
+                       {
+                           {TfToken(in1Name), ustring("sa:vector")},
+                           {CyclesMaterialTokens->out, ustring("vector")},
+                       }};
+  if (in2Name != nullptr) {
+    m.setParameterName(TfToken(in2Name), ustring("sb:vector"));
+  }
+  static const char *const kAxes[3] = {"X", "Y", "Z"};
+  static const char *const kNames[3] = {"m0", "m1", "m2"};
+  for (int i = 0; i < 3; ++i) {
+    UsdToCyclesMapping::FixedMap fixed = {{ustring("math_type"), mode}};
+    if (fixed2 != nullptr) {
+      fixed.emplace_back(ustring("value2"), fixed2);
+    }
+    m.addHelper({kNames[i], "math", {{"Value", kAxes[i]}}, std::move(fixed)});
+  }
+  m.addHelper({"sa",
+               "separate_xyz",
+               {{"X", "m0:Value1"}, {"Y", "m1:Value1"}, {"Z", "m2:Value1"}},
+               {{ustring("vector"), in1Default}}});
+  if (in2Name != nullptr) {
+    m.addHelper({"sb",
+                 "separate_xyz",
+                 {{"X", "m0:Value2"}, {"Y", "m1:Value2"}, {"Z", "m2:Value2"}},
+                 {{ustring("vector"), in2Default}}});
+  }
+  return m;
+}
+
+/* The colour and vector variants of the scalar operators. Cycles' math node
+ * is scalar: a colour sent into it is averaged, so `ND_clamp_color3`,
+ * `ND_max_color3` and every sibling came out grey. vector_math has most of the
+ * same operations per component; the rest go through MakePerChannel.
+ * Longest prefix wins, as in the main table. Returns null when the family has
+ * no vector twin (the caller then uses the main table). */
+const UsdToCyclesMapping *FindMtlxVectorTwin(const std::string &nodeTypeId)
+{
+  static const UsdToCyclesMapping kAbs = MakeMtlxOp("absolute", true, true);
+  static const UsdToCyclesMapping kSign = MakeMtlxOp("sign", true, true);
+  static const UsdToCyclesMapping kFloor = MakeMtlxOp("floor", true, true);
+  static const UsdToCyclesMapping kCeil = MakeMtlxOp("ceil", true, true);
+  static const UsdToCyclesMapping kRound = MakeMtlxOp("round", true, true);
+  static const UsdToCyclesMapping kFract = MakeMtlxOp("fraction", true, true);
+  static const UsdToCyclesMapping kPow = MakeMtlxOp("power", true, false);
+  static const UsdToCyclesMapping kMin = MakeMtlxOp("minimum", true, false);
+  static const UsdToCyclesMapping kMax = MakeMtlxOp("maximum", true, false);
+  static const UsdToCyclesMapping kSin = MakeMtlxOp("sine", true, true);
+  static const UsdToCyclesMapping kCos = MakeMtlxOp("cosine", true, true);
+  static const UsdToCyclesMapping kTan = MakeMtlxOp("tangent", true, true);
+  /* Floored modulo per component: wrap(x, max = y, min = 0) is
+   * x - y * floor(x / y), which is mx_mod. vector_math's own "modulo"
+   * truncates. */
+  static const UsdToCyclesMapping kMod = [] {
+    UsdToCyclesMapping m = MakeMtlxOp("wrap", true, false);
+    m.setFixedValues({{ustring("math_type"), "wrap"},
+                      {ustring("vector2"), "1,1,1"},
+                      {ustring("vector3"), "0,0,0"}});
+    return m;
+  }();
+  static const UsdToCyclesMapping kExp = MakePerChannel("exponent", "in", "0,0,0");
+  static const UsdToCyclesMapping kLn = MakePerChannel(
+      "logarithm", "in", "1,1,1", nullptr, nullptr, "2.718281828");
+  static const UsdToCyclesMapping kSqrt = MakePerChannel("sqrt", "in", "0,0,0");
+  static const UsdToCyclesMapping kAsin = MakePerChannel("arcsine", "in", "0,0,0");
+  static const UsdToCyclesMapping kAcos = MakePerChannel("arccosine", "in", "0,0,0");
+  static const UsdToCyclesMapping kAtan2 = MakePerChannel(
+      "arctan2", "iny", "0,0,0", "inx", "1,1,1");
+  /* clamp(in, low, high) = min(max(in, low), high). */
+  static const UsdToCyclesMapping kClamp = [] {
+    UsdToCyclesMapping m{"vector_math",
+                         {
+                             {TfToken("in"), ustring("lo:vector1")},
+                             {TfToken("low"), ustring("lo:vector2")},
+                             {TfToken("high"), ustring("vector2")},
+                             {CyclesMaterialTokens->out, ustring("vector")},
+                         }};
+    m.setFixedValues({{ustring("math_type"), "minimum"}, {ustring("vector2"), "1,1,1"}});
+    m.addHelper({"lo",
+                 "vector_math",
+                 {{"Vector", "Vector1"}},
+                 {{ustring("math_type"), "maximum"}, {ustring("vector2"), "0,0,0"}}});
+    return m;
+  }();
+  auto makeRange = [](const char *const rangeType) {
+    UsdToCyclesMapping m{"vector_map_range",
+                         {
+                             {TfToken("in"), ustring("vector")},
+                             {TfToken("inlow"), ustring("from_min")},
+                             {TfToken("inhigh"), ustring("from_max")},
+                             {TfToken("outlow"), ustring("to_min")},
+                             {TfToken("outhigh"), ustring("to_max")},
+                             {TfToken("doclamp"), ustring("use_clamp")},
+                             {TfToken("low"), ustring("from_min")},
+                             {TfToken("high"), ustring("from_max")},
+                             {CyclesMaterialTokens->out, ustring("vector")},
+                         }};
+    m.setFixedValues({{ustring("range_type"), rangeType}});
+    return m;
+  };
+  static const UsdToCyclesMapping kRemap = makeRange("linear");
+  static const UsdToCyclesMapping kSmoothStep = makeRange("smoothstep");
+  /* invert = amount - in, per component. */
+  static const UsdToCyclesMapping kInvert = [] {
+    UsdToCyclesMapping m{"vector_math",
+                         {
+                             {TfToken("in"), ustring("vector2")},
+                             {TfToken("amount"), ustring("vector1")},
+                             {CyclesMaterialTokens->out, ustring("vector")},
+                         }};
+    m.setFixedValues({{ustring("math_type"), "subtract"}, {ustring("vector1"), "1,1,1"}});
+    return m;
+  }();
+
+  static const std::vector<MtlxEntry> twins = {
+      {"ND_absval_", &kAbs},       {"ND_sign_", &kSign},
+      {"ND_floor_", &kFloor},      {"ND_ceil_", &kCeil},
+      {"ND_round_", &kRound},      {"ND_fract_", &kFract},
+      {"ND_power_", &kPow},        {"ND_safepower_", &kPow},
+      {"ND_min_", &kMin},          {"ND_max_", &kMax},
+      {"ND_sin_", &kSin},          {"ND_cos_", &kCos},
+      {"ND_tan_", &kTan},          {"ND_modulo_", &kMod},
+      {"ND_exp_", &kExp},          {"ND_ln_", &kLn},
+      {"ND_sqrt_", &kSqrt},        {"ND_asin_", &kAsin},
+      {"ND_acos_", &kAcos},        {"ND_atan2_", &kAtan2},
+      {"ND_clamp_", &kClamp},      {"ND_remap_", &kRemap},
+      {"ND_range_", &kRemap},      {"ND_smoothstep_", &kSmoothStep},
+      {"ND_invert_", &kInvert},
+  };
+  for (const MtlxEntry &entry : twins) {
+    if (nodeTypeId.starts_with(entry.prefix)) {
+      return entry.mapping;
+    }
+  }
+  return nullptr;
+}
+
 /* Returns the mapping for a MaterialX nodedef identifier, or null when that
  * node has no Cycles counterpart yet. */
 const UsdToCyclesMapping *FindMtlxMapping(const std::string &nodeTypeId)
@@ -2153,6 +2334,12 @@ const UsdToCyclesMapping *FindMtlxMapping(const std::string &nodeTypeId)
     }
   }
 
+  if (isVector) {
+    if (const UsdToCyclesMapping *twin = FindMtlxVectorTwin(nodeTypeId)) {
+      return twin;
+    }
+  }
+
   if (nodeTypeId.starts_with("ND_add_")) {
     return isVector ? &kAddV : &kAdd;
   }
