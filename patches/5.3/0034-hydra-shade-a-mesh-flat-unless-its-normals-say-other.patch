From 232ec7e13f348fbb7cd165d6792a92fb511d6641 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Wed, 2 Sep 2026 15:09:03 +0200
Subject: [PATCH 34/48] hydra: shade a mesh flat unless its normals say
 otherwise, and refresh the UsdPreviewSurface names

Smoothing was decided by displayStyle's flat shading hint alone. That hint is a
viewport display style which Houdini leaves unset when rendering, so it read as
false and every mesh came out smooth: a box rendered with its faces bulging and
its edges rounded off, where every other renderer shows it faceted.

A polygonal mesh with no authored normals has nothing to interpolate and is
faceted; a subdivided one is smooth by construction. Cycles carries a single
normal per vertex, so only vertex, varying and constant normals can be honoured
- per-face and per-corner normals are how a hard edge is written, and flat
shading reads them far closer than interpolating the averaged vertex normals
Cycles would otherwise invent for itself.

The UsdPreviewSurface table had also fallen behind the rewritten principled
BSDF: there is no `specular` or `emission` socket any more and the coat is no
longer called clearcoat, so those inputs missed their sockets and were dropped
with a warning. UsdPreviewSurface has no emission strength either - the colour
is the emission - so the strength is pinned to one and the colour defaulted to
black, leaving a material that emits nothing dark.

Not verified by render: husk reports no available license with Houdini closed.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/hydra/material.cpp | 41 +++++++++++++++++++++++++++++------------
 src/hydra/mesh.cpp     | 22 +++++++++++++++++++++-
 2 files changed, 50 insertions(+), 13 deletions(-)

diff --git a/src/hydra/material.cpp b/src/hydra/material.cpp
index 7474c6ff..d436b571 100644
--- a/src/hydra/material.cpp
+++ b/src/hydra/material.cpp
@@ -1296,18 +1296,35 @@ const UsdToCyclesMapping *FindMtlxMapping(const std::string &nodeTypeId)
 }
 
 class UsdToCycles {
-  const UsdToCyclesMapping UsdPreviewSurface = {
-      "principled_bsdf",
-      {
-          {TfToken("diffuseColor"), ustring("base_color")},
-          {TfToken("emissiveColor"), ustring("emission")},
-          {TfToken("specularColor"), ustring("specular")},
-          {TfToken("clearcoatRoughness"), ustring("coat_roughness")},
-          {TfToken("opacity"), ustring("alpha")},
-          /* opacityThreshold */
-          /* occlusion */
-          /* displacement */
-      }};
+  /* The names on the Cycles side moved with the rewritten principled BSDF:
+   * there is no `specular` or `emission` socket any more, and the coat is no
+   * longer called clearcoat. Left as they were, those three inputs missed and
+   * were dropped with a warning.
+   *
+   * `roughness`, `metallic`, `ior` and `normal` are spelled the same on both
+   * sides and reach their sockets without an entry here.
+   *
+   * UsdPreviewSurface has no emission strength - the colour is the emission -
+   * while Cycles keeps the two apart and defaults the strength to zero. The
+   * strength is pinned to one and the colour to black, so a network that emits
+   * nothing stays dark and one that sets a colour gets it at face value. */
+  const UsdToCyclesMapping UsdPreviewSurface = [] {
+    UsdToCyclesMapping mapping{
+        "principled_bsdf",
+        {
+            {TfToken("diffuseColor"), ustring("base_color")},
+            {TfToken("emissiveColor"), ustring("emission_color")},
+            {TfToken("specularColor"), ustring("specular_tint")},
+            {TfToken("clearcoat"), ustring("coat_weight")},
+            {TfToken("clearcoatRoughness"), ustring("coat_roughness")},
+            {TfToken("opacity"), ustring("alpha")},
+            /* opacityThreshold, occlusion: no counterpart.
+             * displacement: carried by the material's displacement terminal. */
+        }};
+    mapping.setFixedValues({{ustring("emission_strength"), "1"},
+                            {ustring("emission_color"), "0,0,0"}});
+    return mapping;
+  }();
   const UsdToCyclesTexture UsdUVTexture = {
       "image_texture",
       {
diff --git a/src/hydra/mesh.cpp b/src/hydra/mesh.cpp
index cf578426..cb1581a9 100644
--- a/src/hydra/mesh.cpp
+++ b/src/hydra/mesh.cpp
@@ -423,9 +423,29 @@ void HdCyclesMesh::PopulateTopology(HdSceneDelegate *sceneDelegate)
     _geom->set_subdivision_type(Mesh::SUBDIVISION_NONE);
   }
 
-  const bool smooth = !flatShadingEnabled;
   const bool subdivision = _geom->get_subdivision_type() != Mesh::SUBDIVISION_NONE;
 
+  /* Whether the surface is shaded smooth follows from the normals the mesh
+   * actually carries, not from the viewport's flat shading hint alone: that
+   * hint is a display style Houdini leaves unset when rendering, so reading it
+   * on its own smoothed every mesh and rounded off every hard edge.
+   *
+   * A polygonal mesh with no authored normals is faceted - there is nothing to
+   * interpolate - and a subdivided one is smooth by construction. In between,
+   * Cycles carries a single normal per vertex, so only vertex, varying and
+   * constant normals can be honoured; per-face and per-corner normals are how a
+   * hard edge is written, and flat shading reads them far closer than
+   * interpolating the averaged vertex normals Cycles would otherwise invent. */
+  const HdSceneIndexPrim normalsPrim = GetPrim(sceneDelegate, GetId());
+  const HdPrimvarsSchema normalsPrimvars = HdPrimvarsSchema::GetFromParent(
+      normalsPrim.dataSource);
+  const HdInterpolation normalsInterpolation = ReadPrimvarInterpolation(normalsPrimvars,
+                                                                       HdTokens->normals);
+  const bool haveVertexNormals = normalsInterpolation == HdInterpolationVertex ||
+                                 normalsInterpolation == HdInterpolationVarying ||
+                                 normalsInterpolation == HdInterpolationConstant;
+  const bool smooth = !flatShadingEnabled && (subdivision || haveVertexNormals);
+
   // Initialize lookup table from polygon face to material shader index
   VtIntArray faceShaders(_topology.GetNumFaces(), 0);
 
-- 
