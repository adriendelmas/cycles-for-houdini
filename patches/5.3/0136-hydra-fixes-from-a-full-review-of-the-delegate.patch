From c78b8d723abde5aa511d6566259ca1b93a3ba2cd Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Sat, 10 Oct 2026 18:38:09 +0200
Subject: [PATCH 136/144] hydra: fixes from a full review of the delegate

Read end to end (19k lines, C++ and Python) and checked by scenes:

- mtlx_expand: the alpha of a constant colour4 routed as a value onto a
  node from Hydra was never written back (the node was not flagged edited),
  the reader kept Cycles' default; both alpha routes flag it (K-93).
- mtlx_expand: OpenPBR's wired base_weight erased its connection, which the
  overlay let through, and the base was weighed twice; emptied instead
  (K-94). FoldLayerIor runs before FoldClosureWeight so a weighted coat
  still hands its IOR to its layer.
- util: ApplyPrimvars copied the whole primvar into an attribute sized by
  the geometry - a constant primvar authored as a long array overran the
  heap and crashed husk; copies what fits, warns (K-95).
- mesh: crease lengths under 2 wrapped the crease count (all memory asked
  for); GeomSubset faces past the mesh wrote past the shader table; a
  uniform primvar shorter than the faces read past its end (K-95).
- curves: negative curve indices read before the array.
- geometry: a prototype left with no instance no longer reads _instances[0].
- houdini_cop: Capture read `_gpu` from the Python dictionary after
  releasing it (K-96).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/hydra/curves.cpp      | 13 ++++++++-----
 src/hydra/geometry.inl    |  2 +-
 src/hydra/houdini_cop.cpp |  5 +++--
 src/hydra/mesh.cpp        | 17 ++++++++++++++---
 src/hydra/mtlx_expand.cpp | 14 ++++++++++++--
 src/hydra/util.cpp        | 15 ++++++++++++++-
 6 files changed, 52 insertions(+), 14 deletions(-)

diff --git a/src/hydra/curves.cpp b/src/hydra/curves.cpp
index b6621402..a9954fd3 100644
--- a/src/hydra/curves.cpp
+++ b/src/hydra/curves.cpp
@@ -412,8 +412,9 @@ void HdCyclesCurves::PopulateTopology(HdSceneDelegate *sceneDelegate)
     std::vector<int> idx(n);
     for (int k = 0; k < n; ++k) {
       const size_t at = controlOffset + k;
+      /* A negative index read before the array; it reads its first point. */
       idx[k] = curveIndices.empty() ? int(at) :
-                                      (at < curveIndices.size() ? curveIndices[at] : 0);
+               (at < curveIndices.size() ? std::max(curveIndices[at], 0) : 0);
     }
     controlOffset += n;
 
@@ -564,10 +565,12 @@ void HdCyclesCurves::PopulateTopology(HdSceneDelegate *sceneDelegate)
     keyCounts.push_back(int(_vertexWeights.size() - keysBefore));
     varyingOffset += varyingCount;
   }
-  _numControlPoints = curveIndices.empty() ? controlOffset :
-                                             size_t(*std::max_element(curveIndices.begin(),
-                                                                      curveIndices.end())) +
-                                                 1;
+  _numControlPoints = curveIndices.empty() ?
+                          controlOffset :
+                          size_t(std::max(*std::max_element(curveIndices.begin(),
+                                                            curveIndices.end()),
+                                          0)) +
+                              1;
   _numVarying = varyingOffset;
 
   size_t numKeys = 0;
diff --git a/src/hydra/geometry.inl b/src/hydra/geometry.inl
index 45bb6af1..fc152c52 100644
--- a/src/hydra/geometry.inl
+++ b/src/hydra/geometry.inl
