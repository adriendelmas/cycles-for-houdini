From c268ecad3ffb15328d7050a1649c83c898c8694e Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Tue, 3 Nov 2026 13:36:45 +0100
Subject: [PATCH 162/182] hydra: one tile at any resolution - 4K renders no
 longer hang or fail

Cycles cuts an image over 2048 pixels into tiles written to disk and
merged at the end, a batch feature this interactive session does not
drive: husk hung at the first tile of a 3840x2560 render, and the
viewport failed with "Error writing tile to file" (the tile files went
to Houdini's working directory, not writable when Houdini is started from
Explorer). A 4K buffer fits any GPU this runs on.
---
 src/hydra/render_delegate.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/hydra/render_delegate.cpp b/src/hydra/render_delegate.cpp
index 6b4e49bb..b8e19f30 100644
--- a/src/hydra/render_delegate.cpp
+++ b/src/hydra/render_delegate.cpp
@@ -100,6 +100,12 @@ SessionParams GetSessionParams(const HdRenderSettingsMap &settings)
 {
   SessionParams params;
   params.threads = 0;
+  /* One tile, whatever the resolution. Cycles cuts an image over 2048 pixels (4K: 3840x2560)
+   * into tiles written to disk and merged at the end, a batch feature this interactive session
+   * does not drive: husk hung at the first tile, and the viewport failed with "Error writing
+   * tile to file" (its temp dir was Houdini's working directory, not writable from Explorer).
+   * A 4K buffer fits any GPU this runs on (K-127). */
+  params.use_auto_tile = false;
   /* Interactive even under husk. Cycles' background mode was measured on
    * 2026-10-08 (smoke.usda, 1920x1080, five pairs): 13.2 s against 13.6 s,
    * inside the 1.5 s spread between runs, bit-identical images. It is not
