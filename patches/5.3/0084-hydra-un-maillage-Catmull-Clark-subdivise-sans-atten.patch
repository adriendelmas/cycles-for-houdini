From c268f9f07b15006b514035ab24097c39765ebfd7 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Wed, 7 Oct 2026 22:46:04 +0200
Subject: [PATCH 84/93] hydra: un maillage Catmull-Clark subdivise sans
 attendre l'indice d'affichage

Le delegue ne subdivisait qu'avec refineLevel > 0 et prenait ce nombre pour
niveau maximal. C'est la complexite d'affichage de Hydra (husk --complexity,
les options d'affichage de Solaris), pas une propriete du maillage : au
viewport en complexite basse, une surface de subdivision rendait sa cage, et
ailleurs elle plafonnait a 3 niveaux quel que soit le pas de decoupage.
Karma subdivise sans lui. Un maillage catmullClark est maintenant toujours
subdivise ; le pas de decoupage decide de la finesse, plafonne par un
nouveau reglage cycles:max_subdivisions (12, comme Blender) qui se change
sans recompiler. Un maillage bilineaire n'y gagne rien sans deplacement et
garde l'ancienne regle.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/hydra/mesh.cpp                            | 18 +++++++++----
 src/hydra/render_delegate.cpp                 | 25 +++++++++++++++++++
 src/hydra/render_delegate.h                   |  2 +-
 .../resources/HdCyclesPluginGPU_Global.ds     | 22 ++++++++++++++++
 src/hydra/resources/HdCyclesPlugin_Global.ds  | 22 ++++++++++++++++
 src/hydra/session.h                           | 13 ++++++++++
 6 files changed, 96 insertions(+), 6 deletions(-)

diff --git a/src/hydra/mesh.cpp b/src/hydra/mesh.cpp
index 8e2acad3..864cd042 100644
--- a/src/hydra/mesh.cpp
+++ b/src/hydra/mesh.cpp
@@ -474,11 +474,17 @@ void HdCyclesMesh::PopulateTopology(HdSceneDelegate *sceneDelegate)
   }
   _topology.SetGeomSubsets(geomSubsetsList);
 
+  /* A Catmull-Clark mesh is a smooth surface whatever the viewport's display
+   * complexity says: `refineLevel` is that display hint (`husk --complexity`,
+   * Solaris' display options), not a property of the mesh, and Karma
+   * subdivides without it. How finely is the dicing rate's and the max
+   * subdivisions setting's call. A bilinear mesh only gains from dicing when
+   * it is displaced, so it keeps waiting for the hint. */
   const TfToken subdivScheme = _topology.GetScheme();
   if (subdivScheme == PxOsdOpenSubdivTokens->bilinear && _topology.GetRefineLevel() > 0) {
     _geom->set_subdivision_type(Mesh::SUBDIVISION_LINEAR);
   }
-  else if (subdivScheme == PxOsdOpenSubdivTokens->catmullClark && _topology.GetRefineLevel() > 0) {
+  else if (subdivScheme == PxOsdOpenSubdivTokens->catmullClark) {
     _geom->set_subdivision_type(Mesh::SUBDIVISION_CATMULL_CLARK);
   }
   else {
@@ -698,15 +704,17 @@ void HdCyclesMesh::PopulateTopology(HdSceneDelegate *sceneDelegate)
      * nombre de pixels par micropolygone. */
     const auto *const cyclesDelegate = static_cast<const HdCyclesDelegate *>(
         sceneDelegate->GetRenderIndex().GetRenderDelegate());
-    const float dicingRate =
-        static_cast<HdCyclesSession *>(cyclesDelegate->GetRenderParam())->GetDicingRate();
+    const auto *const session = static_cast<HdCyclesSession *>(
+        cyclesDelegate->GetRenderParam());
+    const float dicingRate = session->GetDicingRate();
+    const int maxLevel = session->GetMaxSubdivisions();
     _geom->set_subd_dicing_rate(dicingRate);
-    _geom->set_subd_max_level(_topology.GetRefineLevel());
+    _geom->set_subd_max_level(maxLevel);
     /* Les deux nombres qui decident du cout d'une surface subdivisee. Sans eux
      * au journal, un maillage decoupe en millions de triangles ne se voit que
      * dans la memoire du peripherique, ou personne ne pense a regarder. */
     LOG_INFO << "Subdivision " << GetId().GetText() << ": dicing rate " << dicingRate
-             << " px, max level " << _topology.GetRefineLevel() << ".";
+             << " px, max level " << maxLevel << ".";
     _geom->set_subd_objecttoworld(_instances[0]->get_tfm());
   }
 }
diff --git a/src/hydra/render_delegate.cpp b/src/hydra/render_delegate.cpp
index a5c93270..5c3d53c6 100644
--- a/src/hydra/render_delegate.cpp
+++ b/src/hydra/render_delegate.cpp
@@ -496,6 +496,11 @@ HdRenderSettingDescriptorList HdCyclesDelegate::GetRenderSettingDescriptors() co
       HdCyclesRenderSettingsTokens->dicingRate,
       VtValue(_renderParam->GetDicingRate()),
   });
+  descriptors.push_back({
+      "Max Subdivisions",
+      HdCyclesRenderSettingsTokens->maxSubdivisions,
+      VtValue(_renderParam->GetMaxSubdivisions()),
+  });
   descriptors.push_back({
       "Curve Shape",
       HdCyclesRenderSettingsTokens->curveShape,
@@ -567,6 +572,23 @@ void HdCyclesDelegate::SetRenderSetting(const PXR_NS::TfToken &key, const PXR_NS
       ++_settingsVersion;
     }
   }
+  else if (key == HdCyclesRenderSettingsTokens->maxSubdivisions) {
+    const int level = std::clamp(
+        VtValue::Cast<int>(value).GetWithDefault(_renderParam->GetMaxSubdivisions()), 0, 16);
+    if (level != _renderParam->GetMaxSubdivisions()) {
+      _renderParam->SetMaxSubdivisions(level);
+      for (Geometry *const geom : scene->geometry) {
+        if (geom->is_mesh()) {
+          Mesh *const mesh = static_cast<Mesh *>(geom);
+          if (mesh->get_subdivision_type() != Mesh::SUBDIVISION_NONE) {
+            mesh->set_subd_max_level(level);
+            mesh->tag_update(scene, true);
+          }
+        }
+      }
+      ++_settingsVersion;
+    }
+  }
   else if (key == HdCyclesRenderSettingsTokens->curveShape) {
     std::string shape = VtValue::Cast<std::string>(value).GetWithDefault(std::string());
     if (shape.empty() && value.IsHolding<TfToken>()) {
@@ -682,6 +704,9 @@ VtValue HdCyclesDelegate::GetRenderSetting(const TfToken &key) const
   if (key == HdCyclesRenderSettingsTokens->curveShape) {
     return VtValue(_renderParam->GetCurveShape());
   }
+  if (key == HdCyclesRenderSettingsTokens->maxSubdivisions) {
+    return VtValue(_renderParam->GetMaxSubdivisions());
+  }
   if (key == HdCyclesRenderSettingsTokens->threads) {
     return VtValue(session->params.threads);
   }
