+    return _maxSubdivisions;
+  }
+
+  void SetMaxSubdivisions(const int maxSubdivisions)
+  {
+    _maxSubdivisions = maxSubdivisions;
+  }
+
   float GetDicingRate() const
   {
     return _dicingRate;
@@ -148,6 +160,7 @@ class HdCyclesSession final : public PXR_NS::HdRenderParam {
   const bool _ownCyclesSession;
   double _stageMetersPerUnit = 0.01;
   float _dicingRate = 1.0f;
+  int _maxSubdivisions = 12;
   std::string _curveShape = "auto";
   std::map<CCL_NS::Hair *, bool> _curveIsCubic;
   float _shutterOpen = 0.0f;
