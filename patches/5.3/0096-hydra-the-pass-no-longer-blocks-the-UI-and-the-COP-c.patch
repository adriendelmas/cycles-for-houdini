From 8cfbccac87bfa939787d5bbff3bb6ed72c662361 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Thu, 8 Oct 2026 03:59:54 +0200
Subject: [PATCH 096/147] hydra: the pass no longer blocks the UI, and the COP
 cache empties

The render pass took the scene lock by waiting: while the render thread updated
the device after an edit - a BVH can take seconds - Houdini's interface stayed
frozen. It now tries the lock; if the scene is busy, it marks its buffers as
non-converged, which makes the pass re-execute on the next refresh, where
everything is recomputed from the pass state: nothing is lost, unlike the old
try_lock. After ten consecutive postponements it waits, so that an edit is never
pushed back for good.

The COP pixel cache kept all the layers read during the session: an 8K RGBA in
half floats weighs 256 MB, a few edits of a COP network filled the memory. An
entry that no material uses anymore leaves the cache when its last user is
forgotten, and when the cache exceeds its budget (HDCYCLES_COP_CACHE_MB, 4096 by
default). Cycles' image nodes keep their own reference: evicting never removes
an image from a render in progress.

No regression (97 nodes, all benches). Neither can be measured under husk: to be
checked in Houdini.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/hydra/houdini_cop.cpp | 61 +++++++++++++++++++++++++++++++++++++--
 src/hydra/render_pass.cpp | 25 ++++++++++++----
 src/hydra/render_pass.h   |  3 ++
 3 files changed, 81 insertions(+), 8 deletions(-)

diff --git a/src/hydra/houdini_cop.cpp b/src/hydra/houdini_cop.cpp
index 0e202ec9..5df71c54 100644
--- a/src/hydra/houdini_cop.cpp
+++ b/src/hydra/houdini_cop.cpp
@@ -75,6 +75,26 @@ std::unordered_map<std::string, CopPixelsPtr> &Cache()
   return cache;
 }
 
+size_t BytesOf(const CopPixelsPtr &pixels)
+{
+  return pixels ? pixels->data.size() : 0;
+}
+
+/* The cache used to keep every layer it ever captured for the whole session:
+ * an 8K RGBA half layer is 256 MB, and a few edits of a COP network were
+ * enough to fill the host's memory. Entries no material uses any more go
+ * first, when their last user is forgotten and when the cache passes its
+ * budget - HDCYCLES_COP_CACHE_MB, 4096 by default. Cycles' image nodes keep
+ * their own reference to the pixels they show, so evicting never pulls an
+ * image out from under a render; it only means the next use captures again.
+ * Called with the cache mutex held. */
+size_t CacheBudget()
+{
+  const char *env = getenv("HDCYCLES_COP_CACHE_MB");
+  const long long mb = env ? atoll(env) : 4096;
+  return size_t(mb > 0 ? mb : 4096) * 1024 * 1024;
+}
+
 /* Qui se sert de quel COP. Sans ce registre, un COP qui change n'a personne a
  * qui le dire : Solaris ignore la dependance entre un materiau et un noeud de
  * composition. */
@@ -91,6 +111,38 @@ std::map<std::string, std::vector<CopUser>> &Users()
   return users;
 }
 
+void EvictUnused(const std::map<std::string, std::vector<CopUser>> &users,
+                 const bool onlyOverBudget)
+{
+  auto &cache = Cache();
+  size_t total = 0;
+  for (const auto &entry : cache) {
+    total += BytesOf(entry.second);
+  }
+  const size_t budget = CacheBudget();
+  if (onlyOverBudget && total <= budget) {
+    return;
+  }
+  for (auto it = cache.begin(); it != cache.end();) {
+    const auto used = users.find(it->first);
+    const bool inUse = used != users.end() && !used->second.empty();
+    if (!inUse && (!onlyOverBudget || total > budget)) {
+      total -= BytesOf(it->second);
+      LOG_INFO << "Houdini COP " << it->first << " evicted from the pixel cache ("
+               << BytesOf(it->second) / (1024 * 1024) << " MB).";
+      it = cache.erase(it);
+    }
+    else {
+      ++it;
+    }
+  }
+  if (total > budget) {
+    LOG_WARNING << "The Houdini COP pixel cache holds " << total / (1024 * 1024)
+                << " MB in use, over its " << budget / (1024 * 1024)
+                << " MB budget (HDCYCLES_COP_CACHE_MB).";
+  }
+}
+
 /* `op:/stage/copnet/OUT[1]` nomme un plan d'un noeud. Seule la partie noeud
  * designe quelque chose que hou.node() sait trouver. */
 std::string NodePathOf(const std::string &opPath)
@@ -418,6 +470,7 @@ void BindHoudiniCopImage(Scene *scene,
     else {
       pixels = Capture(opPath);
       cache[opPath] = pixels;
+      EvictUnused(Users(), true);
     }
   }
 
@@ -561,15 +614,19 @@ void PollHoudiniCops(Scene *scene)
 void ForgetHoudiniCopUser(const PXR_NS::SdfPath &materialId)
 {
   const thread_scoped_lock lock(CacheMutex());
-  for (auto &entry : Users()) {
-    auto &users = entry.second;
+  auto &allUsers = Users();
+  for (auto it = allUsers.begin(); it != allUsers.end();) {
+    auto &users = it->second;
     users.erase(std::remove_if(users.begin(),
                                users.end(),
                                [&materialId](const CopUser &user) {
                                  return user.materialId == materialId;
                                }),
                 users.end());
+    it = users.empty() ? allUsers.erase(it) : std::next(it);
   }
+  /* What no material uses any more leaves the cache now. */
+  EvictUnused(allUsers, false);
 }
 
 HDCYCLES_NAMESPACE_CLOSE_SCOPE
diff --git a/src/hydra/render_pass.cpp b/src/hydra/render_pass.cpp
index 725c3d3f..fc7ecf57 100644
--- a/src/hydra/render_pass.cpp
+++ b/src/hydra/render_pass.cpp
@@ -150,12 +150,25 @@ void HdCyclesRenderPass::_Execute(const HdRenderPassStateSharedPtr &renderPassSt
     using clock = std::chrono::steady_clock;
     const clock::time_point tStart = clock::now();
 
-    /* Take the lock rather than trying it. A failed try_lock used to skip the
-     * session reset below with no retry, which silently dropped the edit: a
-     * batch render re-executes everything every frame and papers over it, but
-     * an interactive session may only execute once per change, and the change
-     * then never reached the renderer. */
-    scene->mutex.lock();
+    /* The render thread holds the scene while it updates the device after an
+     * edit - a BVH build can take seconds - and waiting for it here froze
+     * Houdini's UI for as long. An older try_lock skipped the session reset
+     * with no retry and lost the edit. So: try, and when the scene is busy,
+     * mark the pass unconverged - Hydra executes an unconverged pass again on
+     * the next redraw, and everything below is recomputed from the pass state
+     * then, so nothing is lost. After kMaxDeferrals busy passes in a row, wait,
+     * so an edit can never be put off for good. */
+    constexpr int kMaxDeferrals = 10;
+    if (_deferrals < kMaxDeferrals && !scene->mutex.try_lock()) {
+      ++_deferrals;
+      ResetConverged();
+      session->draw();
+      return;
+    }
+    if (_deferrals >= kMaxDeferrals) {
+      scene->mutex.lock();
+    }
+    _deferrals = 0;
     const clock::time_point tLocked = clock::now();
 
 #ifdef WITH_HOUDINI_COP
diff --git a/src/hydra/render_pass.h b/src/hydra/render_pass.h
index f600fe73..2d2e1fcd 100644
--- a/src/hydra/render_pass.h
+++ b/src/hydra/render_pass.h
@@ -27,6 +27,9 @@ class HdCyclesRenderPass final : public PXR_NS::HdRenderPass {
   void _Execute(const PXR_NS::HdRenderPassStateSharedPtr &renderPassState,
                 const PXR_NS::TfTokenVector &renderTags) override;
 
+  /* Passes put off in a row because the render thread held the scene. */
+  int _deferrals = 0;
+
   /* The render tags the last execution drew, to notice a change. */
   PXR_NS::TfTokenVector _renderTags;
   bool _renderTagsApplied = false;
