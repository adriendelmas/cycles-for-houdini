+    ShaderOutput *output = FindOutput(sourceNode, outputName);
 
     if (!output) {
       LOG_WARNING << "MaterialX: Cycles node '" << srcNodeIt->second.node->name.c_str()
@@ -2066,6 +2139,38 @@ void HdCyclesMaterial::UpdateConnections(NodeDesc &nodeDesc,
   }
 }
 
+namespace {
+
+/* Le reseau demande-t-il ce que seul un lobe de transmission separe sait
+ * rendre ? Une valeur ecrite comme un fil branche comptent : Hydra ne transmet
+ * que ce que le reseau a pose, donc leur seule presence dit l'intention. */
+bool AsksForGlassLobe(HdMaterialNodeSchema nodeSchema)
+{
+  static const TfToken kNames[] = {TfToken("transmission_color"),
+                                   TfToken("transmission_extra_roughness")};
+
+  HdMaterialNodeParameterContainerSchema params = nodeSchema.GetParameters();
+  for (const TfToken &name : kNames) {
+    for (const TfToken &authored : params.GetNames()) {
+      if (authored == name) {
+        return true;
+      }
+    }
+  }
+
+  HdMaterialConnectionVectorContainerSchema conns = nodeSchema.GetInputConnections();
+  for (const TfToken &name : kNames) {
+    for (const TfToken &connected : conns.GetNames()) {
+      if (connected == name) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+}  // namespace
