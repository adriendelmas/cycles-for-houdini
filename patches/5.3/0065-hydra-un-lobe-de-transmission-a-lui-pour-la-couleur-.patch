+         * principled. Un materiau qui n'ecrit ni l'une ni l'autre garde donc le
+         * principled entier. */
+        if (nodeDesc.mapping == &MtlxStandardSurface && AsksForGlassLobe(nodeSchema)) {
+          nodeDesc.mapping = &MtlxStandardSurfaceGlass;
+        }
         if (nodeDesc.mapping) {
           cyclesType = nodeDesc.mapping->nodeType();
         }
@@ -2137,6 +2250,23 @@ unique_ptr<ShaderGraph> HdCyclesMaterial::BuildShaderGraph(HdMaterialNetworkSche
