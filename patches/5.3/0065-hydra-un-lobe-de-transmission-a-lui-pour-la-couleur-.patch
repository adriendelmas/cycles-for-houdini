+/* standard_surface, variante a lobe de transmission separe.
+ *
+ * Cycles teinte la transmission par `base_color` et n'a qu'une rugosite pour
+ * tous les lobes : ni `transmission_color` ni `transmission_extra_roughness`
+ * n'ont ou aller sur le principled. Un vrai lobe de verre, lui, a sa couleur
+ * et sa rugosite propres, et c'est ainsi que standard_surface est defini -
+ * la transmission y est un lobe a part.
+ *
+ * Le montage : le principled sans transmission d'un cote, un `glass_bsdf` de
+ * l'autre, meles par le poids de transmission.
+ *
+ * ⚠️ Ce que cette variante perd : la **dispersion**, qui ne vit que sur le
+ * principled. C'est pour cela qu'elle n'est prise que lorsque le reseau ecrit
+ * l'une des deux entrees qu'elle sert - un materiau qui n'y touche pas garde
+ * le principled entier, dispersion comprise.
+ *
+ * Le premier essai passait par un `light_path` : la couleur de transmission
+ * n'etait prise que sur les rayons deja transmis, donc pas sur la premiere
+ * traversee, celle qu'on voit. */
+UsdToCyclesMapping MakeMtlxStandardSurfaceGlass();
+
+const UsdToCyclesMapping MtlxStandardSurfaceGlass = MakeMtlxStandardSurfaceGlass();
+
+UsdToCyclesMapping MakeMtlxStandardSurfaceGlass()
+{
+  UsdToCyclesMapping mapping = MakeMtlxStandardSurface();
+
+  /* Le poids de transmission commande le melange, plus le principled. */
+  mapping.setParameterName(TfToken("transmission"), ustring("tmix:Fac"));
+  mapping.setParameterName(TfToken("transmission_color"), ustring("glass:color"));
+  mapping.setParameterName(TfToken("transmission_extra_roughness"), ustring("grough:value2"));
+  /* La rugosite du verre est celle du speculaire, plus le supplement. */
+  mapping.setParameterName(TfToken("specular_roughness"), ustring("roughness;grough:value1"));
+  mapping.setParameterName(TfToken("specular_IOR"), ustring("ior;glass:IOR"));
+  mapping.setParameterName(TfToken("normal"), ustring("normal;glass:normal"));
+
+  /* Le melange vient apres le principled : c'est lui la sortie du montage. */
+  mapping.addHelper({"tmix",
+                     "mix_closure",
+                     {},
+                     {{ustring("fac"), "0"}},
+                     "Closure1",
+                     "BSDF"});
+  mapping.addHelper({"glass",
+                     "glass_bsdf",
+                     {{"BSDF", "tmix:Closure2"}},
+                     {{ustring("color"), "1,1,1"}, {ustring("IOR"), "1.5"}}});
+  /* Les deux defauts de MaterialX : une rugosite speculaire de 0,2 et pas de
+   * supplement. */
+  mapping.addHelper({"grough",
+                     "math",
+                     {{"Value", "glass:Roughness"}},
+                     {{ustring("math_type"), "add"},
+                      {ustring("value1"), "0.2"},
+                      {ustring("value2"), "0.0"}}});
+  return mapping;
+}
+
 /* An image node, with the wrapping and filtering MaterialX asks for.
