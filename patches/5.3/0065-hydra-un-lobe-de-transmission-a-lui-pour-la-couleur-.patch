+                            << "' after '" << nodeDesc.node->name.c_str() << "'.";
+              }
+            }
+
             for (const auto &wire : helper.wires) {
               ShaderOutput *const from = helperNode->output(wire.first);
               /* La cible est le noeud principal, ou un autre auxiliaire quand
@@ -2206,7 +2336,10 @@ unique_ptr<ShaderGraph> HdCyclesMaterial::BuildShaderGraph(HdMaterialNetworkSche
       continue;
     }
 
-    ShaderNode *const node = nodeIt->second.node;
+    /* La sortie du montage, qui n'est le noeud principal que s'il n'a rien
