+/* Poser une image sur un noeud, quelle que soit sa sorte. Rend faux si le noeud
+ * n'est pas un noeud image. */
+bool SetNodeImage(Scene *scene,
+                  ShaderNode *node,
+                  const std::string &opPath,
+                  const CopPixelsPtr &pixels)
+{
+  ImageSlotTextureNode *slotNode = nullptr;
+  ImageParams params;
+
+  if (ImageTextureNode *imageNode = dynamic_cast<ImageTextureNode *>(node)) {
+    params = imageNode->image_params();
+    slotNode = imageNode;
+  }
+  else if (EnvironmentTextureNode *envNode = dynamic_cast<EnvironmentTextureNode *>(node)) {
+    params = envNode->image_params();
+    slotNode = envNode;
+  }
+  else {
+    return false;
+  }
+
+  /* Nommer l'espace ici evite qu'un `colorspace` laisse a "auto" sur le noeud
+   * n'aille en deviner un autre : un COP travaille en lineaire. */
+  params.colorspace = u_colorspace_scene_linear;
+  slotNode->handle = scene->image_manager->add_image(
+      std::make_unique<HoudiniCopImageLoader>(opPath, pixels), params);
+  return true;
+}
+
