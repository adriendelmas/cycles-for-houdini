      * one, with no hint of which path failed. */
     const std::string &resolved = path.GetResolvedPath();
-    return ustring(resolved.empty() ? path.GetAssetPath() : resolved);
+    std::string filename = resolved.empty() ? path.GetAssetPath() : resolved;
+
+#ifdef WITH_HOUDINI_COP
+    /* A Houdini `op:` path names a compositing node, not a file. Cook it here,
+     * while the prim is being synced, and hand Cycles the resulting image -
+     * the loader itself runs on worker threads where cooking a Houdini node
+     * would take the host down. */
+    const std::string cooked = ResolveHoudiniCopPath(filename);
+    if (!cooked.empty()) {
+      filename = cooked;
+    }
+#endif
+
+    return ustring(filename);
   }
 
