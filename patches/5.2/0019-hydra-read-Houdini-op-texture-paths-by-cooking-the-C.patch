+++ b/src/hydra/houdini_cop.h
@@ -0,0 +1,28 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include "hydra/config.h"
+
+#include <string>
+
+HDCYCLES_NAMESPACE_OPEN_SCOPE
+
+/* Houdini lets a texture path point straight at a compositing node with
+ * `op:/img/net/OUT`. Nothing hands those pixels to a third party as a file:
+ * the USD asset resolver returns an asset of size zero, and Houdini's own
+ * image layer refuses the path outright - both measured. The only thing that
+ * produces pixels is cooking the node, so that is what this does, writing the
+ * result to an image file and returning its path.
+ *
+ * Cooking happens here, while the material is being synced, rather than when
+ * Cycles loads the image: image loading runs on Cycles' worker threads, and
+ * cooking a Houdini node from one of those would take the host down.
+ *
+ * Returns an empty string for a path that is not an `op:` path, and for a COP
+ * that could not be cooked. Results are cached per path for the session. */
+std::string ResolveHoudiniCopPath(const std::string &path);
+
+HDCYCLES_NAMESPACE_CLOSE_SCOPE
