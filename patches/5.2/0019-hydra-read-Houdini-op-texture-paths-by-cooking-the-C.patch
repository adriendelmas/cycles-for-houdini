diff --git a/src/hydra/houdini_cop.cpp b/src/hydra/houdini_cop.cpp
new file mode 100644
index 00000000..2ea5093d
--- /dev/null
+++ b/src/hydra/houdini_cop.cpp
@@ -0,0 +1,116 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#include "hydra/houdini_cop.h"
+
+#include "util/log.h"
+#include "util/path.h"
+#include "util/thread.h"
+
+#include <pxr/base/tf/hash.h>
+#include <pxr/base/tf/pyInterpreter.h>
+#include <pxr/base/tf/pyLock.h>
+#include <pxr/base/tf/stringUtils.h>
+
+#include <filesystem>
+#include <unordered_map>
+
+HDCYCLES_NAMESPACE_OPEN_SCOPE
+
+namespace {
+
+const char *const kPrefix = "op:";
+
+thread_mutex &CookMutex()
+{
+  static thread_mutex mutex;
+  return mutex;
+}
+
+std::unordered_map<std::string, std::string> &CookCache()
+{
+  static std::unordered_map<std::string, std::string> cache;
+  return cache;
+}
+
+/* `op:/img/net/OUT_COLOR[1]` names a plane of a node. Only the node part
+ * addresses something hou.node() can find. */
+std::string NodePathOf(const std::string &opPath)
+{
+  std::string node = opPath.substr(strlen(kPrefix));
+  const size_t plane = node.find('[');
+  if (plane != std::string::npos) {
+    node = node.substr(0, plane);
+  }
+  return node;
+}
+
+std::string OutputPathFor(const std::string &opPath)
+{
+  /* Hash the whole path, plane index included, so two planes of one node do
+   * not collide. */
+  const std::string name = "hdcycles_cop_" + std::to_string(PXR_NS::TfHash()(opPath)) + ".exr";
+  std::filesystem::path out = std::filesystem::temp_directory_path() / name;
+  /* Forward slashes only: the path is pasted into a Python string literal
+   * below, where a backslash would start an escape. */
+  return PXR_NS::TfStringReplace(out.string(), "\\", "/");
+}
+
+}  // namespace
+
+std::string ResolveHoudiniCopPath(const std::string &path)
+{
+  if (path.compare(0, strlen(kPrefix), kPrefix) != 0) {
+    return std::string();
+  }
+
+  const CCL_NS::thread_scoped_lock lock(CookMutex());
+
+  auto &cache = CookCache();
+  const auto it = cache.find(path);
+  if (it != cache.end()) {
+    return it->second;
+  }
+
+  const std::string nodePath = NodePathOf(path);
+  const std::string outPath = OutputPathFor(path);
+
+  /* The destination is decided here rather than read back from Python, which
+   * keeps this to a single call with nothing to unmarshal. */
+  /* Guarded so this stays quiet outside an interactive session: a batch render
+   * has no `hou` module at all, and the node would not exist there either. */
+  const std::string code = "try:\n"
+                           "    import hou\n"
+                           "    _n = hou.node('" +
+                           nodePath +
+                           "')\n"
+                           "    if _n is not None:\n"
+                           "        _n.saveImage('" +
+                           outPath +
+                           "')\n"
+                           "except Exception:\n"
+                           "    pass\n";
+
+  {
+    PXR_NS::TfPyInitialize();
+    const PXR_NS::TfPyLock pyLock;
+    PXR_NS::TfPyRunString(code, Py_file_input);
+  }
+
+  std::string result;
+  if (CCL_NS::path_exists(outPath)) {
+    result = outPath;
+    LOG_INFO << "Cooked Houdini COP " << path << " to " << outPath;
+  }
+  else {
+    LOG_WARNING << "Could not cook Houdini COP " << path
+                << ", the texture will be missing. Check that the node exists "
+                   "and can be rendered.";
+  }
+
+  cache[path] = result;
+  return result;
+}
+
+HDCYCLES_NAMESPACE_CLOSE_SCOPE
