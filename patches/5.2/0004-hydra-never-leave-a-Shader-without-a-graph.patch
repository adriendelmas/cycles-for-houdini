From 040b14086b74063d1e35548ba47dbad4f67ad294 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Mon, 31 Aug 2026 01:38:53 +0200
Subject: [PATCH 04/38] hydra: never leave a Shader without a graph

Shader::tag_update() reads graph->output() unconditionally, but
HdCyclesMaterial only assigns a graph once it has managed to read a material
network. A material whose network the delegate cannot read - a MaterialX
network, for one - took the error path, so the freshly created shader
reached tag_update() with a null graph and segfaulted the host.

Seed an empty graph at creation so a Shader is never in an invalid state,
and guard the terminal loop against a null node.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/hydra/material.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/hydra/material.cpp b/src/hydra/material.cpp
index f4e85f0e..6de7a402 100644
--- a/src/hydra/material.cpp
+++ b/src/hydra/material.cpp
@@ -500,6 +500,10 @@ void HdCyclesMaterial::PopulateShaderGraph(HdMaterialNetworkSchema network)
     }
 
     ShaderNode *const node = nodeIt->second.node;
+    if (node == nullptr || node->type == nullptr) {
+      TF_RUNTIME_ERROR("Terminal node '%s' has no Cycles node", upstreamNodePath.GetText());
+      continue;
+    }
 
     const char *inputName = nullptr;
     const char *outputName = nullptr;
@@ -597,6 +601,13 @@ void HdCyclesMaterial::Initialize(HdRenderParam *renderParam)
   const SceneLock lock(renderParam);
 
   _shader = lock.scene->create_node<Shader>();
+
+  /* A Shader with no graph is not a valid state: Shader::tag_update() reads
+   * graph->output() unconditionally. Sync() only assigns a graph once it has
+   * managed to read a material network, so a material whose network cannot be
+   * read would otherwise reach tag_update() with a null graph and crash the
+   * host. Seed an empty graph so the shader is always well-formed. */
+  _shader->set_graph(make_unique<ShaderGraph>());
 }
 
 HDCYCLES_NAMESPACE_CLOSE_SCOPE
