From 7657268cdf634eb61acb43411e6432fa6600f93e Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Tue, 1 Sep 2026 23:33:48 +0200
Subject: [PATCH 33/38] hydra: MaterialX displacement has no midlevel

The Cycles displacement node computes (height - midlevel) * scale and defaults
midlevel to 0.5, which is the convention for a heightfield read from an image
where mid grey means no displacement. MaterialX has no midlevel at all: its
displacement is simply amount * scale.

Left at the Cycles default, a MaterialX displacement node whose amount is
unconnected - which is what Houdini writes for a freshly placed one - pushed
every point half a unit along its normal. On a unit sphere that collapses the
surface, so the object vanished and then reappeared growing as soon as any
value reached the height. Verified on a scene exported from Houdini: an
unauthored displacement now renders identically to no displacement terminal at
all.

Also adds Houdini's kma render context alongside mtlx, which is what a Karma
Material Builder writes its network under.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/hydra/material.cpp        | 33 +++++++++++++++++++++++++--------
 src/hydra/render_delegate.cpp |  8 +++++++-
 2 files changed, 32 insertions(+), 9 deletions(-)

diff --git a/src/hydra/material.cpp b/src/hydra/material.cpp
index 47497aa5..9f1cd74f 100644
--- a/src/hydra/material.cpp
+++ b/src/hydra/material.cpp
@@ -476,14 +476,31 @@ const UsdToCyclesMapping MtlxMix = {"mix_color",
                                     }};
 
 /* Displacement. MaterialX carries the amount on a dedicated node feeding the
- * material's displacement terminal; Cycles has a direct equivalent. */
-const UsdToCyclesMapping MtlxDisplacement = {
-    "displacement",
-    {
-        {TfToken("displacement"), ustring("height")},
-        {TfToken("scale"), ustring("scale")},
-        {CyclesMaterialTokens->out, ustring("displacement")},
-    }};
+ * material's displacement terminal; Cycles has a direct equivalent, but not the
+ * same zero.
+ *
+ * Cycles computes (height - midlevel) * scale and defaults midlevel to 0.5, for
+ * a heightfield read from an image where mid grey means no displacement.
+ * MaterialX has no midlevel at all: its displacement is simply amount * scale.
+ * Left at the Cycles default, a MaterialX displacement node whose amount is
+ * unconnected - which is what Houdini writes for a freshly placed one - pushed
+ * every point half a unit along its inverted normal. On a unit sphere that
+ * collapses the surface to nothing, so the object vanished, and reappeared
+ * growing as soon as any value reached the height. */
+UsdToCyclesMapping MakeMtlxDisplacement()
+{
+  UsdToCyclesMapping mapping{
+      "displacement",
+      {
+          {TfToken("displacement"), ustring("height")},
+          {TfToken("scale"), ustring("scale")},
+          {CyclesMaterialTokens->out, ustring("displacement")},
+      }};
+  mapping.setFixedValues({{ustring("midlevel"), "0"}});
+  return mapping;
+}
+
+const UsdToCyclesMapping MtlxDisplacement = MakeMtlxDisplacement();
 
 const UsdToCyclesMapping MtlxVectorDisplacement = {
     "vector_displacement",
diff --git a/src/hydra/render_delegate.cpp b/src/hydra/render_delegate.cpp
index b02eef20..5d5ab595 100644
--- a/src/hydra/render_delegate.cpp
+++ b/src/hydra/render_delegate.cpp
@@ -44,6 +44,7 @@ TF_DEFINE_ENV_SETTING(CYCLES_DISPLAY_DRIVER,
 TF_DEFINE_PRIVATE_TOKENS(_tokens,
     (cycles)
     (mtlx)
+    (kma)
     (openvdbAsset)
 );
 // clang-format on
@@ -370,7 +371,12 @@ TfToken HdCyclesDelegate::GetMaterialBindingPurpose() const
 
 TfTokenVector HdCyclesDelegate::GetMaterialRenderContexts() const
 {
-  return {_tokens->cycles, _tokens->mtlx};
+  /* Houdini writes a Karma Material Builder's network under its own `kma`
+   * context and a USD MaterialX Builder's under `mtlx`, though both are the
+   * same MaterialX nodes. Without `kma` here, a Karma-built material fell back
+   * to the UsdPreviewSurface Houdini writes alongside it, quietly losing the
+   * real network. */
+  return {_tokens->cycles, _tokens->mtlx, _tokens->kma};
 }
 
 VtDictionary HdCyclesDelegate::GetRenderStats() const
