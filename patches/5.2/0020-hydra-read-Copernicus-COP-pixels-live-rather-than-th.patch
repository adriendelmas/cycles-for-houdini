From 5338795966f9ca95076c8e648054f549907cf721 Mon Sep 17 00:00:00 2001
From: Adrien Delmas <adrien@adriendelmas.com>
Date: Tue, 1 Sep 2026 00:45:16 +0200
Subject: [PATCH 20/38] hydra: read Copernicus COP pixels live rather than
 through an output node

Copernicus nodes - the compositing system Houdini has used since 20.5 - carry
no saveImage method, that being a COP2 API, so the first attempt at this only
ever worked against the old system. They do expose their pixels through
hou.ImageLayer: bufferResolution and allBufferElements hand over the buffer
directly, which is read here and written out. Nothing is added to the user's
scene and no output node has to be wired up.

Measured on a Copernicus node: 1024x1024, Float32, 4194304 bytes, exactly
width * height * channels * 4.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/hydra/houdini_cop.cpp | 20 +++++++++++++++++---
 src/hydra/houdini_cop.h   |  3 +++
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/src/hydra/houdini_cop.cpp b/src/hydra/houdini_cop.cpp
index 2ea5093d..f2a2c574 100644
--- a/src/hydra/houdini_cop.cpp
+++ b/src/hydra/houdini_cop.cpp
@@ -78,15 +78,29 @@ std::string ResolveHoudiniCopPath(const std::string &path)
 
   /* The destination is decided here rather than read back from Python, which
    * keeps this to a single call with nothing to unmarshal. */
-  /* Guarded so this stays quiet outside an interactive session: a batch render
-   * has no `hou` module at all, and the node would not exist there either. */
+  /* Two compositing systems to cover, and neither is reachable as a file.
+   *
+   * The older COP2 nodes write an image themselves. Copernicus nodes do not
+   * carry that method at all, but they do expose their pixels live through
+   * hou.ImageLayer - which is read straight out and written here, so nothing
+   * is added to the user's scene and no output node has to be wired up.
+   *
+   * Guarded as a whole so this stays quiet outside an interactive session: a
+   * batch render has no `hou` module, and no node to read either. */
   const std::string code = "try:\n"
                            "    import hou\n"
                            "    _n = hou.node('" +
                            nodePath +
                            "')\n"
                            "    if _n is not None:\n"
-                           "        _n.saveImage('" +
+                           "        if hasattr(_n, 'saveImage'):\n"
+                           "            _n.saveImage('" +
+                           outPath +
+                           "')\n"
+                           "        else:\n"
+                           "            _l = _n.layer()\n"
+                           "            _r = _l.bufferResolution()\n"
+                           "            hou.saveImageDataToFile(_l.allBufferElements(), _r[0], _r[1], '" +
                            outPath +
                            "')\n"
                            "except Exception:\n"
diff --git a/src/hydra/houdini_cop.h b/src/hydra/houdini_cop.h
index dfd04562..5a7bc95f 100644
--- a/src/hydra/houdini_cop.h
+++ b/src/hydra/houdini_cop.h
@@ -21,6 +21,9 @@ HDCYCLES_NAMESPACE_OPEN_SCOPE
  * Cycles loads the image: image loading runs on Cycles' worker threads, and
  * cooking a Houdini node from one of those would take the host down.
  *
+ * Both compositing systems are handled: COP2 nodes save an image themselves,
+ * while Copernicus nodes expose their pixels live through hou.ImageLayer.
+ *
  * Returns an empty string for a path that is not an `op:` path, and for a COP
  * that could not be cooked. Results are cached per path for the session. */
 std::string ResolveHoudiniCopPath(const std::string &path);
