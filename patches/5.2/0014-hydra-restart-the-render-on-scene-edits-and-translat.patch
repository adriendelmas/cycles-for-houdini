+bool HdCyclesDelegate::IsStopSupported() const
+{
+  return true;
+}
+
+bool HdCyclesDelegate::Stop(const bool blocking)
+{
+  /* Hosts stop the render before applying scene edits and restart it after.
+   * Without this the session kept running against the old scene state, so
+   * moving an object or editing a material only showed up once the user
+   * restarted the render by hand. */
+  _renderParam->session->cancel(!blocking);
+  return true;
+}
+
+bool HdCyclesDelegate::Restart()
+{
+  /* HdCyclesRenderPass::_Execute() returns early while the session is
+   * cancelled, so clear that state before it runs again. It resets and starts
+   * the session itself once the scene reports it needs it. */
+  _renderParam->session->progress.reset();
+  return true;
+}
+
 bool HdCyclesDelegate::IsPauseSupported() const
 {
   return true;
