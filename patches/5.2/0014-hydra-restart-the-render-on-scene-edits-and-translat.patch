+/* A Cycles node whose useful output depends on what it feeds: texture nodes
+ * carry both a scalar `fac` and a `color`, while MaterialX exposes a single
+ * `out`. */
+class MtlxFacOrColor : public UsdToCyclesMapping {
+ public:
+  using UsdToCyclesMapping::UsdToCyclesMapping;
+
+  std::string parameterName(const TfToken &name,
+                            const ShaderInput *inputConnection,
+                            VtValue *value) const override
+  {
+    if (name == CyclesMaterialTokens->out && inputConnection) {
+      switch (inputConnection->socket_type.type) {
+        case SocketType::BOOLEAN:
+        case SocketType::FLOAT:
+        case SocketType::INT:
+        case SocketType::UINT:
+          return "fac";
+        default:
+          return "color";
+      }
+    }
+    return UsdToCyclesMapping::parameterName(name, inputConnection, value);
+  }
+};
