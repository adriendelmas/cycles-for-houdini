+/* Arithmetic. A single Cycles math (or vector_math) node covers all of these,
+ * selected through its mode enum - hence the fixed value. */
+UsdToCyclesMapping MakeMtlxMath(const char *const mode, const bool vector)
+{
+  UsdToCyclesMapping mapping{
+      vector ? "vector_math" : "math",
+      {
+          {TfToken("in1"), ustring(vector ? "vector1" : "value1")},
+          {TfToken("in2"), ustring(vector ? "vector2" : "value2")},
+          {CyclesMaterialTokens->out, ustring(vector ? "vector" : "value")},
+      }};
+  mapping.setFixedValues({{ustring("math_type"), mode}});
+  return mapping;
