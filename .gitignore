# Cycles itself, its builds and the installs: rebuilt by tools/bootstrap.py.
external/cycles/
external/cycles-53/
build/
install/
install-53/
*.user
__pycache__/
*.pyc
*.log

# Rendered output never lives next to the scenes or the references. Each bench
# writes into one of these; the references it compares against are tracked.
tests/nodes/*/scenes/
tests/nodes/*/output/
tests/materialx/output/
tests/curves/output/
tests/motion/output/
tests/instances/output/
tests/implicit/output/
tests/settings/output/
tests/aovs/output/
tests/karma_settings/output/
tests/agreement/output/
tests/volume/output/
tests/usdtex/output/
tests/dome/output/
tests/materialx/hair/
tests/materialx/standard_surface/*.exr
tests/scratch/
